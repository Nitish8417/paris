    "95b2913b-2a37-4e45-b85f-23f61a813e4f": {
      "type": "collapsible-content",
      "blocks": {
        "template--21937777180987__95b2913b-2a37-4e45-b85f-23f61a813e4f-content-1": {
          "type": "content",
          "settings": {
            "heading": "Our design approach focuses on modern expression.",
            "content": "<p>Fashion is shaped by evolving ideas, cultural influences, and design innovation. Our approach centers on creating pieces that balance contemporary aesthetics with refined details, resulting in collections that feel relevant and intentional<\/p>"
          }
        },
        "template--21937777180987__95b2913b-2a37-4e45-b85f-23f61a813e4f-content-2": {
          "type": "content",
          "settings": {
            "heading": "Each collection is developed with attention to quality and design.",
            "content": "<p>Quality reflects not only materials but also structure, finish, and overall execution. We emphasize consistency across our collections, ensuring each design aligns with our visual standards and delivers a refined, considered experience.<\/p>"
          }
        },
        "template--21937777180987__95b2913b-2a37-4e45-b85f-23f61a813e4f-content-3": {
          "type": "content",
          "settings": {
            "heading": "We believe style is influenced by creativity and personal identity.",
            "content": "<p>Style goes beyond trends, representing how individuals express themselves through form, color, and detail. Our collections are inspired by modern lifestyles and creative expression, offering designs that feel personal, confident, and adaptable.<\/p>"
          }
        },
        "content_HLfkDH": {
          "type": "content",
          "settings": {
            "heading": "Our vision is to create collections that remain relevant beyond seasons",
            "content": "<p>Rather than following fleeting trends, we focus on designs that maintain appeal over time. This approach allows our collections to feel enduring while still reflecting modern design sensibilities and evolving style influences.<\/p>"
          }
        }
      },
      "block_order": [
        "template--21937777180987__95b2913b-2a37-4e45-b85f-23f61a813e4f-content-1",
        "template--21937777180987__95b2913b-2a37-4e45-b85f-23f61a813e4f-content-2",
        "template--21937777180987__95b2913b-2a37-4e45-b85f-23f61a813e4f-content-3",
