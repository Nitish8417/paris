    "techty_testimonials_hrDT7G": {
      "type": "techty-testimonials",
      "blocks": {
        "testimonial_kWnBXP": {
          "type": "testimonial",
          "settings": {
            "quote": "It's rare to find one place in Kuwait that has the charger, the speaker and the gift all in the same order. Everything I needed was on Techty, and it all arrived together.",
            "name": "Abdullah K.",
            "role": "Techty customer",
            "rating": 5,
            "tag": "Shop all",
            "tag_link": "/collections/all"
          }
        },
        "testimonial_p6Gfcd": {
          "type": "testimonial",
          "settings": {
            "quote": "I messaged them on WhatsApp to check which charger actually suits my laptop. Quick, straight answer, and they didn't push me toward the most expensive one.",
            "name": "Noura A.",
            "role": "Techty customer",
            "rating": 5,
            "tag": "Chargers",
            "tag_link": "/collections/chargers-adapters"
          }
        },
        "testimonial_6xWCYA": {
          "type": "testimonial",
          "settings": {
            "quote": "Bought the GRIT Apex for my evening walks. Having two straps in the box was a nice touch — sporty one for the gym, the other for work.",
            "name": "Fahad M.",
            "role": "Wearables customer",
            "rating": 5,
            "tag": "Smart watches",
            "tag_link": "/collections/smart-watches-fitness-trackers"
          }
        },
        "testimonial_8MQWyg": {
          "type": "testimonial",
          "settings": {
            "quote": "The Xiaomi magnetic power bank with the built-in cable basically lives in my bag now. No more hunting for a cable at the airport.",
            "name": "Mariam S.",
            "role": "Frequent traveller",
            "rating": 5,
            "tag": "Power banks",
            "tag_link": "/collections/power-banks"
          }
        },
        "testimonial_AGmQGX": {
          "type": "testimonial",
          "settings": {
            "quote": "Wanted Soundcore earbuds that are good for calls while driving. Voice comes through clearly and they're comfortable enough to forget I'm wearing them.",
            "name": "Dana R.",
            "role": "Audio customer",
            "rating": 5,
            "tag": "Earbuds",
            "tag_link": "/collections/earbuds-headphones"
          }
        },
        "testimonial_hVzQD8": {
          "type": "testimonial",
          "settings": {
            "quote": "Got a Neewer light kit and the KM18 lavalier mic for my home setup. Took about ten minutes to get running and my videos look like a different channel.",
            "name": "Hessa J.",
            "role": "Content creator",
            "rating": 5,
            "tag": "Creator kit",
            "tag_link": "/collections/content-creator-kit"
          }
        },
        "testimonial_TQg9iX": {
          "type": "testimonial",
          "settings": {
            "quote": "The gaming section is well picked rather than endless. Grabbed a new controller and a couple of cables for my setup, and everything matched the description exactly.",
            "name": "Yousef H.",
            "role": "Gaming customer",
            "rating": 5,
            "tag": "Gaming gear",
            "tag_link": "/collections/gaming-controllers-gear"
          }
        },
        "testimonial_LVjeXL": {
          "type": "testimonial",
          "settings": {
            "quote": "Ordered a travel adapter two days before a trip and it made it in time. I also swapped a cable that didn't fit my phone — the exchange was easy and free.",
            "name": "Omar T.",
            "role": "Techty customer",
            "rating": 5,
            "tag": "Travel",
            "tag_link": "/collections/travel"
          }
        }
      },
