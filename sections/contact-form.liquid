<div class="{{ section.settings.color_scheme }}-scheme spacing-box techty-contact">
  <div class="{% if section.settings.section_full_width %}{{ settings.layout_width }}{% else %}{{ settings.layout_width }}{% endif %}">
    <div class="techty-contact__grid{% if section.settings.image != blank %} techty-contact__grid--with-image{% endif %}">
      {% if section.settings.image != blank %}
        <div class="techty-contact__media cont-img-{{ section.settings.image_position }}">
          <div class="contact-image">
            {%- assign image_ratio = 1 | divided_by: section.settings.image.aspect_ratio | times: 100 | plus: 1 -%}
            <div class="media-image" style="--mediaRatio:{{ image_ratio }}%">
              {%- render 'image', image: section.settings.image -%}
            </div>
          </div>
        </div>
      {% endif %}

      <aside class="techty-contact__info">
        {% if section.settings.heading != blank or section.settings.description != blank %}
          <div class="techty-contact__intro align-{{ section.settings.content_alignment }}">
            {% if section.settings.heading != blank %}
              <h2 class="techty-contact__heading {{ section.settings.heading_size }} {{ section.settings.heading_size_mobile }}">
                {{ section.settings.heading }}
              </h2>
            {% endif %}
            {% if section.settings.description != blank %}
              <p class="techty-contact__desc">{{ section.settings.description }}</p>
            {% endif %}
          </div>
        {% endif %}

        <ul class="techty-contact__details" role="list">
          {% if section.settings.email != blank %}
            <li class="techty-contact__detail">
              <span class="techty-contact__detail-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                  <path d="M4 6.5h16v11H4v-11z" stroke="currentColor" stroke-width="1.6"/>
                  <path d="M4.5 7l7.5 6 7.5-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <div>
                <span class="techty-contact__detail-label">Email</span>
                <a href="mailto:{{ section.settings.email | escape }}">{{ section.settings.email }}</a>
              </div>
            </li>
          {% endif %}
          {% if section.settings.phone != blank %}
            <li class="techty-contact__detail">
              <span class="techty-contact__detail-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                  <path d="M7.5 4.5h3l1.5 4-2 1.2a11 11 0 005.3 5.3l1.2-2 4 1.5v3A2 2 0 0018.5 19 14.5 14.5 0 015 5.5a2 2 0 002.5-1z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                </svg>
              </span>
              <div>
                <span class="techty-contact__detail-label">Phone</span>
                <a href="tel:{{ section.settings.phone | replace: ' ', '' | escape }}">{{ section.settings.phone }}</a>
              </div>
            </li>
          {% endif %}
          {% if section.settings.address != blank %}
            <li class="techty-contact__detail">
              <span class="techty-contact__detail-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                  <path d="M12 21s7-5.2 7-11a7 7 0 10-14 0c0 5.8 7 11 7 11z" stroke="currentColor" stroke-width="1.6"/>
                  <circle cx="12" cy="10" r="2.5" stroke="currentColor" stroke-width="1.6"/>
                </svg>
              </span>
              <div>
                <span class="techty-contact__detail-label">Address</span>
                <p>{{ section.settings.address | newline_to_br }}</p>
              </div>
            </li>
          {% endif %}
        </ul>
      </aside>

      <div class="techty-contact__form-wrap">
        <div class="techty-contact__form-card">
          <div class="techty-contact__form-head">
            <h3 class="techty-contact__form-title">
              {{ section.settings.form_heading | default: 'Send us a message' }}
            </h3>
            {% if section.settings.form_description != blank %}
              <p class="techty-contact__form-desc">{{ section.settings.form_description }}</p>
            {% endif %}
          </div>

          {%- form 'contact', id: 'ContactForm', class: 'techty-contact-form' -%}
            {%- if form.posted_successfully? -%}
              <div class="techty-contact__alert techty-contact__alert--success" role="status" tabindex="-1" autofocus>
                <p>{{- 'templates.contact.form.post_success' | t -}}</p>
              </div>
            {%- endif -%}

            {%- if form.errors -%}
              <div class="techty-contact__alert techty-contact__alert--error" role="alert" tabindex="-1" autofocus>
                <p>{{ 'templates.contact.form.error_heading' | t }}</p>
                <ul>
                  {%- for field in form.errors -%}
                    <li>
                      {%- if field == 'form' -%}
                        {{ form.errors.messages[field] }}
                      {%- else -%}
                        {{ form.errors.translated_fields[field] | capitalize }}
                        {{ form.errors.messages[field] }}
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}

            <div class="techty-contact__fields">
              <div class="techty-contact__field">
                <label for="ContactForm-name">{{ 'templates.contact.form.name' | t }}</label>
                <input
                  type="text"
                  id="ContactForm-name"
                  name="contact[name]"
                  class="form-input-field"
                  autocomplete="name"
                  value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                  placeholder="{{ 'templates.contact.form.name' | t }}"
                  required
                >
              </div>

              <div class="techty-contact__field">
                <label for="ContactForm-email">{{ 'templates.contact.form.email' | t }}</label>
                <input
                  type="email"
                  id="ContactForm-email"
                  name="contact[email]"
                  class="form-input-field"
                  autocomplete="email"
                  autocapitalize="off"
                  spellcheck="false"
                  value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                  aria-required="true"
                  {% if form.errors contains 'email' %}
                    aria-invalid="true"
                    aria-describedby="ContactForm-email-error"
                  {% endif %}
                  placeholder="{{ 'templates.contact.form.email' | t }}"
                  required
                >
              </div>

              <div class="techty-contact__field">
                <label for="ContactForm-phone">{{ 'templates.contact.form.phone' | t }}</label>
                <input
                  type="tel"
                  id="ContactForm-phone"
                  name="contact[phone]"
                  class="form-input-field"
                  autocomplete="tel"
                  value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                  placeholder="{{ 'templates.contact.form.phone' | t }}"
                >
              </div>

              <div class="techty-contact__field">
                <label for="ContactForm-subject">Subject</label>
                <input
                  type="text"
                  id="ContactForm-subject"
                  name="contact[subject]"
                  class="form-input-field"
                  value="{% if form.subject %}{{ form.subject }}{% endif %}"
                  placeholder="Subject"
                >
              </div>

              <div class="techty-contact__field techty-contact__field--full">
                <label for="ContactForm-body">{{ 'templates.contact.form.comment' | t }}</label>
                <textarea
                  rows="6"
                  id="ContactForm-body"
                  name="contact[body]"
                  class="form-input-field"
                  placeholder="{{ 'templates.contact.form.comment' | t }}"
                  required
                >{% if form.body %}{{ form.body }}{% endif %}</textarea>
              </div>
            </div>

            <div class="techty-contact__actions align-{{ section.settings.content_alignment }}">
              <button type="submit" class="btn fill-btn btn-medium techty-contact__submit">
                <span>{{ 'templates.contact.form.send' | t }}</span>
              </button>
            </div>
          {%- endform -%}
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  #shopify-section-{{ section.id }} {
    --topSpace: {{ section.settings.top_space_desktop }}px;
    --bottomSpace: {{ section.settings.bottom_space_desktop }}px;
  }

  #shopify-section-{{ section.id }} .techty-contact__grid {
    display: grid;
    grid-template-columns: minmax(240px, 0.9fr) minmax(0, 1.2fr);
    gap: 28px 40px;
    align-items: start;
  }

  #shopify-section-{{ section.id }} .techty-contact__grid--with-image {
    grid-template-columns: minmax(0, 0.9fr) minmax(240px, 0.85fr) minmax(0, 1.1fr);
  }

  #shopify-section-{{ section.id }} .techty-contact__intro {
    margin-bottom: 28px;
  }

  #shopify-section-{{ section.id }} .techty-contact__heading {
    margin: 0 0 10px;
  }

  #shopify-section-{{ section.id }} .techty-contact__desc {
    margin: 0;
    opacity: 0.8;
    line-height: 1.5;
  }

  #shopify-section-{{ section.id }} .techty-contact__details {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }

  #shopify-section-{{ section.id }} .techty-contact__detail {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  #shopify-section-{{ section.id }} .techty-contact__detail-icon {
    width: 38px;
    height: 38px;
    border-radius: 999px;
    background: #111;
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 38px;
  }

  #shopify-section-{{ section.id }} .techty-contact__detail-label {
    display: block;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: 2px;
  }

  #shopify-section-{{ section.id }} .techty-contact__detail a,
  #shopify-section-{{ section.id }} .techty-contact__detail p {
    margin: 0;
    color: inherit;
    text-decoration: none;
    line-height: 1.45;
  }

  #shopify-section-{{ section.id }} .techty-contact__detail a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  #shopify-section-{{ section.id }} .techty-contact__form-card {
    background: #fff;
    border: 1px solid rgba(17, 17, 17, 0.1);
    border-radius: 16px;
    padding: 28px;
    box-shadow: 0 10px 30px rgba(17, 17, 17, 0.04);
  }

  #shopify-section-{{ section.id }} .techty-contact__form-head {
    margin-bottom: 22px;
  }

  #shopify-section-{{ section.id }} .techty-contact__form-title {
    margin: 0 0 6px;
    font-size: clamp(22px, 2vw, 28px);
  }

  #shopify-section-{{ section.id }} .techty-contact__form-desc {
    margin: 0;
    opacity: 0.75;
  }

  #shopify-section-{{ section.id }} .techty-contact__fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  #shopify-section-{{ section.id }} .techty-contact__field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  #shopify-section-{{ section.id }} .techty-contact__field--full {
    grid-column: 1 / -1;
  }

  #shopify-section-{{ section.id }} .techty-contact__field label {
    font-size: 13px;
    font-weight: 600;
  }

  #shopify-section-{{ section.id }} .techty-contact__field .form-input-field {
    width: 100%;
    margin: 0;
    border-radius: 10px;
    border: 1px solid rgba(17, 17, 17, 0.14);
    background: #fafafa;
    padding: 12px 14px;
  }

  #shopify-section-{{ section.id }} .techty-contact__field textarea.form-input-field {
    resize: vertical;
    min-height: 140px;
  }

  #shopify-section-{{ section.id }} .techty-contact__field .form-input-field:focus {
    outline: 2px solid #111;
    outline-offset: 1px;
    background: #fff;
  }

  #shopify-section-{{ section.id }} .techty-contact__actions {
    margin-top: 18px;
  }

  #shopify-section-{{ section.id }} .techty-contact__submit {
    min-width: 160px;
  }

  #shopify-section-{{ section.id }} .techty-contact__alert {
    border-radius: 10px;
    padding: 12px 14px;
    margin-bottom: 16px;
  }

  #shopify-section-{{ section.id }} .techty-contact__alert p,
  #shopify-section-{{ section.id }} .techty-contact__alert ul {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .techty-contact__alert ul {
    margin-top: 6px;
    padding-left: 18px;
  }

  #shopify-section-{{ section.id }} .techty-contact__alert--success {
    background: #e8f6ec;
    color: #126e00;
  }

  #shopify-section-{{ section.id }} .techty-contact__alert--error {
    background: #fdecec;
    color: #a11818;
  }

  @media only screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .techty-contact__grid,
    #shopify-section-{{ section.id }} .techty-contact__grid--with-image {
      grid-template-columns: 1fr;
    }
  }

  @media only screen and (max-width: 767px) {
    #shopify-section-{{ section.id }}.shopify-section {
      --topSpace: {{ section.settings.top_space_mobile }}px;
      --bottomSpace: {{ section.settings.bottom_space_mobile }}px;
    }

    #shopify-section-{{ section.id }} .techty-contact__fields {
      grid-template-columns: 1fr;
    }

    #shopify-section-{{ section.id }} .techty-contact__form-card {
      padding: 20px;
    }
  }
</style>

{% schema %}
{
  "name": "t:sections.contact_form.name",
  "tag": "section",
  "class": "contact-form",
  "disabled_on": {
    "groups": ["header", "footer", "aside"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "section_full_width",
      "label": "t:common.global.section_full_width.label",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:common.global.image.label"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:common.global.image_position.label",
      "default": "left",
      "options": [
        {
          "label": "t:common.global.left.label",
          "value": "left"
        },
        {
          "label": "t:common.global.right.label",
          "value": "right"
        }
      ]
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Get in touch",
      "label": "t:common.global.heading.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "default": "h2",
      "label": "t:common.heading_size.desktop_label",
      "options": [
        { "value": "h1", "label": "t:common.heading_size.options.extra_large.label" },
        { "value": "h2", "label": "t:common.heading_size.options.large.label" },
        { "value": "h3", "label": "t:common.heading_size.options.medium.label" },
        { "value": "h4", "label": "t:common.heading_size.options.small.label" },
        { "value": "h5", "label": "t:common.heading_size.options.extra_small.label" }
      ]
    },
    {
      "type": "select",
      "id": "heading_size_mobile",
      "default": "h3_mobile",
      "label": "t:common.heading_size.mobile_label",
      "options": [
        { "value": "h1_mobile", "label": "t:common.heading_size.options.extra_large.label" },
        { "value": "h2_mobile", "label": "t:common.heading_size.options.large.label" },
        { "value": "h3_mobile", "label": "t:common.heading_size.options.medium.label" },
        { "value": "h4_mobile", "label": "t:common.heading_size.options.small.label" },
        { "value": "h5_mobile", "label": "t:common.heading_size.options.extra_small.label" }
      ]
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:common.global.description.label",
      "default": "Questions about orders, products, or support? Send us a message and we’ll reply soon."
    },
    {
      "type": "header",
      "content": "Contact details"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "info@techty.com"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone",
      "default": "+965 22280345"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Address",
      "default": "Techty\nHamad Al-Mubarak Street\nSalmiya, Kuwait"
    },
    {
      "type": "header",
      "content": "Form"
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Form heading",
      "default": "Send us a message"
    },
    {
      "type": "textarea",
      "id": "form_description",
      "label": "Form description",
      "default": "Fill in the form and our team will get back to you."
    },
    {
      "type": "header",
      "content": "t:common.header.content.content"
    },
    {
      "type": "text_alignment",
      "id": "content_alignment",
      "label": "t:common.global.alignment.label",
      "default": "left"
    },
    {
      "type": "header",
      "content": "t:common.header.colors.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "primary",
      "label": "t:common.global.color_scheme.label"
    },
    {
      "type": "header",
      "content": "t:common.header.section_spacing.content"
    },
    {
      "type": "range",
      "id": "top_space_desktop",
      "label": "t:common.section_spacing.top_space_desktop.label",
      "default": 60,
      "min": 0,
      "max": 150,
      "step": 5
    },
    {
      "type": "range",
      "id": "bottom_space_desktop",
      "label": "t:common.section_spacing.bottom_space_desktop.label",
      "default": 80,
      "min": 0,
      "max": 150,
      "step": 5
    },
    {
      "type": "range",
      "id": "top_space_mobile",
      "label": "t:common.section_spacing.top_space_mobile.label",
      "default": 40,
      "min": 0,
      "max": 100,
      "step": 5
    },
    {
      "type": "range",
      "id": "bottom_space_mobile",
      "label": "t:common.section_spacing.bottom_space_mobile.label",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 5
    }
  ],
  "presets": [
    {
      "name": "t:sections.contact_form.presets.name"
    }
  ]
}
{% endschema %}
