{% assign collection = section.settings.collection %}
{%- liquid
  assign view_all_label = section.settings.btn_text | default: 'View All'
  assign view_all_link = section.settings.btn_link
  if view_all_link == blank and collection != blank
    assign view_all_link = collection.url
  endif
-%}
<div class="featured-collection-wrapper {{ section.settings.color_scheme }}-scheme spacing-box">
  <div class="{{ settings.layout_width }}">
    {% if section.settings.heading != blank
      or collection != blank and section.settings.enable_collection_title
      or view_all_link != blank
    %}
      <div class="heading-header flex featured-collection__header">
        {% if section.settings.heading != blank or collection != blank and section.settings.enable_collection_title %}
          <h2 class="{{ section.settings.heading_size }} {{ section.settings.heading_size_mobile }} align-{{ section.settings.heading_alignment }}">
            {% if section.settings.heading != blank and section.settings.enable_collection_title == false -%}
              {{- section.settings.heading -}}
            {%- else %}
              {{- collection.title -}}
            {% endif %}
          </h2>
        {% endif %}
        {% if view_all_link != blank and view_all_label != blank %}
          <a href="{{ view_all_link }}" class="show-all-btn textBase desk-view">
            <span class="link-text">
              {{- view_all_label }}
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path d="M1 5.8H10.5833M6 11L11 5.8L6 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </span>
          </a>
        {% endif %}
      </div>
    {% endif %}
    {% assign sliderStyle = false %}

    {%- liquid
      assign item_column = 12 | divided_by: section.settings.columns_desktop
    -%}

    {% if section.settings.products_style
      and section.settings.products_to_show > 2
      and collection.all_products_count > 2
    %}
      {% assign sliderStyle = true %}
    {% elsif collection == blank and section.settings.products_style and section.settings.products_to_show > 2 %}
      {% assign sliderStyle = true %}
    {% endif %}
    <div
      class="{% if section.settings.products_style %} slider product_card {% else %}grid-row stacked{% endif %}"
      {% if sliderStyle %}
        data-flickity-slider
        data-flickity='
          {
            "wrapAround": true,
            "cellAlign": "left",
            "contain": false,
            "pageDots": false,
            "prevNextButtons": false,
            "resize": true,
            "draggable": true,
            "freeScroll": true,
            "autoPlay": false,
            "groupCells": 1
          }
        '
      {% endif %}
    >
      {%- if collection != blank and collection.all_products_count > 0 -%}
        {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
          {% assign aosDelayAttr = forloop.index | times: 150 %}
          {% assign productFormId = 'product-form-'
            | append: section.id
            | append: forloop.index
            | append: '-'
            | append: collection.handle
          %}
          <div class="{% if section.settings.products_style %}product-media-cards featured-collection-item grid-item-md-{{ item_column }}{% else %}grid-item-md-{{ item_column }}{% endif %}">
            {%- capture current -%}{% cycle section.id: 1, 2, 3, 4 %}{%- endcapture -%}
            {%- assign placeholder_image = 'product-apparel-' | append: current -%}
            {% render 'product-grid',
              cardProduct: product,
              section: section,
              productFormId: productFormId,
              aosDelayAttr: aosDelayAttr,
              placeholder_image: placeholder_image,
              imageRatio: section.settings.grid_image_size,
              show_add_to_cart: section.settings.show_add_to_cart,
              enable_image_border: section.settings.enable_image_border
            %}
          </div>
        {% endfor %}
      {% else %}
        {% assign limit = section.settings.products_to_show %}
        {%- for i in (1..limit) -%}
          {% assign aosDelayAttr = forloop.index | times: 150 %}
          <div class="{% if section.settings.products_style %}product-media-cards featured-collection-item grid-item-md-{{ item_column }}{% else %}grid-item-md-{{ 12 | divided_by: section.settings.columns_desktop }} {% endif %}">
            {%- capture current -%}{% cycle section.id: 1, 2, 3, 4 %}{%- endcapture -%}
            {%- assign placeholder_image = 'product-apparel-' | append: current -%}
            {% render 'product-grid',
              section: section,
              aosDelayAttr: aosDelayAttr,
              placeholder_image: placeholder_image,
              imageRatio: section.settings.grid_image_size,
              show_add_to_cart: section.settings.show_add_to_cart,
              enable_image_border: section.settings.enable_image_border
            %}
          </div>
        {%- endfor -%}
      {% endif %}
    </div>

    {% if view_all_link != blank and view_all_label != blank %}
      <div class="show-all-btn-box align-center mob-view">
        <a href="{{ view_all_link }}" class="show-all-btn textBase">
          <span class="link-text">
            {{- view_all_label }}
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M1 5.8H10.5833M6 11L11 5.8L6 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </span>
        </a>
      </div>
    {% endif %}
  </div>
</div>

<style>
  #shopify-section-{{ section.id }} {
    --topSpace:{{ section.settings.top_space_desktop }}px;
    --bottomSpace:{{ section.settings.bottom_space_desktop }}px;
    --fcImageBg: {{ section.settings.image_background_color }};
    {%- case section.settings.grid_image_size -%}
      {%- when 'landscape' -%}
        --fcMediaRatio: 75%;
      {%- when 'portrait' -%}
        --fcMediaRatio: 125%;
      {%- when 'auto' -%}
        --fcMediaRatio: 100%;
      {%- else -%}
        --fcMediaRatio: 100%;
    {%- endcase -%}
  }

  #shopify-section-{{ section.id }} .featured-collection__header {
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 20px;
  }

  #shopify-section-{{ section.id }} .featured-collection__header .show-all-btn {
    margin-top: 0;
    margin-left: auto;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .featured-collection__header h2 {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .slider.product_card,
  #shopify-section-{{ section.id }} .grid-row {
    min-height: 1px;
  }

  #shopify-section-{{ section.id }} .product-media-cards.featured-collection-item {
    width: calc(100% / {{ section.settings.columns_desktop }});
    max-width: calc(100% / {{ section.settings.columns_desktop }});
    flex: 0 0 calc(100% / {{ section.settings.columns_desktop }});
    padding: 0 10px;
    box-sizing: border-box;
  }

  /* Same image height for every card — do not use height:100% (breaks Flickity) */
  #shopify-section-{{ section.id }} .product-card .media-image {
    height: auto !important;
    padding-top: var(--fcMediaRatio) !important;
    background-color: var(--fcImageBg) !important;
  }

  #shopify-section-{{ section.id }} .product-card .media-image img,
  #shopify-section-{{ section.id }} .product-card .media-image .placeholder-svg {
    object-fit: {{ section.settings.image_fit | default: 'contain' }};
    background-color: transparent;
    padding: 30px;
  }

  #shopify-section-{{ section.id }} .product-card-inner {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .product-header {
    display: flex;
    flex-direction: column;
    width: 100%;
    padding-top: 12px;
  }

  #shopify-section-{{ section.id }} .product-swatch-slot {
    min-height: 34px;
    margin-bottom: 8px;
    display: flex;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .product-swatch-slot .product-swatch-list {
    margin-bottom: 0;
  }

  #shopify-section-{{ section.id }} .product-title-wrapper {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  #shopify-section-{{ section.id }} .product-name {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    min-height: calc(1.35em * 2);
    line-height: 1.35;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .price-wrapper {
    min-height: 1.5em;
    margin-top: 0;
  }

  #shopify-section-{{ section.id }} .product-card-atc {
    margin-top: 14px;
  }

  #shopify-section-{{ section.id }} .product-card-atc__btn {
    width: 100%;
    justify-content: center;
    max-width: 200px;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .product-card-atc .product-form__error-message-wrapper {
    margin-bottom: 6px;
  }

  @media only screen and (max-width: 989px) and (min-width: 768px) {
    #shopify-section-{{ section.id }} .product-media-cards.featured-collection-item {
      width: 33.333%;
      max-width: 33.333%;
      flex: 0 0 33.333%;
      padding: 0 8px;
      box-sizing: border-box;
    }
  }

  @media only screen and (max-width: 767px) {
    #shopify-section-{{ section.id }}.shopify-section {
      --topSpace: {{ section.settings.top_space_mobile }}px;
      --bottomSpace: 20px;
    }

    /* Hide Flickity Navigation Buttons / Arrows completely in Mobile */
    #shopify-section-{{ section.id }} .flickity-button,
    #shopify-section-{{ section.id }} .flickity-prev-next-button,
    #shopify-section-{{ section.id }} .flickity-page-dots {
      display: none !important;
    }

    /* Smooth Touch & Swipe Handling */
    #shopify-section-{{ section.id }} .slider.product_card {
      touch-action: pan-y !important;
      -webkit-overflow-scrolling: touch;
    }

    #shopify-section-{{ section.id }} .slider.product_card .flickity-slider {
      will-change: transform;
    }

    /* Exact 10px spacing on both sides */
    #shopify-section-{{ section.id }} .featured-collection-wrapper {
      padding-left: 10px !important;
      padding-right: 10px !important;
      box-sizing: border-box !important;
      overflow: hidden !important;
    }

    /* Prevent the theme layout wrapper from adding extra spacing */
    #shopify-section-{{ section.id }} .featured-collection-wrapper > div {
      width: 100% !important;
      max-width: 100% !important;
      padding-left: 0 !important;
      padding-right: 0 !important;
      margin-left: auto !important;
      margin-right: auto !important;
      box-sizing: border-box !important;
    }

    /* Heading spacing */
    #shopify-section-{{ section.id }} .featured-collection__header {
      margin-bottom: 14px !important;
      gap: 10px !important;
    }

    #shopify-section-{{ section.id }} .featured-collection__header h2 {
      font-size: clamp(18px, 5vw, 22px);
      line-height: 1.25;
    }

    /* Slider stays inside the 10px section container */
    #shopify-section-{{ section.id }} .slider.product_card {
      width: 100% !important;
      max-width: 100% !important;
      margin-left: 0 !important;
      margin-right: 0 !important;
      padding-left: 0 !important;
      padding-right: 0 !important;
      box-sizing: border-box !important;
      overflow: hidden !important;
    }

    #shopify-section-{{ section.id }} .slider.product_card .flickity-viewport {
      width: 100% !important;
      max-width: 100% !important;
      overflow: hidden !important;
    }

    /* Show exactly 2 products */
    #shopify-section-{{ section.id }} .product-media-cards.featured-collection-item,
    #shopify-section-{{ section.id }} .product_card.flickity-enabled .product-media-cards.featured-collection-item,
    #shopify-section-{{ section.id }} .product_card:not(.flickity-enabled) .product-media-cards.featured-collection-item {
      width: 50% !important;
      max-width: 50% !important;
      flex: 0 0 50% !important;
      padding-left: 5px !important;
      padding-right: 5px !important;
      box-sizing: border-box !important;
      display: flex !important;
      height: auto !important;
    }

    /* Remove extra space from first and second visible cards */
    #shopify-section-{{ section.id }} .product-media-cards.featured-collection-item:first-child {
      padding-left: 0 !important;
      padding-right: 5px !important;
    }

    /* Equal card layout */
    #shopify-section-{{ section.id }} .product-card,
    #shopify-section-{{ section.id }} .product-card-inner {
      width: 100% !important;
      height: 100% !important;
      display: flex !important;
      flex-direction: column !important;
    }

    /* Equal image box */
    #shopify-section-{{ section.id }} .product-card .media-image {
      width: 100% !important;
      height: 145px !important;
      min-height: 145px !important;
      padding-top: 0 !important;
      overflow: hidden !important;
    }

    #shopify-section-{{ section.id }} .product-card .media-image img,
    #shopify-section-{{ section.id }} .product-card .media-image .placeholder-svg {
      width: 100% !important;
      height: 100% !important;
      object-fit: contain !important;
      padding: 12px !important;
      box-sizing: border-box !important;
    }

    /* Product content */
    #shopify-section-{{ section.id }} .product-header {
      width: 100% !important;
      padding-top: 8px !important;
      display: flex !important;
      flex-direction: column !important;
      flex: 1 1 auto !important;
    }

    #shopify-section-{{ section.id }} .product-swatch-slot {
      min-height: 30px !important;
      margin-bottom: 6px !important;
    }

    #shopify-section-{{ section.id }} .product-name {
      display: -webkit-box !important;
      -webkit-box-orient: vertical !important;
      -webkit-line-clamp: 3 !important;
      line-clamp: 3 !important;
      overflow: hidden !important;
      font-size: 12px !important;
      line-height: 1.3 !important;
      min-height: calc(1.3em * 3) !important;
      max-height: calc(1.3em * 3) !important;
      margin: 0 0 5px !important;
    }

    #shopify-section-{{ section.id }} .price-wrapper {
      min-height: 30px !important;
      margin-top: 0 !important;
    }

    #shopify-section-{{ section.id }} .price-wrapper,
    #shopify-section-{{ section.id }} .item-price,
    #shopify-section-{{ section.id }} .item-price-old,
    #shopify-section-{{ section.id }} .vendor {
      font-size: 11px !important;
    }

    /* Add to cart alignment */
    #shopify-section-{{ section.id }} .product-card-atc {
      width: 100% !important;
      margin-top: auto !important;
      padding-top: 8px !important;
    }

    #shopify-section-{{ section.id }} .product-card-atc__btn {
      width: 100% !important;
      max-width: none !important;
      min-height: 38px !important;
      padding: 8px 5px !important;
      font-size: 11px !important;
    }

    /* View All closer to products */
    #shopify-section-{{ section.id }} .show-all-btn-box {
      margin-top: 18px !important;
      margin-bottom: 0 !important;
      padding-top: 0 !important;
    }
  }
</style>

{% schema %}
{
  "name": "t:sections.featured_collection.name",
  "tag": "section",
  "class": "section-featured-collection",
  "disabled_on": {
    "groups": ["header", "footer", "aside"]
  },
  "settings": [
    {
      "type": "select",
      "id": "grid_image_size",
      "label": "t:common.image_size.label",
      "default": "square",
      "options": [
        {
          "value": "auto",
          "label": "t:common.image_size.options.auto.label"
        },
        {
          "value": "landscape",
          "label": "t:common.image_size.options.landscape.label"
        },
        {
          "value": "portrait",
          "label": "t:common.image_size.options.portrait.label"
        },
        {
          "value": "square",
          "label": "t:common.image_size.options.square.label"
        }
      ]
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "default": "contain",
      "options": [
        {
          "value": "contain",
          "label": "Contain"
        },
        {
          "value": "cover",
          "label": "Cover"
        }
      ]
    },
    {
      "type": "color",
      "id": "image_background_color",
      "label": "Product image background",
      "default": "#FFFFFF"
    },
    {
      "type": "checkbox",
      "id": "enable_image_border",
      "label": "Enable image border",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_add_to_cart",
      "label": "Show add to cart button",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Our products",
      "label": "t:common.global.heading.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "default": "h2",
      "label": "t:common.heading_size.desktop_label",
      "options": [
        {
          "value": "h1",
          "label": "t:common.heading_size.options.extra_large.label"
        },
        {
          "value": "h2",
          "label": "t:common.heading_size.options.large.label"
        },
        {
          "value": "h3",
          "label": "t:common.heading_size.options.medium.label"
        },
        {
          "value": "h4",
          "label": "t:common.heading_size.options.small.label"
        },
        {
          "value": "h5",
          "label": "t:common.heading_size.options.extra_small.label"
        }
      ]
    },
    {
      "type": "select",
      "id": "heading_size_mobile",
      "default": "h3_mobile",
      "label": "t:common.heading_size.mobile_label",
      "options": [
        {
          "value": "h1_mobile",
          "label": "t:common.heading_size.options.extra_large.label"
        },
        {
          "value": "h2_mobile",
          "label": "t:common.heading_size.options.large.label"
        },
        {
          "value": "h3_mobile",
          "label": "t:common.heading_size.options.medium.label"
        },
        {
          "value": "h4_mobile",
          "label": "t:common.heading_size.options.small.label"
        },
        {
          "value": "h5_mobile",
          "label": "t:common.heading_size.options.extra_small.label"
        }
      ]
    },
    {
      "type": "text_alignment",
      "id": "heading_alignment",
      "label": "t:common.global.heading_alignment.label",
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "enable_collection_title",
      "default": false,
      "label": "t:sections.featured_collection.settings.enable_collection_title.label"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:common.global.collection.label"
    },
    {
      "type": "checkbox",
      "id": "products_style",
      "default": true,
      "label": "t:sections.featured_collection.settings.products_style.label"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8,
      "label": "t:sections.featured_collection.settings.products_to_show.label"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 4,
      "label": "t:sections.featured_collection.settings.columns_desktop.label"
    },
    {
      "type": "header",
      "content": "t:common.header.button.content"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "t:common.global.text.label",
      "default": "View All"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "t:common.global.link.label",
      "info": "Leave blank to use the selected collection URL"
    },
    {
      "type": "header",
      "content": "t:common.header.colors.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "primary",
      "label": "t:common.global.color_scheme.label"
    },
    {
      "type": "header",
      "content": "t:common.header.section_spacing.content"
    },
    {
      "type": "range",
      "id": "top_space_desktop",
      "label": "t:common.section_spacing.top_space_desktop.label",
      "default": 80,
      "min": 0,
      "max": 150,
      "step": 5
    },
    {
      "type": "range",
      "id": "bottom_space_desktop",
      "label": "t:common.section_spacing.bottom_space_desktop.label",
      "default": 80,
      "min": 0,
      "max": 150,
      "step": 5
    },
    {
      "type": "range",
      "id": "top_space_mobile",
      "label": "t:common.section_spacing.top_space_mobile.label",
      "default": 40,
      "min": 0,
      "max": 100,
      "step": 5
    },
    {
      "type": "range",
      "id": "bottom_space_mobile",
      "label": "t:common.section_spacing.bottom_space_mobile.label",
      "default": 40,
      "min": 0,
      "max": 100,
      "step": 5
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured_collection.presets.name"
    }
  ]
}
{% endschema %}