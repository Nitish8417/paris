{%- liquid
  assign brand_links = blank
  assign menu = linklists[section.settings.menu]
  assign parent_handle = section.settings.parent_title | handleize

  if menu != blank
    assign brand_links = menu.links
    if parent_handle != blank
      for link in menu.links
        assign link_handle = link.title | handleize
        if link_handle == parent_handle and link.links.size > 0
          assign brand_links = link.links
          break
        endif
      endfor
    endif
  endif

  assign letters = ''
  for link in brand_links
    assign first_letter = link.title | strip | slice: 0 | upcase
    unless letters contains first_letter
      assign letters = letters | append: first_letter
    endunless
  endfor
  assign letters_array = letters | split: ''
-%}

<div class="{{ section.settings.color_scheme }}-scheme spacing-box">
  <div class="{{ settings.layout_width }}">
    <brands-directory class="bd">
      <header class="bd__hero">
        <div class="bd__hero-text">
          {%- if section.settings.eyebrow != blank -%}
            <p class="bd__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h1 class="bd__title">{{ section.settings.heading | escape }}</h1>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <div class="bd__text">{{ section.settings.text }}</div>
          {%- endif -%}
        </div>
        {%- if brand_links.size > 0 -%}
          <div class="bd__stat">
            <span class="bd__stat-value">{{ brand_links.size }}</span>
            <span class="bd__stat-label">Brands</span>
          </div>
        {%- endif -%}
      </header>

      {%- if brand_links.size > 0 -%}
        <div class="bd__toolbar">
          {%- if section.settings.show_search -%}
            <label class="bd__search">
              <span class="visually-hidden">Search brands</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
              <input type="search" placeholder="Search brands" autocomplete="off" data-bd-search>
            </label>
          {%- endif -%}

          {%- if section.settings.show_letters and letters_array.size > 1 -%}
            <div class="bd__letters" role="toolbar" aria-label="Filter by letter">
              <button type="button" class="bd__letter is-active" data-bd-letter="" aria-pressed="true">All</button>
              {%- for letter in letters_array -%}
                <button type="button" class="bd__letter" data-bd-letter="{{ letter }}" aria-pressed="false">{{ letter }}</button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>

        <ul class="bd__grid" role="list" data-bd-grid>
          {%- for link in brand_links -%}
            {%- liquid
              assign brand_collection = blank
              if link.type == 'collection_link'
                assign brand_collection = link.object
              endif
              assign brand_image = blank
              if brand_collection != blank
                assign brand_image = brand_collection.image | default: brand_collection.featured_image
              endif
              assign brand_letter = link.title | strip | slice: 0 | upcase
            -%}
            <li class="bd__item" data-bd-name="{{ link.title | downcase | escape }}" data-bd-letter="{{ brand_letter }}">
              <a href="{{ link.url }}" class="bd__card">
                <span class="bd__logo">
                  {%- if brand_image != blank -%}
                    {{
                      brand_image
                      | image_url: width: 480
                      | image_tag: loading: 'lazy', widths: '240, 360, 480', sizes: '(min-width: 1200px) 240px, 45vw', alt: link.title
                    }}
                  {%- else -%}
                    <span class="bd__logo-text">{{ link.title | escape }}</span>
                  {%- endif -%}
                </span>
                <span class="bd__meta">
                  <span class="bd__name">{{ link.title | escape }}</span>
                  {%- if section.settings.show_count and brand_collection != blank -%}
                    <span class="bd__count">
                      {{- brand_collection.all_products_count }}
                      {% if brand_collection.all_products_count == 1 %}product{% else %}products{% endif -%}
                    </span>
                  {%- endif -%}
                </span>
                <span class="bd__arrow" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9"/></svg>
                </span>
              </a>
            </li>
          {%- endfor -%}
        </ul>

        <p class="bd__empty" data-bd-empty hidden>No brands match your search.</p>
      {%- else -%}
        <p class="bd__empty">Choose a menu with your brand collections in the theme editor.</p>
      {%- endif -%}
    </brands-directory>
  </div>
</div>

<style>
  #shopify-section-{{ section.id }} {
    --topSpace: {{ section.settings.top_space_desktop }}px;
    --bottomSpace: {{ section.settings.bottom_space_desktop }}px;
  }

  #shopify-section-{{ section.id }} .bd {
    --bdLine: color-mix(in srgb, var(--bodyTextColor) 10%, transparent);
    --bdMuted: color-mix(in srgb, var(--bodyTextColor) 60%, transparent);
    --bdLogoBg: {{ section.settings.logo_bg }};
    --bdCols: {{ section.settings.columns_desktop }};
    display: block;
  }

  #shopify-section-{{ section.id }} .bd__hero {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    padding: 48px;
    border-radius: 22px;
    background:
      radial-gradient(120% 140% at 100% 0%, rgba(255, 255, 255, 0.10) 0%, transparent 55%),
      #0e0e10;
    color: #fff;
  }

  #shopify-section-{{ section.id }} .bd__eyebrow {
    margin: 0 0 10px;
    color: rgba(255, 255, 255, 0.6);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .bd__title {
    margin: 0;
    color: #fff;
    font-size: clamp(32px, 4vw, 52px);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  #shopify-section-{{ section.id }} .bd__text {
    max-width: 560px;
    margin-top: 14px;
    color: rgba(255, 255, 255, 0.7);
    font-size: 15px;
    line-height: 1.6;
  }

  #shopify-section-{{ section.id }} .bd__text p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .bd__stat {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .bd__stat-value {
    font-size: clamp(40px, 5vw, 64px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  #shopify-section-{{ section.id }} .bd__stat-label {
    margin-top: 6px;
    color: rgba(255, 255, 255, 0.6);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .bd__toolbar {
    position: sticky;
    top: 92px;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 24px 0 20px;
    padding: 12px 0;
    background: var(--bodyColor);
  }

  #shopify-section-{{ section.id }} .bd__search {
    position: relative;
    display: flex;
    align-items: center;
    flex: 0 0 300px;
    color: var(--bdMuted);
  }

  #shopify-section-{{ section.id }} .bd__search svg {
    position: absolute;
    left: 16px;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .bd__search input {
    width: 100%;
    height: 46px;
    margin: 0;
    padding: 0 18px 0 44px;
    border: 1px solid var(--bdLine);
    border-radius: 999px;
    background: #fff;
    color: var(--bodyTextColor);
    font-size: 14px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  #shopify-section-{{ section.id }} .bd__search input:focus {
    outline: none;
    border-color: var(--bodyTextColor);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--bodyTextColor) 10%, transparent);
  }

  #shopify-section-{{ section.id }} .bd__letters {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  #shopify-section-{{ section.id }} .bd__letter {
    min-width: 38px;
    height: 38px;
    padding: 0 12px;
    border: 1px solid var(--bdLine);
    border-radius: 999px;
    background: #fff;
    color: var(--bodyTextColor);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  #shopify-section-{{ section.id }} .bd__letter:hover {
    border-color: var(--bodyTextColor);
  }

  #shopify-section-{{ section.id }} .bd__letter.is-active {
    border-color: var(--bodyTextColor);
    background: var(--bodyTextColor);
    color: #fff;
  }

  #shopify-section-{{ section.id }} .bd__grid {
    display: grid;
    grid-template-columns: repeat(var(--bdCols), minmax(0, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #shopify-section-{{ section.id }} .bd__item {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #shopify-section-{{ section.id }} .bd__item::before {
    content: none;
  }

  #shopify-section-{{ section.id }} .bd__item[hidden] {
    display: none;
  }

  #shopify-section-{{ section.id }} .bd__card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--bdLine);
    border-radius: 16px;
    background: #fff;
    color: var(--bodyTextColor);
    text-decoration: none;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }

  #shopify-section-{{ section.id }} .bd__card:hover {
    border-color: color-mix(in srgb, var(--bodyTextColor) 24%, transparent);
    box-shadow: 0 16px 36px rgba(17, 17, 17, 0.1);
    transform: translateY(-4px);
  }

  #shopify-section-{{ section.id }} .bd__logo {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16 / 10;
    margin: 8px 8px 0;
    border-radius: 11px;
    background: var(--bdLogoBg);
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .bd__logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.4s ease;
  }

  #shopify-section-{{ section.id }} .bd__card:hover .bd__logo img {
    transform: scale(1.06);
  }

  #shopify-section-{{ section.id }} .bd__logo-text {
    padding: 0 12px;
    color: #fff;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.01em;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .bd__meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 14px 52px 16px 16px;
  }

  #shopify-section-{{ section.id }} .bd__name {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.3;
  }

  #shopify-section-{{ section.id }} .bd__count {
    color: var(--bdMuted);
    font-size: 13px;
  }

  #shopify-section-{{ section.id }} .bd__arrow {
    position: absolute;
    right: 14px;
    bottom: 16px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border: 1px solid var(--bdLine);
    border-radius: 50%;
    transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease;
  }

  #shopify-section-{{ section.id }} .bd__card:hover .bd__arrow {
    border-color: var(--bodyTextColor);
    background: var(--bodyTextColor);
    color: #fff;
  }

  #shopify-section-{{ section.id }} .bd__empty {
    margin: 32px 0 0;
    padding: 40px 20px;
    border: 1px dashed var(--bdLine);
    border-radius: 16px;
    color: var(--bdMuted);
    text-align: center;
  }

  @media only screen and (max-width: 1199px) {
    #shopify-section-{{ section.id }} .bd__toolbar {
      top: 72px;
      flex-direction: column;
      align-items: stretch;
    }

    #shopify-section-{{ section.id }} .bd__search {
      flex-basis: auto;
    }

    #shopify-section-{{ section.id }} .bd__letters {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
    }

    #shopify-section-{{ section.id }} .bd__letters::-webkit-scrollbar {
      display: none;
    }

    #shopify-section-{{ section.id }} .bd__letter {
      flex-shrink: 0;
    }

    #shopify-section-{{ section.id }} .bd__grid {
      grid-template-columns: repeat(min(var(--bdCols), 4), minmax(0, 1fr));
    }
  }

  @media only screen and (max-width: 767px) {
    #shopify-section-{{ section.id }}.shopify-section {
      --topSpace: {{ section.settings.top_space_mobile }}px;
      --bottomSpace: {{ section.settings.bottom_space_mobile }}px;
    }

    #shopify-section-{{ section.id }} .bd__hero {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
      padding: 28px 22px;
      border-radius: 18px;
    }

    #shopify-section-{{ section.id }} .bd__stat {
      flex-direction: row;
      align-items: baseline;
      gap: 8px;
    }

    #shopify-section-{{ section.id }} .bd__stat-value {
      font-size: 32px;
    }

    #shopify-section-{{ section.id }} .bd__toolbar {
      margin: 16px 0 12px;
      gap: 12px;
    }

    #shopify-section-{{ section.id }} .bd__grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, minmax(0, 1fr));
      gap: 10px;
    }

    #shopify-section-{{ section.id }} .bd__card {
      border-radius: 14px;
    }

    #shopify-section-{{ section.id }} .bd__logo {
      margin: 6px 6px 0;
      border-radius: 10px;
    }

    #shopify-section-{{ section.id }} .bd__meta {
      padding: 10px 12px 12px;
    }

    #shopify-section-{{ section.id }} .bd__name {
      font-size: 14px;
    }

    #shopify-section-{{ section.id }} .bd__count {
      font-size: 12px;
    }

    #shopify-section-{{ section.id }} .bd__arrow {
      display: none;
    }
  }
</style>

<script>
  if (!customElements.get('brands-directory')) {
    customElements.define(
      'brands-directory',
      class BrandsDirectory extends HTMLElement {
        connectedCallback() {
          this.items = Array.from(this.querySelectorAll('.bd__item'));
          this.search = this.querySelector('[data-bd-search]');
          this.letterButtons = Array.from(this.querySelectorAll('button[data-bd-letter]'));
          this.empty = this.querySelector('[data-bd-empty]');
          this.letter = '';

          if (this.search) this.search.addEventListener('input', () => this.apply());
          this.letterButtons.forEach((button) => {
            button.addEventListener('click', () => {
              this.letter = button.dataset.bdLetter;
              this.letterButtons.forEach((b) => {
                const active = b === button;
                b.classList.toggle('is-active', active);
                b.setAttribute('aria-pressed', active ? 'true' : 'false');
              });
              this.apply();
            });
          });
        }

        apply() {
          const query = this.search ? this.search.value.trim().toLowerCase() : '';
          let visible = 0;
          this.items.forEach((item) => {
            const matchesLetter = !this.letter || item.dataset.bdLetter === this.letter;
            const matchesQuery = !query || item.dataset.bdName.includes(query);
            const show = matchesLetter && matchesQuery;
            item.hidden = !show;
            if (show) visible++;
          });
          if (this.empty) this.empty.hidden = visible > 0;
        }
      }
    );
  }
</script>

{% schema %}
{
  "name": "Brands directory",
  "tag": "section",
  "class": "section-brands-directory",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Brands menu",
      "info": "Each link should point to a brand collection. The collection image is used as the logo."
    },
    {
      "type": "text",
      "id": "parent_title",
      "label": "Use links under this menu item",
      "default": "Brands",
      "info": "Leave empty to use the top-level links of the menu."
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Official brands"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by brand"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Explore the trusted tech brands we carry, from everyday essentials to the latest gadgets.</p>"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_letters",
      "label": "Show A–Z filter",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Show product count",
      "default": true
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 3,
      "max": 7,
      "step": 1,
      "default": 6
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "default": "2",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" }
      ]
    },
    {
      "type": "color",
      "id": "logo_bg",
      "label": "Logo background",
      "default": "#0e0e10"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:common.global.color_scheme.label",
      "default": "primary"
    },
    {
      "type": "header",
      "content": "t:common.header.section_spacing.content"
    },
    {
      "type": "range",
      "id": "top_space_desktop",
      "label": "t:common.section_spacing.top_space_desktop.label",
      "default": 40,
      "min": 0,
      "max": 150,
      "step": 5
    },
    {
      "type": "range",
      "id": "bottom_space_desktop",
      "label": "t:common.section_spacing.bottom_space_desktop.label",
      "default": 80,
      "min": 0,
      "max": 150,
      "step": 5
    },
    {
      "type": "range",
      "id": "top_space_mobile",
      "label": "t:common.section_spacing.top_space_mobile.label",
      "default": 20,
      "min": 0,
      "max": 100,
      "step": 5
    },
    {
      "type": "range",
      "id": "bottom_space_mobile",
      "label": "t:common.section_spacing.bottom_space_mobile.label",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 5
    }
  ],
  "presets": [
    {
      "name": "Brands directory"
    }
  ]
}
{% endschema %}
