{% comment %}
  Multi-video banner (YouTube / Vimeo)
  - Up to 4 videos, each added as its own block
  - Display as a slider (one at a time) or a grid (side by side)
  - Videos autoplay muted, loop, and have no player UI
{% endcomment %}

{%- liquid
  assign sid = section.id
  assign count = section.blocks.size
  assign mode = section.settings.display_mode
  if count < 2
    assign mode = 'grid'
  endif

  case section.settings.height_desktop
    when 'adapt'
      assign h_d = 'auto'
      assign ar_d = '16 / 9'
    when 'small'
      assign h_d = '420px'
      assign ar_d = 'auto'
    when 'medium'
      assign h_d = '600px'
      assign ar_d = 'auto'
    when 'large'
      assign h_d = '760px'
      assign ar_d = 'auto'
    when 'full'
      assign h_d = '100svh'
      assign ar_d = 'auto'
  endcase

  case section.settings.height_mobile
    when 'adapt'
      assign h_m = 'auto'
      assign ar_m = '16 / 9'
    when 'portrait'
      assign h_m = 'auto'
      assign ar_m = '4 / 5'
    when 'small'
      assign h_m = '320px'
      assign ar_m = 'auto'
    when 'medium'
      assign h_m = '480px'
      assign ar_m = 'auto'
    when 'large'
      assign h_m = '640px'
      assign ar_m = 'auto'
    when 'full'
      assign h_m = '100svh'
      assign ar_m = 'auto'
  endcase

  case section.settings.inner_width
    when 'container'
      assign max_w = 'var(--page-width, 1200px)'
    when 'custom'
      assign max_w = section.settings.custom_max_width | append: 'px'
    else
      assign max_w = 'none'
  endcase
-%}

<style>
  #mvb-{{ sid }} {
    --mvb-pt: {{ section.settings.padding_top }}px;
    --mvb-pb: {{ section.settings.padding_bottom }}px;
    --mvb-side: {{ section.settings.side_padding_desktop }}px;
    --mvb-max: {{ max_w }};
    --mvb-gap: {{ section.settings.column_spacing }}px;
    --mvb-cols: {{ count | at_least: 1 }};
    --mvb-h: {{ h_d }};
    --mvb-ar: {{ ar_d }};
    --mvb-zoom: {{ section.settings.video_zoom | divided_by: 100.0 }};
    --mvb-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --mvb-radius: {{ section.settings.corner_radius }}px;
    padding-top: var(--mvb-pt);
    padding-bottom: var(--mvb-pb);
  }
  @media screen and (max-width: 749px) {
    #mvb-{{ sid }} {
      --mvb-pt: {{ section.settings.padding_top_mobile }}px;
      --mvb-pb: {{ section.settings.padding_bottom_mobile }}px;
      --mvb-side: {{ section.settings.side_padding_mobile }}px;
      --mvb-cols: {{ section.settings.mobile_columns }};
      --mvb-h: {{ h_m }};
      --mvb-ar: {{ ar_m }};
    }
  }

  #mvb-{{ sid }} .mvb__inner {
    max-width: var(--mvb-max);
    margin: 0 auto;
    padding-inline: var(--mvb-side);
  }

  /* Sizing: the stage in slider mode, each tile in grid mode */
  #mvb-{{ sid }}.mvb--slider .mvb__stage,
  #mvb-{{ sid }}.mvb--grid .mvb__slide {
    height: var(--mvb-h);
    aspect-ratio: var(--mvb-ar);
    width: 100%;
  }

  #mvb-{{ sid }} .mvb__stage {
    position: relative;
    overflow: hidden;
    border-radius: var(--mvb-radius);
  }
  #mvb-{{ sid }}.mvb--grid .mvb__stage {
    display: grid;
    grid-template-columns: repeat(var(--mvb-cols), minmax(0, 1fr));
    gap: var(--mvb-gap);
    overflow: visible;
    border-radius: 0;
  }

  #mvb-{{ sid }} .mvb__slide {
    position: relative;
    overflow: hidden;
    container-type: size;
    background: #000;
    border-radius: var(--mvb-radius);
  }
  #mvb-{{ sid }}.mvb--slider .mvb__slide {
    position: absolute;
    inset: 0;
    border-radius: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.7s ease, visibility 0.7s ease;
  }
  #mvb-{{ sid }}.mvb--slider .mvb__slide.is-active {
    opacity: 1;
    visibility: visible;
    z-index: 1;
  }

  #mvb-{{ sid }} .mvb__cover,
  #mvb-{{ sid }} .mvb__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  #mvb-{{ sid }} .mvb__placeholder { background: #1a1a1a; fill: rgba(255,255,255,0.15); }

  /* Cover-fit the iframe: always fills the tile, crops the overflow */
  #mvb-{{ sid }} .mvb__iframe {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100%;
    height: 100%;
    width: max(100cqw, 177.78cqh);
    height: max(100cqh, 56.25cqw);
    transform: translate(-50%, -50%) scale(var(--mvb-zoom));
    border: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.8s ease;
  }
  #mvb-{{ sid }} .mvb__iframe.is-loaded { opacity: 1; }

  #mvb-{{ sid }} .mvb__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: rgba(0, 0, 0, var(--mvb-overlay));
    pointer-events: none;
  }

  #mvb-{{ sid }} .mvb__link-cover {
    position: absolute;
    inset: 0;
    z-index: 3;
  }

  #mvb-{{ sid }} .mvb__content {
    position: absolute;
    inset: 0;
    z-index: 4;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: clamp(1.25rem, 4vw, 3.5rem);
    pointer-events: none;
  }
  #mvb-{{ sid }} .mvb__content > * { pointer-events: auto; max-width: 42rem; margin: 0; }
  #mvb-{{ sid }} .mvb__content--h-left   { align-items: flex-start; text-align: left; }
  #mvb-{{ sid }} .mvb__content--h-center { align-items: center;     text-align: center; }
  #mvb-{{ sid }} .mvb__content--h-right  { align-items: flex-end;   text-align: right; }
  #mvb-{{ sid }} .mvb__content--v-top    { justify-content: flex-start; }
  #mvb-{{ sid }} .mvb__content--v-middle { justify-content: center; }
  #mvb-{{ sid }} .mvb__content--v-bottom { justify-content: flex-end; }
  #mvb-{{ sid }}.mvb--slider .mvb__content--v-bottom { padding-bottom: clamp(3rem, 6vw, 4.5rem); }

  #mvb-{{ sid }} .mvb__heading {
    font-size: clamp(1.75rem, 4vw, 3.5rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
  }
  #mvb-{{ sid }}.mvb--grid .mvb__heading { font-size: clamp(1.25rem, 2.2vw, 2rem); }
  #mvb-{{ sid }} .mvb__text { font-size: clamp(0.95rem, 1.3vw, 1.125rem); line-height: 1.5; opacity: 0.9; }

  #mvb-{{ sid }} .mvb__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.7rem 1.6rem;
    border-radius: 999px;
    background: #fff;
    color: #000;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.2s ease, background 0.2s ease;
  }
  #mvb-{{ sid }} .mvb__btn:hover { transform: translateY(-1px); background: #f0f0f0; }
  #mvb-{{ sid }} .mvb__btn:focus-visible,
  #mvb-{{ sid }} .mvb__arrow:focus-visible,
  #mvb-{{ sid }} .mvb__dot:focus-visible,
  #mvb-{{ sid }} .mvb__link-cover:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }

  /* Slider controls */
  #mvb-{{ sid }} .mvb__arrow {
    width: {{ section.settings.arrow_size }}px;
    height: {{ section.settings.arrow_size }}px;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.35);
    color: #fff;
    cursor: pointer;
    backdrop-filter: blur(6px);
    transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }
  #mvb-{{ sid }} .mvb__arrow:hover { background: rgba(0, 0, 0, 0.6); }
  #mvb-{{ sid }} .mvb__arrow:active { transform: scale(0.94); }
  #mvb-{{ sid }} .mvb__arrow svg { width: 40%; height: 40%; }

  /* Position: middle of the left and right edges */
  #mvb-{{ sid }} .mvb__nav--sides .mvb__arrow {
    position: absolute;
    top: 50%;
    z-index: 5;
    translate: 0 -50%;
  }
  #mvb-{{ sid }} .mvb__nav--sides .mvb__arrow--prev { left: 16px; }
  #mvb-{{ sid }} .mvb__nav--sides .mvb__arrow--next { right: 16px; }

  /* Position: bottom-right corner, on the video */
  #mvb-{{ sid }} .mvb__nav--corner {
    position: absolute;
    right: clamp(12px, 2.5vw, 28px);
    bottom: clamp(12px, 2.5vw, 28px);
    z-index: 5;
    display: flex;
    gap: 10px;
  }

  /* Position: centered below the banner (outlined circles) */
  #mvb-{{ sid }} .mvb__nav--below {
    display: flex;
    justify-content: center;
    gap: 14px;
    padding-top: 18px;
  }
  #mvb-{{ sid }} .mvb__nav--below .mvb__arrow {
    background: transparent;
    color: inherit;
    border: 1.5px solid currentColor;
    backdrop-filter: none;
  }
  #mvb-{{ sid }} .mvb__nav--below .mvb__arrow:hover {
    background: currentColor;
  }
  #mvb-{{ sid }} .mvb__nav--below .mvb__arrow:hover svg {
    filter: invert(1);
  }


  #mvb-{{ sid }} .mvb__dots {
    position: absolute;
    left: 50%;
    bottom: 18px;
    z-index: 5;
    display: flex;
    gap: 6px;
    transform: translateX(-50%);
  }
  #mvb-{{ sid }} .mvb__dot {
    width: 28px;
    height: 44px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    display: grid;
    place-items: center;
  }
  #mvb-{{ sid }} .mvb__dot::before {
    content: "";
    width: 100%;
    height: 3px;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.45);
    transition: background 0.3s ease;
  }
  #mvb-{{ sid }} .mvb__dot[aria-current="true"]::before { background: #fff; }

  @media screen and (max-width: 749px) {
    {%- unless section.settings.arrows_mobile -%}
    #mvb-{{ sid }} .mvb__nav { display: none; }
    {%- endunless -%}
    #mvb-{{ sid }} .mvb__nav--sides .mvb__arrow--prev { left: 8px; }
    #mvb-{{ sid }} .mvb__nav--sides .mvb__arrow--next { right: 8px; }
  }
  @media (prefers-reduced-motion: reduce) {
    #mvb-{{ sid }} .mvb__slide,
    #mvb-{{ sid }} .mvb__iframe { transition: none; }
  }
</style>

<multi-video-banner
  id="mvb-{{ sid }}"
  class="mvb mvb--{{ mode }} color-{{ section.settings.color_scheme }} gradient"
  data-autoplay="{{ section.settings.autoplay_speed }}"
  {% if mode == 'slider' %}aria-roledescription="carousel" aria-label="Video banner"{% endif %}
>
  <div class="mvb__inner">
    <div class="mvb__stage">
      {%- for block in section.blocks -%}
        {%- liquid
          assign v = block.settings.video
          assign embed = blank
          if v != blank
            if v.type == 'youtube'
              assign embed = 'https://www.youtube.com/embed/' | append: v.id | append: '?autoplay=1&mute=1&loop=1&playlist=' | append: v.id | append: '&controls=0&playsinline=1&rel=0&modestbranding=1&iv_load_policy=3&disablekb=1&fs=0&enablejsapi=1&origin=' | append: request.origin
            elsif v.type == 'vimeo'
              assign embed = 'https://player.vimeo.com/video/' | append: v.id | append: '?background=1&autoplay=1&loop=1&muted=1&dnt=1'
            endif
          endif

          assign is_first = forloop.first
          assign defer_load = false
          if mode == 'slider' and is_first == false
            assign defer_load = true
          endif

          assign whole_link = false
          if block.settings.button_link != blank and block.settings.button_label == blank
            assign whole_link = true
          endif
        -%}

        <div
          class="mvb__slide{% if mode == 'slider' and is_first %} is-active{% endif %}"
          data-index="{{ forloop.index0 }}"
          {% if mode == 'slider' %}
            role="group"
            aria-roledescription="slide"
            aria-label="{{ forloop.index }} of {{ count }}"
            {% unless is_first %}aria-hidden="true" inert{% endunless %}
          {% endif %}
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.cover_image != blank -%}
            {%- if is_first -%}
              {{ block.settings.cover_image | image_url: width: 2400 | image_tag: class: 'mvb__cover', widths: '750, 1100, 1500, 1920, 2400', sizes: '100vw', fetchpriority: 'high', alt: block.settings.cover_image.alt }}
            {%- else -%}
              {{ block.settings.cover_image | image_url: width: 2400 | image_tag: class: 'mvb__cover', widths: '750, 1100, 1500, 1920, 2400', sizes: '100vw', loading: 'lazy', alt: block.settings.cover_image.alt }}
            {%- endif -%}
          {%- elsif embed == blank -%}
            {{ 'hero-apparel-1' | placeholder_svg_tag: 'mvb__placeholder' }}
          {%- endif -%}

          {%- if embed != blank -%}
            <iframe
              class="mvb__iframe"
              {% if defer_load %}data-src{% else %}src{% endif %}="{{ embed }}"
              title="{{ block.settings.heading | default: 'Background video' | escape }}"
              allow="autoplay; encrypted-media; picture-in-picture"
              tabindex="-1"
              aria-hidden="true"
              onload="if(this.getAttribute('src'))this.classList.add('is-loaded')"
            ></iframe>
          {%- endif -%}

          <div class="mvb__overlay"></div>

          {%- if whole_link -%}
            <a class="mvb__link-cover" href="{{ block.settings.button_link }}" aria-label="{{ block.settings.heading | default: 'View' | escape }}"></a>
          {%- endif -%}

          {%- if block.settings.heading != blank or block.settings.text != blank or block.settings.button_label != blank -%}
            <div
              class="mvb__content mvb__content--h-{{ block.settings.content_h }} mvb__content--v-{{ block.settings.content_v }}"
              style="color: {{ block.settings.text_color }};"
            >
              {%- if block.settings.heading != blank -%}
                <h2 class="mvb__heading">{{ block.settings.heading | escape }}</h2>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="mvb__text">{{ block.settings.text | escape | newline_to_br }}</p>
              {%- endif -%}
              {%- if block.settings.button_label != blank -%}
                <a class="mvb__btn" href="{{ block.settings.button_link | default: '#' }}">{{ block.settings.button_label | escape }}</a>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}

      {%- liquid
        assign has_nav = false
        if mode == 'slider' and count > 1 and section.settings.show_arrows
          assign has_nav = true
        endif
        assign arrow_pos = section.settings.arrow_position
      -%}
      {%- capture arrow_buttons -%}
        <button type="button" class="mvb__arrow mvb__arrow--prev" data-prev aria-label="Previous video">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <button type="button" class="mvb__arrow mvb__arrow--next" data-next aria-label="Next video">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
        </button>
      {%- endcapture -%}

      {%- if has_nav and arrow_pos != 'below' -%}
        <div class="mvb__nav mvb__nav--{{ arrow_pos }}">{{ arrow_buttons }}</div>
      {%- endif -%}

      {%- if mode == 'slider' and count > 1 -%}
        {%- if section.settings.show_dots -%}
          <div class="mvb__dots">
            {%- for block in section.blocks -%}
              <button type="button" class="mvb__dot" aria-label="Go to video {{ forloop.index }}" {% if forloop.first %}aria-current="true"{% else %}aria-current="false"{% endif %}></button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>

    {%- if has_nav and arrow_pos == 'below' -%}
      <div class="mvb__nav mvb__nav--below">{{ arrow_buttons }}</div>
    {%- endif -%}
  </div>
</multi-video-banner>

<script>
  if (!customElements.get('multi-video-banner')) {
    class MultiVideoBanner extends HTMLElement {
      connectedCallback() {
        if (!this.classList.contains('mvb--slider')) return;
        this.slides = Array.from(this.querySelectorAll('.mvb__slide'));
        if (this.slides.length < 2) return;

        this.dots = Array.from(this.querySelectorAll('.mvb__dot'));
        this.index = 0;
        this.delay = parseInt(this.dataset.autoplay || '0', 10) * 1000;
        this.reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        this.querySelector('[data-prev]')?.addEventListener('click', () => this.go(this.index - 1, true));
        this.querySelector('[data-next]')?.addEventListener('click', () => this.go(this.index + 1, true));
        this.dots.forEach((dot, i) => dot.addEventListener('click', () => this.go(i, true)));

        let startX = null;
        this.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; }, { passive: true });
        this.addEventListener('touchend', (e) => {
          if (startX === null) return;
          const dx = e.changedTouches[0].clientX - startX;
          if (Math.abs(dx) > 40) this.go(this.index + (dx < 0 ? 1 : -1), true);
          startX = null;
        });

        this.addEventListener('mouseenter', () => this.stop());
        this.addEventListener('mouseleave', () => this.start());
        this.addEventListener('focusin', () => this.stop());

        /* Theme editor: jump to the block being edited */
        this.addEventListener('shopify:block:select', (e) => {
          const i = this.slides.indexOf(e.target.closest('.mvb__slide'));
          if (i > -1) { this.go(i); this.stop(); this.editing = true; }
        });
        this.addEventListener('shopify:block:deselect', () => { this.editing = false; this.start(); });

        this.start();
      }

      disconnectedCallback() { this.stop(); }

      start() {
        this.stop();
        if (!this.delay || this.reduced || this.editing) return;
        this.timer = setInterval(() => this.go(this.index + 1), this.delay);
      }

      stop() { clearInterval(this.timer); }

      go(target, byUser) {
        const n = this.slides.length;
        const next = (target + n) % n;
        if (next === this.index) return;

        const current = this.slides[this.index];
        this.send(current, 'pause');
        current.classList.remove('is-active');
        current.setAttribute('aria-hidden', 'true');
        current.inert = true;

        const incoming = this.slides[next];
        incoming.classList.add('is-active');
        incoming.removeAttribute('aria-hidden');
        incoming.inert = false;

        const lazy = incoming.querySelector('iframe[data-src]');
        if (lazy) {
          lazy.src = lazy.dataset.src;
          lazy.removeAttribute('data-src');
        } else {
          this.send(incoming, 'play');
        }

        this.dots.forEach((d, i) => d.setAttribute('aria-current', i === next ? 'true' : 'false'));
        this.index = next;
        if (byUser) this.start();
      }

      send(slide, action) {
        const frame = slide.querySelector('iframe');
        if (!frame || !frame.getAttribute('src') || !frame.contentWindow) return;
        const isYT = frame.src.includes('youtube');
        const msg = isYT
          ? { event: 'command', func: action === 'play' ? 'playVideo' : 'pauseVideo', args: [] }
          : { method: action };
        frame.contentWindow.postMessage(JSON.stringify(msg), '*');
      }
    }
    customElements.define('multi-video-banner', MultiVideoBanner);
  }
</script>

{% schema %}
{
  "name": "YouTube video banner",
  "tag": "section",
  "class": "section-multi-video-banner",
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "display_mode",
      "label": "Display style",
      "options": [
        { "value": "slider", "label": "Slider (one video at a time)" },
        { "value": "grid", "label": "Grid (side by side)" }
      ],
      "default": "slider"
    },
    {
      "type": "select",
      "id": "inner_width",
      "label": "Inner width",
      "options": [
        { "value": "container", "label": "Theme container" },
        { "value": "custom", "label": "Custom width" },
        { "value": "full", "label": "Full width" }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "custom_max_width",
      "label": "Custom max width",
      "min": 600,
      "max": 2000,
      "step": 20,
      "unit": "px",
      "default": 1400,
      "info": "Used when Inner width is set to Custom width"
    },
    {
      "type": "range",
      "id": "side_padding_desktop",
      "label": "Side padding (desktop)",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "side_padding_mobile",
      "label": "Side padding (mobile)",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Size"
    },
    {
      "type": "select",
      "id": "height_desktop",
      "label": "Image height (desktop)",
      "options": [
        { "value": "adapt", "label": "Adapt to video (16:9)" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "full", "label": "Full screen" }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "height_mobile",
      "label": "Image height (mobile)",
      "options": [
        { "value": "adapt", "label": "Adapt to video (16:9)" },
        { "value": "portrait", "label": "Portrait (4:5)" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "full", "label": "Full screen" }
      ],
      "default": "portrait"
    },
    {
      "type": "range",
      "id": "column_spacing",
      "label": "Column spacing",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 16,
      "info": "Space between videos in Grid style"
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Grid columns (mobile)",
      "options": [
