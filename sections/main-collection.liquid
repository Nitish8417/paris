{{ 'nouislider.min.css' | asset_url | stylesheet_tag }}
<script src="{{ 'nouislider.min.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'filter.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'infinite-scroll.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'stock-ordered-grid.js' | asset_url }}" defer="defer"></script>
<div class="{{ section.settings.color_scheme }}-scheme spacing-box">
  {% render 'filter-and-sort', results: collection, section: section %}
  {% paginate collection.products by section.settings.products_per_page %}
    {%- liquid
      # Sold-out products go after every in-stock product across all pages. This works by
      # streaming the availability filter's "in stock" results first, then "out of stock".
      assign stock_order = false
      assign stock_scope = 'all'
      for filter in collection.filters
        if filter.param_name != 'filter.v.availability'
          continue
        endif
        if filter.active_values.size > 0
          assign stock_scope = filter.active_values | map: 'value' | join: '-'
        elsif paginate.current_page == 1
          for value in filter.values
            if value.value == '1'
              assign in_stock_count = value.count
              assign in_stock_url = value.url_to_add
            elsif value.value == '0'
              assign out_of_stock_count = value.count
              assign out_of_stock_url = value.url_to_add
            endif
          endfor
          if in_stock_count > 0 and out_of_stock_count > 0
            assign stock_order = true
          endif
        endif
      endfor
      assign stock_scope = stock_scope | append: '-' | append: paginate.current_page

      assign page_sold_out = 0
      if stock_order
        for product in collection.products
          unless product.available
            assign page_sold_out = page_sold_out | plus: 1
          endunless
        endfor
      endif
    -%}
    <div class="{{ settings.layout_width }}">
      <div class="collection-grid">
        {% if section.settings.enable_filtering and collection.filters.size > 0 %}
          {% render 'filters', results: collection, section: section %}
        {% endif %}

        {% capture activeFilterValue %}
            {%- for filter in collection.filters -%}
                {%- for value in filter.active_values -%}
                  <filter-remove class="facet-tag">
                    {{ value.label | escape }}
                    <a class="filter-remove" href="{{ value.url_to_remove }}">
                     <svg class="close-icon" xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 23.691 22.723">
                        <g transform="translate(-126.154 -143.139)">
                          <line x2="23" y2="22" transform="translate(126.5 143.5)" fill="none" stroke="CurrentColor" stroke-width="2"></line>
                          <path d="M0,22,23,0" transform="translate(126.5 143.5)" fill="none" stroke="CurrentColor" stroke-width="2"></path>
                        </g>
                      </svg>
                    </a>
                  </filter-remove>
                {% endfor %}
                  {% if filter.type == 'price_range' %}
                    {%- if filter.min_value.value != null or filter.max_value.value != null -%}
                      <filter-remove class="facet-tag">
                        {%- if filter.min_value.value -%}
                          {{ filter.min_value.value | money }}
                        {%- else -%}
                          {{ 0 | money }}
                        {%- endif -%}
                        -
                        {%- if filter.max_value.value -%}
                          {{ filter.max_value.value | money }}
                        {%- else -%}
                          {{ filter.range_max | money }}
                        {%- endif -%}
                        <a class="filter-remove" href="{{ filter.url_to_remove }}">
                          <svg class="close-icon" xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 23.691 22.723">
                            <g transform="translate(-126.154 -143.139)">
                              <line x2="23" y2="22" transform="translate(126.5 143.5)" fill="none" stroke="CurrentColor" stroke-width="2"></line>
                              <path d="M0,22,23,0" transform="translate(126.5 143.5)" fill="none" stroke="CurrentColor" stroke-width="2"></path>
                            </g>
                          </svg>
                        </a>
                      </filter-remove>
                      {% endif %}
                  {% endif %}
              {% endfor %}
          {% endcapture %}
        <div id="ProductGridContainer" class="product-list-wrapper column-spacing">
          <div class="facets-apply-list active-filter-desktop">
            {% if section.settings.enable_filtering and collection.filters.size > 0 and activeFilterValue != blank %}
              <span class="select-facet-title textBase">{{ 'sections.collection_template.selected_filter' | t }}</span>
              {{ activeFilterValue }}
              <a href="{{ collection.url }}" class="btn btn-xsmall fill-btn"
                ><span>{{ 'sections.collection_template.clear_all' | t }}</span></a
              >
            {% endif %}
          </div>
          {%- if stock_order -%}
            <stock-ordered-grid
              data-section-id="{{ section.id }}"
              data-per-page="{{ section.settings.products_per_page }}"
              data-in-stock-url="{{ in_stock_url | escape }}"
              data-in-stock-count="{{ in_stock_count }}"
              data-out-of-stock-url="{{ out_of_stock_url | escape }}"
              data-out-of-stock-count="{{ out_of_stock_count }}"
              data-initial-complete="{% if page_sold_out == 0 %}true{% else %}false{% endif %}"
              data-mode="{% if section.settings.pagination_type == 'infinite' %}infinite{% else %}button{% endif %}"
              data-status-template="{{ 'products.facets.product_count' | t: product_count: '[shown]', count: collection.products_count | escape }}"
            >
          {%- endif -%}
          <div
            class="collection-result{% if stock_order and page_sold_out > 0 %} is-stock-pending{% endif %}"
            id="result-product-grid"
            data-id="{{ section.id }}"
          >
            <div class="loading-overlay gradient"></div>
            {% if collection.products_count > 0 %}
              <div class="grid-row">
                {%- assign card_index = 0 -%}
                {%- for pass in (1..2) -%}
                {%- for product in collection.products limit: section.settings.products_per_page -%}
                  {%- capture is_sold_out -%}{%- render 'card-sold-out', product: product -%}{%- endcapture -%}
                  {%- if pass == 1 and is_sold_out == 'true' -%}{%- continue -%}{%- endif -%}
                  {%- if pass == 2 and is_sold_out != 'true' -%}{%- continue -%}{%- endif -%}
                  {% assign show_product = true %}
                  {% assign selected_variant = null %}

                  {% if request.params.color %}
                    {% assign selected_color = request.params.color %}

                    {% assign show_product = false %}
                    {%- for variant in product.variants -%}
                      {% assign variant_color = variant.options[0] | downcase %}
                      {% if variant_color == selected_color %}
                        {% assign show_product = true %}
                        {% assign selected_variant = variant %}
                        {% break %}
                      {% endif %}
                    {%- endfor -%}
                  {% endif %}

                  {% if show_product %}
                    {%- assign card_index = card_index | plus: 1 -%}
                    {% assign aosDelayAttr = card_index | times: 50 %}
                    {%- capture current -%}{% cycle section.id: 1, 2, 3, 4 %}{%- endcapture -%}
                    {%- assign placeholder_image = 'product-apparel-' | append: current -%}
                    {% assign productFormId = 'product-form-'
                      | append: section.id
                      | append: '-'
                      | append: stock_scope
                      | append: '-'
                      | append: card_index
                      | append: '-'
                      | append: collection.handle
                    %}
                    <div class="grid-item-sm-6 grid-item-md-3">
                      {% render 'product-grid',
                        cardProduct: product,
                        selectedVariant: selected_variant,
                        aosDelayAttr: aosDelayAttr,
                        section: section,
                        productFormId: productFormId,
                        placeholder_image: placeholder_image,
                        imageRatio: section.settings.grid_image_size
                      %}
                    </div>
                  {% endif %}
                {% endfor %}
                {%- endfor -%}
              </div>
            {% else %}
              <div class="empty-wrapper">
                <h2 class="empty-text">{{ 'sections.collection_template.empty' | t }}</h2>
              </div>
            {% endif %}
          </div>
          {% if stock_order %}
            <div class="pagination-container stock-order-pager" data-stock-order-pager>
              <p class="stock-order-status textSmall" data-stock-order-status aria-live="polite">
                {%- assign first_page_count = paginate.page_size | at_most: collection.products_count -%}
                {{- 'products.facets.product_count' | t: product_count: first_page_count, count: collection.products_count -}}
              </p>
              <a href="{{ paginate.next.url }}" class="btn stock-order-more" data-stock-order-more>
                <span>{{ 'sections.collection_template.load_more' | t }}</span>
              </a>
            </div>
            </stock-ordered-grid>
          {% elsif section.settings.pagination_type == 'infinite' %}
            {% if paginate.next %}
              <div class="pagination-container align-center">
                <infinite-scroll
                  class="infinite-scroll button"
                  data-url="{{ paginate.next.url }}"
                  data-trigger="infinite"
                  mode="on-load"
                >
                  <svg
                    width="40"
                    height="40"
                    style="shape-rendering: auto; animation-play-state: running; animation-delay: 0s; background: none;"
                    viewBox="0 0 100 100"
                    preserveAspectRatio="xMidYMid"
                  >
                    <circle cx="50" cy="50" fill="none" stroke="#d9e2ed" stroke-width="6" r="35"
                            stroke-dasharray="164.93361431346415 56.97787143782138"
                            style="animation-play-state: running; animation-delay: 0s;"
                            transform="rotate(115.597 50 50)">
                      <animateTransform attributeName="transform" type="rotate" calcMode="linear"
                                        values="0 50 50;360 50 50" keyTimes="0;1" dur="1s" begin="0s"
                                        repeatCount="indefinite">
                      </animateTransform>
                    </circle>
                  </svg>
                </infinite-scroll>
              </div>
            {% endif %}
          {% elsif section.settings.pagination_type == 'on-button' %}
            {% if paginate.next %}
              <div class="pagination-container">
                <infinite-scroll
                  class="infinite-scroll btn"
                  data-url="{{ paginate.next.url }}"
                  mode="on-click"
                  data-infinite-scroll
                  tabindex="0"
                >
                  <span>{{ 'sections.collection_template.load_more' | t }}</span>
                  <div class="loader-icon">
                    <svg
                      class="loadMore"
                      width="40"
                      height="40"
                      style="shape-rendering: auto; animation-play-state: running; animation-delay: 0s; background: none;"
                      viewBox="0 0 100 100"
                      preserveAspectRatio="xMidYMid"
                    >
                      <circle cx="50" cy="50" fill="none" stroke="#d9e2ed" stroke-width="6" r="35"
                              stroke-dasharray="164.93361431346415 56.97787143782138"
                              style="animation-play-state: running; animation-delay: 0s;"
                              transform="rotate(115.597 50 50)">
                        <animateTransform attributeName="transform" type="rotate" calcMode="linear"
                                          values="0 50 50;360 50 50" keyTimes="0;1" dur="1s" begin="0s"
                                          repeatCount="indefinite">
                        </animateTransform>
                      </circle>
                    </svg>
                  </div>
                </infinite-scroll>
              </div>
            {% endif %}
          {% else %}
            {%- if paginate.pages > 1 -%}
              <div class="pagination-container">
                {% render 'pagination', paginate: paginate, anchor: '' %}
              </div>
            {%- endif -%}
          {% endif %}
        </div>
      </div>
    </div>
  {% endpaginate %}
</div>

<style>
  #shopify-section-{{ section.id }} {
     --topSpace:{{ section.settings.top_space_desktop }}px;
     --bottomSpace:{{ section.settings.bottom_space_desktop }}px;
   }

   @media only screen and (max-width:767px) {
     #shopify-section-{{ section.id }}.shopify-section{
       --topSpace:{{ section.settings.top_space_mobile }}px;
       --bottomSpace:{{ section.settings.bottom_space_mobile }}px;
     }

   }
</style>

{% schema %}
{
  "name": "t:sections.main_collection.name",
  "tag": "section",
  "class": "section-collection-filters",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 32,
      "step": 1,
      "default": 12,
      "label": "t:sections.main_collection.settings.products_per_page.label"
    },
    {
      "type": "header",
      "content": "t:common.header.sort_filter.content"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "t:sections.main_collection.settings.enable_filtering.label"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "default": true,
      "label": "t:sections.main_collection.settings.enable_sorting.label"
    },
    {
      "type": "header",
      "content": "t:common.header.pagination.content"
    },

    {
      "type": "select",
      "id": "pagination_type",
      "label": "t:sections.main_collection.settings.pagination_type.label",
      "default": "pagination",
      "options": [
        {
          "value": "pagination",
          "label": "t:sections.main_collection.settings.pagination_type.settings.pagination.label"
        },
        {
          "value": "infinite",
          "label": "t:sections.main_collection.settings.pagination_type.settings.infinite.label"
        },
        {
          "value": "on-button",
          "label": "t:sections.main_collection.settings.pagination_type.settings.on-button.label"
        }
      ]
    },

    {
      "type": "select",
      "id": "grid_image_size",
      "label": "t:common.image_size.label",
      "default": "square",
      "options": [
        {
          "value": "auto",
          "label": "t:common.image_size.options.auto.label"
        },
        {
          "value": "landscape",
          "label": "t:common.image_size.options.landscape.label"
        },
        {
          "value": "portrait",
          "label": "t:common.image_size.options.portrait.label"
        },
        {
          "value": "square",
          "label": "t:common.image_size.options.square.label"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:common.header.colors.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "primary",
      "label": "t:common.global.color_scheme.label"
    },

    {
      "type": "header",
      "content": "t:common.header.section_spacing.content"
    },
    {
      "type": "range",
      "id": "top_space_desktop",
      "label": "t:common.section_spacing.top_space_desktop.label",
      "default": 0,
      "min": 0,
      "max": 150,
      "step": 5
    },
    {
      "type": "range",
      "id": "bottom_space_desktop",
      "label": "t:common.section_spacing.bottom_space_desktop.label",
      "default": 70,
      "min": 0,
      "max": 150,
      "step": 5
    },
    {
      "type": "range",
      "id": "top_space_mobile",
      "label": "t:common.section_spacing.top_space_mobile.label",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 5
    },
    {
      "type": "range",
      "id": "bottom_space_mobile",
      "label": "t:common.section_spacing.bottom_space_mobile.label",
      "default": 40,
      "min": 0,
      "max": 100,
      "step": 5
    }
  ]
}
{% endschema %}
