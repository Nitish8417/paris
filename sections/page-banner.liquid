{% liquid
  assign banner_heading = section.settings.heading
  if banner_heading == blank
    assign banner_heading = page.title
  endif
  assign has_image = false
  if section.settings.banner_image != blank
    assign has_image = true
  endif
  assign has_content = false
  if banner_heading != blank or section.settings.description != blank
    assign has_content = true
  endif
%}

{% if has_image or has_content %}
  <div class="{{ section.settings.color_scheme }}-scheme collection-split-banner-section page-split-banner-section">
    <div class="{{ settings.layout_width }}">
      <div
        class="collection-split-banner page-split-banner height-{{ section.settings.banner_height_desktop }} mobile-height-{{ section.settings.banner_height_mobile }}{% unless has_image %} collection-split-banner--no-image{% endunless %}{% unless has_content %} collection-split-banner--no-content{% endunless %}"
      >
        {% if has_content %}
          <div class="collection-split-banner__content align-{{ section.settings.heading_alignment }}">
            <div class="collection-split-banner__content-inner content-width-{{ section.settings.content_width }}">
              {% if banner_heading != blank %}
                <h1 class="collection-split-banner__heading banner-heading {{ section.settings.heading_size }} {{ section.settings.heading_size_mobile }}">
                  {{ banner_heading }}
                </h1>
              {% endif %}
              {% if section.settings.description != blank %}
                <div class="collection-split-banner__desc textLarge">
                  {{ section.settings.description }}
                </div>
              {% endif %}
            </div>
          </div>
        {% endif %}

        {% if has_image %}
          <div class="collection-split-banner__media">
            <div class="collection-split-banner__image banner-image">
              {% render 'image', image: section.settings.banner_image %}
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
{% endif %}

<style>
  #shopify-section-{{ section.id }} {
    --topSpace: {{ section.settings.top_space_desktop }}px;
    --bottomSpace: {{ section.settings.bottom_space_desktop }}px;
    --overlayBg: {{ section.settings.bg_color_opacity }};
    --overlayOpacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  }

  #shopify-section-{{ section.id }} .page-split-banner-section {
    padding-top: 20px;
  }

  #shopify-section-{{ section.id }} .page-split-banner {
    display: grid;
    grid-template-columns: minmax(280px, 0.4fr) minmax(0, 0.6fr);
    align-items: stretch;
    width: 100%;
    overflow: hidden;
    border-radius: 28px;
    background: var(--bodyColor);
    color: var(--mainHeadingColor);
    height: auto !important;
    min-height: 300px;
  }

  #shopify-section-{{ section.id }} .page-split-banner.height-small {
    min-height: 280px;
  }

  #shopify-section-{{ section.id }} .page-split-banner.height-medium {
    min-height: 360px;
  }

  #shopify-section-{{ section.id }} .page-split-banner.height-large {
    min-height: 460px;
  }

  #shopify-section-{{ section.id }} .page-split-banner.collection-split-banner--no-image,
  #shopify-section-{{ section.id }} .page-split-banner.collection-split-banner--no-content {
    grid-template-columns: 1fr;
  }

  #shopify-section-{{ section.id }} .collection-split-banner__content {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding: 48px 40px;
    background: var(--bodyColor);
  }

  #shopify-section-{{ section.id }} .collection-split-banner__content.align-center {
    justify-content: center;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .collection-split-banner__content.align-left {
    justify-content: flex-start;
    text-align: left;
  }

  #shopify-section-{{ section.id }} .collection-split-banner__content.align-right {
    justify-content: flex-end;
    text-align: right;
  }

  #shopify-section-{{ section.id }} .collection-split-banner__heading {
    margin: 0 0 12px;
    padding: 0 !important;
    background: none !important;
    border-radius: 0 !important;
    color: var(--mainHeadingColor) !important;
    box-shadow: none !important;
    position: static !important;
    overflow: visible !important;
    text-align: inherit !important;
  }

  #shopify-section-{{ section.id }} .collection-split-banner__heading::after {
    content: none !important;
    display: none !important;
  }

  #shopify-section-{{ section.id }} .collection-split-banner__desc {
    color: var(--textColor, var(--mainHeadingColor));
    opacity: 0.9;
  }

  #shopify-section-{{ section.id }} .collection-split-banner__media {
    position: relative;
    align-self: stretch;
    min-height: 100%;
    overflow: hidden;
    background: transparent;
  }

  #shopify-section-{{ section.id }} .collection-split-banner__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .collection-split-banner__image:after {
    display: none;
  }

  #shopify-section-{{ section.id }} .collection-split-banner__image img {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    max-width: none !important;
    max-height: none !important;
    object-fit: cover !important;
    display: block;
  }

  @media only screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .page-split-banner {
      grid-template-columns: 1fr;
      border-radius: 20px;
      min-height: 0;
    }

    #shopify-section-{{ section.id }} .collection-split-banner__content {
      padding: 32px 24px;
      order: 1;
    }

    #shopify-section-{{ section.id }} .collection-split-banner__media {
      order: 2;
      min-height: 220px;
      aspect-ratio: 16 / 10;
    }
  }

  @media only screen and (max-width: 767px) {
    #shopify-section-{{ section.id }}.shopify-section {
      --topSpace: {{ section.settings.top_space_mobile }}px;
      --bottomSpace: {{ section.settings.bottom_space_mobile }}px;
    }
  }
</style>

{% schema %}
{
  "name": "t:sections.banner.name",
  "tag": "section",
  "class": "page-banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "t:common.global.image.label",
      "info": "t:sections.banner.settings.banner_image.info"
    },
    {
      "type": "select",
      "id": "banner_height_desktop",
      "label": "t:common.global.desktop_height.label",
      "default": "medium",
      "options": [
        { "value": "small", "label": "t:common.height.small.label" },
        { "value": "medium", "label": "t:common.height.medium.label" },
        { "value": "large", "label": "t:common.height.large.label" }
      ]
    },
    {
      "type": "select",
      "id": "banner_height_mobile",
      "label": "t:common.global.mobile_height.label",
      "default": "small",
      "options": [
        { "value": "small", "label": "t:common.height.small.label" },
        { "value": "medium", "label": "t:common.height.medium.label" },
        { "value": "large", "label": "t:common.height.large.label" }
      ]
    },
    {
      "type": "header",
      "content": "t:common.header.content.content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:common.global.heading.label"
    },
    {
      "type": "textarea",
      "id": "description",
      "default": "Add short description here",
      "label": "t:common.global.description.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "default": "h2",
      "label": "t:common.heading_size.desktop_label",
      "options": [
        { "value": "h1", "label": "t:common.heading_size.options.extra_large.label" },
        { "value": "h2", "label": "t:common.heading_size.options.large.label" },
        { "value": "h3", "label": "t:common.heading_size.options.medium.label" },
        { "value": "h4", "label": "t:common.heading_size.options.small.label" },
        { "value": "h5", "label": "t:common.heading_size.options.extra_small.label" }
      ]
    },
    {
      "type": "select",
      "id": "heading_size_mobile",
      "default": "h3_mobile",
      "label": "t:common.heading_size.mobile_label",
      "options": [
        { "value": "h1_mobile", "label": "t:common.heading_size.options.extra_large.label" },
        { "value": "h2_mobile", "label": "t:common.heading_size.options.large.label" },
        { "value": "h3_mobile", "label": "t:common.heading_size.options.medium.label" },
        { "value": "h4_mobile", "label": "t:common.heading_size.options.small.label" },
        { "value": "h5_mobile", "label": "t:common.heading_size.options.extra_small.label" }
      ]
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:common.content_width.label",
      "default": "small",
      "options": [
        { "value": "small", "label": "t:common.content_width.options.small.label" },
        { "value": "medium", "label": "t:common.content_width.options.medium.label" },
        { "value": "large", "label": "t:common.content_width.options.Large.label" }
      ]
    },
    {
      "type": "text_alignment",
      "id": "heading_alignment",
      "label": "t:common.global.alignment.label",
      "default": "left"
    },
    {
      "type": "header",
      "content": "t:common.header.colors.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "secondary",
      "label": "t:common.global.color_scheme.label"
    },
    {
      "type": "color",
      "id": "bg_color_opacity",
      "default": "#eeeeee",
      "label": "t:common.global.image_overlay.label",
      "info": "Not used in the split banner layout."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:common.global.overlay_opacity.label",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "info": "Not used in the split banner layout."
    },
    {
      "type": "header",
      "content": "t:common.header.section_spacing.content"
    },
    {
      "type": "range",
      "id": "top_space_desktop",
      "label": "t:common.section_spacing.top_space_desktop.label",
      "default": 0,
      "min": 0,
      "max": 150,
      "step": 5
    },
    {
      "type": "range",
      "id": "bottom_space_desktop",
      "label": "t:common.section_spacing.bottom_space_desktop.label",
      "default": 0,
      "min": 0,
      "max": 150,
      "step": 5
    },
    {
      "type": "range",
      "id": "top_space_mobile",
      "label": "t:common.section_spacing.top_space_mobile.label",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 5
    },
    {
      "type": "range",
      "id": "bottom_space_mobile",
      "label": "t:common.section_spacing.bottom_space_mobile.label",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 5
    }
  ]
}
{% endschema %}
