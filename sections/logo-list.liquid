{% capture logolist %}
      {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
           <div class="multi-logo-item">
           <{% if block.settings.image_link != blank %}a href="{{ block.settings.image_link }}"{% else %}div{% endif %} id="block-{{ block.id }}" class="multi-logo-block logo-shape-{{ section.settings.logo_shape }}{% if section.settings.images_height or section.settings.logo_shape == 'circle' %} card-height-true{% endif %} {% if section.settings.show_card_background  %}logo-background{% endif %} {% if section.settings.show_card_border %}logo-border{% endif %}">
                  {% liquid 
                   if block.settings.image != blank
                      render 'image', image: block.settings.image
                    else
                      echo 'logo' | placeholder_svg_tag: 'placeholder-svg'
                    endif 
                  %}
  
              </{% if block.settings.image_link != blank %}a{% else %}div{% endif %}>
          </div>
      {% endfor %}
     {% endif %}
{% endcapture %}
{%- comment -%}
  TECHTY FIX: the scrolling animation is now built into this file (pure CSS),
  so the speed is exactly what you set:
  "Scrolling speed" = seconds for ONE full loop of your logos. Higher = slower.
{%- endcomment -%}
{% liquid
  assign mq_seconds = section.settings.scrolling_speed
  assign mq_copies = 2
  if section.blocks.size < 8
    assign mq_copies = 4
  endif
  if section.blocks.size <= 3
    assign mq_copies = 8
  endif
%}
    <div class="{{ section.settings.color_scheme }}-scheme spacing-box">
    <div class="{{ settings.layout_width }}">
        {% if section.settings.heading != blank %}
          <h2 class="{{ section.settings.heading_size }} {{ section.settings.heading_size_mobile }} align-{{ section.settings.heading_alignment }}">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.layout_type == 'grid' %}
          <div class="multi-logo-wrapper logo-list-shape-{{ section.settings.logo_shape }} {% if section.settings.swipe_enable_mobile %} swipe-mobile-true{% endif %} logo-stacked">
            {{ logolist }}
          </div>
        {% else %}
          <div class="multi-logo-wrapper logo-list-shape-{{ section.settings.logo_shape }} tt-mq tt-mq--{{ section.settings.direction }}" style="--tt-mq-duration: {{ mq_seconds }}s; --tt-mq-copies: {{ mq_copies }};">
            <div class="tt-mq__track">
              {% for i in (1..mq_copies) %}
                <div class="tt-mq__set"{% if i > 1 %} aria-hidden="true" inert{% endif %}>
                  {{ logolist }}
                </div>
              {% endfor %}
            </div>
          </div>
        {% endif %}
      </div>
  </div>

<style>
    #shopify-section-{{ section.id }} {
      --topSpace:{{ section.settings.top_space_desktop }}px;
      --bottomSpace:{{ section.settings.bottom_space_desktop }}px;
      --dividerColor: {{ section.settings.border }};
      --logosSpace:{{ section.settings.column_spacing }}px;
      --logoCircleSize: {{ section.settings.circle_size }}px;
      --logoRadius: {{ section.settings.corner_radius }}px;
  }
       #shopify-section-{{ section.id }} .logo-background{
       --logoBg: {{ section.settings.background }};
    }

  #shopify-section-{{ section.id }} .multi-logo-block {
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .multi-logo-block img,
  #shopify-section-{{ section.id }} .multi-logo-block .placeholder-svg {
    object-fit: contain;
    max-width: 100%;
    max-height: 100%;
  }

  /* Circle */
  #shopify-section-{{ section.id }} .logo-list-shape-circle .multi-logo-item {
    max-width: var(--logoCircleSize);
    flex-grow: 0;
    padding-right: var(--logosSpace);
  }

  #shopify-section-{{ section.id }} .multi-logo-block.logo-shape-circle {
    width: var(--logoCircleSize);
    height: var(--logoCircleSize);
    min-width: var(--logoCircleSize);
    min-height: var(--logoCircleSize);
    border-radius: 50%;
    padding: {{ section.settings.circle_padding | default: 16 }}px;
  }

  /* Rounded */
  #shopify-section-{{ section.id }} .multi-logo-block.logo-shape-rounded {
    border-radius: var(--logoRadius);
  }

  /* Square */
  #shopify-section-{{ section.id }} .multi-logo-block.logo-shape-square {
    border-radius: 0;
  }

  /* ===== TECHTY MARQUEE (smooth, speed = seconds per loop) ===== */
  #shopify-section-{{ section.id }} .tt-mq {
    position: relative;
    overflow: hidden;
    direction: ltr;
    padding-block: 6px;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 6%, #000 94%, transparent 100%);
            mask-image: linear-gradient(90deg, transparent 0, #000 6%, #000 94%, transparent 100%);
  }
  #shopify-section-{{ section.id }} .tt-mq__track {
    display: flex;
    width: max-content;
    animation: tt-mq-{{ section.id | handleize }} var(--tt-mq-duration) linear infinite;
    will-change: transform;
  }
  #shopify-section-{{ section.id }} .tt-mq--rtl .tt-mq__track { animation-direction: reverse; }
  #shopify-section-{{ section.id }} .tt-mq:hover .tt-mq__track { animation-play-state: paused; }
  #shopify-section-{{ section.id }} .tt-mq__set {
    display: flex;
    flex: none;
    align-items: center;
  }
  #shopify-section-{{ section.id }} .tt-mq .multi-logo-item {
    flex: none;
    width: auto;
    max-width: none;
    padding-right: var(--logosSpace);
  }
  #shopify-section-{{ section.id }} .tt-mq .multi-logo-block {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #shopify-section-{{ section.id }} .tt-mq .multi-logo-block:not(.logo-shape-circle) {
    width: 170px;
    height: 90px;
    padding: 14px;
  }
  @keyframes tt-mq-{{ section.id | handleize }} {
    from { transform: translateX(0); }
    to   { transform: translateX(calc(-100% / var(--tt-mq-copies))); }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .tt-mq { overflow-x: auto; -webkit-mask-image: none; mask-image: none; }
    #shopify-section-{{ section.id }} .tt-mq__track { animation: none; }
  }

  @media only screen and (max-width:767px) {
    #shopify-section-{{ section.id }}.shopify-section{
      --topSpace:{{ section.settings.top_space_mobile }}px;
      --bottomSpace:{{ section.settings.bottom_space_mobile }}px;
      --logoCircleSize: {{ section.settings.circle_size_mobile }}px;
    }
    #shopify-section-{{ section.id }} .tt-mq .multi-logo-block:not(.logo-shape-circle) {
      width: 128px;
      height: 70px;
      padding: 10px;
    }
  }
</style>
{% schema %}
{
  "name": "t:sections.logo_list.name",
  "tag": "section",
  "class": "section-multi-logos",
  "disabled_on": {
   "groups": ["header", "footer","aside"]
  },
  "max_blocks": 30,
  "settings": [
      { "type": "header", "content": "Logo shape" },
      {
        "type": "select", "id": "logo_shape", "label": "Logo shape", "default": "circle",
        "options": [
          { "value": "circle", "label": "Circle" },
          { "value": "rounded", "label": "Rounded" },
          { "value": "square", "label": "Square" }
        ]
      },
      { "type": "range", "id": "circle_size", "label": "Circle size (desktop)", "min": 60, "max": 160, "step": 4, "unit": "px", "default": 112, "info": "Used when Logo shape is Circle" },
      { "type": "range", "id": "circle_size_mobile", "label": "Circle size (mobile)", "min": 48, "max": 120, "step": 4, "unit": "px", "default": 80 },
      { "type": "range", "id": "circle_padding", "label": "Circle inner padding", "min": 4, "max": 32, "step": 2, "unit": "px", "default": 16 },
      { "type": "range", "id": "corner_radius", "label": "Corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 12, "info": "Used when Logo shape is Rounded" },
      { "type": "checkbox", "id": "images_height", "label": "t:sections.logo_list.settings.images_height.label", "default": false },
      { "type": "checkbox", "id": "swipe_enable_mobile", "label": "t:sections.logo_list.settings.swipe_enable_mobile.label", "default": true },
      { "type": "checkbox", "id": "show_card_background", "label": "t:sections.logo_list.settings.show_card_background.label", "default": true },
      { "type": "checkbox", "id": "show_card_border", "label": "t:sections.logo_list.settings.show_card_border.label", "default": true },
      {
        "type": "select", "id": "layout_type", "label": "t:sections.logo_list.settings.layout_type.label", "default": "marquee",
        "options": [
          { "value": "grid", "label": "t:sections.logo_list.settings.layout_type.options.carousel.label" },
          { "value": "marquee", "label": "t:sections.logo_list.settings.layout_type.options.marquee.label" }
        ]
      },
      { "type": "header", "content": "t:common.header.marquee.content" },
      {
        "type": "range",
        "id": "scrolling_speed",
        "label": "t:sections.logo_list.settings.scrolling_speed.label",
        "min": 10,
        "max": 500,
        "step": 5,
        "unit": "s",
        "default": 60,
        "info": "Seconds for one full loop of your logos. Higher = slower. 50–80 feels natural."
      },
      {
        "type": "select", "id": "direction", "label": "t:common.direction.label", "default": "ltr",
        "options": [
          { "value": "ltr", "label": "t:common.direction.options.ltr.label" },
          { "value": "rtl", "label": "t:common.direction.options.rtl.label" }
        ]
      },
      { "type": "header", "content": "t:common.header.grid.content" },
      { "type": "range", "id": "column_spacing", "label": "t:sections.logo_list.settings.column_spacing.label", "min": 0, "max": 100, "unit": "px", "step": 2, "default": 40 },
      { "type": "header", "content": "t:common.header.content.content" },
      { "type": "inline_richtext", "id": "heading", "label": "t:common.global.heading.label", "default": "Logo list" },
      {
        "type": "select", "id": "heading_size", "default": "h2", "label": "t:common.heading_size.desktop_label",
        "options": [
          { "value": "h1", "label": "t:common.heading_size.options.extra_large.label" },
          { "value": "h2", "label": "t:common.heading_size.options.large.label" },
          { "value": "h3", "label": "t:common.heading_size.options.medium.label" },
          { "value": "h4", "label": "t:common.heading_size.options.small.label" },
          { "value": "h5", "label": "t:common.heading_size.options.extra_small.label" }
        ]
      },
      {
        "type": "select", "id": "heading_size_mobile", "default": "h3_mobile", "label": "t:common.heading_size.mobile_label",
        "options": [
          { "value": "h1_mobile", "label": "t:common.heading_size.options.extra_large.label" },
          { "value": "h2_mobile", "label": "t:common.heading_size.options.large.label" },
          { "value": "h3_mobile", "label": "t:common.heading_size.options.medium.label" },
          { "value": "h4_mobile", "label": "t:common.heading_size.options.small.label" },
          { "value": "h5_mobile", "label": "t:common.heading_size.options.extra_small.label" }
        ]
      },
      { "type": "text_alignment", "id": "heading_alignment", "label": "t:common.global.heading_alignment.label", "default": "left" },
      { "type": "header", "content": "t:common.header.colors.content" },
      { "type": "color_scheme", "id": "color_scheme", "default": "secondary", "label": "t:common.global.color_scheme.label" },
      { "type": "color", "id": "background", "label": "t:common.global.background.label", "default": "#FFFFFF" },
      { "type": "color", "id": "border", "label": "t:common.global.border.label", "default": "#E6E6E6" },
      { "type": "header", "content": "t:common.header.section_spacing.content" },
      { "type": "range", "id": "top_space_desktop", "label": "t:common.section_spacing.top_space_desktop.label", "default": 80, "min": 0, "max": 150, "step": 5 },
      { "type": "range", "id": "bottom_space_desktop", "label": "t:common.section_spacing.bottom_space_desktop.label", "default": 80, "min": 0, "max": 150, "step": 5 },
      { "type": "range", "id": "top_space_mobile", "label": "t:common.section_spacing.top_space_mobile.label", "default": 40, "min": 0, "max": 100, "step": 5 },
      { "type": "range", "id": "bottom_space_mobile", "label": "t:common.section_spacing.bottom_space_mobile.label", "default": 40, "min": 0, "max": 100, "step": 5 }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "t:sections.logo_list.blocks.name",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "t:common.global.image.label" },
        { "type": "url", "id": "image_link", "label": "t:common.global.link.label" },
        { "type": "range", "id": "image_width", "label": "t:sections.logo_list.blocks.settings.image_width.label", "default": 50, "min": 50, "max": 100, "unit": "%", "step": 5 }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.logo_list.presets.name",
      "blocks": [
        { "type": "logo" }, { "type": "logo" }, { "type": "logo" }, { "type": "logo" }, { "type": "logo" }
      ]
    }
  ]
}
{% endschema %} 