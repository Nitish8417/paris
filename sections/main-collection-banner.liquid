<div class="{{ section.settings.color_scheme }}-scheme collection-split-banner-section">
  {% liquid
    assign collectionImageStatus = false
    if section.settings.show_collection_image
      if collection.image != blank
        assign collectionImage = collection.image
        assign collectionImageStatus = true
      elsif section.settings.custom_collection_image != blank
        assign collectionImage = section.settings.custom_collection_image
        assign collectionImageStatus = true
      endif
    endif

    assign contentStatus = false
    if section.settings.show_collection_title and collection.title != blank
      assign contentStatus = true
    elsif section.settings.show_collection_description and collection.description != blank
      assign contentStatus = true
    endif

    assign description_plain = collection.description | strip_html | strip
    assign description_word_count = description_plain | split: ' ' | size
    assign show_read_more = false
    if description_word_count > 40
      assign show_read_more = true
    endif
  %}

  {% if collectionImageStatus or contentStatus %}
    <div class="collection-banner-full-width">
      <div
        class="collection-split-banner height-{{ section.settings.banner_height_desktop }} mobile-height-{{ section.settings.banner_height_mobile }}{% if collectionImageStatus == false %} collection-split-banner--no-image{% endif %}{% if contentStatus == false %} collection-split-banner--no-content{% endif %}"
      >
        {% if contentStatus %}
          <div class="{{ settings.layout_width }} collection-split-banner__content align-{{ section.settings.content_alignment }}">
            <div class="collection-split-banner__content-inner content-width-{{ section.settings.content_width }}">
              {% if section.settings.show_collection_title and collection.title != blank %}
                <h1 class="collection-split-banner__heading banner-heading h2">
                  {{ collection.title | escape }}
                </h1>
              {% endif %}

              {% if section.settings.show_collection_description and collection.description != blank %}
                {% if show_read_more %}
                  <details class="collection-split-banner__details">
                    <summary class="collection-split-banner__summary">
                      <div class="collection-split-banner__desc textLarge rte collection-split-banner__desc--clamped">
                        {{
                          collection.description
                          | replace: '<table', '<div class="table-content"><table '
                          | replace: '</table>', '</table></div>'
                        }}
                      </div>
                      <span class="collection-split-banner__read-more">Read More</span>
                    </summary>
                    <div class="collection-split-banner__desc textLarge rte">
                      {{
                        collection.description
                        | replace: '<table', '<div class="table-content"><table '
                        | replace: '</table>', '</table></div>'
                      }}
                    </div>
                  </details>
                {% else %}
                  <div class="collection-split-banner__desc textLarge rte">
                    {{
                      collection.description
                      | replace: '<table', '<div class="table-content"><table '
                      | replace: '</table>', '</table></div>'
                    }}
                  </div>
                {% endif %}
              {% endif %}
            </div>
          </div>
        {% endif %}

        {% if collectionImageStatus %}
          <div class="collection-split-banner__media">
            <div class="collection-split-banner__image banner-image">
              {% render 'image', image: collectionImage %}
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  {% endif %}
</div>

<style>
  #shopify-section-{{ section.id }} {
    --overlayBg: {{ section.settings.bg_color_opacity }};
    --overlayOpacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  }

  #shopify-section-{{ section.id }} .collection-split-banner-section {
    padding: 0;
  }

  #shopify-section-{{ section.id }} .collection-banner-full-width {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
  }

  /* Text sits in the theme container; the image bleeds to the right edge
     and fades into the background colour behind the text. */
  #shopify-section-{{ section.id }} .collection-split-banner {
    --bannerMediaStart: 26%;
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
    overflow: hidden;
    border-radius: 0;
    background: var(--bodyColor);
    color: var(--mainHeadingColor);
    height: auto !important;
    min-height: 300px;
  }

  #shopify-section-{{ section.id }} .collection-split-banner.height-small {
    min-height: 300px;
  }

  #shopify-section-{{ section.id }} .collection-split-banner.height-medium {
    min-height: 380px;
  }

  #shopify-section-{{ section.id }} .collection-split-banner.height-large {
    min-height: 480px;
  }

  #shopify-section-{{ section.id }} .collection-split-banner--no-content {
    --bannerMediaStart: 0%;
  }

  #shopify-section-{{ section.id }} .collection-split-banner__content {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding-top: 48px;
    padding-bottom: 48px;
  }

  #shopify-section-{{ section.id }} .collection-split-banner:not(.collection-split-banner--no-image) .collection-split-banner__content-inner {
    max-width: min(var(--bannerTextMax, 420px), 40%);
  }

  #shopify-section-{{ section.id }} .collection-split-banner__content.align-center {
    justify-content: center;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .collection-split-banner__content.align-left {
    justify-content: flex-start;
    text-align: left;
  }

  #shopify-section-{{ section.id }} .collection-split-banner__content-inner {
    width: 100%;
    max-width: 100%;
  }

  #shopify-section-{{ section.id }} .collection-split-banner__content-inner.content-width-small {
    --bannerTextMax: 420px;
    max-width: 420px;
  }

  #shopify-section-{{ section.id }} .collection-split-banner__content-inner.content-width-medium {
    --bannerTextMax: 520px;
    max-width: 520px;
  }

  #shopify-section-{{ section.id }} .collection-split-banner__content-inner.content-width-large {
    --bannerTextMax: 640px;
    max-width: 100%;
  }

  #shopify-section-{{ section.id }} .collection-split-banner__heading {
    margin: 0 0 16px;
    padding: 0;
    background: none;
    border-radius: 0;
    color: var(--mainHeadingColor);
    box-shadow: none;
  }

  #shopify-section-{{ section.id }} .collection-split-banner__heading::after {
    content: none;
    display: none;
  }

  #shopify-section-{{ section.id }} .collection-split-banner__desc {
    color: var(--textColor, var(--mainHeadingColor));
    opacity: 0.9;
  }

  #shopify-section-{{ section.id }} .collection-split-banner__desc p:last-child {
    margin-bottom: 0;
  }

  #shopify-section-{{ section.id }} .collection-split-banner__details {
    border: 0;
  }

  #shopify-section-{{ section.id }} .collection-split-banner__summary {
    list-style: none;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .collection-split-banner__summary::-webkit-details-marker {
    display: none;
  }

  #shopify-section-{{ section.id }} .collection-split-banner__desc--clamped {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .collection-split-banner__read-more {
    display: inline-block;
    margin-top: 18px;
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 600;
    color: var(--mainHeadingColor);
  }

  #shopify-section-{{ section.id }} .collection-split-banner__details[open] .collection-split-banner__summary {
    display: none;
  }

  #shopify-section-{{ section.id }} .collection-split-banner__media {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: var(--bannerMediaStart);
    z-index: 1;
    overflow: hidden;
    background: transparent;
    padding: 0;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .collection-split-banner:not(.collection-split-banner--no-content) .collection-split-banner__media::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      var(--bodyColor) 0%,
      color-mix(in srgb, var(--bodyColor) 75%, transparent) 14%,
      color-mix(in srgb, var(--bodyColor) 30%, transparent) 30%,
      transparent 48%
    );
  }

  #shopify-section-{{ section.id }} .collection-split-banner__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .collection-split-banner__image:after {
    display: none;
  }

  #shopify-section-{{ section.id }} .collection-split-banner__image img {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    max-width: none !important;
    max-height: none !important;
    object-fit: cover !important;
    object-position: center;
    display: block;
  }

  #shopify-section-{{ section.id }} .collection-split-banner__image .loader-image {
    display: none;
  }

  @media only screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .collection-split-banner,
    #shopify-section-{{ section.id }} .collection-split-banner[class*="height-"] {
      flex-direction: column;
      align-items: stretch;
      min-height: 0;
    }

    #shopify-section-{{ section.id }} .collection-split-banner:not(.collection-split-banner--no-image) .collection-split-banner__content-inner {
      max-width: 100%;
    }

    #shopify-section-{{ section.id }} .collection-split-banner:not(.collection-split-banner--no-content) .collection-split-banner__media::after {
      background: linear-gradient(
        180deg,
        var(--bodyColor) 0%,
        color-mix(in srgb, var(--bodyColor) 40%, transparent) 18%,
        transparent 40%
      );
    }

    #shopify-section-{{ section.id }} .collection-split-banner.mobile-height-small .collection-split-banner__media {
      min-height: 220px;
    }

    #shopify-section-{{ section.id }} .collection-split-banner.mobile-height-medium .collection-split-banner__media {
      min-height: 280px;
    }

    #shopify-section-{{ section.id }} .collection-split-banner.mobile-height-large .collection-split-banner__media {
      min-height: 340px;
    }

    #shopify-section-{{ section.id }} .collection-split-banner__content {
      width: 100%;
      padding-top: 28px;
      padding-bottom: 20px;
      order: 1;
    }

    #shopify-section-{{ section.id }} .collection-split-banner__media {
      position: relative;
      inset: auto;
      order: 2;
      min-height: 240px;
      aspect-ratio: 16 / 10;
    }

    #shopify-section-{{ section.id }} .collection-split-banner__image {
      position: absolute;
    }
  }
</style>

{% schema %}
{
  "name": "t:sections.main_collection_banner.name",
  "class": "collection-banner",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_collection_title",
      "default": true,
      "label": "t:sections.main_collection_banner.settings.show_collection_title.label"
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "default": true,
      "label": "t:sections.main_collection_banner.settings.show_collection_description.label"
    },
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "default": true,
      "label": "t:sections.main_collection_banner.settings.show_collection_image.label"
    },
    {
      "type": "header",
      "content": "t:common.header.content.content"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:common.content_width.label",
      "default": "small",
      "options": [
        {
          "value": "small",
          "label": "t:common.content_width.options.small.label"
        },
        {
          "value": "medium",
          "label": "t:common.content_width.options.medium.label"
        },
        {
          "value": "large",
          "label": "t:common.content_width.options.Large.label"
        }
      ]
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "t:common.global.alignment.label",
      "default": "left",
      "options": [
        {
          "label": "t:common.global.left.label",
          "value": "left"
        },
        {
          "label": "t:common.global.center.label",
          "value": "center"
        }
      ]
    },
    {
      "type": "image_picker",
      "id": "custom_collection_image",
      "label": "t:sections.main_collection_banner.settings.custom_collection_image.label"
    },
    {
      "type": "select",
      "id": "banner_height_desktop",
      "label": "t:common.global.desktop_height.label",
      "default": "medium",
      "options": [
        {
          "value": "small",
          "label": "t:common.height.small.label"
        },
        {
          "value": "medium",
          "label": "t:common.height.medium.label"
        },
        {
          "value": "large",
          "label": "t:common.height.large.label"
        }
      ]
    },
    {
      "type": "select",
      "id": "banner_height_mobile",
      "label": "t:common.global.mobile_height.label",
      "default": "small",
      "options": [
        {
          "value": "small",
          "label": "t:common.height.small.label"
        },
        {
          "value": "medium",
          "label": "t:common.height.medium.label"
        },
        {
          "value": "large",
          "label": "t:common.height.large.label"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:common.header.colors.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "secondary",
      "label": "t:common.global.color_scheme.label"
    },
    {
      "type": "color",
      "id": "bg_color_opacity",
      "default": "#000000",
      "label": "t:common.global.image_overlay.label",
      "info": "Not used in the split banner layout."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:common.global.overlay_opacity.label",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "info": "Not used in the split banner layout."
    }
  ]
}
{% endschema %}
