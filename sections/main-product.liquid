{%- assign unique_3d_model = product.media | where: 'media_type', 'model' | first -%}
{%- if unique_3d_model -%}
  <link rel="stylesheet" href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css">
{%- endif -%}
{%- assign product_variant = product.selected_variant -%}
<div class="{{ section.settings.color_scheme }}-scheme spacing-box">
  <product-recently-viewed data-product-id="{{ product.id }}" class="hidden"></product-recently-viewed>

  <div class="{% if section.settings.container_type =='container' %}container {% endif %}product-container">
    <div class="main-product-grid">
      {% render 'product-media-gallery', product: product, section: section, product_variant: product_variant %}
      <div class="main-product-content">
        <div class="featured-product-content">
          {% render 'product-info', product: product, section: section, product_variant: false %}
        </div>
      </div>
    </div>
  </div>
</div>
{% if product.media.size > 0 %}
  {% render 'product-media-popup', product: product, section: section, product_variant: product_variant %}
{% endif %}
{% if product.quantity_price_breaks_configured? %}
  <script src="{{ 'volume-pricing.js' | asset_url }}" defer></script>
  <script src="{{ 'price-per-item.js' | asset_url }}" defer></script>
{% endif %}
<script type="application/json" id="ProductJSON-{{ product.id }}">
  {{ product.media | where: 'media_type', 'model' | json }}
</script>
{%- if unique_3d_model -%}
  <script src="{{ 'product-model.js' | asset_url }}" defer></script>
{% endif %}
{%- liquid
  if product.selected_or_first_available_variant.featured_media
    assign seo_media = product.selected_or_first_available_variant.featured_media
  else
    assign seo_media = product.featured_media
  endif
-%}

<script type="application/ld+json">
  {
    "@context": "http://schema.org/",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ request.origin | append: product.url | json }},
    {% if seo_media -%}
      "image": [
        {{ seo_media | image_url: width: 1920 | prepend: "https:" | json }}
      ],
    {%- endif %}
    "description": {{ product.description | strip_html | json }},
    {% if product.selected_or_first_available_variant.sku != blank -%}
      "sku": {{ product.selected_or_first_available_variant.sku | json }},
    {%- endif %}
    "brand": {
      "@type": "Brand",
      "name": {{ product.vendor | json }}
    },
    "offers": [
      {%- for variant in product.variants -%}
        {
          "@type" : "Offer",
          {%- if variant.sku != blank -%}
            "sku": {{ variant.sku | json }},
          {%- endif -%}
          {%- if variant.barcode.size == 12 -%}
            "gtin12": {{ variant.barcode }},
          {%- endif -%}
          {%- if variant.barcode.size == 13 -%}
            "gtin13": {{ variant.barcode }},
          {%- endif -%}
          {%- if variant.barcode.size == 14 -%}
            "gtin14": {{ variant.barcode }},
          {%- endif -%}
          "availability" : "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "price" : {{ variant.price | divided_by: 100.00 | json }},
          "priceCurrency" : {{ cart.currency.iso_code | json }},
          "url" : {{ request.origin | append: variant.url | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>
<style>
  {%- liquid
    assign mp_main_h = section.settings.main_image_height | default: 480
    assign mp_main_h_mobile = section.settings.main_image_height_mobile | default: 320
    assign mp_thumb = section.settings.thumb_size | default: 72
    assign mp_thumb_mobile = section.settings.thumb_size_mobile | default: 56
    assign mp_image_pad = section.settings.gallery_image_padding | default: 28
    assign mp_image_pad_mobile = section.settings.gallery_image_padding_mobile | default: 16
    assign mp_radius = section.settings.image_radius | default: 8
    assign mp_image_bg = section.settings.image_background_color | default: '#FFFFFF'
    assign mp_border = section.settings.image_border_color | default: '#E6E6E6'
    assign mp_thumb_active = section.settings.thumb_active_border_color | default: '#111111'
    assign mp_media_max = section.settings.media_max_width | default: 560
  -%}
  #shopify-section-{{ section.id }} {
    --topSpace:{{ section.settings.top_space_desktop }}px;
    --bottomSpace:{{ section.settings.bottom_space_desktop }}px;
    --mpMainImageHeight: {{ mp_main_h }}px;
    --mpThumbSize: {{ mp_thumb }}px;
    --mpImagePad: {{ mp_image_pad }}px;
    --mpImageBg: {{ mp_image_bg }};
    --mpMediaMax: {{ mp_media_max }}px;
  }

  #shopify-section-{{ section.id }} .main-product-grid {
    grid-template-columns: minmax(0, var(--mpMediaMax)) minmax(0, 1fr);
    grid-gap: 48px;
    align-items: flex-start;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .main-product-images {
    width: 100%;
    max-width: var(--mpMediaMax);
    justify-self: start;
  }

  #shopify-section-{{ section.id }} .main-product-images,
  #shopify-section-{{ section.id }} .product-slide-box {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    gap: 12px;
  }

  #shopify-section-{{ section.id }} .product-slide-box {
    width: 100%;
    max-width: 100%;
  }

  #shopify-section-{{ section.id }} .product-slider-thumbnail,
  #shopify-section-{{ section.id }} .main-product-thumbs-rail {
    order: 0 !important;
    width: var(--mpThumbSize) !important;
    flex: 0 0 var(--mpThumbSize) !important;
    height: var(--mpMainImageHeight) !important;
    overflow: hidden;
    display: flex !important;
    flex-direction: column;
    align-items: stretch;
    gap: 8px;
  }

  #shopify-section-{{ section.id }} .main-product-thumbs-arrow {
    flex: 0 0 28px;
    width: 100%;
    height: 28px;
    border: 1px solid #111;
    border-radius: 999px;
    background: #fff;
    color: #111;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .main-product-thumbs-arrow:hover {
    background: #111;
    color: #fff;
  }

  #shopify-section-{{ section.id }} .main-product-thumbs-arrow:disabled {
    opacity: 0.35;
    cursor: default;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .main-product-thumbs-arrow--prev svg,
  #shopify-section-{{ section.id }} .main-product-thumbs-arrow--next svg {
    display: block;
  }

  #shopify-section-{{ section.id }} .product-slider-nav-wrapper.main-product-thumbs-stack {
    transform: none !important;
    transform-origin: unset !important;
    width: 100% !important;
    flex: 1 1 auto !important;
    height: auto !important;
    min-height: 0 !important;
    margin: 0 !important;
    display: flex !important;
    flex-direction: column;
    gap: 8px;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  #shopify-section-{{ section.id }} .product-slider-nav-wrapper.main-product-thumbs-stack::-webkit-scrollbar {
    width: 0;
    height: 0;
    display: none;
  }

  #shopify-section-{{ section.id }} .product-slider-nav-wrapper.main-product-thumbs-stack .main-product-thumb {
    width: 100% !important;
    height: var(--mpThumbSize) !important;
    flex: 0 0 var(--mpThumbSize) !important;
    position: relative !important;
    left: auto !important;
    padding: 0;
    margin: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .main-product-thumb .main-product-thumb-item {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: {{ mp_radius }}px;
    background-color: var(--mpImageBg);
    border: 1px solid {{ mp_border }};
    overflow: hidden;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .main-product-thumb.is-nav-selected .main-product-thumb-item {
    border-color: {{ mp_thumb_active }};
    border-width: 2px;
  }

  #shopify-section-{{ section.id }} .main-product-thumb .media-image {
    display: block !important;
    transform: none !important;
    padding-top: 100% !important;
    height: 0 !important;
    background-color: var(--mpImageBg) !important;
  }

  #shopify-section-{{ section.id }} .main-product-thumb .media-image img,
  #shopify-section-{{ section.id }} .main-product-thumb .main-product-thumb-img {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    max-width: none !important;
    max-height: none !important;
    object-fit: contain !important;
    display: block !important;
    opacity: 1 !important;
  }

  #shopify-section-{{ section.id }} .main-product-slider,
  #shopify-section-{{ section.id }} .product-slider-wrapper.main-product-slider {
    flex: 1 1 auto;
    width: auto;
    max-width: calc(100% - var(--mpThumbSize) - 12px);
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .main-product-slider.main-product-single-media {
    max-width: 100%;
  }

  #shopify-section-{{ section.id }} .main-product-slider .product-info-item .media-image,
  #shopify-section-{{ section.id }} .main-product-slider .product-info-item .media-box {
    max-height: var(--mpMainImageHeight);
    padding-top: 0 !important;
    height: var(--mpMainImageHeight) !important;
    background-color: var(--mpImageBg) !important;
    border-radius: {{ mp_radius }}px;
    {% if section.settings.enable_image_border != false %}
      border: 1px solid {{ mp_border }};
    {% endif %}
    overflow: hidden;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .main-product-slider .media-image img,
  #shopify-section-{{ section.id }} .main-product-slider .media-image .placeholder-svg,
  #shopify-section-{{ section.id }} .main-product-slider .media-box img {
    object-fit: contain !important;
    padding: var(--mpImagePad);
    box-sizing: border-box;
    background: transparent;
  }

  #shopify-section-{{ section.id }} .main-product-slider .flickity-button {
    width: 40px;
    height: 40px;
    background: #fff;
    border: 1px solid #111;
    box-shadow: none;
    opacity: 1;
  }

  #shopify-section-{{ section.id }} .main-product-slider .flickity-button:hover {
    background: #fff;
  }

  #shopify-section-{{ section.id }} .main-product-slider .flickity-button-icon {
    fill: #111;
  }

  #shopify-section-{{ section.id }} .main-product-content {
    padding: 0;
    width: 100%;
    max-width: none;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .main-product-content .featured-product-content {
    width: 100%;
    max-width: none;
  }

  #shopify-section-{{ section.id }} .main-product-content .product-form,
  #shopify-section-{{ section.id }} .main-product-content .main-product-form,
  #shopify-section-{{ section.id }} .main-product-content .shopify-payment-button,
  #shopify-section-{{ section.id }} .main-product-content .product-form-submit {
    width: 100%;
    max-width: 100%;
  }

  /* Stacked (grid) also compact */
  #shopify-section-{{ section.id }} .gallery-layout-stacked .main-product-slider:not(.flickity-enabled) {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
    max-width: var(--mpMediaMax);
  }

  #shopify-section-{{ section.id }} .gallery-layout-stacked .main-product-slider:not(.flickity-enabled) .product-info-item .media-image {
    max-height: none;
    height: auto !important;
    aspect-ratio: 1 / 1;
  }

  @media only screen and (max-width: 1199px) {
    #shopify-section-{{ section.id }} .main-product-grid {
      grid-template-columns: 1fr;
      grid-gap: 24px;
    }

    #shopify-section-{{ section.id }} .main-product-images,
    #shopify-section-{{ section.id }} .product-slide-box {
      max-width: 100%;
    }

    #shopify-section-{{ section.id }} .main-product-content {
      max-width: 100%;
      width: 100%;
    }
  }
  @media only screen and (max-width: 1199px) {

  #shopify-section-{{ section.id }} .main-product-images,
  #shopify-section-{{ section.id }} .product-slide-box,
  #shopify-section-{{ section.id }} .main-product-slider {
    position: relative !important;
    z-index: 1 !important;
  }

  #shopify-section-{{ section.id }} .product-slide-box,
  #shopify-section-{{ section.id }} .main-product-slider,
  #shopify-section-{{ section.id }} .main-product-slider .flickity-viewport {
    overflow: hidden !important;
  }

  #shopify-section-{{ section.id }} .main-product-slider .flickity-prev-next-button {
    position: absolute !important;
    top: 50% !important;
    bottom: auto !important;
    transform: translateY(-50%) !important;
    z-index: 3 !important;
  }
}
  @media only screen and (max-width:767px) {
    #shopify-section-{{ section.id }}.shopify-section{
      --topSpace:{{ section.settings.top_space_mobile }}px;
      --bottomSpace:{{ section.settings.bottom_space_mobile }}px;
      --mpMainImageHeight: {{ mp_main_h_mobile }}px;
      --mpThumbSize: {{ mp_thumb_mobile }}px;
      --mpImagePad: {{ mp_image_pad_mobile }}px;
    }

    #shopify-section-{{ section.id }} .product-slide-box {
      gap: 8px;
    }

    #shopify-section-{{ section.id }} .main-product-slider .flickity-button {
      width: 34px;
      height: 34px;
    }
  }
  @media only screen and (max-width: 767px) {

  /* Reduce and center the complete product image container */
  #shopify-section-{{ section.id }} .main-product-images {
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 auto !important;
    position: relative !important;
    z-index: 1 !important;
  }

  #shopify-section-{{ section.id }} .product-slide-box {
    width: 100% !important;
    max-width: 340px !important;
    margin: 0 auto !important;
    gap: 0 !important;
    position: relative !important;
    overflow: hidden !important;
    z-index: 1 !important;
  }

  /* Hide left thumbnails on mobile */
  #shopify-section-{{ section.id }} .product-slider-thumbnail {
    display: none !important;
  }

  /* Make slider fill the smaller container */
  #shopify-section-{{ section.id }} .main-product-slider,
  #shopify-section-{{ section.id }} .product-slider-wrapper.main-product-slider {
    width: 100% !important;
    max-width: 100% !important;
    flex: 0 0 100% !important;
    margin: 0 auto !important;
    position: relative !important;
    overflow: hidden !important;
    isolation: isolate !important;
    z-index: 1 !important;
  }

  /* Keep Flickity viewport clipped inside the gallery */
  #shopify-section-{{ section.id }} .main-product-slider .flickity-viewport {
    position: relative !important;
    overflow: hidden !important;
  }

  /* Main white image box */
  #shopify-section-{{ section.id }} .main-product-slider .product-info-item .media-image,
  #shopify-section-{{ section.id }} .main-product-slider .product-info-item .media-box {
    width: 100% !important;
    height: auto !important;
    aspect-ratio: 1 / 1;
    padding-top: 0 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    overflow: hidden !important;
  }

  /* Keep product image normal inside the container */
  #shopify-section-{{ section.id }} .main-product-slider .media-image img,
  #shopify-section-{{ section.id }} .main-product-slider .media-box img {
    width: 100% !important;
    height: 100% !important;
    object-fit: contain !important;
    padding: 18px !important;
    margin: 0 !important;
  }

  /* Keep arrows inside the image container */
  #shopify-section-{{ section.id }} .main-product-slider .flickity-prev-next-button {
    position: absolute !important;
    width: 36px !important;
    height: 36px !important;
    top: 50% !important;
    bottom: auto !important;
    transform: translateY(-50%) !important;
    z-index: 3 !important;
    margin: 0 !important;
  }

  #shopify-section-{{ section.id }} .main-product-slider .flickity-prev-next-button.previous {
    left: 10px !important;
    right: auto !important;
  }

  #shopify-section-{{ section.id }} .main-product-slider .flickity-prev-next-button.next {
    right: 10px !important;
    left: auto !important;
  }
}
</style>

<script>
  (function () {
    var sectionId = {{ section.id | json }};
    var root = document.getElementById('shopify-section-' + sectionId);
    if (!root) return;

    function initMainThumbs() {
      var main = root.querySelector('#main-product-' + sectionId);
      var rail = root.querySelector('.main-product-thumbs-rail');
      var stack = root.querySelector('.main-product-thumbs-stack');
      var thumbs = root.querySelectorAll('.main-product-thumbs-stack .main-product-thumb');
      var prevBtn = root.querySelector('.main-product-thumbs-arrow--prev');
      var nextBtn = root.querySelector('.main-product-thumbs-arrow--next');
      if (!main || !stack || !thumbs.length) return;

      if (stack.dataset.thumbsBound === 'true') return;
      stack.dataset.thumbsBound = 'true';

      function getFlickity() {
        if (window.jQuery) {
          try {
            var jqFlkty = jQuery(main).data('flickity');
            if (jqFlkty) return jqFlkty;
          } catch (e) {}
        }
        return main.flickityInstance || (window.Flickity && Flickity.data(main)) || null;
      }

      function setActive(index, mediaId) {
        thumbs.forEach(function (thumb, i) {
          var active = mediaId
            ? String(thumb.getAttribute('data-media-id')) === String(mediaId)
            : i === index;
          thumb.classList.toggle('is-nav-selected', active);
        });
      }

      function scrollThumbIntoView(thumb) {
        if (!thumb || !stack) return;
        var stackRect = stack.getBoundingClientRect();
        var thumbRect = thumb.getBoundingClientRect();
        if (thumbRect.top < stackRect.top) {
          stack.scrollTop -= stackRect.top - thumbRect.top + 8;
        } else if (thumbRect.bottom > stackRect.bottom) {
          stack.scrollTop += thumbRect.bottom - stackRect.bottom + 8;
        }
        updateArrowState();
      }

      function updateArrowState() {
        if (!prevBtn || !nextBtn) return;
        var maxScroll = stack.scrollHeight - stack.clientHeight;
        prevBtn.disabled = stack.scrollTop <= 2;
        nextBtn.disabled = stack.scrollTop >= maxScroll - 2 || maxScroll <= 0;
        if (rail) {
          rail.classList.toggle('is-scrollable', maxScroll > 2);
        }
      }

      function selectByThumb(thumb) {
        if (!thumb) return;
        var index = parseInt(thumb.getAttribute('data-index'), 10);
        if (isNaN(index)) {
          index = Array.prototype.indexOf.call(thumbs, thumb);
        }
        var mediaId = thumb.getAttribute('data-media-id');

        function applySelect(flkty) {
          if (!flkty) {
            setActive(index, mediaId);
            return;
          }

          var targetIndex = index;
          var cells = flkty.cells || [];
          if (mediaId && cells.length) {
            for (var i = 0; i < cells.length; i++) {
              var el = cells[i].element;
              if (!el) continue;
              var cellId = el.getAttribute('data-media-id');
              if (!cellId && el.id && el.id.indexOf('product-media-') === 0) {
                cellId = el.id.replace('product-media-', '');
              }
              if (String(cellId) === String(mediaId)) {
                targetIndex = i;
                break;
              }
            }
          }

          if (targetIndex < 0) targetIndex = 0;
          if (cells.length && targetIndex >= cells.length) {
            targetIndex = cells.length - 1;
          }

          if (window.jQuery && jQuery(main).hasClass('flickity-enabled')) {
            jQuery(main).flickity('select', targetIndex, false, true);
          } else if (typeof flkty.select === 'function') {
            flkty.select(targetIndex, false, true);
          }

          setActive(targetIndex, mediaId);
        }

        var flkty = getFlickity();
        if (flkty) {
          applySelect(flkty);
        } else if (window.jQuery) {
          // Flickity may still be initializing — wait briefly then select.
          var tries = 0;
          (function retry() {
            flkty = getFlickity();
            if (flkty || tries > 20) {
              applySelect(flkty);
              return;
            }
            tries += 1;
            setTimeout(retry, 50);
          })();
        } else {
          setActive(index, mediaId);
        }

        scrollThumbIntoView(thumb);
      }

      function syncFromSlider() {
        var flkty = getFlickity();
        if (!flkty) return;
        var index = typeof flkty.selectedIndex === 'number' ? flkty.selectedIndex : 0;
        var mediaId = flkty.selectedElement
          ? flkty.selectedElement.getAttribute('data-media-id')
          : null;
        if (!mediaId && thumbs[index]) {
          mediaId = thumbs[index].getAttribute('data-media-id');
        }
        setActive(index, mediaId);
        var activeThumb =
          (mediaId && stack.querySelector('.main-product-thumb[data-media-id="' + mediaId + '"]')) ||
          thumbs[index];
        scrollThumbIntoView(activeThumb);
      }

      stack.addEventListener('click', function (event) {
        var thumb = event.target.closest('.main-product-thumb');
        if (!thumb || !stack.contains(thumb)) return;
        event.preventDefault();
        selectByThumb(thumb);
      });

      stack.addEventListener('keydown', function (event) {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        var thumb = event.target.closest('.main-product-thumb');
        if (!thumb || !stack.contains(thumb)) return;
        event.preventDefault();
        selectByThumb(thumb);
      });

      if (prevBtn) {
        prevBtn.addEventListener('click', function () {
          stack.scrollBy({ top: -(thumbs[0].offsetHeight + 8) * 2, behavior: 'smooth' });
        });
      }
      if (nextBtn) {
        nextBtn.addEventListener('click', function () {
          stack.scrollBy({ top: (thumbs[0].offsetHeight + 8) * 2, behavior: 'smooth' });
        });
      }
      stack.addEventListener('scroll', updateArrowState, { passive: true });

      if (window.jQuery) {
        jQuery(main).on('ready.flickity change.flickity select.flickity settle.flickity', syncFromSlider);
      }

      var tries = 0;
      (function waitForFlickity() {
        if (getFlickity() || tries > 40) {
          syncFromSlider();
          updateArrowState();
          return;
        }
        tries += 1;
        setTimeout(waitForFlickity, 100);
      })();

      updateArrowState();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMainThumbs);
    } else {
      initMainThumbs();
    }

    document.addEventListener('shopify:section:load', function (event) {
      if (event.detail && String(event.detail.sectionId) === String(sectionId)) {
        var stack = root.querySelector('.main-product-thumbs-stack');
        if (stack) delete stack.dataset.thumbsBound;
        initMainThumbs();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "t:sections.main_product.name",
  "class": "section-main-product",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "container_type",
      "label": "t:sections.main_product.settings.container_type.label",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "t:sections.main_product.settings.container_type.options.container.label"
        },
        {
          "value": "fullwidth",
          "label": "t:sections.main_product.settings.container_type.options.fullwidth.label"
        }
      ]
    },
    {
