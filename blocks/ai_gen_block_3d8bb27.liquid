{% doc %}
  @prompt
    Create a new Paris-theme section that displays 2 or 3 individually selected products as a carousel of full Featured product panels, not a featured collection banner or a grid of product cards. Match the existing 'Trending Item' Featured product section appearance in the screenshot: each carousel slide contains one product with its image gallery and vertical thumbnails on the left, and its title, price, quantity selector, Add to cart and Buy it now controls on the right. Provide prominent outer previous/next controls to switch between the selected products, separate from the image gallery's own arrows. Each slide must show and purchase its own selected product correctly. Keep a responsive mobile layout. Do not modify or remove the existing Trending section., Can you make the pictures scrollable - on the mobile I dont want arrows. And the thumbnails can be under the main image , the thumbnails need to under the main image and smaller in size and make the images scrollable , Make 4 selected products 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}.ai-pc-{{ai_gen_id}}{display:block;width:{{block.settings.desktop_width_percent}}%;max-width:100%;background:{{block.settings.background_color}};color:{{block.settings.text_color}}}.ai-pc-{{ai_gen_id}}__track{display:flex;overflow:hidden}.ai-pc-{{ai_gen_id}}__slide{min-width:100%;display:grid;grid-template-columns:1fr 1fr;gap:40px;padding:20px 60px;box-sizing:border-box}.ai-pc-{{ai_gen_id}}__main{aspect-ratio:1;overflow:hidden;background:{{block.settings.image_background}}}.ai-pc-{{ai_gen_id}}__images{height:100%;display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none}.ai-pc-{{ai_gen_id}}__images img{min-width:100%;height:100%;object-fit:contain;scroll-snap-align:start}.ai-pc-{{ai_gen_id}}__thumbs{display:flex;gap:6px;overflow:auto;margin-top:8px}.ai-pc-{{ai_gen_id}}__thumb{flex:0 0 48px;width:48px;height:48px;padding:2px;background:none;border:1px solid {{block.settings.border_color}}}.ai-pc-{{ai_gen_id}}__thumb img{width:100%;height:100%;object-fit:cover}.ai-pc-{{ai_gen_id}}__details{align-self:center}.ai-pc-{{ai_gen_id}}__title{color:{{block.settings.heading_color}}}.ai-pc-{{ai_gen_id}}__button,.ai-pc-{{ai_gen_id}}__nav{padding:12px 18px;border:1px solid {{block.settings.button_color}};background:{{block.settings.button_color}};color:{{block.settings.button_text_color}};cursor:pointer}.ai-pc-{{ai_gen_id}}__nav{position:absolute;top:50%;z-index:2;border-radius:50%;font-size:22px}.ai-pc-{{ai_gen_id}}__viewport{position:relative}.ai-pc-{{ai_gen_id}}__prev{left:8px}.ai-pc-{{ai_gen_id}}__next{right:8px}@media(max-width:749px){.ai-pc-{{ai_gen_id}}__slide{grid-template-columns:1fr;padding:12px 42px;gap:20px}.ai-pc-{{ai_gen_id}}__thumb{flex-basis:42px;width:42px;height:42px}}{% endstyle %}
<featured-product-carousel-{{ai_gen_id}} class="ai-pc-{{ai_gen_id}}" {{block.shopify_attributes}}><div class="ai-pc-{{ai_gen_id}}__viewport"><button class="ai-pc-{{ai_gen_id}}__nav ai-pc-{{ai_gen_id}}__prev" type="button" aria-label="Previous">‹</button><div class="ai-pc-{{ai_gen_id}}__track">{% for product in block.settings.products %}<article class="ai-pc-{{ai_gen_id}}__slide"><div><div class="ai-pc-{{ai_gen_id}}__main"><div class="ai-pc-{{ai_gen_id}}__images">{% for image in product.images limit:5 %}<img src="{{image|image_url:width:1200}}" alt="{{image.alt|default:product.title|escape}}" loading="lazy">{% endfor %}</div></div><div class="ai-pc-{{ai_gen_id}}__thumbs">{% for image in product.images limit:5 %}<button class="ai-pc-{{ai_gen_id}}__thumb" type="button" data-index="{{forloop.index0}}"><img src="{{image|image_url:width:100}}" alt="{{image.alt|default:product.title|escape}}"></button>{% endfor %}</div></div><div class="ai-pc-{{ai_gen_id}}__details"><h2 class="ai-pc-{{ai_gen_id}}__title">{{product.title|escape}}</h2><p>{{product.price|money}}</p><form data-form><input type="hidden" name="id" value="{{product.selected_or_first_available_variant.id}}"><input type="number" name="quantity" value="1" min="1" aria-label="Quantity"><button class="ai-pc-{{ai_gen_id}}__button" type="submit">{{block.settings.add_label}}</button><button class="ai-pc-{{ai_gen_id}}__button" type="button" data-buy>{{block.settings.buy_label}}</button><p data-status aria-live="polite"></p></form></div></article>{% endfor %}</div><button class="ai-pc-{{ai_gen_id}}__nav ai-pc-{{ai_gen_id}}__next" type="button" aria-label="Next">›</button></div></featured-product-carousel-{{ai_gen_id}}>
<script>(function(){class C{{ai_gen_id}} extends HTMLElement{connectedCallback(){this.t=this.querySelector('.ai-pc-{{ai_gen_id}}__track');this.i=0;this.querySelector('.ai-pc-{{ai_gen_id}}__prev').onclick=()=>this.go(-1);this.querySelector('.ai-pc-{{ai_gen_id}}__next').onclick=()=>this.go(1);this.querySelectorAll('.ai-pc-{{ai_gen_id}}__slide').forEach(s=>{let im=s.querySelector('.ai-pc-{{ai_gen_id}}__images');s.querySelectorAll('[data-index]').forEach(b=>b.onclick=()=>im.children[+b.dataset.index].scrollIntoView({behavior:'smooth',inline:'start'}));let f=s.querySelector('[data-form]');f.onsubmit=e=>{e.preventDefault();this.add(f,false)};f.querySelector('[data-buy]').onclick=()=>this.add(f,true)})}go(n){let c=this.t.children.length;this.i=(this.i+n+c)%c;this.t.style.transform='translateX(-'+this.i*100+'%)'}add(f,b){fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({items:[{id:+f.id.value,quantity:+f.quantity.value}]})}).then(()=>{if(b)location.href='/checkout';else f.querySelector('[data-status]').textContent='Added to cart'})}}customElements.define('featured-product-carousel-{{ai_gen_id}}',C{{ai_gen_id}})})();</script>
{% schema %}{"name":"Featured product carousel","settings":[{"type":"product_list","id":"products","label":"Products","limit":4},{"type":"text","id":"add_label","label":"Add button","default":"Add to cart"},{"type":"text","id":"buy_label","label":"Buy button","default":"Buy it now"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"color","id":"background_color","label":"Background","default":"#f4f1ff"},{"type":"color","id":"image_background","label":"Image background","default":"#ffffff"},{"type":"color","id":"heading_color","label":"Headings","default":"#010133"},{"type":"color","id":"text_color","label":"Text","default":"#000041"},{"type":"color","id":"button_color","label":"Button","default":"#000000"},{"type":"color","id":"button_text_color","label":"Button text","default":"#f4f1ff"},{"type":"color","id":"border_color","label":"Borders","default":"#d6d2e5"}],"presets":[{"name":"Featured product carousel"}],"tag":null,"class":"featured-product-carousel-block"}{% endschema %}