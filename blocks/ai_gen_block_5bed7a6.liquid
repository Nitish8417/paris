{% doc %}
  Featured products spotlight: one product at a time, with its own gallery and purchase form.
  Products are chosen with the product_1 … product_6 settings.
{% enddoc %}
{%- liquid
  assign ai_gen_id = block.id | replace: '_', '' | downcase
  assign slide_count = 0
  for i in (1..6)
    assign key = 'product_' | append: i
    if block.settings[key] != blank
      assign slide_count = slide_count | plus: 1
    endif
  endfor
-%}
{% style %}
  .tfp-{{ ai_gen_id }} {
    --tfpImageWidth: {{ block.settings.image_width }}%;
    --tfpGap: {{ block.settings.gap }}px;
    --tfpRadius: {{ block.settings.radius }}px;
    --tfpAccent: {{ block.settings.arrow_bg }};
    --tfpAccentText: {{ block.settings.arrow_text }};
    --tfpMaxWidth: {{ block.settings.width }}px;
  }
{% endstyle %}

{%- if slide_count > 0 -%}
  <techty-featured-products class="tfp tfp-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
    <div class="{{ settings.layout_width }}">
      <div class="tfp__header">
        {%- if block.settings.heading != blank -%}
          <h2 class="tfp__heading h3 h4_mobile">{{ block.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if slide_count > 1 -%}
          <div class="tfp__nav">
            <span class="tfp__count" aria-live="polite"><span data-tfp-current>1</span> / {{ slide_count }}</span>
            <button type="button" class="tfp__arrow" data-tfp-prev aria-label="Previous product">
              <svg viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M11 6.2H1.4M6 1L1 6.2L6 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <button type="button" class="tfp__arrow" data-tfp-next aria-label="Next product">
              <svg viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M1 5.8H10.6M6 11L11 5.8L6 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
        {%- endif -%}
      </div>

      <div class="tfp__stage">
        {%- assign slide_index = 0 -%}
        {%- for i in (1..6) -%}
          {%- assign key = 'product_' | append: i -%}
          {%- assign p = block.settings[key] -%}
          {%- if p == blank -%}{%- continue -%}{%- endif -%}
          {%- assign slide_index = slide_index | plus: 1 -%}
          {%- assign variant = p.selected_or_first_available_variant -%}
          {%- assign form_id = 'tfp-form-' | append: ai_gen_id | append: '-' | append: slide_index -%}

          <article
            class="tfp__slide{% if slide_index == 1 %} is-active{% endif %}"
            data-tfp-slide
            {% unless slide_index == 1 %}hidden{% endunless %}
          >
            <div class="tfp__gallery">
              <div class="tfp__media">
                <div class="tfp__images" data-tfp-images>
                  {%- for image in p.images -%}
                    {%- liquid
                      if slide_index == 1 and forloop.first
                        assign loading = 'eager'
                      else
                        assign loading = 'lazy'
                      endif
                    -%}
                    <div class="tfp__image">
                      {{ image | image_url: width: 1200 | image_tag: loading: loading, widths: '400, 600, 800, 1000, 1200', sizes: '(min-width: 990px) 50vw, 100vw', alt: p.title }}
                    </div>
                  {%- else -%}
                    <div class="tfp__image">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
                  {%- endfor -%}
                </div>
                {%- if p.images.size > 1 -%}
                  <button type="button" class="tfp__image-arrow tfp__image-arrow--prev" data-tfp-image-prev aria-label="Previous image">
                    <svg viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M8 1L3 6l5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </button>
                  <button type="button" class="tfp__image-arrow tfp__image-arrow--next" data-tfp-image-next aria-label="Next image">
                    <svg viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M4 1l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </button>
                  <span class="tfp__image-count"><span data-tfp-image-current>1</span> / {{ p.images.size }}</span>
                {%- endif -%}
              </div>
              {%- if p.images.size > 1 -%}
                <div class="tfp__thumbs">
                  {%- for image in p.images -%}
                    <button
                      type="button"
                      class="tfp__thumb{% if forloop.first %} is-active{% endif %}"
                      data-tfp-thumb="{{ forloop.index0 }}"
                      aria-label="Show image {{ forloop.index }}"
                    >
                      {{ image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
                    </button>
                  {%- endfor -%}
                </div>
              {%- endif -%}
            </div>

            <div class="tfp__info">
              {%- if p.vendor != blank -%}
                <p class="tfp__vendor">{{ p.vendor | escape }}</p>
              {%- endif -%}
              <h3 class="tfp__title h3 h4_mobile">
                <a href="{{ p.url }}">{{ p.title | escape }}</a>
              </h3>

              <div class="tfp__price" data-tfp-price>
                <span class="tfp__price-now" data-tfp-price-now>{{ variant.price | money }}</span>
                <span class="tfp__price-was" data-tfp-price-was{% unless variant.compare_at_price > variant.price %} hidden{% endunless %}>
                  {{- variant.compare_at_price | money -}}
                </span>
                {%- liquid
                  assign save_percent = 0
                  if variant.compare_at_price > variant.price
                    assign save_percent = variant.compare_at_price | minus: variant.price | times: 100 | divided_by: variant.compare_at_price
                  endif
                -%}
                <span class="tfp__save" data-tfp-save{% if save_percent == 0 %} hidden{% endif %}>Save {{ save_percent }}%</span>
              </div>

              {%- assign excerpt = p.description | strip_html | strip | truncatewords: 26 -%}
              {%- if excerpt != blank -%}
                <p class="tfp__excerpt">{{ excerpt }}</p>
              {%- endif -%}

              {%- form 'product', p, id: form_id, class: 'tfp__form', novalidate: 'novalidate' -%}
                <input type="hidden" name="id" value="{{ variant.id }}" data-tfp-variant-id>

                {%- unless p.has_only_default_variant -%}
                  <label class="tfp__label" for="{{ form_id }}-variant">{{ p.options | join: ' / ' }}</label>
                  <div class="tfp__select-wrap">
                    <select class="tfp__select" id="{{ form_id }}-variant" data-tfp-variant>
                      {%- for v in p.variants -%}
                        <option
                          value="{{ v.id }}"
                          data-price="{{ v.price | money | escape }}"
                          data-compare="{% if v.compare_at_price > v.price %}{{ v.compare_at_price | money | escape }}{% endif %}"
                          data-save="{% if v.compare_at_price > v.price %}{{ v.compare_at_price | minus: v.price | times: 100 | divided_by: v.compare_at_price }}{% endif %}"
                          data-available="{{ v.available }}"
                          {% if v.id == variant.id %}selected{% endif %}
                          {% unless v.available %}disabled{% endunless %}
                        >
                          {{- v.title | escape }}{% unless v.available %} — Sold out{% endunless -%}
                        </option>
                      {%- endfor -%}
                    </select>
                  </div>
                {%- endunless -%}

                <div class="tfp__buy-row">
                  <div class="tfp__qty">
                    <button type="button" data-tfp-minus aria-label="Decrease quantity">−</button>
                    <input type="number" name="quantity" value="1" min="1" aria-label="Quantity">
                    <button type="button" data-tfp-plus aria-label="Increase quantity">+</button>
                  </div>
                  <button
                    type="submit"
                    name="add"
                    class="tfp__add"
                    data-tfp-add
                    {% unless variant.available %}disabled{% endunless %}
                  >
                    {%- if variant.available -%}Add to cart{%- else -%}Sold out{%- endif -%}
                  </button>
                </div>
                <button
                  type="button"
                  class="tfp__buy"
                  data-tfp-buy
                  {% unless variant.available %}disabled{% endunless %}
                >
                  Buy it now
                </button>
              {%- endform -%}

              <a class="tfp__details" href="{{ p.url }}">
                View full details
                <svg viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M1 5.8H10.6M6 11L11 5.8L6 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </div>
          </article>
        {%- endfor -%}
      </div>

      {%- if slide_count > 1 -%}
        <div class="tfp__dots" role="tablist" aria-label="Featured products">
          {%- for n in (1..slide_count) -%}
            <button
              type="button"
              class="tfp__dot{% if forloop.first %} is-active{% endif %}"
              data-tfp-dot="{{ forloop.index0 }}"
              aria-label="Show product {{ n }}"
            ></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </techty-featured-products>
{%- endif -%}

{% stylesheet %}
  .tfp {
    display: block;
    padding: 64px 0;
  }

  .tfp__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 20px;
  }

  .tfp__heading {
    margin: 0;
    padding: 0;
    letter-spacing: -0.01em;
  }

  .tfp__nav {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
  }

  .tfp__count {
    margin-right: 6px;
    font-size: var(--textSmall);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    opacity: 0.6;
  }

  .tfp__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid color-mix(in srgb, var(--bodyTextColor) 15%, transparent);
    border-radius: 50%;
    background: #fff;
    color: var(--bodyTextColor);
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .tfp__arrow:hover {
    background: var(--bodyTextColor);
    color: #fff;
  }

  .tfp__arrow svg {
    width: 14px;
    height: 14px;
  }

  .tfp__stage {
    max-width: var(--tfpMaxWidth);
  }

  .tfp__slide {
    display: grid;
    grid-template-columns: var(--tfpImageWidth) minmax(0, 1fr);
    gap: var(--tfpGap);
    align-items: center;
    padding: 28px;
    border: 1px solid color-mix(in srgb, var(--bodyTextColor) 8%, transparent);
    border-radius: var(--tfpRadius);
    background: #fff;
  }

  .tfp__slide[hidden] {
    display: none;
  }

  .tfp__slide.is-active {
    animation: tfpFade 0.4s ease;
  }

  @keyframes tfpFade {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: none; }
  }

  .tfp__gallery {
    min-width: 0;
  }

  .tfp__media {
    position: relative;
    border-radius: calc(var(--tfpRadius) * 0.7);
    background: color-mix(in srgb, var(--bodyTextColor) 3%, #fff);
    overflow: hidden;
  }

  .tfp__images {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    aspect-ratio: 4 / 3;
  }

  .tfp__images::-webkit-scrollbar {
    display: none;
  }

  .tfp__image {
    flex: 0 0 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    scroll-snap-align: start;
  }

  .tfp__image img,
  .tfp__image .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .tfp__image-arrow {
    position: absolute;
    top: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.92);
    color: var(--bodyTextColor);
    box-shadow: 0 4px 14px rgba(17, 17, 17, 0.12);
    transform: translateY(-50%);
    opacity: 0;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .tfp__image-arrow svg {
    width: 12px;
    height: 12px;
  }

  .tfp__media:hover .tfp__image-arrow,
  .tfp__image-arrow:focus-visible {
    opacity: 1;
  }

  .tfp__image-arrow--prev { left: 12px; }
  .tfp__image-arrow--next { right: 12px; }

  .tfp__image-count {
    position: absolute;
    right: 12px;
    bottom: 12px;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(17, 17, 17, 0.7);
    color: #fff;
    font-size: 11px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .tfp__thumbs {
    display: flex;
    gap: 8px;
    margin-top: 12px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .tfp__thumbs::-webkit-scrollbar {
    display: none;
  }

  .tfp__thumb {
    flex: 0 0 60px;
    height: 60px;
    padding: 4px;
    border: 1px solid color-mix(in srgb, var(--bodyTextColor) 10%, transparent);
    border-radius: 10px;
    background: #fff;
    cursor: pointer;
    opacity: 0.65;
    transition: opacity 0.2s ease, border-color 0.2s ease;
  }

  .tfp__thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .tfp__thumb:hover,
  .tfp__thumb.is-active {
    opacity: 1;
    border-color: var(--bodyTextColor);
  }

  .tfp__info {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .tfp__vendor {
    margin: 0 0 8px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.55;
  }

  .tfp__title {
    margin: 0;
    padding: 0;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .tfp__title a {
    color: inherit;
    text-decoration: none;
  }

  .tfp__price {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    margin-top: 14px;
  }

  .tfp__price-now {
    font-size: 24px;
    font-weight: 700;
  }

  .tfp__price-was {
    font-size: 15px;
    text-decoration: line-through;
    opacity: 0.5;
  }

  .tfp__save {
    padding: 4px 10px;
    border-radius: 999px;
    background: #fdecea;
    color: #c62828;
    font-size: 12px;
    font-weight: 700;
  }

  .tfp__price [hidden] {
    display: none;
  }

  .tfp__excerpt {
    margin: 16px 0 0;
    font-size: 15px;
    line-height: 1.65;
    opacity: 0.75;
  }

  .tfp__form {
    display: grid;
    gap: 12px;
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid color-mix(in srgb, var(--bodyTextColor) 8%, transparent);
  }

  .tfp__label {
    font-size: 13px;
    font-weight: 600;
  }

  .tfp__select-wrap {
    position: relative;
    margin-top: -4px;
  }

  .tfp__select-wrap::after {
    content: "";
    position: absolute;
    top: 50%;
    right: 16px;
    width: 8px;
    height: 8px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-70%) rotate(45deg);
    pointer-events: none;
  }

  .tfp__select {
    width: 100%;
    height: 48px;
    padding: 0 40px 0 16px;
    border: 1px solid color-mix(in srgb, var(--bodyTextColor) 18%, transparent);
    border-radius: 12px;
    background: #fff;
    color: var(--bodyTextColor);
    font: inherit;
    font-size: 15px;
    appearance: none;
    cursor: pointer;
  }

  .tfp__buy-row {
    display: grid;
    grid-template-columns: 132px minmax(0, 1fr);
    gap: 12px;
  }

  .tfp__qty {
    display: flex;
    align-items: center;
    height: 50px;
    border: 1px solid color-mix(in srgb, var(--bodyTextColor) 18%, transparent);
    border-radius: 999px;
    background: #fff;
    overflow: hidden;
  }

  .tfp__qty button {
    flex: 0 0 40px;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: var(--bodyTextColor);
    font-size: 18px;
    cursor: pointer;
  }

  .tfp__qty input {
    flex: 1 1 auto;
    min-width: 0;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: var(--bodyTextColor);
    font: inherit;
    font-weight: 600;
    text-align: center;
    -moz-appearance: textfield;
  }

  .tfp__qty input::-webkit-outer-spin-button,
  .tfp__qty input::-webkit-inner-spin-button {
    margin: 0;
    -webkit-appearance: none;
  }

  .tfp__add,
  .tfp__buy {
    height: 50px;
    padding: 0 20px;
    border-radius: 999px;
    font: inherit;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease, opacity 0.2s ease;
  }

  .tfp__add {
    border: 1px solid var(--bodyTextColor);
    background: #fff;
    color: var(--bodyTextColor);
  }

  .tfp__add:hover:not(:disabled) {
    background: var(--bodyTextColor);
    color: #fff;
  }

  .tfp__buy {
    width: 100%;
    border: 1px solid var(--tfpAccent);
    background: var(--tfpAccent);
    color: var(--tfpAccentText);
  }

  .tfp__buy:hover:not(:disabled) {
    opacity: 0.9;
  }

  .tfp__add:disabled,
  .tfp__buy:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .tfp__add.is-busy,
  .tfp__buy.is-busy {
    opacity: 0.6;
    pointer-events: none;
  }

  .tfp__details {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    align-self: flex-start;
    margin-top: 18px;
    padding-bottom: 2px;
    border-bottom: 1px solid currentColor;
    color: var(--bodyTextColor);
    font-size: var(--textSmall);
    font-weight: 600;
    text-decoration: none;
  }

  .tfp__details svg {
    width: 12px;
    height: 12px;
    transition: transform 0.2s ease;
  }

  .tfp__details:hover svg {
    transform: translateX(3px);
  }

  .tfp__dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 20px;
  }

  .tfp__dot {
    width: 8px;
    height: 8px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: color-mix(in srgb, var(--bodyTextColor) 20%, transparent);
    cursor: pointer;
    transition: width 0.3s ease, background-color 0.3s ease;
  }

  .tfp__dot.is-active {
    width: 24px;
    background: var(--bodyTextColor);
  }

  @media only screen and (max-width: 989px) {
    .tfp__slide {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 28px;
      padding: 20px;
    }
  }

  @media only screen and (max-width: 767px) {
    .tfp {
      padding: 40px 0;
    }

    .tfp__header {
      margin-bottom: 14px;
    }

    .tfp__count {
      display: none;
    }

    .tfp__arrow {
      width: 36px;
      height: 36px;
    }

    .tfp__slide {
      grid-template-columns: 1fr;
      gap: 20px;
      padding: 14px 14px 20px;
    }

    .tfp__images {
      aspect-ratio: 1 / 1;
    }

    .tfp__image {
      padding: 16px;
    }

    .tfp__image-arrow {
      display: none;
    }

    .tfp__thumb {
      flex-basis: 52px;
      height: 52px;
    }

    .tfp__price-now {
      font-size: 20px;
    }

    .tfp__excerpt {
      font-size: 14px;
    }

    .tfp__form {
      margin-top: 18px;
      padding-top: 18px;
    }

    .tfp__buy-row {
      grid-template-columns: 116px minmax(0, 1fr);
      gap: 10px;
    }

    .tfp__qty,
    .tfp__add,
    .tfp__buy {
      height: 46px;
    }

    .tfp__add,
    .tfp__buy {
      font-size: 14px;
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('techty-featured-products')) {
    class TechtyFeaturedProducts extends HTMLElement {
      connectedCallback() {
        this.slides = [...this.querySelectorAll('[data-tfp-slide]')];
        this.dots = [...this.querySelectorAll('[data-tfp-dot]')];
        this.current = this.querySelector('[data-tfp-current]');
        this.index = 0;

        this.querySelector('[data-tfp-prev]')?.addEventListener('click', () => this.show(this.index - 1));
        this.querySelector('[data-tfp-next]')?.addEventListener('click', () => this.show(this.index + 1));
        this.dots.forEach((dot, i) => dot.addEventListener('click', () => this.show(i)));
        this.slides.forEach((slide) => this.bindSlide(slide));
      }

      show(index) {
        if (!this.slides.length) return;
        const next = (index + this.slides.length) % this.slides.length;
        this.slides[this.index].hidden = true;
        this.slides[this.index].classList.remove('is-active');
        this.slides[next].hidden = false;
        this.slides[next].classList.add('is-active');
        this.dots.forEach((dot, i) => dot.classList.toggle('is-active', i === next));
        if (this.current) this.current.textContent = next + 1;
        this.index = next;
      }

      bindSlide(slide) {
        const images = slide.querySelector('[data-tfp-images]');
        const thumbs = [...slide.querySelectorAll('[data-tfp-thumb]')];
        const imageCount = slide.querySelector('[data-tfp-image-current]');

        const goToImage = (i) => images.scrollTo({ left: images.clientWidth * i });
        slide.querySelector('[data-tfp-image-prev]')?.addEventListener('click', () => images.scrollBy({ left: -images.clientWidth }));
        slide.querySelector('[data-tfp-image-next]')?.addEventListener('click', () => images.scrollBy({ left: images.clientWidth }));
        thumbs.forEach((thumb, i) => thumb.addEventListener('click', () => goToImage(i)));

        images?.addEventListener('scroll', () => {
          const i = Math.round(images.scrollLeft / Math.max(images.clientWidth, 1));
          thumbs.forEach((thumb, j) => thumb.classList.toggle('is-active', i === j));
          if (imageCount) imageCount.textContent = i + 1;
        }, { passive: true });

        const qty = slide.querySelector('input[name="quantity"]');
        slide.querySelector('[data-tfp-minus]')?.addEventListener('click', () => {
          qty.value = Math.max(1, (parseInt(qty.value, 10) || 1) - 1);
        });
        slide.querySelector('[data-tfp-plus]')?.addEventListener('click', () => {
          qty.value = (parseInt(qty.value, 10) || 1) + 1;
        });

        const select = slide.querySelector('[data-tfp-variant]');
        const idInput = slide.querySelector('[data-tfp-variant-id]');
        const add = slide.querySelector('[data-tfp-add]');
        const buy = slide.querySelector('[data-tfp-buy]');
        select?.addEventListener('change', () => {
          const option = select.selectedOptions[0];
          idInput.value = option.value;
          slide.querySelector('[data-tfp-price-now]').textContent = option.dataset.price;
          const was = slide.querySelector('[data-tfp-price-was]');
          const save = slide.querySelector('[data-tfp-save]');
          was.textContent = option.dataset.compare;
          was.hidden = !option.dataset.compare;
          save.textContent = option.dataset.save ? `Save ${option.dataset.save}%` : '';
          save.hidden = !option.dataset.save;
          const available = option.dataset.available === 'true';
          add.disabled = !available;
          buy.disabled = !available;
          add.textContent = available ? 'Add to cart' : 'Sold out';
        });

        buy?.addEventListener('click', () => {
          const form = buy.closest('form');
          buy.classList.add('is-busy');
          fetch(`${window.Shopify?.routes?.root || '/'}cart/add.js`, {
            method: 'POST',
            headers: { Accept: 'application/json' },
            body: new FormData(form),
          })
            .then((response) => {
              if (!response.ok) throw new Error('add failed');
              window.location.href = `${window.Shopify?.routes?.root || '/'}checkout`;
            })
            .catch(() => buy.classList.remove('is-busy'));
        });
      }
    }

    customElements.define('techty-featured-products', TechtyFeaturedProducts);
  }
{% endjavascript %}

