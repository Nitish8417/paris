<script id="tt-hero">
(function () {
  'use strict';

  var CONFIG = {
    // Banners whose link contains any of these get a copied Shop Now button
    forceButton: ['/collections/promate']
  };

  var COPY = [
    'backgroundColor','color','fontFamily','fontSize','fontWeight','fontStyle',
    'letterSpacing','lineHeight','textTransform','textAlign','whiteSpace',
    'paddingTop','paddingRight','paddingBottom','paddingLeft',
    'borderTopWidth','borderRightWidth','borderBottomWidth','borderLeftWidth',
    'borderTopStyle','borderRightStyle','borderBottomStyle','borderLeftStyle',
    'borderTopColor','borderRightColor','borderBottomColor','borderLeftColor',
    'borderTopLeftRadius','borderTopRightRadius','borderBottomLeftRadius','borderBottomRightRadius',
    'boxShadow','width','height','display','alignItems','justifyContent'
  ];

  function heroRoot() {
    return document.querySelector('.section-hero-banner')
        || document.querySelector('#MainContent > .shopify-section');
  }

  // The slide = nearest ancestor of the link that holds an image and is banner-wide
  function slideOf(link, root) {
    var wide = root.getBoundingClientRect().width * 0.6;
    var el = link.parentElement;
    while (el && el !== root) {
      if (el.querySelector('img') && el.getBoundingClientRect().width >= wide) return el;
      el = el.parentElement;
    }
    return null;
  }

  function visibleIn(el, slide) {
    var node = el;
    while (node && node !== slide) {
      var cs = getComputedStyle(node);
      if (cs.display === 'none' || cs.visibility === 'hidden' || parseFloat(cs.opacity) < 0.1) return false;
      node = node.parentElement;
    }
    var r = el.getBoundingClientRect(), s = slide.getBoundingClientRect();
    if (r.width < 10 || r.height < 10) return false;
    return !(r.right < s.left || r.left > s.right || r.bottom < s.top || r.top > s.bottom);
  }

  function isForced(href) {
    return CONFIG.forceButton.some(function (p) { return href.indexOf(p) > -1; });
  }

  function heroLinks(root) {
    return [].filter.call(root.querySelectorAll('a[href]'), function (a) {
      var h = a.getAttribute('href') || '';
      return h && h !== '#' && !a.classList.contains('tt-hero-copy');
    });
  }

  function findDonor(root) {
    var links = heroLinks(root);
    for (var i = 0; i < links.length; i++) {
      var a = links[i];
      if (isForced(a.href)) continue;
      if (!/shop/i.test(a.textContent || '')) continue;
      var s = slideOf(a, root);
      if (s && visibleIn(a, s)) return { link: a, slide: s };
    }
    return null;
  }

  function placeCopy(slide, href, donor) {
    var btn = slide.querySelector('.tt-hero-copy');

    if (!btn) {
      btn = document.createElement('a');
      btn.className = 'tt-hero-copy';
      slide.appendChild(btn);
    }

    btn.href = href;
    btn.style.position = 'absolute';
    btn.style.zIndex = '6';
    btn.style.textDecoration = 'none';
    btn.style.boxSizing = 'border-box';

    if (donor) {
      btn.className = donor.link.className + ' tt-hero-copy';
      btn.innerHTML = donor.link.innerHTML;

      var cs = getComputedStyle(donor.link);
      COPY.forEach(function (p) { btn.style[p] = cs[p]; });
      if (btn.style.display === 'inline') btn.style.display = 'inline-block';

      var r = donor.link.getBoundingClientRect();
      var s = donor.slide.getBoundingClientRect();
      btn.style.left = ((r.left - s.left) / s.width * 100) + '%';
      btn.style.top  = ((r.top  - s.top)  / s.height * 100) + '%';
      btn.style.bottom = 'auto';
    } else {
      btn.className = 'tt-hero-copy tt-hero-fallback';
      btn.textContent = 'Shop Now';
    }
  }

  function fix() {
    var root = heroRoot();
    if (!root) return;

    var donor = findDonor(root);

    heroLinks(root).forEach(function (link) {
      var slide = slideOf(link, root);
      if (!slide) return;

      slide.classList.add('tt-hero-slide');
      if (getComputedStyle(slide).position === 'static') slide.style.position = 'relative';

      if (!isForced(link.href)) return;

      link.classList.add('tt-hero-hide');
      placeCopy(slide, link.href, donor);
    });
  }

  /* ---------- click anywhere on a banner ---------- */

  var startX = 0, startY = 0;

  document.addEventListener('pointerdown', function (e) {
    startX = e.clientX;
    startY = e.clientY;
  }, true);

  document.addEventListener('click', function (e) {
    var slide = e.target.closest('.tt-hero-slide');
    if (!slide) return;
    if (e.target.closest('a, button')) return;
    if (Math.abs(e.clientX - startX) > 10 || Math.abs(e.clientY - startY) > 10) return;

    var link = slide.querySelector('.tt-hero-copy') ||
               slide.querySelector('a[href]:not([href="#"]):not(.tt-hero-hide)');
    if (link) window.location.href = link.href;
  });

  /* ---------- run once the slider has settled, and on resize ---------- */

  function run() {
    setTimeout(fix, 700);
    setTimeout(fix, 2200);
  }

  if (document.readyState === 'complete') run();
  else window.addEventListener('load', run);

  var rt;
  window.addEventListener('resize', function () {
    clearTimeout(rt);
    rt = setTimeout(fix, 250);
  });
})();
</script>
