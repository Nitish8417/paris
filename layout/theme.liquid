<script id="tt-cmp">
(function () {
  'use strict';

  var KEY = 'tt_compare';
  var MAX = 3;
  var ROOT = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
  var BASE = ROOT.replace(/\/$/, '');

  function read() {
    try { return JSON.parse(sessionStorage.getItem(KEY)) || []; }
    catch (e) { return []; }
  }
  function write(l) {
    try { sessionStorage.setItem(KEY, JSON.stringify(l)); } catch (e) {}
  }

  function money(c) { return (Number(c) / 100).toFixed(3) + ' KD'; }
  function thumb(u, w) { return u ? u.replace(/(\.[a-z]{3,4})(\?|$)/i, '_' + w + 'x$1$2') : ''; }

  /* ---------- bar ---------- */

  var bar, modal;

  function buildBar() {
    bar = document.createElement('div');
    bar.className = 'tt-cmp-bar';
    bar.innerHTML =
      '<div class="tt-cmp-thumbs"></div>'
      + '<button type="button" class="tt-cmp-go">Compare</button>'
      + '<button type="button" class="tt-cmp-clear">Clear</button>';
    document.body.appendChild(bar);

    bar.querySelector('.tt-cmp-go').addEventListener('click', openModal);
    bar.querySelector('.tt-cmp-clear').addEventListener('click', function () {
      write([]);
      document.querySelectorAll('.tt-cmp-tick').forEach(function (t) {
        t.classList.remove('is-on');
        t.querySelector('input').checked = false;
      });
      refreshBar();
    });
  }

  function refreshBar() {
    var list = read();
    if (!bar) buildBar();

    var thumbs = bar.querySelector('.tt-cmp-thumbs');
    thumbs.innerHTML = '';
    list.forEach(function (it) {
      if (!it.img) return;
      var i = document.createElement('img');
      i.className = 'tt-cmp-thumb';
      i.src = thumb(it.img, 120);
      i.alt = '';
      thumbs.appendChild(i);
    });

    bar.querySelector('.tt-cmp-go').disabled = list.length < 2;
    bar.classList.toggle('is-up', list.length > 0);
  }

  /* ---------- modal ---------- */

  function buildModal() {
    modal = document.createElement('div');
    modal.className = 'tt-cmp-modal';
    modal.innerHTML =
      '<div class="tt-cmp-panel" style="position:relative">'
      + '<button type="button" class="tt-cmp-x" aria-label="Close">&times;</button>'
      + '<h3>Compare</h3><div class="tt-cmp-body">Loading…</div></div>';
    document.body.appendChild(modal);

    modal.querySelector('.tt-cmp-x').addEventListener('click', close);
    modal.addEventListener('click', function (e) { if (e.target === modal) close(); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
  }

  function close() { if (modal) modal.classList.remove('is-open'); }

  function row(label, cells, cls) {
    return '<tr><th>' + label + '</th>'
      + cells.map(function (c) {
          return '<td' + (cls && c.best ? ' class="tt-cmp-best"' : '') + '>' + c.v + '</td>';
        }).join('')
      + '</tr>';
  }

  function openModal() {
    var list = read();
    if (list.length < 2) return;
    if (!modal) buildModal();

    modal.classList.add('is-open');
    var body = modal.querySelector('.tt-cmp-body');
    body.innerHTML = 'Loading…';

    Promise.all(list.map(function (it) {
      return fetch(BASE + '/products/' + it.handle + '.js')
        .then(function (r) { return r.ok ? r.json() : null; })
        .catch(function () { return null; });
    })).then(function (res) {
      var ps = res.filter(Boolean);
      if (ps.length < 2) { body.innerHTML = 'Could not load these products.'; return; }

      var cheapest = Math.min.apply(null, ps.map(function (p) { return p.price; }));

      var html = '<table class="tt-cmp-table">';
      html += row('', ps.map(function (p) {
        return { v: '<img src="' + thumb(p.featured_image, 300) + '" alt="">' };
      }));
      html += row('Product', ps.map(function (p) {
        return { v: '<a href="' + BASE + '/products/' + p.handle + '">' + p.title + '</a>' };
      }));
      html += row('Price', ps.map(function (p) {
        return { v: money(p.price), best: p.price === cheapest };
      }), true);
      html += row('Brand', ps.map(function (p) { return { v: p.vendor || '—' }; }));
      html += row('Type', ps.map(function (p) { return { v: p.type || '—' }; }));
      html += row('Options', ps.map(function (p) {
        return { v: p.variants.length > 1 ? p.variants.length + ' variants' : 'Single option' };
      }));
      html += row('Availability', ps.map(function (p) {
        return { v: p.available ? 'In stock' : 'Sold out', best: p.available };
      }), true);
      html += '</table>';

      body.innerHTML = html;
    });
  }

  /* ---------- ticks on cards ---------- */

  function cardData(media) {
    var card = media.closest('[data-tt-done]') || media.parentElement;
    var a = card.querySelector('a[href*="/products/"]');
    if (!a) return null;
    var m = a.pathname.match(/\/products\/([^/?#]+)/);
    if (!m) return null;
    var img = card.querySelector('img');
    return { handle: m[1], img: img ? img.src : '' };
  }

  function addTick(media) {
    if (media.querySelector('.tt-cmp-tick')) return;
    var data = cardData(media);
    if (!data) return;

    var on = read().some(function (i) { return i.handle === data.handle; });

    var label = document.createElement('label');
    label.className = 'tt-cmp-tick' + (on ? ' is-on' : '');
    label.innerHTML = '<input type="checkbox"' + (on ? ' checked' : '') + '><span>Compare</span>';

    label.addEventListener('click', function (e) { e.stopPropagation(); });
    label.querySelector('input').addEventListener('change', function (e) {
      var list = read();
      if (e.target.checked) {
        if (list.length >= MAX) {
          e.target.checked = false;
          alert('You can compare up to ' + MAX + ' products.');
          return;
        }
        list.push(data);
        label.classList.add('is-on');
      } else {
        list = list.filter(function (i) { return i.handle !== data.handle; });
        label.classList.remove('is-on');
      }
      write(list);
      refreshBar();
    });

    media.appendChild(label);
  }

  function scan() {
    document.querySelectorAll('.tt-media').forEach(addTick);
  }

  function start() {
    scan();
    refreshBar();
    var t = 0;
    var iv = setInterval(function () { scan(); if (++t > 20) clearInterval(iv); }, 300);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', start);
  } else {
    start();
  }

  new MutationObserver(function () { setTimeout(scan, 150); })
    .observe(document.body, { childList: true, subtree: true });
})();
</script>
<!-- ============ END TT COMPARE ============ -->