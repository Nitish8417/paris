<style id="tt-atc-css">
  .tt-atc-busy { opacity: .6 !important; pointer-events: none !important; }
  .tt-atc-toast {
    position: fixed;
    left: 50%;
    bottom: 24px;
    z-index: 99999;
    padding: 12px 20px;
    border-radius: 999px;
    background: #111;
    color: #fff;
    font-family: inherit;
    font-size: .9rem;
    font-weight: 600;
    box-shadow: 0 10px 30px rgba(0,0,0,.25);
    transform: translate(-50%, 140%);
    transition: transform .3s cubic-bezier(.34,1.3,.64,1);
    pointer-events: none;
  }
  .tt-atc-toast.is-up { transform: translate(-50%, 0); }
  .tt-atc-toast.is-error { background: #c62828; }
</style>

<script id="tt-atc">
(function () {
  'use strict';

  var ROOT = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
  var ADD_BUTTONS = 'button[name="add"], [data-addtocart-main], .add-to-cart-btn';
  var LEAVE_ALONE = 'cart-drawer, #minicart, .side-drawer-panel, .shopify-payment-button';

  /* ---------- small toast message ---------- */

  function toast(msg, isError) {
    var t = document.querySelector('.tt-atc-toast');
    if (!t) {
      t = document.createElement('div');
      t.className = 'tt-atc-toast';
      document.body.appendChild(t);
    }
    t.textContent = msg;
    t.classList.toggle('is-error', !!isError);
    t.classList.add('is-up');
    clearTimeout(t._timer);
    t._timer = setTimeout(function () { t.classList.remove('is-up'); }, 2200);
  }

  /* ---------- mini-cart drawer ---------- */

  function refreshDrawer() {
    return fetch(ROOT + '?section_id=mini-cart')
      .then(function (r) { return r.text(); })
      .then(function (html) {
        var doc   = new DOMParser().parseFromString(html, 'text/html');
        var fresh = doc.querySelector('cart-drawer');
        var live  = document.querySelector('cart-drawer');
        if (fresh && live) live.innerHTML = fresh.innerHTML;
        return !!live;
      })
      .catch(function () { return false; });
  }

  function openDrawer() {
    var trigger = document.querySelector(
      '[data-sidedrawer-open="minicart"], a[href="#minicart"], [data-cart-drawer-open]'
    );
    if (trigger) { trigger.click(); return true; }

    var drawer = document.querySelector('cart-drawer');
    if (!drawer) return false;

    if (typeof drawer.open === 'function') { drawer.open(); return true; }

    drawer.classList.add('is-open', 'active', 'open', 'side-drawer-open');
    document.body.classList.add('side-drawer-active', 'drawer-open', 'overlay-active');
    return true;
  }

  /* ---------- the add itself ---------- */

  function addFromForm(form, btn) {
    if (form.dataset.ttBusy) return;
    form.dataset.ttBusy = '1';
    if (btn) btn.classList.add('tt-atc-busy');

    var data = new FormData(form);
    if (!data.get('quantity')) data.set('quantity', '1');

    fetch(ROOT + 'cart/add.js', {
      method: 'POST',
      headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
      credentials: 'same-origin',
      body: data
    })
      .then(function (r) {
        return r.json().then(function (body) {
          if (!r.ok || body.status) throw new Error(body.description || body.message || 'Could not add to cart');
          return body;
        });
      })
      .then(function () {
        // Your Quick Buy script listens for this: updates the count + wiggles the icon
        document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));

        return refreshDrawer().then(function () {
          if (!openDrawer()) toast('Added to cart ✓');
        });
      })
      .catch(function (err) {
        toast(err.message || 'Could not add to cart', true);
      })
      .then(function () {
        delete form.dataset.ttBusy;
        if (btn) btn.classList.remove('tt-atc-busy');
      });
  }

  function formFor(btn) {
    var id = btn.getAttribute('form');
    if (id) return document.getElementById(id);
    return btn.closest('form[action*="/cart/add"]');
  }

  /* ---------- intercept Add to cart (before the theme can redirect) ---------- */

  document.addEventListener('click', function (e) {
    var btn = e.target.closest(ADD_BUTTONS);
    if (!btn || btn.closest(LEAVE_ALONE)) return;
    if (btn.disabled || btn.classList.contains('techty-disabled-atc')) return;

    var form = formFor(btn);
    if (!form || form.closest(LEAVE_ALONE)) return;

    e.preventDefault();
    e.stopPropagation();
    e.stopImmediatePropagation();
    addFromForm(form, btn);
  }, true);

  // Pressing Enter inside the form
  document.addEventListener('submit', function (e) {
    var form = e.target;
    if (!form.matches || !form.matches('form[action*="/cart/add"]')) return;
    if (form.closest(LEAVE_ALONE)) return;

    var sub = e.submitter;
    if (sub && (sub.name === 'checkout' || sub.closest('.shopify-payment-button'))) return;

    e.preventDefault();
    e.stopImmediatePropagation();
    addFromForm(form, sub);
  }, true);
})();
</script>
<!-- ============ END TT ADD TO CART STAYS ON PAGE ============ -->
<!-- ============ TT CLICKABLE HERO SLIDES ============ -->
<style id="tt-hero-css">
  .tt-hero-slide { cursor: pointer; }

  .tt-hero-btn {
    position: absolute;
    left: 4%;
    bottom: 10%;
    z-index: 6;
    display: inline-block;
    padding: 16px 38px;
    border-radius: 4px;
    background: #111;
    color: #fff !important;
    font-family: inherit;
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: .03em;
    line-height: 1.2;
    text-decoration: none !important;
    box-shadow: 0 8px 24px rgba(0,0,0,.25);
    transition: transform .2s ease, background .2s ease;
  }

  .tt-hero-btn:hover { background: #000; transform: translateY(-2px); }

  .tt-hero-hide { display: none !important; }

  @media (max-width: 767px) {
    .tt-hero-btn {
      left: 50%;
      bottom: 8%;
      padding: 12px 28px;
      font-size: .95rem;
      transform: translateX(-50%);
    }
    .tt-hero-btn:hover { transform: translateX(-50%); }
  }
</style>

<script id="tt-hero">
(function () {
  'use strict';

  var CONFIG = {
    label: 'Shop Now',
    // Slides whose link contains any of these ALWAYS get the Techty button
    alwaysAdd: ['/collections/promate']
  };

  function slides() {
    var list = document.querySelectorAll('.section-hero-banner .hero-media-card');
    if (!list.length) list = document.querySelectorAll('.section-hero-banner .flickity-slider > *');
    return [].slice.call(list);
  }

  function slideLink(slide) {
    return slide.querySelector('a[href]:not([href="#"]):not([href=""]):not(.tt-hero-btn)');
  }

  function reallyVisible(el, slide) {
    var node = el;
    while (node && node !== slide) {
      var cs = getComputedStyle(node);
      if (cs.display === 'none' || cs.visibility === 'hidden' || parseFloat(cs.opacity) < 0.1) return false;
      node = node.parentElement;
    }
    var r = el.getBoundingClientRect();
    var s = slide.getBoundingClientRect();
    if (r.width < 10 || r.height < 10) return false;
    if (r.right < s.left || r.left > s.right || r.bottom < s.top || r.top > s.bottom) return false;
    return true;
  }

  function forced(href) {
    return CONFIG.alwaysAdd.some(function (part) { return href.indexOf(part) > -1; });
  }

  function fix() {
    slides().forEach(function (slide) {
      if (slide.dataset.ttHero) return;

      var link = slideLink(slide);
      if (!link) return;

      slide.dataset.ttHero = '1';
      slide.classList.add('tt-hero-slide');

      var mustAdd = forced(link.href);
      if (!mustAdd && reallyVisible(link, slide)) return;

      if (getComputedStyle(slide).position === 'static') slide.style.position = 'relative';

      if (mustAdd) link.classList.add('tt-hero-hide');

      var btn = document.createElement('a');
      btn.className = 'tt-hero-btn';
      btn.href = link.href;
      btn.textContent = CONFIG.label;
      slide.appendChild(btn);
    });
  }

  /* ---------- click anywhere on a slide ---------- */

  var startX = 0, startY = 0;

  document.addEventListener('pointerdown', function (e) {
    startX = e.clientX;
    startY = e.clientY;
  }, true);

  document.addEventListener('click', function (e) {
    var slide = e.target.closest('.tt-hero-slide');
    if (!slide) return;
    if (e.target.closest('a, button')) return;
    if (Math.abs(e.clientX - startX) > 10 || Math.abs(e.clientY - startY) > 10) return;

    var link = slide.querySelector('.tt-hero-btn') || slideLink(slide);
    if (link) window.location.href = link.href;
  });

  /* ---------- run after the slider has finished setting up ---------- */

  function run() {
    setTimeout(fix, 600);
    setTimeout(fix, 2000);
  }

  if (document.readyState === 'complete') run();
  else window.addEventListener('load', run);
})();
</script>
<!-- ============ END TT CLICKABLE HERO SLIDES ============ -->