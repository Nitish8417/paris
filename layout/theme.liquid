<script id="tt-bis">
(function () {
  'use strict';

  var PHONE   = '96522280345';
  var TITLE   = {{ product.title | json }};
  var URL     = 'https://{{ shop.domain }}{{ product.url }}';
  var DEFAULT = '{{ product.selected_or_first_available_variant.id }}';

  var STOCK = {
    {%- for v in product.variants -%}
      "{{ v.id }}": { "t": {{ v.title | json }}, "a": {{ v.available }} }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  };

  var WA_ICON = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347M12.05 21.785h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884"/></svg>';

  function currentVariant() {
    var q = new URLSearchParams(location.search).get('variant');
    if (q && STOCK[q]) return q;

    var form = document.querySelector('form[action*="/cart/add"] [name="id"]');
    if (form && STOCK[form.value]) return form.value;

    return DEFAULT;
  }

  function anchor() {
    var btn = document.querySelector(
      'button[name="add"], .add-to-cart-btn, [data-addtocart-main]'
    );
    if (!btn) return null;
    return btn.closest('.product-form__buttons, .product-form, form') || btn.parentElement;
  }

  function render() {
    var id = currentVariant();
    var v  = STOCK[id];
    if (!v) return;

    var existing = document.querySelector('.tt-bis-wrap');

    if (v.a) {                       // in stock — remove if present
      if (existing) existing.remove();
      return;
    }

    var label = TITLE + (v.t && v.t !== 'Default Title' ? ' — ' + v.t : '');
    var text  = 'Hi Techty, please let me know when this is back in stock:\n\n'
              + label + '\n' + URL;
    var href  = 'https://wa.me/' + PHONE + '?text=' + encodeURIComponent(text);

    if (existing) {                  // variant changed — just update the link
      existing.querySelector('a').href = href;
      return;
    }

    var host = anchor();
    if (!host) return;

    var wrap = document.createElement('div');
    wrap.className = 'tt-bis-wrap';
    wrap.innerHTML =
      '<a class="tt-bis" href="' + href + '" target="_blank" rel="noopener noreferrer">'
      + WA_ICON + 'Notify me on WhatsApp</a>'
      + '<p class="tt-bis-note">We\'ll message you the moment it\'s back.</p>';

    host.appendChild(wrap);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', render);
  } else {
    render();
  }

  // Variant pickers swap the DOM — re-check after any change
  document.addEventListener('change', function () { setTimeout(render, 60); });
  new MutationObserver(function () { setTimeout(render, 60); })
    .observe(document.body, { childList: true, subtree: true });
})();
</script>
