<script id="tt-wa-smart">
(function () {
  var PHONE = '96522280345';

  function productTitle() {
    var og = document.querySelector('meta[property="og:title"]');
    if (og && og.content) return og.content.trim();

    var h1 = document.querySelector('main h1, .product__title h1, .product-title, h1');
    if (h1 && h1.textContent.trim()) return h1.textContent.trim();

    return document.title.split('–')[0].split('|')[0].trim();
  }

  function pageTitle() {
    var h1 = document.querySelector('main h1, .collection-title, h1');
    return h1 && h1.textContent.trim() ? h1.textContent.trim() : 'your products';
  }

  function build() {
    var path = window.location.pathname;
    var here = window.location.origin + path;

    if (path.indexOf('/products/') > -1) {
      return 'Hi Techty, I would like to enquire about this product:\n\n'
           + productTitle() + '\n' + here;
    }
    if (path.indexOf('/collections/') > -1) {
      return 'Hi Techty, I am looking at your ' + pageTitle()
           + ' and need help choosing the right one. Can you recommend something?';
    }
    if (path.indexOf('/cart') > -1) {
      return 'Hi Techty, I have a question about my order before I check out.';
    }
    if (path.indexOf('/search') > -1) {
      return 'Hi Techty, I am trying to find a product on your site. Can you help me?';
    }
    return 'Hi Techty, I need help picking the right product. What do you recommend?';
  }

  function apply() {
    var float = document.querySelector('.techty-whatsapp-float');
    if (!float) return false;

    float.href = 'https://wa.me/' + PHONE + '?text=' + encodeURIComponent(build());
    float.setAttribute('aria-label', 'Chat with Techty on WhatsApp');
    return true;
  }

  function start() {
    if (apply()) return;

    // Button not in the DOM yet — retry briefly
    var tries = 0;
    var t = setInterval(function () {
      if (apply() || ++tries > 20) clearInterval(t);
    }, 150);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', start);
  } else {
    start();
  }

  // Variant switches change the URL — rebuild the link
  document.addEventListener('change', function () { setTimeout(apply, 80); });
  window.addEventListener('popstate', apply);
})();
</script>
<style id="tt-quick-buy-css">
  /* ---------- Quick Buy overlay ---------- */
  .tt-media { position: relative; }

  .tt-quick-buy {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -40%);
    z-index: 4;
    min-width: 70%;
    padding: .95rem 1.4rem;
    border: 1px solid rgba(0, 0, 0, .18);
    border-radius: 4px;
    background: #fff;
    color: #111;
    font: inherit;
    font-size: .88rem;
    font-weight: 600;
    letter-spacing: .08em;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transition: opacity .22s ease, transform .22s ease, visibility .22s,
                background .15s ease, color .15s ease, border-color .15s ease;
  }

  .tt-media:hover .tt-quick-buy,
  .tt-media:focus-within .tt-quick-buy {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, -50%);
  }

  .tt-quick-buy:hover     { background: #111; color: #fff; border-color: #111; }
  .tt-quick-buy[disabled] { opacity: .65; cursor: wait; }
  .tt-quick-buy.is-done   { background: #1a7f4b; border-color: #1a7f4b; color: #fff; }
  .tt-quick-buy.is-error  { background: #c62828; border-color: #c62828; color: #fff; }

  @media (hover: none) { .tt-quick-buy { display: none; } }

  /* ---------- Duplicate cart badge suppression ---------- */
  .tt-dupe-badge { display: none !important; }

  /* ---------- Animations ---------- */
  @keyframes tt-wiggle {
    0%   { transform: scale(1)    rotate(0deg); }
    12%  { transform: scale(1.22) rotate(-14deg); }
    26%  { transform: scale(1.16) rotate(11deg); }
    40%  { transform: scale(1.18) rotate(-8deg); }
    56%  { transform: scale(1.1)  rotate(6deg); }
    72%  { transform: scale(1.12) rotate(-3deg); }
    86%  { transform: scale(1.04) rotate(1deg); }
    100% { transform: scale(1)    rotate(0deg); }
  }

  .tt-cart-wiggle {
    animation: tt-wiggle .75s cubic-bezier(.36, .07, .19, .97) both;
    transform-origin: 50% 60%;
    will-change: transform;
  }

  @keyframes tt-pop {
    0%   { transform: scale(1); }
    35%  { transform: scale(1.5); }
    60%  { transform: scale(.88); }
    80%  { transform: scale(1.12); }
    100% { transform: scale(1); }
  }

  .tt-count-pop { animation: tt-pop .55s cubic-bezier(.34, 1.56, .64, 1) both; }

  @keyframes tt-float {
    0%   { opacity: 0; transform: translate(-50%, 4px)   scale(.7); }
    20%  { opacity: 1; transform: translate(-50%, -6px)  scale(1.1); }
    100% { opacity: 0; transform: translate(-50%, -34px) scale(.95); }
  }

  .tt-float-badge {
    position: fixed;
    z-index: 99999;
    padding: 2px 9px;
    border-radius: 999px;
    background: #111;
    color: #fff;
    font-family: inherit;
    font-size: 12px;
    font-weight: 700;
    line-height: 1.6;
    pointer-events: none;
    animation: tt-float 1.1s ease-out forwards;
  }

  @media (prefers-reduced-motion: reduce) {
    .tt-cart-wiggle, .tt-count-pop, .tt-float-badge { animation: none !important; }
    .tt-float-badge { display: none; }
  }
</style>

<script id="tt-quick-buy">
(function () {
  'use strict';

  var CONFIG = {
    label:       'QUICK BUY',
    chooseLabel: 'CHOOSE OPTIONS',
    dedupeBadge: true,     // hide the duplicate number bubble
    keepBadge:   'last',   // 'last' or 'first' — which bubble survives
    openDrawer:  true,     // slide the mini-cart open after adding
    wiggle:      true,     // shake the header cart icon
    floatBadge:  true,     // the little +1 that drifts up
    debug:       false
  };

  var ROOT   = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
  var SEED   = {{ cart.item_count | default: 0 }};
  var queued = false;

  function log() {
    if (CONFIG.debug && window.console) {
      console.log.apply(console, ['[tt]'].concat([].slice.call(arguments)));
    }
  }

  /* ---------------- cart icon ---------------- */

  function cartIcon() {
    var scope = document.querySelector('header, .header, [class*="site-header"]') || document;
    var sels = [
      '[data-sidedrawer-open="minicart"]',
      'a[href="#minicart"]',
      '[data-cart-icon]',
      '.cart-icon',
      '.header-cart',
      '.site-header__cart',
      'a[href$="/cart"]',
      'a[href*="/cart"]'
    ];
    for (var i = 0; i < sels.length; i++) {
      var el = scope.querySelector(sels[i]);
      if (el) return el;
    }
    return document.querySelector('a[href*="/cart"]');
  }

  function isNumberBubble(el) {
    if (el.children.length) return false;          // leaf nodes only
    if (el.closest('svg')) return false;
    return /^\(?\s*\d{1,3}\s*\)?$/.test((el.textContent || '').trim());
  }

  /* ---------------- duplicate badge cleanup ---------------- */

  function dedupeBadges() {
    if (!CONFIG.dedupeBadge) return;

    var icon = cartIcon();
    if (!icon) return;

    var scopes = [icon];
    if (icon.parentElement) scopes.push(icon.parentElement);

    for (var s = 0; s < scopes.length; s++) {
      var found = [];
      scopes[s].querySelectorAll('*').forEach(function (el) {
        if (isNumberBubble(el)) found.push(el);
      });

      if (found.length > 1) {
        var keep = CONFIG.keepBadge === 'first' ? found[0] : found[found.length - 1];
        found.forEach(function (el) {
          if (el === keep) el.classList.remove('tt-dupe-badge');
          else el.classList.add('tt-dupe-badge');
        });
        log('deduped badges:', found.length, '→ kept', keep.className || keep.tagName);
        return;
      }
    }
  }

  /* ---------------- update existing counts ---------------- */

  function paintCount(count, animate) {
    count = Number(count) || 0;
    var touched = 0;

    document.querySelectorAll(
      '#cartDrawer-count, .cart-total-count, [data-cart-count], .cart-count, ' +
      '.cart-count-bubble, [class*="cart-item-count"], [class*="cart-qty"], ' +
      '[class*="cart-badge"], [class*="cart-counter"]'
    ).forEach(function (el) {
      if (el.hasAttribute('data-cart-count')) el.setAttribute('data-cart-count', count);

      var txt = (el.textContent || '').trim();
      if (!/^\(?\s*\d{1,3}\s*\)?$/.test(txt)) return;   // only touch plain numbers

      el.textContent = txt.indexOf('(') > -1 ? '(' + count + ')' : String(count);
      touched++;

      if (animate && !el.classList.contains('tt-dupe-badge')) {
        el.classList.remove('tt-count-pop');
        void el.offsetWidth;
        el.classList.add('tt-count-pop');
        setTimeout(function () { el.classList.remove('tt-count-pop'); }, 600);
      }
    });

    dedupeBadges();

    var icon = cartIcon();
    if (icon) icon.setAttribute('aria-label', 'Cart, ' + count + ' item' + (count === 1 ? '' : 's'));

    log('count →', count, '| updated', touched, 'element(s)');
  }

  function syncCount(animate) {
    return fetch(ROOT + 'cart.js', { headers: { 'Accept': 'application/json' } })
      .then(function (r) { return r.json(); })
      .then(function (c) { paintCount(c.item_count, animate); return c.item_count; })
      .catch(function (e) { log('cart.js failed', e); });
  }

  /* ---------------- animations ---------------- */

  function wiggle() {
    if (!CONFIG.wiggle) return null;
    var icon = cartIcon();
    if (!icon) { log('cart icon not found'); return null; }
    icon.classList.remove('tt-cart-wiggle');
    void icon.offsetWidth;
    icon.classList.add('tt-cart-wiggle');
    setTimeout(function () { icon.classList.remove('tt-cart-wiggle'); }, 800);
    return icon;
  }

  function floatBadge(icon) {
    if (!CONFIG.floatBadge || !icon) return;
    var r = icon.getBoundingClientRect();
    var b = document.createElement('span');
    b.className = 'tt-float-badge';
    b.textContent = '+1';
    b.style.left = (r.left + r.width / 2) + 'px';
    b.style.top  = (r.top - 6) + 'px';
    document.body.appendChild(b);
    setTimeout(function () { b.remove(); }, 1200);
  }

  /* ---------------- drawer ---------------- */

  function refreshDrawer() {
    return fetch(ROOT + '?section_id=mini-cart')
      .then(function (r) { return r.text(); })
      .then(function (html) {
        var doc   = new DOMParser().parseFromString(html, 'text/html');
        var fresh = doc.querySelector('cart-drawer');
        var live  = document.querySelector('cart-drawer');
        if (fresh && live) live.innerHTML = fresh.innerHTML;
      })
      .catch(function (e) { log('drawer refresh failed', e); });
  }

  function showDrawer() {
    if (!CONFIG.openDrawer) return;

    var trigger = document.querySelector(
      '[data-sidedrawer-open="minicart"], [data-sideDrawer-open], ' +
      'a[href="#minicart"], [data-cart-drawer-open]'
    );
    if (trigger) { trigger.click(); return; }

    var drawer = document.querySelector('cart-drawer#minicart, cart-drawer');
    if (!drawer) { log('no cart-drawer found'); return; }

    if (typeof drawer.open === 'function') { drawer.open(); return; }

    drawer.classList.add('is-open', 'active', 'open', 'side-drawer-open');
    document.body.classList.add('side-drawer-active', 'drawer-open', 'overlay-active');
  }

  /* ---------------- card discovery ---------------- */

  function findCard(link) {
    var el = link.parentElement, best = null, depth = 0;
    while (el && el !== document.body && depth < 10) {
      var seen = {}, n = 0;
      el.querySelectorAll('a[href*="/products/"]').forEach(function (a) {
        if (!seen[a.pathname]) { seen[a.pathname] = 1; n++; }
      });
      if (n > 1) break;
      if (el.querySelector('img')) best = el;
      el = el.parentElement;
      depth++;
    }
    return best;
  }

  function findMedia(card) {
    var img = card.querySelector('img');
    if (!img) return null;
    var el = img.parentElement, depth = 0;
    while (el && el !== card && depth < 4) {
      if (el.clientHeight > 80) return el;
      el = el.parentElement;
      depth++;
    }
    return img.parentElement;
  }

  function productUrl(card) {
    var a = card.querySelector('a[href*="/products/"]');
    return a ? a.href : null;
  }

  function variantId(card) {
    var a = card.querySelector('a[href*="variant="]');
    if (a) {
      try { return new URL(a.href, location.origin).searchParams.get('variant'); } catch (e) {}
    }
    var i = card.querySelector('[name="id"]');
    return i ? i.value : null;
  }

  function isSoldOut(card) {
    return /sold out|out of stock|نفذ/i.test(card.textContent || '');
  }

  function hasChoices(card) {
    return card.querySelectorAll(
      '[class*="swatch"], [data-variant-option], [class*="color-option"]'
    ).length > 1;
  }

  /* ---------------- add to cart ---------------- */

  function reset(btn, label) {
    setTimeout(function () {
      btn.disabled = false;
      btn.classList.remove('is-done', 'is-error');
      btn.textContent = label;
    }, 1500);
  }

  function add(card, btn) {
    var id = variantId(card);
    if (!id) { log('no variant id on card'); return; }

    var label = CONFIG.label;
    btn.disabled = true;
    btn.textContent = 'ADDING…';

    fetch(ROOT + 'cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ items: [{ id: id, quantity: 1 }] })
    })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        if (d.status) throw new Error(d.description || 'Unavailable');

        btn.classList.add('is-done');
        btn.textContent = 'ADDED ✓';

        var icon = wiggle();
        floatBadge(icon);

        return syncCount(true)
          .then(refreshDrawer)
          .then(function () {
            syncCount(false);   // drawer was just re-rendered, re-apply
            showDrawer();
            reset(btn, label);
                   });
      })
      .catch(function (e) {
        log('add failed', e);
        btn.classList.add('is-error');
        btn.textContent = 'TRY AGAIN';
        reset(btn, label);
      });
  }

  /* ---------------- wiring ---------------- */
  var SKIP_ZONES = '.section-hero-banner, .hero-media-wrapper, .hero-media-card, ' +
                   '.hero-media-content-wrapper, .hero-media-img, ' +
                   '[class*="marquee"], [class*="megamenu"], [class*="submenu"], ' +
                   'header, footer, cart-drawer, .side-drawer-panel';
  function looksLikeProductCard(card) {
    // Every real product card shows a price. Banners and menu tiles never do.
    if (card.querySelector('[class*="price"], .money, .item-price')) return true;
    return /\d+[.,]\d{2,3}\s*(KD|د\.ك)/i.test(card.textContent || '');
  }
  function enhance(link) {
    var card = findCard(link);
    if (!card || card.dataset.ttDone) return false;

    // Banners, sliders, menu tiles and drawers are not product cards.
    if (card.closest(SKIP_ZONES) || !looksLikeProductCard(card)) {
      card.dataset.ttDone = 'skip';
      return false;
    }

    var media = findMedia(card);
    if (!media) return false;

    card.dataset.ttDone = '1';
    if (isSoldOut(card)) return false;

    media.classList.add('tt-media');

    var choose = hasChoices(card);
    var btn = document.createElement(choose ? 'a' : 'button');
    btn.className = 'tt-quick-buy';
    btn.textContent = choose ? CONFIG.chooseLabel : CONFIG.label;

    if (choose) {
      btn.href = productUrl(card) || '#';
    } else {
      btn.type = 'button';
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        add(card, btn);
      });
    }

    media.appendChild(btn);
    return true;
  }

  function scan() {
    queued = false;
    var links = document.querySelectorAll('a[href*="/products/"]');
    var n = 0;
    links.forEach(function (l) { if (enhance(l)) n++; });
    dedupeBadges();
    log('product links:', links.length, '| cards wired:', n);
  }

  function queue() {
    if (queued) return;
    queued = true;
    setTimeout(scan, 120);
  }

  function boot() {
    paintCount(SEED, false);
    scan();
    syncCount(false);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot);
  } else {
    boot();
  }

  window.addEventListener('load', queue);
  window.addEventListener('pageshow', function () { syncCount(false); });
  new MutationObserver(queue).observe(document.documentElement, { childList: true, subtree: true });

  // Keep things in sync when your theme's own Add to cart is used
  ['cart:refresh', 'cart:updated', 'cart:build', 'ajaxProduct:added'].forEach(function (evt) {
    document.addEventListener(evt, function () { syncCount(true); wiggle(); });
  });
})();
</script>
