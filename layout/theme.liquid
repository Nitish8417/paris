<script>
(function () {
  /* ---------- SETTINGS ---------- */
  var ATTR = 'Delivery Area';     // Name shown on the order in Shopify admin
  var HIDE_OLD_FIELD = true;      // Hide the broken "Select The Delivery Area" box

  // Edit this list freely (add/remove areas)
  var AREAS = {
    'Capital': ['Kuwait City','Sharq','Mirqab','Qibla','Dasman','Bneid Al Gar','Dasma','Daiya','Shamiya','Shuwaikh','Shuwaikh Industrial','Abdullah Al Salem','Adailiya','Khaldiya','Kaifan','Qadsiya','Mansouriya','Faiha','Nuzha','Rawda','Surra','Yarmouk','Qortuba','Granada','Sulaibikhat','Doha','Nahdha','Jaber Al Ahmad','Qairawan'],
    'Hawalli': ['Hawalli','Salmiya','Jabriya','Rumaithiya','Salwa','Mishref','Bayan','Mubarak Al Abdullah','Shaab','Shuhada','Siddiq','Hittin','Salam','Zahra','Maidan Hawalli','Bidaa'],
    'Farwaniya': ['Farwaniya','Khaitan','Jleeb Al Shuyoukh','Abraq Khaitan','Ardiya','Andalus','Rabiya','Rehab','Omariya','Ishbiliya','Firdous','Sabah Al Nasser','Abdullah Al Mubarak','Dajeej','Rai'],
    'Mubarak Al Kabeer': ['Mubarak Al Kabeer','Adan','Qurain','Qusour','Sabah Al Salem','Messila','Abu Futaira','Abu Al Hasaniya','Fnaitees','Masayel','Sabhan'],
    'Ahmadi': ['Ahmadi','Fahaheel','Mangaf','Abu Halifa','Fintas','Mahboula','Egaila','Riqqa','Hadiya','Sabahiya','Dhaher','Jaber Al Ali','Fahad Al Ahmad','Ali Sabah Al Salem','Sabah Al Ahmad','Wafra','Khairan','Zour','Mina Abdullah','Julaia'],
    'Jahra': ['Jahra','Saad Al Abdullah','Oyoun','Naeem','Qasr','Taima','Waha','Nasseem','Amghara','Sulaibiya','Kabd','Abdali','Mutlaa']
  };

  var isAr = (document.documentElement.lang || '').toLowerCase().indexOf('ar') === 0;
  var T = isAr
    ? { label: 'منطقة التوصيل', placeholder: 'اختر منطقة التوصيل', error: 'يرجى اختيار منطقة التوصيل للمتابعة' }
    : { label: 'Delivery area', placeholder: 'Choose your delivery area', error: 'Please choose your delivery area to continue' };
  /* ------------------------------ */

  console.log('[Delivery Area] Script loaded');
  var ROOT = (window.Shopify && Shopify.routes && Shopify.routes.root) || '/';
  var OLD_TEXT = /select the delivery area|اختر منطقة التوصيل/i;
  var selected = '';
  var saving = Promise.resolve();

  function isCheckoutButton(el) {
    if (!el || el.closest('.da-wrap')) return false;
    if (el.name === 'checkout') return true;
    if (el.tagName === 'A' && /\/checkout/.test(el.getAttribute('href') || '')) return true;
    return /check\s?out|الدفع|إتمام الطلب/i.test(el.textContent || el.value || '');
  }

  function checkoutButtons() {
    return Array.prototype.filter.call(
      document.querySelectorAll('button, input[type="submit"], a'), isCheckoutButton);
  }

  function getContainers() {
    var list = Array.prototype.slice.call(document.querySelectorAll('[data-cart-checkout-buttons]'));
    if (!list.length) {
      checkoutButtons().forEach(function (b) {
        if (b.parentElement && list.indexOf(b.parentElement) === -1) list.push(b.parentElement);
      });
    }
    return list;
  }

  function buildPicker() {
    var id = 'da-' + Math.random().toString(36).slice(2, 8);
    var html = '<label class="da-label" for="' + id + '">' + T.label + '</label>' +
      '<select class="da-select" id="' + id + '"><option value="">' + T.placeholder + '</option>';
    Object.keys(AREAS).forEach(function (gov) {
      html += '<optgroup label="' + gov + '">';
      AREAS[gov].forEach(function (a) { html += '<option value="' + a + '">' + a + '</option>'; });
      html += '</optgroup>';
    });
    html += '</select><div class="da-msg" role="alert">' + T.error + '</div>';

    var wrap = document.createElement('div');
    wrap.className = 'da-wrap';
    wrap.innerHTML = html;
    var sel = wrap.querySelector('select');
    sel.value = selected;
    sel.addEventListener('change', function () { setArea(sel.value); });
    return wrap;
  }

  function setArea(value) {
    selected = value;
    document.querySelectorAll('.da-select').forEach(function (s) { if (s.value !== value) s.value = value; });
    if (value) document.querySelectorAll('.da-wrap').forEach(function (w) { w.classList.remove('da-error'); });
    var attrs = {}; attrs[ATTR] = value;
    saving = fetch(ROOT + 'cart/update.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ attributes: attrs })
    }).catch(function (e) { console.warn('[Delivery Area] Could not save:', e); });
    enableCheckout();
  }

  // Always unlock checkout: the old Techty lock is replaced by our own check on click
  function enableCheckout() {
    checkoutButtons().forEach(function (b) {
      if (b.disabled) b.disabled = false;
      if (b.getAttribute('aria-disabled') === 'true') b.removeAttribute('aria-disabled');
      ['disabled', 'is-disabled', 'btn--disabled'].forEach(function (c) {
        if (b.classList.contains(c)) b.classList.remove(c);
      });
      if (b.style.pointerEvents !== 'auto') b.style.pointerEvents = 'auto';
      if (b.style.opacity !== '1') b.style.opacity = '1';
    });
  }

  function hideOld(container) {
    if (!HIDE_OLD_FIELD) return;
    var scope = container.parentElement || container;
    var targets = [];
    scope.querySelectorAll('[placeholder]').forEach(function (el) {
      if (OLD_TEXT.test(el.getAttribute('placeholder'))) targets.push(el);
    });
    scope.querySelectorAll('*').forEach(function (el) {
      if (el.children.length === 0 && OLD_TEXT.test(el.textContent || '')) {
        targets.push(el.tagName === 'OPTION' ? el.closest('select') : el);
      }
    });
    targets.forEach(function (el) {
      if (!el || el.closest('.da-wrap')) return;
      // Walk up to the visible box, without swallowing the checkout button
      while (el.parentElement && el.parentElement !== container && el.parentElement !== scope &&
             el.parentElement.children.length === 1) {
        el = el.parentElement;
      }
      if (el.querySelector && el.querySelector('.da-wrap')) return;
      if (checkoutButtons().some(function (b) { return el.contains(b); })) return;
      el.style.display = 'none';
    });
  }

  function inject() {
    getContainers().forEach(function (c) {
      if (!c.querySelector('.da-wrap')) c.insertBefore(buildPicker(), c.firstChild);
      hideOld(c);
    });
    enableCheckout();
  }

  // Take over the checkout click so the old broken logic can't redirect
  window.addEventListener('click', function (e) {
    var btn = e.target.closest && e.target.closest('button, input[type="submit"], a');
    if (!btn || !isCheckoutButton(btn) || !document.querySelector('.da-wrap')) return;
    e.preventDefault();
    e.stopImmediatePropagation();
    console.log('[Delivery Area] Checkout clicked. Area:', selected || '(none)');
    var visible = Array.prototype.find.call(document.querySelectorAll('.da-select'),
      function (s) { return s.offsetParent !== null; });
    if (!selected && visible) {
      document.querySelectorAll('.da-wrap').forEach(function (w) { w.classList.add('da-error'); });
      visible.scrollIntoView({ behavior: 'smooth', block: 'center' });
      visible.focus();
      return;
    }
    if (!selected) { window.location.href = ROOT + 'checkout'; return; } // never leave customer stuck
    saving.then(goToCheckoutWithArea);
  }, true);

  // Send customer to checkout with their area already filled in
  function goToCheckoutWithArea() {
    fetch(ROOT + 'cart.js', { headers: { 'Accept': 'application/json' } })
      .then(function (r) { return r.json(); })
      .then(function (cart) {
        var items = cart.items || [];
        // If any item has custom options (engraving etc.), use normal checkout so nothing is lost
        var hasProps = items.some(function (i) {
          return i.properties && Object.keys(i.properties).some(function (k) { return i.properties[k]; });
        });
        if (!items.length || hasProps) { window.location.href = ROOT + 'checkout'; return; }

        var lines = items.map(function (i) { return i.variant_id + ':' + i.quantity; }).join(',');
        var p = [
          'checkout[shipping_address][country]=KW',
          'checkout[shipping_address][city]=' + encodeURIComponent(selected),
          'attributes[' + encodeURIComponent(ATTR) + ']=' + encodeURIComponent(selected)
        ];
        var codes = (cart.discount_codes || [])
          .filter(function (d) { return d.applicable; })
          .map(function (d) { return d.code; });
        if (codes.length) p.push('discount=' + encodeURIComponent(codes.join(',')));
        if (window.Shopify && Shopify.locale) p.push('locale=' + encodeURIComponent(Shopify.locale));
        if (cart.note) p.push('note=' + encodeURIComponent(cart.note));

        window.location.href = '/cart/' + lines + '?' + p.join('&');
      })
      .catch(function () { window.location.href = ROOT + 'checkout'; });
  }

  // Re-add the picker whenever the cart refreshes
  var timer;
  new MutationObserver(function () {
    clearTimeout(timer);
    timer = setTimeout(inject, 100);
  }).observe(document.body, { childList: true, subtree: true, attributes: true,
                              attributeFilter: ['disabled', 'class', 'aria-disabled'] });

  inject();
  fetch(ROOT + 'cart.js', { headers: { 'Accept': 'application/json' } })
    .then(function (r) { return r.json(); })
    .then(function (cart) {
      var saved = cart.attributes && cart.attributes[ATTR];
      if (saved) {
        selected = saved;
        document.querySelectorAll('.da-select').forEach(function (s) { s.value = saved; });
        enableCheckout();
      }
    })
    .catch(function () {});
})();
</script>
