<script id="tt-rv">
(function () {
  'use strict';

  var CONFIG = {
    key:      'tt_recently_viewed',
    heading:  'Recently viewed',
    max:      12,
    show:     10,
    decimals: 3,
    suffix:   ' KD',
    debug:    true
  };

  var ROOT = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
  var BASE = ROOT.replace(/\/$/, '');

  // Places that contain product links but are NOT the related section
  var IGNORE = 'header, footer, nav, cart-drawer, .side-drawer-panel, #minicart, ' +
               '[class*="quick-view"], [class*="megamenu"], [class*="submenu"], ' +
               '[class*="breadcrumb"], .tt-rv';

  function log() {
    if (CONFIG.debug && window.console) {
      console.log.apply(console, ['[tt-rv]'].concat([].slice.call(arguments)));
    }
  }

  function read() {
    try {
      var raw = localStorage.getItem(CONFIG.key);
      var arr = raw ? JSON.parse(raw) : [];
      return Array.isArray(arr) ? arr : [];
    } catch (e) { return []; }
  }

  function write(list) {
    try { localStorage.setItem(CONFIG.key, JSON.stringify(list)); } catch (e) {}
  }

  function currentHandle() {
    var m = window.location.pathname.match(/\/products\/([^/?#]+)/);
    return m ? m[1] : null;
  }

  function track() {
    var handle = currentHandle();
    if (!handle) return;
    var list = read().filter(function (h) { return h !== handle; });
    list.unshift(handle);
    write(list.slice(0, CONFIG.max));
  }

  function money(cents) {
    return (Number(cents) / 100).toFixed(CONFIG.decimals) + CONFIG.suffix;
  }

  function thumb(url, w) {
    if (!url) return '';
    return url.replace(/(\.[a-z]{3,4})(\?|$)/i, '_' + w + 'x$1$2');
  }

  function card(p) {
    var a = document.createElement('a');
    a.className = 'tt-rv__item';
    a.href = BASE + '/products/' + p.handle;

    var onSale = p.compare_at_price && p.compare_at_price > p.price;
    var img = p.featured_image || (p.images && p.images[0]) || '';

    a.innerHTML =
      '<div class="tt-rv__media">'
      +   (p.available ? '' : '<span class="tt-rv__badge">Sold out</span>')
      +   (img ? '<img src="' + thumb(img, 400) + '" alt="" loading="lazy" width="400" height="400">' : '')
      + '</div>'
      + '<p class="tt-rv__name">' + p.title + '</p>'
      + '<div class="tt-rv__price">' + money(p.price)
      +   (onSale ? '<span class="tt-rv__was">' + money(p.compare_at_price) + '</span>' : '')
      + '</div>';

    return a;
  }

  /* ---------- placement: after the LAST block of other products ---------- */

  function relatedSection() {
    var here  = currentHandle();
    var links = document.querySelectorAll('a[href*="/products/"]');
    var last  = null;

    for (var i = 0; i < links.length; i++) {
      var a = links[i];
      if (a.closest(IGNORE)) continue;
      if (here && a.pathname.indexOf('/products/' + here) > -1) continue;
      last = a;
    }

    if (!last) return null;
    return last.closest('.shopify-section') || null;
  }

  function place(wrap) {
    var rel = relatedSection();

    if (rel && rel.parentNode) {
      if (rel.nextElementSibling !== wrap) {
        rel.parentNode.insertBefore(wrap, rel.nextSibling);
        log('placed after:', rel.id || rel.className);
      }
      return;
    }

    var main = document.getElementById('MainContent') || document.querySelector('main');
    if (main && main.lastElementChild !== wrap) {
      main.appendChild(wrap);
      log('no related block yet — placed at end of main');
    }
  }

  function watch(wrap) {
    if (!window.MutationObserver) return;
    var pending = false;
    var mo = new MutationObserver(function () {
      if (pending) return;
      pending = true;
      setTimeout(function () { pending = false; place(wrap); }, 200);
    });
    mo.observe(document.body, { childList: true, subtree: true });
    setTimeout(function () { mo.disconnect(); }, 15000);
  }

  function mount(products) {
    if (!products.length) return;

    var old = document.querySelector('.tt-rv');
    if (old) old.remove();

    var wrap = document.createElement('section');
    wrap.className = 'tt-rv';
    wrap.innerHTML =
      '<div class="tt-rv__head">'
      +   '<h2 class="tt-rv__title">' + CONFIG.heading + '</h2>'
      +   '<button type="button" class="tt-rv__clear">Clear</button>'
      + '</div>'
      + '<div class="tt-rv__track"></div>';

    var track = wrap.querySelector('.tt-rv__track');
    products.forEach(function (p) { track.appendChild(card(p)); });

    wrap.querySelector('.tt-rv__clear').addEventListener('click', function () {
      write([]);
      wrap.remove();
    });

    place(wrap);
    watch(wrap);
  }

  function load() {
    var here = currentHandle();
    var list = read().filter(function (h) { return h !== here; }).slice(0, CONFIG.show);
    if (!list.length) return;

    Promise.all(list.map(function (h) {
      return fetch(BASE + '/products/' + h + '.js', { headers: { 'Accept': 'application/json' } })
        .then(function (r) { return r.ok ? r.json() : null; })
        .catch(function () { return null; });
    })).then(function (results) {
      var clean = results.filter(Boolean);

      if (clean.length !== list.length) {
        var alive = clean.map(function (p) { return p.handle; });
        write(read().filter(function (h) { return h === here || alive.indexOf(h) > -1; }));
      }

      mount(clean);
    });
  }

  function start() { track(); load(); }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', start);
  } else {
    start();
  }
})();
</script>
