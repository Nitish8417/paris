{% doc %}
  @prompt
    i want to ad a bos where the customer couldd order notes
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-cart-notes-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    margin: 0 auto;
  }

  .ai-cart-notes-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 12px 0;
    font-weight: 600;
  }

  .ai-cart-notes-description-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    margin: 0 0 16px 0;
    line-height: 1.5;
  }

  .ai-cart-notes-textarea-{{ ai_gen_id }} {
    width: 100%;
    min-height: {{ block.settings.textarea_height }}px;
    padding: 12px 16px;
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    background-color: {{ block.settings.input_background }};
    color: {{ block.settings.input_text_color }};
    font-size: 14px;
    font-family: inherit;
    resize: vertical;
    transition: border-color 0.2s ease;
  }

  .ai-cart-notes-textarea-{{ ai_gen_id }}:focus {
    outline: none;
    border-color: {{ block.settings.focus_border_color }};
  }

  .ai-cart-notes-textarea-{{ ai_gen_id }}::placeholder {
    color: {{ block.settings.placeholder_color }};
    opacity: 0.7;
  }

  .ai-cart-notes-char-count-{{ ai_gen_id }} {
    display: block;
    text-align: right;
    font-size: 12px;
    color: {{ block.settings.text_color }};
    margin-top: 8px;
    opacity: 0.7;
  }
{% endstyle %}

<cart-notes-{{ ai_gen_id }} class="ai-cart-notes-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h3 class="ai-cart-notes-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h3>
  {% endif %}

  {% if block.settings.description != blank %}
    <div class="ai-cart-notes-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
  {% endif %}

  <textarea
    class="ai-cart-notes-textarea-{{ ai_gen_id }}"
    name="note"
    id="cart-note-{{ ai_gen_id }}"
    placeholder="{{ block.settings.placeholder }}"
    {% if block.settings.max_characters > 0 %}maxlength="{{ block.settings.max_characters }}"{% endif %}
    aria-label="{{ block.settings.heading | default: 'Order notes' }}"
    data-cart-note
  >{{ cart.note }}</textarea>

  {% if block.settings.show_character_count and block.settings.max_characters > 0 %}
    <span class="ai-cart-notes-char-count-{{ ai_gen_id }}">
      <span data-char-current>{{ cart.note | size }}</span> / {{ block.settings.max_characters }}
    </span>
  {% endif %}
</cart-notes-{{ ai_gen_id }}>

<script>
  (function() {
    class CartNotes{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.textarea = this.querySelector('[data-cart-note]');
        this.charCurrent = this.querySelector('[data-char-current]');
      }

      connectedCallback() {
        if (!this.textarea) return;

        this.textarea.addEventListener('change', this.updateCartNote.bind(this));

        if (this.charCurrent) {
          this.textarea.addEventListener('input', this.updateCharCount.bind(this));
        }
      }

      updateCharCount() {
        if (this.charCurrent) {
          this.charCurrent.textContent = this.textarea.value.length;
        }
      }

      updateCartNote() {
        const note = this.textarea.value;

        fetch('/cart/update.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ note: note })
        })
        .then(response => response.json())
        .catch(error => {
          console.error('Error updating cart note:', error);
        });
      }
    }

    customElements.define('cart-notes-{{ ai_gen_id }}', CartNotes{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Cart order notes",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Order notes"
    },
    {
      "type": "inline_richtext",
      "id": "description",
      "label": "Description",
      "default": "Add special instructions for your order"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Placeholder text",
      "default": "e.g., Gift wrapping, delivery instructions..."
    },
    {
      "type": "header",
      "content": "Settings"
    },
    {
      "type": "range",
      "id": "textarea_height",
      "label": "Textarea height",
      "min": 80,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "max_characters",
      "label": "Maximum characters",
      "min": 0,
      "max": 500,
      "step": 50,
      "default": 250,
      "info": "Set to 0 for unlimited"
    },
    {
      "type": "checkbox",
      "id": "show_character_count",
      "label": "Show character count",
      "default": true
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "input_border_radius",
      "label": "Input border radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 14,
      "max": 28,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f4f1ff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000041"
    },
    {
      "type": "color",
      "id": "input_background",
      "label": "Input background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "input_text_color",
      "label": "Input text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#03032b"
    },
    {
      "type": "color",
      "id": "focus_border_color",
      "label": "Focus border",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "placeholder_color",
      "label": "Placeholder",
      "default": "#5c5d5d"
    }
  ],
  "presets": [
    {
      "name": "Cart order notes"
    }
  ]
}
{% endschema %}
