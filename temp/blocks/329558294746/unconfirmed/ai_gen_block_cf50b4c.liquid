{% doc %}
  @prompt
    make me a 3 collection page slider or like 3 collection page cars make them unquieq like tech type and give me a templete which i can change later on 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-tech-collections-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-tech-collections__inner-{{ ai_gen_id }} {
    position: relative;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .ai-tech-collections__header-{{ ai_gen_id }} {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 24px;
  }

  .ai-tech-collections__eyebrow-{{ ai_gen_id }} {
    margin: 0 0 8px;
    color: {{ block.settings.accent_color }};
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .ai-tech-collections__title-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.heading_color }};
    font-size: clamp(28px, 4vw, 48px);
    line-height: 1.05;
  }

  .ai-tech-collections__intro-{{ ai_gen_id }} {
    max-width: 560px;
    margin: 12px 0 0;
    line-height: 1.6;
  }

  .ai-tech-collections__controls-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
  }

  .ai-tech-collections__button-{{ ai_gen_id }} {
    width: 42px;
    height: 42px;
    border: 1px solid {{ block.settings.border_color }};
    border-radius: 50%;
    background: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    cursor: pointer;
    font-size: 20px;
    line-height: 1;
  }

  .ai-tech-collections__button-{{ ai_gen_id }}:hover,
  .ai-tech-collections__button-{{ ai_gen_id }}:focus-visible {
    background: {{ block.settings.accent_color }};
    color: #ffffff;
  }

  .ai-tech-collections__button-{{ ai_gen_id }}:focus-visible,
  .ai-tech-collections__card-{{ ai_gen_id }}:focus-visible {
    outline: 3px solid {{ block.settings.accent_color }};
    outline-offset: 3px;
  }

  .ai-tech-collections__track-{{ ai_gen_id }} {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 32px) / 3);
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    scrollbar-color: {{ block.settings.accent_color }} transparent;
    padding: 4px 2px 14px;
  }

  .ai-tech-collections__card-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    min-height: 360px;
    overflow: hidden;
    scroll-snap-align: start;
    border-radius: {{ block.settings.card_radius }}px;
    background: #11112c;
    color: #ffffff;
    text-decoration: none;
  }

  .ai-tech-collections__image-{{ ai_gen_id }},
  .ai-tech-collections__placeholder-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-tech-collections__placeholder-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #252550;
  }

  .ai-tech-collections__placeholder-{{ ai_gen_id }} svg {
    width: 58%;
    height: 58%;
    opacity: 0.3;
  }

  .ai-tech-collections__overlay-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(1, 1, 51, 0.02) 24%, rgba(1, 1, 51, 0.9) 100%);
  }

  .ai-tech-collections__content-{{ ai_gen_id }} {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: end;
    width: 100%;
    padding: 24px;
  }

  .ai-tech-collections__number-{{ ai_gen_id }} {
    margin-bottom: auto;
    color: {{ block.settings.accent_color }};
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .ai-tech-collections__card-title-{{ ai_gen_id }} {
    margin: 0 0 8px;
    color: #ffffff;
    font-size: 25px;
  }

  .ai-tech-collections__card-text-{{ ai_gen_id }} {
    margin: 0 0 18px;
    color: #f1f1fc;
    font-size: 14px;
    line-height: 1.5;
  }

  .ai-tech-collections__link-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #ffffff;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @media screen and (max-width: 749px) {
    .ai-tech-collections__inner-{{ ai_gen_id }} { padding: 0 16px; }
    .ai-tech-collections__header-{{ ai_gen_id }} { align-items: start; flex-direction: column; }
    .ai-tech-collections__controls-{{ ai_gen_id }} { align-self: end; }
    .ai-tech-collections__track-{{ ai_gen_id }} { grid-auto-columns: 86%; }
    .ai-tech-collections__card-{{ ai_gen_id }} { min-height: 330px; }
  }
{% endstyle %}

<tech-collections-{{ ai_gen_id }} class="ai-tech-collections-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-tech-collections__inner-{{ ai_gen_id }}">
    <div class="ai-tech-collections__header-{{ ai_gen_id }}">
      <div>
        {% if block.settings.eyebrow != blank %}<p class="ai-tech-collections__eyebrow-{{ ai_gen_id }}">{{ block.settings.eyebrow | escape }}</p>{% endif %}
        <h2 class="ai-tech-collections__title-{{ ai_gen_id }}">{{ block.settings.heading | escape }}</h2>
        {% if block.settings.description != blank %}<p class="ai-tech-collections__intro-{{ ai_gen_id }}">{{ block.settings.description | escape }}</p>{% endif %}
      </div>
      <div class="ai-tech-collections__controls-{{ ai_gen_id }}">
        <button type="button" class="ai-tech-collections__button-{{ ai_gen_id }}" data-direction="prev" aria-label="Previous collections">&#8592;</button>
        <button type="button" class="ai-tech-collections__button-{{ ai_gen_id }}" data-direction="next" aria-label="Next collections">&#8594;</button>
      </div>
    </div>

    <div class="ai-tech-collections__track-{{ ai_gen_id }}" data-track>
      {% for i in (1..3) %}
        {% liquid
          assign collection_key = 'collection_' | append: i
          assign label_key = 'label_' | append: i
          assign text_key = 'text_' | append: i
          assign selected_collection = block.settings[collection_key]
          assign card_label = block.settings[label_key]
          assign card_text = block.settings[text_key]
        %}
        {% if selected_collection != blank %}
          <a class="ai-tech-collections__card-{{ ai_gen_id }}" href="{{ selected_collection.url }}">
            {% if selected_collection.featured_image %}
              <img class="ai-tech-collections__image-{{ ai_gen_id }}" src="{{ selected_collection.featured_image | image_url: width: 1200 }}" alt="{{ selected_collection.featured_image.alt | default: selected_collection.title | escape }}" loading="lazy" width="1200" height="900">
            {% else %}
              <div class="ai-tech-collections__placeholder-{{ ai_gen_id }}">{{ 'collection-apparel-1' | placeholder_svg_tag }}</div>
            {% endif %}
            <div class="ai-tech-collections__overlay-{{ ai_gen_id }}"></div>
            <div class="ai-tech-collections__content-{{ ai_gen_id }}">
              <span class="ai-tech-collections__number-{{ ai_gen_id }}">0{{ i }} / 03</span>
              <h3 class="ai-tech-collections__card-title-{{ ai_gen_id }}">{{ selected_collection.title | escape }}</h3>
              {% if card_text != blank %}<p class="ai-tech-collections__card-text-{{ ai_gen_id }}">{{ card_text | escape }}</p>{% endif %}
              <span class="ai-tech-collections__link-{{ ai_gen_id }}">{{ card_label | default: 'Explore collection' | escape }} <span aria-hidden="true">&#8594;</span></span>
            </div>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</tech-collections-{{ ai_gen_id }}>

<script>
  (function() {
    class TechCollections{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        this.track = this.querySelector('[data-track]');
        this.buttons = this.querySelectorAll('[data-direction]');
        this.buttons.forEach((button) => {
          button.addEventListener('click', () => {
            const amount = this.track.clientWidth * 0.92;
            this.track.scrollBy({ left: button.dataset.direction === 'next' ? amount : -amount, behavior: 'smooth' });
          });
        });
      }
    }
    if (!customElements.get('tech-collections-{{ ai_gen_id }}')) customElements.define('tech-collections-{{ ai_gen_id }}', TechCollections{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Tech collection slider",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Techty systems" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find your next setup" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Curated collections for smarter work, play, and everyday tech." },
    { "type": "collection", "id": "collection_1", "label": "Collection one" },
    { "type": "text", "id": "label_1", "label": "Link label one", "default": "Explore collection" },
    { "type": "textarea", "id": "text_1", "label": "Card text one", "default": "Build a cleaner, faster desk setup." },
    { "type": "collection", "id": "collection_2", "label": "Collection two" },
    { "type": "text", "id": "label_2", "label": "Link label two", "default": "Explore collection" },
    { "type": "textarea", "id": "text_2", "label": "Card text two", "default": "Power your everyday performance." },
    { "type": "collection", "id": "collection_3", "label": "Collection three" },
    { "type": "text", "id": "label_3", "label": "Link label three", "default": "Explore collection" },
    { "type": "textarea", "id": "text_3", "label": "Card text three", "default": "Smart accessories, made simple." },
    { "type": "header", "content": "Style" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "section_padding", "label": "Section spacing", "min": 10, "max": 100, "step": 5, "unit": "px", "default": 50 },
    { "type": "range", "id": "card_radius", "label": "Card radius", "min": 0, "max": 40, "step": 4, "unit": "px", "default": 4 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#f4f1ff" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#010133" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#000041" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#5353ce" },
    { "type": "color", "id": "border_color", "label": "Border", "default": "#000041" },
    { "type": "color", "id": "button_background", "label": "Button background", "default": "#000000" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#ffffff" }
  ],
  "presets": [ { "name": "Tech collection slider" } ],
  "tag": null,
  "class": "tech-collection-slider"
}
{% endschema %}