{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}{% style %}.ai-techty-{{ai_gen_id}}{display:block;width:100%}.ai-techty-{{ai_gen_id}}__panel{display:grid;grid-template-columns:1fr 1fr;gap:32px;align-items:stretch}.ai-techty-{{ai_gen_id}}__image{height:{{block.settings.image_height}}px;overflow:auto}.ai-techty-{{ai_gen_id}}__image img{width:100%;height:100%;object-fit:contain}.ai-techty-{{ai_gen_id}}__details{display:flex;flex-direction:column;justify-content:flex-start}.ai-techty-{{ai_gen_id}}__details h2{margin-top:0}.ai-techty-{{ai_gen_id}}__details form{display:flex;flex-direction:column;height:100%;gap:14px}.ai-techty-{{ai_gen_id}}__actions{margin-top:auto;display:grid;gap:14px}.ai-techty-{{ai_gen_id}}__actions button,.ai-techty-{{ai_gen_id}} .shopify-payment-button__button{min-height:54px;width:100%;border-radius:28px;background:#000041!important;color:#fff!important}.ai-techty-{{ai_gen_id}}__qty{display:flex;min-height:54px;border:1px solid #000041;border-radius:28px;overflow:hidden}.ai-techty-{{ai_gen_id}}__qty button{width:54px;border:0;background:#000041;color:#fff}.ai-techty-{{ai_gen_id}}__qty input{flex:1;text-align:center;border:0}.ai-techty-{{ai_gen_id}}__add{background:#F4F1FF!important;color:#000041!important}@media(max-width:749px){.ai-techty-{{ai_gen_id}}__panel{grid-template-columns:1fr}.ai-techty-{{ai_gen_id}}__image{height:{{block.settings.mobile_image_height}}px}}{% endstyle %}<div class="ai-techty-{{ai_gen_id}}" {{block.shopify_attributes}}><div class="ai-techty-{{ai_gen_id}}__panel"><div class="ai-techty-{{ai_gen_id}}__image">{% if block.settings.product %}{% for image in block.settings.product.images %}<img src="{{image|image_url:width:1400}}" alt="{{image.alt|escape}}">{% endfor %}{% else %}{{'image'|placeholder_svg_tag}}{% endif %}</div><div class="ai-techty-{{ai_gen_id}}__details">{% if block.settings.product %}<h2>{{block.settings.product.title}}</h2>{% form 'product',block.settings.product %}<strong>{{block.settings.product.price|money}}</strong><div class="ai-techty-{{ai_gen_id}}__qty"><button type="button">−</button><input type="number" name="quantity" value="1" min="1"><button type="button">+</button></div><div class="ai-techty-{{ai_gen_id}}__actions"><button class="ai-techty-{{ai_gen_id}}__add" type="submit">Add to cart</button>{{form|payment_button}}</div>{% endform %}{% endif %}</div></div></div>{% schema %}{"name":"Techty Featured Products","tag":null,"class":"techty-featured-products","settings":[{"type":"product","id":"product","label":"Product"},{"type":"range","id":"image_height","label":"Image height","min":300,"max":800,"step":50,"unit":"px","default":550},{"type":"range","id":"mobile_image_height","label":"Mobile image height","min":240,"max":600,"step":40,"unit":"px","default":360}],"presets":[{"name":"Techty Featured Products"}]}{% endschema %}