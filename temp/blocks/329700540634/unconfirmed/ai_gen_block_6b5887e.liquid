{% doc %}
  @prompt
    Create a new customizable Trending product carousel section for the Paris theme to replace the current single-product Featured product section. Let the merchant select 2 or 3 individual products in the theme editor. Show the selected products in a horizontally scrollable carousel with clear previous/next controls, responsive on desktop and mobile, preserving the featured-product look as closely as practical. Do not alter the existing Featured product section or other product sections.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}.ai-trending-carousel-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;background:{{ block.settings.background_color }};color:{{ block.settings.text_color }};padding:{{ block.settings.section_padding }}px 0}.ai-trending-carousel-{{ ai_gen_id }}__inner{max-width:1400px;margin:0 auto;padding:0 24px}.ai-trending-carousel-{{ ai_gen_id }}__header{display:flex;justify-content:space-between;align-items:center;margin-bottom:24px}.ai-trending-carousel-{{ ai_gen_id }}__title{margin:0;color:{{ block.settings.heading_color }};font-family:{{ block.settings.heading_font.family }};font-size:{{ block.settings.heading_size }}px}.ai-trending-carousel-{{ ai_gen_id }}__controls{display:flex;gap:8px}.ai-trending-carousel-{{ ai_gen_id }}__control{width:42px;height:42px;border:1px solid {{ block.settings.control_border_color }};border-radius:{{ block.settings.control_radius }}px;background:{{ block.settings.control_background }};color:{{ block.settings.control_icon_color }};font-size:25px;cursor:pointer}.ai-trending-carousel-{{ ai_gen_id }}__control:disabled{opacity:.45;cursor:not-allowed}.ai-trending-carousel-{{ ai_gen_id }}__viewport{overflow-x:auto;scroll-behavior:smooth}.ai-trending-carousel-{{ ai_gen_id }}__track{display:flex;gap:{{ block.settings.card_gap }}px}.ai-trending-carousel-{{ ai_gen_id }}__card{flex:0 0 calc((100% - {{ block.settings.card_gap }}px * 2)/3);color:{{ block.settings.text_color }};text-decoration:none}.ai-trending-carousel-{{ ai_gen_id }}__image{aspect-ratio:1;overflow:hidden;border-radius:{{ block.settings.image_radius }}px;background:{{ block.settings.image_background }};margin-bottom:14px}.ai-trending-carousel-{{ ai_gen_id }}__image img,.ai-trending-carousel-{{ ai_gen_id }}__image svg{width:100%;height:100%;object-fit:cover}.ai-trending-carousel-{{ ai_gen_id }}__vendor{margin:0 0 6px;color:{{ block.settings.muted_text_color }};font-size:12px;text-transform:uppercase}.ai-trending-carousel-{{ ai_gen_id }}__product-title{margin:0 0 8px;font-size:{{ block.settings.card_title_size }}px}.ai-trending-carousel-{{ ai_gen_id }}__price{font-weight:600}@media(max-width:749px){.ai-trending-carousel-{{ ai_gen_id }}{padding:{{ block.settings.mobile_padding }}px 0}.ai-trending-carousel-{{ ai_gen_id }}__inner{padding:0 16px}.ai-trending-carousel-{{ ai_gen_id }}__card{flex-basis:78%}.ai-trending-carousel-{{ ai_gen_id }}__title{font-size:{{ block.settings.mobile_heading_size }}px}}{% endstyle %}
<trending-product-carousel-{{ ai_gen_id }} class="ai-trending-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-trending-carousel-{{ ai_gen_id }}__inner"><div class="ai-trending-carousel-{{ ai_gen_id }}__header"><h2 class="ai-trending-carousel-{{ ai_gen_id }}__title">{{ block.settings.heading }}</h2><div class="ai-trending-carousel-{{ ai_gen_id }}__controls"><button type="button" class="ai-trending-carousel-{{ ai_gen_id }}__control" data-direction="prev" aria-label="Previous products">‹</button><button type="button" class="ai-trending-carousel-{{ ai_gen_id }}__control" data-direction="next" aria-label="Next products">›</button></div></div><div class="ai-trending-carousel-{{ ai_gen_id }}__viewport" data-viewport tabindex="0" aria-label="Trending products"><div class="ai-trending-carousel-{{ ai_gen_id }}__track">{% if block.settings.product_1 != blank %}<a class="ai-trending-carousel-{{ ai_gen_id }}__card" href="{{ block.settings.product_1.url }}"><div class="ai-trending-carousel-{{ ai_gen_id }}__image">{% if block.settings.product_1.featured_image %}<img src="{{ block.settings.product_1.featured_image | image_url: width: 900 }}" alt="{{ block.settings.product_1.title | escape }}" loading="lazy">{% else %}{{ 'product-apparel-1' | placeholder_svg_tag }}{% endif %}</div><h3 class="ai-trending-carousel-{{ ai_gen_id }}__product-title">{{ block.settings.product_1.title }}</h3><div class="ai-trending-carousel-{{ ai_gen_id }}__price">{{ block.settings.product_1.price | money }}</div></a>{% endif %}{% if block.settings.product_2 != blank %}<a class="ai-trending-carousel-{{ ai_gen_id }}__card" href="{{ block.settings.product_2.url }}"><div class="ai-trending-carousel-{{ ai_gen_id }}__image">{% if block.settings.product_2.featured_image %}<img src="{{ block.settings.product_2.featured_image | image_url: width: 900 }}" alt="{{ block.settings.product_2.title | escape }}" loading="lazy">{% else %}{{ 'product-apparel-1' | placeholder_svg_tag }}{% endif %}</div><h3 class="ai-trending-carousel-{{ ai_gen_id }}__product-title">{{ block.settings.product_2.title }}</h3><div class="ai-trending-carousel-{{ ai_gen_id }}__price">{{ block.settings.product_2.price | money }}</div></a>{% endif %}{% if block.settings.product_count == '3' and block.settings.product_3 != blank %}<a class="ai-trending-carousel-{{ ai_gen_id }}__card" href="{{ block.settings.product_3.url }}"><div class="ai-trending-carousel-{{ ai_gen_id }}__image">{% if block.settings.product_3.featured_image %}<img src="{{ block.settings.product_3.featured_image | image_url: width: 900 }}" alt="{{ block.settings.product_3.title | escape }}" loading="lazy">{% else %}{{ 'product-apparel-1' | placeholder_svg_tag }}{% endif %}</div><h3 class="ai-trending-carousel-{{ ai_gen_id }}__product-title">{{ block.settings.product_3.title }}</h3><div class="ai-trending-carousel-{{ ai_gen_id }}__price">{{ block.settings.product_3.price | money }}</div></a>{% endif %}</div></div></div></trending-product-carousel-{{ ai_gen_id }}>
<script>(function(){class TrendingProductCarousel{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.v=this.querySelector('[data-viewport]');this.querySelectorAll('[data-direction]').forEach(b=>b.addEventListener('click',()=>this.v.scrollBy({left:(b.dataset.direction==='next'?1:-1)*this.v.clientWidth*.85,behavior:'smooth'})))}}customElements.define('trending-product-carousel-{{ ai_gen_id }}',TrendingProductCarousel{{ ai_gen_id }})})();</script>
{% schema %}{"name":"Trending product carousel","settings":[{"type":"select","id":"product_count","label":"Products to show","options":[{"value":"2","label":"2"},{"value":"3","label":"3"}],"default":"3"},{"type":"product","id":"product_1","label":"Product 1"},{"type":"product","id":"product_2","label":"Product 2"},{"type":"product","id":"product_3","label":"Product 3"},{"type":"text","id":"heading","label":"Heading","default":"Trending now"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"font_picker","id":"heading_font","label":"Heading font","default":"inter_n7"},{"type":"range","id":"heading_size","label":"Heading size","min":20,"max":56,"step":2,"unit":"px","default":32},{"type":"range","id":"mobile_heading_size","label":"Mobile heading size","min":18,"max":36,"step":2,"unit":"px","default":24},{"type":"range","id":"card_title_size","label":"Product title size","min":12,"max":24,"step":1,"unit":"px","default":16},{"type":"color","id":"background_color","label":"Background","default":"#f4f1ff"},{"type":"color","id":"heading_color","label":"Heading","default":"#010133"},{"type":"color","id":"text_color","label":"Text","default":"#000041"},{"type":"color","id":"muted_text_color","label":"Muted text","default":"#4b4b63"},{"type":"color","id":"image_background","label":"Image background","default":"#e3dff8"},{"type":"color","id":"control_background","label":"Control background","default":"#000000"},{"type":"color","id":"control_icon_color","label":"Control icon","default":"#ffffff"},{"type":"color","id":"control_border_color","label":"Control border","default":"#000000"},{"type":"range","id":"section_padding","label":"Desktop padding","min":0,"max":80,"step":4,"unit":"px","default":40},{"type":"range","id":"mobile_padding","label":"Mobile padding","min":0,"max":60,"step":4,"unit":"px","default":28},{"type":"range","id":"card_gap","label":"Card gap","min":8,"max":40,"step":4,"unit":"px","default":20},{"type":"range","id":"image_radius","label":"Image radius","min":0,"max":20,"step":2,"unit":"px","default":4},{"type":"range","id":"control_radius","label":"Control radius","min":0,"max":20,"step":2,"unit":"px","default":4}],"presets":[{"name":"Trending product carousel"}],"tag":null,"class":"trending-product-carousel-block"}{% endschema %}