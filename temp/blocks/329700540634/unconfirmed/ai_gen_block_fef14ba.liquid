{% doc %}
  @prompt
    Create a new Paris-theme section that displays 2 or 3 individually selected products as a carousel of full Featured product panels, not a featured collection banner or a grid of product cards. Match the existing 'Trending Item' Featured product section appearance in the screenshot: each carousel slide contains one product with its image gallery and vertical thumbnails on the left, and its title, price, quantity selector, Add to cart and Buy it now controls on the right. Provide prominent outer previous/next controls to switch between the selected products, separate from the image gallery's own arrows. Each slide must show and purchase its own selected product correctly. Keep a responsive mobile layout. Do not modify or remove the existing Trending section., the picture is too big. I want it exactly like the featured prodcut image I sent. And the arrows need to be on the side , Make the main image bigger and thumbnail images under the main image and they should take less space , The thumbnail images do not correspond to the main picture , No I want the thumbnail to highlight the corresponding main image 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}{% style %}.ai-fpc-{{ai_gen_id}} .ai-fpc-thumb.active{border:3px solid {{block.settings.accent_color}};box-shadow:0 0 0 2px {{block.settings.background_color}} inset;opacity:1}.ai-fpc-{{ai_gen_id}} .ai-fpc-thumb:not(.active){opacity:.58}.ai-fpc-{{ai_gen_id}} .ai-fpc-thumb:focus-visible{outline:3px solid {{block.settings.accent_color}};outline-offset:2px}{% endstyle %}<script>(function(){var root=document.querySelector('.ai-fpc-{{ai_gen_id}}');if(!root)return;root.querySelectorAll('[data-slide]').forEach(function(slide){var main=slide.querySelector('[data-main]'),thumbs=[].slice.call(slide.querySelectorAll('[data-thumb]'));function sync(){var current=(main.getAttribute('src')||'').split('?')[0];thumbs.forEach(function(thumb){var image=(thumb.dataset.url||'').split('?')[0];thumb.classList.toggle('active',image===current)})}thumbs.forEach(function(thumb){thumb.addEventListener('click',function(){main.src=thumb.dataset.url;sync()})});slide.querySelectorAll('[data-prev],[data-next]').forEach(function(button){button.addEventListener('click',function(){window.setTimeout(sync,0)})});sync()})})();</script>{% schema %}{"name":"Thumbnail highlight fix","settings":[{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"color","id":"accent_color","label":"Accent","default":"#000041"},{"type":"color","id":"background_color","label":"Background","default":"#f4f1ff"}],"presets":[{"name":"Thumbnail highlight fix"}],"tag":null,"class":"thumbnail-highlight-fix"}{% endschema %}