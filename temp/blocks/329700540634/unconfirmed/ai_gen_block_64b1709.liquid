{% doc %}
  @prompt
    Create a NEW Paris theme section named 'Techty Featured Products' with repeatable product blocks: each block has ONE product picker, so I can add one product at a time (4 or 5 total) and drag/reorder the blocks in the theme editor to change carousel order. Do not use a single multi-product picker. Show one full product panel at a time, matching the existing Paris Featured product / Trending Item appearance: large scrollable main product image gallery on the left, with SMALL clickable image thumbnails horizontally BELOW it; selected product title, price, a centered and polished quantity selector, Add to cart and Buy it now on the right. Show variant selection only if that product has actual variant choices. Put prominent previous/next PRODUCT arrows at the outside left and right edges of the entire carousel, separate from controls for scrolling the current product's main images. Each slide's image gallery, variants, quantity, and purchase actions must operate on that slide's product. Responsive on mobile. Do not make compact cards or a featured collection banner. Do not modify or remove the existing Trending Featured product section or other blocks., This is just one product, I wanted at least 4 to 6 , Give me the ability to change the container. And Make the images scrollable , Make the thumbnails 20% smaller. And can you also give me the ability to change colors fonts and picture container , The arrows to switch between products is gone. Bring it Back and the Add to Cart button is the same color as the button make it F4F1FF color, Other products are not showing , wait No products are showing , Change the quantity picker look better , Can you make the quanity picker a bit longer and make add to cart and buy it now all the same length so that it looks cohesive 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}.techty-featured-products-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:auto;color:{{ block.settings.text_color }};position:relative}.techty-featured-products-{{ ai_gen_id }}__track{display:flex;overflow:hidden}.techty-featured-products-{{ ai_gen_id }}__slide{min-width:100%;display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center}.techty-featured-products-{{ ai_gen_id }}__gallery{background:{{ block.settings.picture_background }};border-radius:{{ block.settings.picture_radius }}px;overflow:hidden}.techty-featured-products-{{ ai_gen_id }}__main{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;aspect-ratio:1}.techty-featured-products-{{ ai_gen_id }}__main img{min-width:100%;object-fit:contain;scroll-snap-align:start}.techty-featured-products-{{ ai_gen_id }}__thumbs{display:flex;gap:8px;padding:10px;overflow:auto}.techty-featured-products-{{ ai_gen_id }}__thumb{width:53px;height:53px;flex:0 0 53px;padding:3px;background:#fff;border:1px solid #999}.techty-featured-products-{{ ai_gen_id }}__thumb img{width:100%;height:100%;object-fit:contain}.techty-featured-products-{{ ai_gen_id }}__info{display:flex;flex-direction:column;gap:16px}.techty-featured-products-{{ ai_gen_id }}__quantity{display:flex;align-items:center;justify-content:center;width:190px;height:50px;margin:2px auto 4px;border:1px solid #000041;border-radius:999px;background:#fff;overflow:hidden}.techty-featured-products-{{ ai_gen_id }}__quantity button{width:54px;height:50px;border:0;background:transparent;color:#000041;font-size:24px;cursor:pointer}.techty-featured-products-{{ ai_gen_id }}__quantity input{width:82px;height:50px;text-align:center;border:0;border-left:1px solid #d8d8e8;border-right:1px solid #d8d8e8;color:#000041;font-size:17px;font-weight:600;appearance:textfield}.techty-featured-products-{{ ai_gen_id }}__quantity input::-webkit-inner-spin-button,.techty-featured-products-{{ ai_gen_id }}__quantity input::-webkit-outer-spin-button{appearance:none}.techty-featured-products-{{ ai_gen_id }}__actions{display:flex;flex-direction:column;gap:10px;width:100%}.techty-featured-products-{{ ai_gen_id }}__button{display:flex;align-items:center;justify-content:center;width:100%;min-height:52px;padding:15px;border-radius:{{ block.settings.control_radius }}px;font-size:15px;cursor:pointer;box-sizing:border-box}.techty-featured-products-{{ ai_gen_id }}__cart{background:#F4F1FF;color:#000041;border:1px solid #000041}.techty-featured-products-{{ ai_gen_id }}__buy{background:{{ block.settings.accent_color }};color:#F4F1FF;border:1px solid {{ block.settings.accent_color }}}.techty-featured-products-{{ ai_gen_id }}__arrows{position:absolute;z-index:5;top:50%;left:-28px;right:-28px;display:flex;justify-content:space-between;transform:translateY(-50%)}.techty-featured-products-{{ ai_gen_id }}__arrows button{width:52px;height:52px;border-radius:50%;background:#F4F1FF;color:#000041;border:1px solid #000041;font-size:30px}@media(max-width:749px){.techty-featured-products-{{ ai_gen_id }}__slide{grid-template-columns:1fr}.techty-featured-products-{{ ai_gen_id }}__arrows{left:4px;right:4px}}{% endstyle %}
<techty-featured-products-{{ ai_gen_id }} class="techty-featured-products-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="techty-featured-products-{{ ai_gen_id }}__track">{% for i in (1..6) %}{% case i %}{% when 1 %}{% assign product=block.settings.product_1 %}{% when 2 %}{% assign product=block.settings.product_2 %}{% when 3 %}{% assign product=block.settings.product_3 %}{% when 4 %}{% assign product=block.settings.product_4 %}{% when 5 %}{% assign product=block.settings.product_5 %}{% when 6 %}{% assign product=block.settings.product_6 %}{% endcase %}{% if product != blank %}{% assign variant=product.selected_or_first_available_variant %}<article class="techty-featured-products-{{ ai_gen_id }}__slide"><div class="techty-featured-products-{{ ai_gen_id }}__gallery"><div class="techty-featured-products-{{ ai_gen_id }}__main">{% for image in product.images %}<img src="{{ image | image_url: width: 1400 }}" alt="{{ image.alt | default: product.title | escape }}">{% endfor %}</div><div class="techty-featured-products-{{ ai_gen_id }}__thumbs">{% for image in product.images %}<button type="button" class="techty-featured-products-{{ ai_gen_id }}__thumb" data-index="{{ forloop.index0 }}"><img src="{{ image | image_url: width: 120 }}" alt="{{ image.alt | default: product.title | escape }}"></button>{% endfor %}</div></div><div class="techty-featured-products-{{ ai_gen_id }}__info"><h2>{{ product.title }}</h2><strong>{{ variant.price | money }}</strong><div class="techty-featured-products-{{ ai_gen_id }}__quantity"><button type="button" data-minus>−</button><input type="number" min="1" value="1" data-quantity aria-label="Quantity"><button type="button" data-plus>+</button></div><div class="techty-featured-products-{{ ai_gen_id }}__actions"><form method="post" action="/cart/add"><input type="hidden" name="id" value="{{ variant.id }}"><input type="hidden" name="quantity" value="1" data-form-quantity><button type="submit" class="techty-featured-products-{{ ai_gen_id }}__button techty-featured-products-{{ ai_gen_id }}__cart">Add to cart</button></form><button type="button" class="techty-featured-products-{{ ai_gen_id }}__button techty-featured-products-{{ ai_gen_id }}__buy">Buy it now</button></div></div></article>{% endif %}{% endfor %}</div><div class="techty-featured-products-{{ ai_gen_id }}__arrows"><button type="button" data-prev>‹</button><button type="button" data-next>›</button></div></techty-featured-products-{{ ai_gen_id }}>
<script>(function(){class T{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.track=this.querySelector('[class*="__track"]');this.slides=[...this.querySelectorAll('[class*="__slide"]')];this.i=0;this.querySelector('[data-prev]').onclick=()=>this.go(this.i-1);this.querySelector('[data-next]').onclick=()=>this.go(this.i+1);this.slides.forEach(s=>{let q=s.querySelector('[data-quantity]'),f=s.querySelector('[data-form-quantity]');s.querySelector('[data-minus]').onclick=()=>{q.value=Math.max(1,+q.value-1);f.value=q.value};s.querySelector('[data-plus]').onclick=()=>{q.value=+q.value+1;f.value=q.value};q.oninput=()=>{q.value=Math.max(1,+q.value||1);f.value=q.value};let m=s.querySelector('[class*="__main"]');s.querySelectorAll('[data-index]').forEach(b=>b.onclick=()=>m.children[+b.dataset.index].scrollIntoView({behavior:'smooth',inline:'start'}))})}go(i){if(!this.slides.length)return;this.i=(i+this.slides.length)%this.slides.length;this.track.style.transform='translateX(-'+this.i*100+'%)'}}customElements.define('techty-featured-products-{{ ai_gen_id }}',T{{ ai_gen_id }})})();</script>
{% schema %}{"name":"Techty Featured Products","settings":[{"type":"product","id":"product_1","label":"Product 1"},{"type":"product","id":"product_2","label":"Product 2"},{"type":"product","id":"product_3","label":"Product 3"},{"type":"product","id":"product_4","label":"Product 4"},{"type":"product","id":"product_5","label":"Product 5"},{"type":"product","id":"product_6","label":"Product 6"},{"type":"color","id":"text_color","label":"Text","default":"#000041"},{"type":"color","id":"accent_color","label":"Accent","default":"#000041"},{"type":"color","id":"picture_background","label":"Picture background","default":"#F4F1FF"},{"type":"range","id":"picture_radius","label":"Picture radius","min":0,"max":40,"step":2,"unit":"px","default":4},{"type":"range","id":"control_radius","label":"Control radius","min":0,"max":20,"step":2,"unit":"px","default":4},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100}],"presets":[{"name":"Techty Featured Products"}],"tag":null,"class":"techty-featured-products"}{% endschema %}