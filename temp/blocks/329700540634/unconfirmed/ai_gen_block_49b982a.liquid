{% doc %}
  @prompt
    Create a NEW Paris theme section named 'Techty Featured Products' to replace the broken generated block, leaving the original Trending section untouched. Support 4 to 6 reorderable product blocks, each with its own single product picker; add products one at a time in the editor. Show one full Featured product panel at a time, with large independently scrollable main product images on the left and clickable thumbnails 20% smaller horizontally below, and title, price, real variant choices only if present, quantity, Add to cart and Buy it now on the right. FIX THE CURRENT FAILURE: products and their PICTURES do not appear on second and third carousel pages. For each slide, render images and thumbnails from THAT block's selected product, with a visible first image initially and working image navigation after switching products; avoid shared gallery state and duplicate element IDs. Include prominent outer left/right arrows to change products, separate from picture navigation. Ensure every slide shows the correct selected product, variant, image, thumbnail, price, and purchase form; the quantity and buttons work for that slide. Provide editor settings for overall container width, product/image container size, colors and fonts. Center and lengthen the polished quantity selector and align its width with Add to cart and Buy it now. Add to cart background #F4F1FF with readable contrasting text. Responsive on mobile. Do not create compact cards or a collection banner.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}{% style %}.techty-featured-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:auto;color:{{ block.settings.text_color }};font-family:{{ block.settings.body_font.family }}}.techty-featured__track-{{ ai_gen_id }}{display:flex;overflow:hidden}.techty-featured__slide-{{ ai_gen_id }}{flex:0 0 100%;display:grid;grid-template-columns:55% 1fr;gap:5%;padding:20px 70px;align-items:center}.techty-featured__main-{{ ai_gen_id }}{height:{{ block.settings.image_height }}px;background:{{ block.settings.image_background }};display:flex;align-items:center;justify-content:center;overflow:auto}.techty-featured__main-{{ ai_gen_id }} img{width:100%;height:100%;object-fit:contain}.techty-featured__thumbs-{{ ai_gen_id }}{display:flex;gap:8px;overflow:auto;padding:12px 10%}.techty-featured__thumb-{{ ai_gen_id }}{flex:0 0 80px;height:64px;padding:0;border:2px solid transparent;background:none}.techty-featured__thumb.is-active-{{ ai_gen_id }}{border-color:{{ block.settings.accent_color }}}.techty-featured__thumb img{width:100%;height:100%;object-fit:cover}.techty-featured__title-{{ ai_gen_id }}{color:{{ block.settings.heading_color }};font-family:{{ block.settings.heading_font.family }};font-size:clamp(24px,3vw,40px)}.techty-featured__price-{{ ai_gen_id }}{font-size:22px;margin-bottom:20px}.techty-featured__quantity-{{ ai_gen_id }},.techty-featured__add-{{ ai_gen_id }}{width:100%;min-height:50px;box-sizing:border-box}.techty-featured__quantity-{{ ai_gen_id }}{margin:20px 0 10px;text-align:center}.techty-featured__add-{{ ai_gen_id }}{border:0;background:#F4F1FF;color:#000041;font-weight:700}.techty-featured__arrow-{{ ai_gen_id }}{position:absolute;top:50%;z-index:2;border:1px solid {{ block.settings.border_color }};background:#fff;color:#000041;border-radius:50%;width:46px;height:46px;font-size:25px}.techty-featured__viewport-{{ ai_gen_id }}{position:relative}.techty-featured__prev-{{ ai_gen_id }}{left:8px}.techty-featured__next-{{ ai_gen_id }}{right:8px}@media(max-width:749px){.techty-featured__slide-{{ ai_gen_id }}{grid-template-columns:1fr;padding:15px 48px}.techty-featured__main-{{ ai_gen_id }}{height:{{ block.settings.mobile_image_height }}px}}{% endstyle %}
<techty-featured-{{ ai_gen_id }} class="techty-featured-{{ ai_gen_id }}" {{ block.shopify_attributes }}><h2>{{ block.settings.heading }}</h2>{% assign products='product_1,product_2,product_3,product_4,product_5,product_6' | split:',' %}<div class="techty-featured__viewport-{{ ai_gen_id }}"><button class="techty-featured__arrow-{{ ai_gen_id }} techty-featured__prev-{{ ai_gen_id }}" type="button">‹</button><div class="techty-featured__track-{{ ai_gen_id }}">{% for key in products %}{% assign product=block.settings[key] %}{% if product != blank %}{% assign variant=product.selected_or_first_available_variant %}<article class="techty-featured__slide-{{ ai_gen_id }}"><div><div class="techty-featured__main-{{ ai_gen_id }}">{% if product.images.first %}<img src="{{ product.images.first | image_url:width:1400 }}" data-main alt="{{ product.title | escape }}">{% else %}{{ 'product-apparel-1' | placeholder_svg_tag }}{% endif %}</div><div class="techty-featured__thumbs-{{ ai_gen_id }}">{% for image in product.images %}<button class="techty-featured__thumb-{{ ai_gen_id }}{% if forloop.first %} is-active-{{ ai_gen_id }}{% endif %}" type="button" data-image="{{ image | image_url:width:1400 }}"><img src="{{ image | image_url:width:180 }}" alt=""></button>{% endfor %}</div></div><div><h3 class="techty-featured__title-{{ ai_gen_id }}">{{ product.title }}</h3><div class="techty-featured__price-{{ ai_gen_id }}">{{ variant.price | money }}</div>{% form 'product',product %}<input type="hidden" name="id" value="{{ variant.id }}"><input class="techty-featured__quantity-{{ ai_gen_id }}" type="number" name="quantity" min="1" value="1" aria-label="Quantity"><button class="techty-featured__add-{{ ai_gen_id }}" type="submit">Add to cart</button>{{ form | payment_button }}{% endform %}</div></article>{% endif %}{% endfor %}</div><button class="techty-featured__arrow-{{ ai_gen_id }} techty-featured__arrow--next-{{ ai_gen_id }}" type="button">›</button></div></techty-featured-{{ ai_gen_id }}><script>(function(){class T extends HTMLElement{connectedCallback(){this.t=this.querySelector('.techty-featured__track-{{ ai_gen_id }}');this.s=[...this.querySelectorAll('.techty-featured__slide-{{ ai_gen_id }}')];this.i=0;this.querySelector('.techty-featured__prev-{{ ai_gen_id }}').onclick=()=>{this.i=(this.i-1+this.s.length)%this.s.length;this.go()};this.querySelector('.techty-featured__arrow--next-{{ ai_gen_id }}').onclick=()=>{this.i=(this.i+1)%this.s.length;this.go()};this.s.forEach(x=>x.querySelectorAll('[data-image]').forEach(b=>b.onclick=()=>{x.querySelector('[data-main]').src=b.dataset.image}));this.go()}go(){this.t.style.transform='translateX(-'+this.i*100+'%)'}}customElements.define('techty-featured-{{ ai_gen_id }}',T)})()</script>
{% schema %}{"name":"Techty Featured Products","tag":null,"class":"techty-featured-block","settings":[{"type":"text","id":"heading","label":"Heading","default":"Featured products"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"image_height","label":"Image height","min":300,"max":800,"step":50,"unit":"px","default":550},{"type":"range","id":"mobile_image_height","label":"Mobile image height","min":220,"max":600,"step":20,"unit":"px","default":360},{"type":"font_picker","id":"heading_font","label":"Heading font","default":"inter_n7"},{"type":"font_picker","id":"body_font","label":"Body font","default":"inter_n4"},{"type":"color","id":"heading_color","label":"Heading","default":"#010133"},{"type":"color","id":"text_color","label":"Text","default":"#000041"},{"type":"color","id":"image_background","label":"Image background","default":"#F4F1FF"},{"type":"color","id":"border_color","label":"Borders","default":"#585981"},{"type":"color","id":"accent_color","label":"Accent","default":"#000041"},{"type":"product","id":"product_1","label":"Product 1"},{"type":"product","id":"product_2","label":"Product 2"},{"type":"product","id":"product_3","label":"Product 3"},{"type":"product","id":"product_4","label":"Product 4"},{"type":"product","id":"product_5","label":"Product 5"},{"type":"product","id":"product_6","label":"Product 6"}],"presets":[{"name":"Techty Featured Products"}]}{% endschema %}