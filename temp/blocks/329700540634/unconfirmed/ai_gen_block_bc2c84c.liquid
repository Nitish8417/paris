{% doc %}
  @prompt
    Create a NEW Paris theme section named 'Techty Featured Products' to replace the broken generated block, leaving the original Trending section untouched. Support 4 to 6 reorderable product blocks, each with its own single product picker; add products one at a time in the editor. Show one full Featured product panel at a time, with large independently scrollable main product images on the left and clickable thumbnails 20% smaller horizontally below, and title, price, real variant choices only if present, quantity, Add to cart and Buy it now on the right. FIX THE CURRENT FAILURE: products and their PICTURES do not appear on second and third carousel pages. For each slide, render images and thumbnails from THAT block's selected product, with a visible first image initially and working image navigation after switching products; avoid shared gallery state and duplicate element IDs. Include prominent outer left/right arrows to change products, separate from picture navigation. Ensure every slide shows the correct selected product, variant, image, thumbnail, price, and purchase form; the quantity and buttons work for that slide. Provide editor settings for overall container width, product/image container size, colors and fonts. Center and lengthen the polished quantity selector and align its width with Add to cart and Buy it now. Add to cart background #F4F1FF with readable contrasting text. Responsive on mobile. Do not create compact cards or a collection banner., Make the quantity picker, add to cart and buy it now better. Make the thumbnails smaller. Make the Images scrollable, Make the image fit to container not zoomed in. Make add to cart, buy it now and quanity picker look more asthetic, Make the images scrollable Can you change the add to cart and buy it now buttons more rounded, and make the quantity picker a Stepper (- / +), The products are gone . , the arrows need to be centered not on the bottom
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}{% style %}.ai-fp-{{ai_gen_id}}{display:block;width:{{block.settings.desktop_width_percent}}%;max-width:100%;margin:auto}.ai-fp-{{ai_gen_id}}__slide{display:none;grid-template-columns:55% 1fr;gap:32px;background:{{block.settings.panel_color}};padding:32px;border-radius:16px}.ai-fp-{{ai_gen_id}}__slide.active{display:grid}.ai-fp-{{ai_gen_id}}__main{height:{{block.settings.image_height}}px;overflow:auto;background:#fff}.ai-fp-{{ai_gen_id}}__main img{width:100%;height:auto;min-height:100%;object-fit:contain}.ai-fp-{{ai_gen_id}}__thumbs{display:flex;gap:8px;overflow:auto;padding-top:10px}.ai-fp-{{ai_gen_id}}__thumb{flex:0 0 60px;height:60px;padding:0;border:2px solid transparent}.ai-fp-{{ai_gen_id}}__thumb.active{border-color:{{block.settings.accent}}}.ai-fp-{{ai_gen_id}}__thumb img{width:100%;height:100%;object-fit:contain}.ai-fp-{{ai_gen_id}}__details{display:flex;flex-direction:column;gap:15px}.ai-fp-{{ai_gen_id}} select,.ai-fp-{{ai_gen_id}}__qty{width:100%;padding:13px;border:1px solid #b9b5d5;border-radius:16px}.ai-fp-{{ai_gen_id}}__qty{display:flex;padding:0;max-width:320px;margin:auto}.ai-fp-{{ai_gen_id}}__qty button{width:48px;background:{{block.settings.accent}};color:#fff;border:0;font-size:22px}.ai-fp-{{ai_gen_id}}__qty input{flex:1;text-align:center;border:0}.ai-fp-{{ai_gen_id}}__actions{max-width:320px;width:100%;margin:auto;display:grid;gap:10px}.ai-fp-{{ai_gen_id}}__actions button{min-height:50px;border-radius:24px;font-weight:bold}.ai-fp-{{ai_gen_id}}__add{background:#F4F1FF;color:#000041;border:1px solid {{block.settings.accent}}}.ai-fp-{{ai_gen_id}}__arrow{position:absolute;top:50%;transform:translateY(-50%);border:0;border-radius:50%;width:46px;height:46px;background:{{block.settings.accent}};color:#fff;font-size:22px}.ai-fp-{{ai_gen_id}}__prev{left:0}.ai-fp-{{ai_gen_id}}__next{right:0}.ai-fp-{{ai_gen_id}}__viewport{position:relative;padding:0 52px}@media(max-width:749px){.ai-fp-{{ai_gen_id}}__slide{grid-template-columns:1fr;padding:18px}.ai-fp-{{ai_gen_id}}__viewport{padding:0 8px}}{% endstyle %}<featured-products-{{ai_gen_id}} class="ai-fp-{{ai_gen_id}}" {{block.shopify_attributes}}><h2>{{block.settings.heading}}</h2><div class="ai-fp-{{ai_gen_id}}__viewport"><button type="button" class="ai-fp-{{ai_gen_id}}__arrow ai-fp-{{ai_gen_id}}__prev">←</button><button type="button" class="ai-fp-{{ai_gen_id}}__arrow ai-fp-{{ai_gen_id}}__next">→</button>{% for p in block.settings.products %}<article class="ai-fp-{{ai_gen_id}}__slide{% if forloop.first %} active{% endif %}"><div><div class="ai-fp-{{ai_gen_id}}__main">{% for im in p.images %}<img src="{{im|image_url:width:1400}}" alt="{{im.alt|default:p.title|escape}}" data-i="{{forloop.index0}}"{% unless forloop.first %} hidden{% endunless %}>{% endfor %}</div><div class="ai-fp-{{ai_gen_id}}__thumbs">{% for im in p.images %}<button type="button" class="ai-fp-{{ai_gen_id}}__thumb{% if forloop.first %} active{% endif %}" data-i="{{forloop.index0}}"><img src="{{im|image_url:width:200}}" alt="{{im.alt|default:p.title|escape}}"></button>{% endfor %}</div></div><div class="ai-fp-{{ai_gen_id}}__details"><h3>{{p.title}}</h3>{% form 'product',p %}<strong>{{p.selected_or_first_available_variant.price|money}}</strong>{% for o in p.options_with_values %}<label>{{o.name}}<select name="options[{{o.name|escape}}]">{% for v in o.values %}<option>{{v}}</option>{% endfor %}</select></label>{% endfor %}<select name="id">{% for v in p.variants %}<option value="{{v.id}}"{% unless v.available %} disabled{% endunless %}>{{v.title}}</option>{% endfor %}</select><div class="ai-fp-{{ai_gen_id}}__qty"><button type="button" data-minus>−</button><input name="quantity" type="number" value="1" min="1"><button type="button" data-plus>+</button></div><div class="ai-fp-{{ai_gen_id}}__actions"><button class="ai-fp-{{ai_gen_id}}__add" type="submit">Add to cart</button>{{form|payment_button}}</div>{% endform %}</div></article>{% endfor %}</div></featured-products-{{ai_gen_id}}><script>(function(){class FP{{ai_gen_id}} extends HTMLElement{connectedCallback(){this.s=[...this.querySelectorAll('.ai-fp-{{ai_gen_id}}__slide')];this.i=0;this.querySelector('.ai-fp-{{ai_gen_id}}__prev').onclick=()=>this.go(this.i-1);this.querySelector('.ai-fp-{{ai_gen_id}}__next').onclick=()=>this.go(this.i+1);this.s.forEach(x=>{x.querySelectorAll('.ai-fp-{{ai_gen_id}}__thumb').forEach(b=>b.onclick=()=>{x.querySelectorAll('[data-i]').forEach(e=>e.hidden=e.dataset.i!=b.dataset.i);x.querySelectorAll('.ai-fp-{{ai_gen_id}}__thumb').forEach(e=>e.classList.toggle('active',e==b))});let q=x.querySelector('input[type=number]');x.querySelector('[data-minus]').onclick=()=>q.value=Math.max(1,+q.value-1);x.querySelector('[data-plus]').onclick=()=>q.value=+q.value+1})}go(i){this.i=(i+this.s.length)%this.s.length;this.s.forEach((x,j)=>x.classList.toggle('active',j==this.i))}}customElements.define('featured-products-{{ai_gen_id}}',FP{{ai_gen_id}})})();</script>{% schema %}{"name":"Techty Featured Products","tag":null,"class":"techty-featured-products","settings":[{"type":"text","id":"heading","label":"Heading","default":"Featured products"},{"type":"product_list","id":"products","label":"Products","limit":6},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"image_height","label":"Image height","min":300,"max":800,"step":50,"unit":"px","default":550},{"type":"color","id":"panel_color","label":"Panel background","default":"#F4F1FF"},{"type":"color","id":"accent","label":"Accent color","default":"#000041"}],"presets":[{"name":"Techty Featured Products"}]}{% endschema %}