{% doc %}
  @prompt
    Create a NEW Paris theme section named 'Techty Featured Products' to replace the broken generated block, leaving the original Trending section untouched. Support 4 to 6 reorderable product blocks, each with its own single product picker; add products one at a time in the editor. Show one full Featured product panel at a time, with large independently scrollable main product images on the left and clickable thumbnails 20% smaller horizontally below, and title, price, real variant choices only if present, quantity, Add to cart and Buy it now on the right. FIX THE CURRENT FAILURE: products and their PICTURES do not appear on second and third carousel pages. For each slide, render images and thumbnails from THAT block's selected product, with a visible first image initially and working image navigation after switching products; avoid shared gallery state and duplicate element IDs. Include prominent outer left/right arrows to change products, separate from picture navigation. Ensure every slide shows the correct selected product, variant, image, thumbnail, price, and purchase form; the quantity and buttons work for that slide. Provide editor settings for overall container width, product/image container size, colors and fonts. Center and lengthen the polished quantity selector and align its width with Add to cart and Buy it now. Add to cart background #F4F1FF with readable contrasting text. Responsive on mobile. Do not create compact cards or a collection banner., Make the quantity picker, add to cart and buy it now better. Make the thumbnails smaller. Make the Images scrollable
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-featured-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:auto;color:{{ block.settings.text_color }};font-family:{{ block.settings.body_font.family }}}
.ai-featured-{{ ai_gen_id }}__heading{margin:0 0 24px;text-align:center;color:{{ block.settings.heading_color }};font-family:{{ block.settings.heading_font.family }}}
.ai-featured-{{ ai_gen_id }}__viewport{position:relative;overflow:hidden}.ai-featured-{{ ai_gen_id }}__track{display:flex;transition:transform .25s ease}.ai-featured-{{ ai_gen_id }}__slide{min-width:100%;display:grid;grid-template-columns:minmax(0,{{ block.settings.image_column_percent }}%) minmax(280px,1fr);gap:32px;align-items:center;padding:8px 64px;box-sizing:border-box}.ai-featured-{{ ai_gen_id }}__gallery{min-width:0}.ai-featured-{{ ai_gen_id }}__main{width:100%;height:{{ block.settings.image_height }}px;overflow:auto;display:block;background:{{ block.settings.image_background }};border-radius:{{ block.settings.radius }}px;white-space:nowrap}.ai-featured-{{ ai_gen_id }}__main img{display:block;width:auto;max-width:none;height:auto;min-height:100%;object-fit:contain}.ai-featured-{{ ai_gen_id }}__main svg{width:100%;height:100%}.ai-featured-{{ ai_gen_id }}__thumbs{display:flex;gap:8px;overflow-x:auto;margin-top:12px;padding:0 10%}.ai-featured-{{ ai_gen_id }}__thumb{flex:0 0 64px;width:64px;height:64px;border:1px solid {{ block.settings.border_color }};padding:0;background:{{ block.settings.image_background }};cursor:pointer;border-radius:{{ block.settings.radius }}px;overflow:hidden}.ai-featured-{{ ai_gen_id }}__thumb img{width:100%;height:100%;object-fit:cover}.ai-featured-{{ ai_gen_id }}__details{display:flex;flex-direction:column;gap:18px}.ai-featured-{{ ai_gen_id }}__title{margin:0;color:{{ block.settings.heading_color }};font-family:{{ block.settings.heading_font.family }}}.ai-featured-{{ ai_gen_id }}__price{font-size:1.25rem;font-weight:700}.ai-featured-{{ ai_gen_id }}__option label{display:block;margin-bottom:6px;font-weight:600}.ai-featured-{{ ai_gen_id }}__select,.ai-featured-{{ ai_gen_id }}__quantity{width:100%;min-height:50px;border:1px solid {{ block.settings.border_color }};border-radius:{{ block.settings.radius }}px;background:{{ block.settings.input_background }};color:{{ block.settings.text_color }};padding:10px 14px;box-sizing:border-box}.ai-featured-{{ ai_gen_id }}__quantity{display:block;width:100%;max-width:100%;margin:0 auto;text-align:center;font-size:1.05rem}.ai-featured-{{ ai_gen_id }}__actions{display:grid;gap:10px;width:100%}.ai-featured-{{ ai_gen_id }}__button{width:100%;min-height:54px;padding:12px;border-radius:{{ block.settings.radius }}px;cursor:pointer;font:inherit;font-weight:700}.ai-featured-{{ ai_gen_id }}__add{background:#F4F1FF;color:#03032B;border:1px solid #03032B}.ai-featured-{{ ai_gen_id }}__buy{background:{{ block.settings.buy_background }};color:{{ block.settings.buy_text }};border:1px solid {{ block.settings.buy_background }}}.ai-featured-{{ ai_gen_id }}__arrow{position:absolute;z-index:2;top:50%;transform:translateY(-50%);width:44px;height:44px;border:1px solid {{ block.settings.border_color }};border-radius:50%;background:{{ block.settings.arrow_background }};color:{{ block.settings.arrow_color }};cursor:pointer;font-size:25px}.ai-featured-{{ ai_gen_id }}__arrow--prev{left:6px}.ai-featured-{{ ai_gen_id }}__arrow--next{right:6px}.ai-featured-{{ ai_gen_id }}__empty{text-align:center;padding:50px 20px;background:{{ block.settings.image_background }}}@media(max-width:749px){.ai-featured-{{ ai_gen_id }}__slide{grid-template-columns:1fr;gap:20px;padding:8px 44px}.ai-featured-{{ ai_gen_id }}__main{height:{{ block.settings.mobile_image_height }}px}.ai-featured-{{ ai_gen_id }}__thumbs{padding:0}}
{% endstyle %}
<featured-products-{{ ai_gen_id }} class="ai-featured-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
{% if block.settings.heading != blank %}<h2 class="ai-featured-{{ ai_gen_id }}__heading">{{ block.settings.heading }}</h2>{% endif %}
{% assign product_count=0 %}{% for i in (1..6) %}{% assign key='product_' | append:i %}{% if block.settings[key] != blank %}{% assign product_count=product_count | plus:1 %}{% endif %}{% endfor %}
{% if product_count > 0 %}<div class="ai-featured-{{ ai_gen_id }}__viewport"><button type="button" class="ai-featured-{{ ai_gen_id }}__arrow ai-featured-{{ ai_gen_id }}__arrow--prev" aria-label="Previous product">‹</button><div class="ai-featured-{{ ai_gen_id }}__track">
{% for i in (1..6) %}{% assign key='product_' | append:i %}{% assign product=block.settings[key] %}{% if product != blank %}{% assign first=product.media | where:'media_type','image' | first %}<article class="ai-featured-{{ ai_gen_id }}__slide" data-slide><div class="ai-featured-{{ ai_gen_id }}__gallery"><div class="ai-featured-{{ ai_gen_id }}__main">{% if first %}<img src="{{ first | image_url:width:1400 }}" alt="{{ first.alt | default:product.title | escape }}" data-main-image>{% else %}{{ 'image' | placeholder_svg_tag }}{% endif %}</div><div class="ai-featured-{{ ai_gen_id }}__thumbs">{% for media in product.media %}{% if media.media_type == 'image' %}<button type="button" class="ai-featured-{{ ai_gen_id }}__thumb" data-image="{{ media | image_url:width:1400 }}"><img src="{{ media | image_url:width:160 }}" alt="{{ media.alt | default:product.title | escape }}" loading="lazy"></button>{% endif %}{% endfor %}</div></div><div class="ai-featured-{{ ai_gen_id }}__details"><h3 class="ai-featured-{{ ai_gen_id }}__title">{{ product.title }}</h3><div class="ai-featured-{{ ai_gen_id }}__price">{{ product.selected_or_first_available_variant.price | money }}</div>{% form 'product',product %}{% unless product.has_only_default_variant %}{% for option in product.options_with_values %}<div class="ai-featured-{{ ai_gen_id }}__option"><label for="{{ ai_gen_id }}-{{ i }}-{{ forloop.index }}">{{ option.name }}</label><select class="ai-featured-{{ ai_gen_id }}__select" id="{{ ai_gen_id }}-{{ i }}-{{ forloop.index }}">{% for value in option.values %}<option>{{ value }}</option>{% endfor %}</select></div>{% endfor %}{% endunless %}<select name="id" class="ai-featured-{{ ai_gen_id }}__select" hidden>{% for variant in product.variants %}<option value="{{ variant.id }}"{% unless variant.available %} disabled{% endunless %}>{{ variant.title }}</option>{% endfor %}</select><input class="ai-featured-{{ ai_gen_id }}__quantity" type="number" name="quantity" min="1" value="1" aria-label="Quantity"><div class="ai-featured-{{ ai_gen_id }}__actions"><button type="submit" class="ai-featured-{{ ai_gen_id }}__button ai-featured-{{ ai_gen_id }}__add">Add to cart</button>{% if product.available %}<button type="submit" name="buy_now" class="ai-featured-{{ ai_gen_id }}__button ai-featured-{{ ai_gen_id }}__buy">Buy it now</button>{% endif %}</div>{% endform %}</div></article>{% endif %}{% endfor %}</div><button type="button" class="ai-featured-{{ ai_gen_id }}__arrow ai-featured-{{ ai_gen_id }}__arrow--next" aria-label="Next product">›</button></div>{% else %}<div class="ai-featured-{{ ai_gen_id }}__empty">Add products one at a time in the block settings.</div>{% endif %}</featured-products-{{ ai_gen_id }}>
<script>(function(){class FeaturedProducts{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.track=this.querySelector('.ai-featured-{{ ai_gen_id }}__track');this.slides=[...this.querySelectorAll('[data-slide]')];this.index=0;this.querySelector('.ai-featured-{{ ai_gen_id }}__arrow--prev')?.addEventListener('click',()=>this.move(-1));this.querySelector('.ai-featured-{{ ai_gen_id }}__arrow--next')?.addEventListener('click',()=>this.move(1));this.slides.forEach(slide=>slide.querySelectorAll('[data-image]').forEach(button=>button.addEventListener('click',()=>{let image=slide.querySelector('[data-main-image]');if(image)image.src=button.dataset.image;})))}move(step){this.index=(this.index+step+this.slides.length)%this.slides.length;this.track.style.transform='translateX(-'+this.index*100+'%)'}}customElements.define('featured-products-{{ ai_gen_id }}',FeaturedProducts{{ ai_gen_id }})})();</script>
{% schema %}{"name":"Techty Featured Products","settings":[{"type":"text","id":"heading","label":"Heading","default":"Featured products"},{"type":"font_picker","id":"heading_font","label":"Heading font","default":"inter_n7"},{"type":"font_picker","id":"body_font","label":"Body font","default":"inter_n4"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"image_column_percent","label":"Image column","min":40,"max":70,"step":5,"unit":"%","default":55},{"type":"range","id":"image_height","label":"Image height","min":300,"max":900,"step":50,"unit":"px","default":600},{"type":"range","id":"mobile_image_height","label":"Mobile image height","min":220,"max":600,"step":20,"unit":"px","default":360},{"type":"range","id":"radius","label":"Corner radius","min":0,"max":20,"step":2,"unit":"px","default":4},{"type":"product","id":"product_1","label":"Product 1"},{"type":"product","id":"product_2","label":"Product 2"},{"type":"product","id":"product_3","label":"Product 3"},{"type":"product","id":"product_4","label":"Product 4"},{"type":"product","id":"product_5","label":"Product 5"},{"type":"product","id":"product_6","label":"Product 6"},{"type":"color","id":"heading_color","label":"Heading color","default":"#03032B"},{"type":"color","id":"text_color","label":"Text color","default":"#000041"},{"type":"color","id":"image_background","label":"Image background","default":"#F4F1FF"},{"type":"color","id":"input_background","label":"Input background","default":"#FFFFFF"},{"type":"color","id":"border_color","label":"Border color","default":"#585981"},{"type":"color","id":"buy_background","label":"Buy background","default":"#03032B"},{"type":"color","id":"buy_text","label":"Buy text","default":"#F4F1FF"},{"type":"color","id":"arrow_background","label":"Arrow background","default":"#FFFFFF"},{"type":"color","id":"arrow_color","label":"Arrow color","default":"#03032B"}],"presets":[{"name":"Techty Featured Products"}],"tag":null,"class":"techty-featured-products"}{% endschema %}