{% doc %}
  @prompt
    Create a NEW Paris theme section named 'Techty Featured Products' with repeatable product blocks: each block has ONE product picker, so I can add one product at a time (4 or 5 total) and drag/reorder the blocks in the theme editor to change carousel order. Do not use a single multi-product picker. Show one full product panel at a time, matching the existing Paris Featured product / Trending Item appearance: large scrollable main product image gallery on the left, with SMALL clickable image thumbnails horizontally BELOW it; selected product title, price, a centered and polished quantity selector, Add to cart and Buy it now on the right. Show variant selection only if that product has actual variant choices. Put prominent previous/next PRODUCT arrows at the outside left and right edges of the entire carousel, separate from controls for scrolling the current product's main images. Each slide's image gallery, variants, quantity, and purchase actions must operate on that slide's product. Responsive on mobile. Do not make compact cards or a featured collection banner. Do not modify or remove the existing Trending Featured product section or other blocks., This is just one product, I wanted at least 4 to 6 , Give me the ability to change the container. And Make the images scrollable , Make the thumbnails 20% smaller. And can you also give me the ability to change colors fonts and picture container 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-techty-carousel-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:0 auto;color:{{ block.settings.text_color }};font-family:{{ block.settings.body_font.family }};}.ai-techty-carousel-{{ ai_gen_id }}__viewport{overflow:hidden}.ai-techty-carousel-{{ ai_gen_id }}__track{display:flex;transition:transform .25s ease}.ai-techty-carousel-{{ ai_gen_id }}__slide{min-width:100%;display:grid;grid-template-columns:minmax(0,1.15fr) minmax(280px,.85fr);gap:clamp(28px,5vw,72px);align-items:center}.ai-techty-carousel-{{ ai_gen_id }}__main{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:thin;background:{{ block.settings.picture_background }};aspect-ratio:1;border-radius:{{ block.settings.picture_radius }}px}.ai-techty-carousel-{{ ai_gen_id }}__main-item{min-width:100%;scroll-snap-align:start;display:flex}.ai-techty-carousel-{{ ai_gen_id }}__main-item img{width:100%;height:100%;object-fit:contain}.ai-techty-carousel-{{ ai_gen_id }}__thumbs{display:flex;gap:8px;overflow-x:auto;padding:12px 2px 4px}.ai-techty-carousel-{{ ai_gen_id }}__thumb{width:53px;height:53px;flex:0 0 53px;padding:3px;background:#fff;border:1px solid #bbb;border-radius:{{ block.settings.picture_radius }}px;cursor:pointer}.ai-techty-carousel-{{ ai_gen_id }}__thumb[aria-current=true]{border:2px solid {{ block.settings.accent_color }}}.ai-techty-carousel-{{ ai_gen_id }}__thumb img{width:100%;height:100%;object-fit:contain}.ai-techty-carousel-{{ ai_gen_id }}__info{display:flex;flex-direction:column;gap:16px}.ai-techty-carousel-{{ ai_gen_id }}__title{margin:0;font-family:{{ block.settings.heading_font.family }};font-size:clamp(24px,3vw,42px);color:{{ block.settings.heading_color }}}.ai-techty-carousel-{{ ai_gen_id }}__price{font-size:20px;font-weight:600}.ai-techty-carousel-{{ ai_gen_id }}__select,.ai-techty-carousel-{{ ai_gen_id }}__quantity{min-height:46px;border:1px solid {{ block.settings.accent_color }};border-radius:{{ block.settings.control_radius }}px;background:#fff;color:{{ block.settings.text_color }};padding:0 14px}.ai-techty-carousel-{{ ai_gen_id }}__select{width:100%}.ai-techty-carousel-{{ ai_gen_id }}__quantity-wrap{display:flex;justify-content:center;align-items:center;gap:18px}.ai-techty-carousel-{{ ai_gen_id }}__quantity{width:74px;text-align:center}.ai-techty-carousel-{{ ai_gen_id }}__qty{border:0;background:transparent;color:{{ block.settings.accent_color }};font-size:26px;cursor:pointer}.ai-techty-carousel-{{ ai_gen_id }}__actions{display:grid;gap:10px}.ai-techty-carousel-{{ ai_gen_id }}__button{min-height:50px;border-radius:{{ block.settings.control_radius }}px;border:1px solid {{ block.settings.accent_color }};cursor:pointer;font-weight:600}.ai-techty-carousel-{{ ai_gen_id }}__cart{background:{{ block.settings.accent_color }};color:{{ block.settings.button_text_color }}}.ai-techty-carousel-{{ ai_gen_id }}__buy{background:{{ block.settings.button_background }};color:{{ block.settings.button_text_color }}}.ai-techty-carousel-{{ ai_gen_id }}__product-nav{position:absolute;top:50%;left:-34px;right:-34px;display:flex;justify-content:space-between;transform:translateY(-50%);pointer-events:none}.ai-techty-carousel-{{ ai_gen_id }}__nav{pointer-events:auto;width:52px;height:52px;border:1px solid {{ block.settings.accent_color }};border-radius:50%;background:{{ block.settings.button_background }};color:{{ block.settings.accent_color }};font-size:30px;cursor:pointer}@media(max-width:749px){.ai-techty-carousel-{{ ai_gen_id }}__slide{grid-template-columns:1fr;gap:24px}.ai-techty-carousel-{{ ai_gen_id }}__product-nav{left:4px;right:4px}.ai-techty-carousel-{{ ai_gen_id }}__nav{width:44px;height:44px;font-size:24px}}
{% endstyle %}
<techty-featured-products-{{ ai_gen_id }} class="ai-techty-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-techty-carousel-{{ ai_gen_id }}__viewport"><div class="ai-techty-carousel-{{ ai_gen_id }}__track">{% for i in (1..6) %}{% assign key='product_' | append:i %}{% assign product=block.settings[key] %}{% if product != blank %}{% assign variant=product.selected_or_first_available_variant %}<article class="ai-techty-carousel-{{ ai_gen_id }}__slide" data-slide><div><div class="ai-techty-carousel-{{ ai_gen_id }}__main" data-main>{% for image in product.images %}<div class="ai-techty-carousel-{{ ai_gen_id }}__main-item"><img src="{{ image | image_url: width:1400 }}" alt="{{ image.alt | default:product.title | escape }}"></div>{% endfor %}</div><div class="ai-techty-carousel-{{ ai_gen_id }}__thumbs">{% for image in product.images %}<button class="ai-techty-carousel-{{ ai_gen_id }}__thumb" type="button" data-i="{{ forloop.index0 }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}"><img src="{{ image | image_url: width:120 }}" alt="{{ image.alt | default:product.title | escape }}"></button>{% endfor %}</div></div><div class="ai-techty-carousel-{{ ai_gen_id }}__info"><h2 class="ai-techty-carousel-{{ ai_gen_id }}__title">{{ product.title }}</h2><div class="ai-techty-carousel-{{ ai_gen_id }}__price">{{ variant.price | money }}</div>{% unless product.has_only_default_variant %}{% for option in product.options_with_values %}<label>{{ option.name }}<select class="ai-techty-carousel-{{ ai_gen_id }}__select" data-option="{{ forloop.index0 }}">{% for value in option.values %}<option>{{ value }}</option>{% endfor %}</select></label>{% endfor %}{% endunless %}<div class="ai-techty-carousel-{{ ai_gen_id }}__quantity-wrap"><button class="ai-techty-carousel-{{ ai_gen_id }}__qty" data-minus type="button">−</button><input class="ai-techty-carousel-{{ ai_gen_id }}__quantity" data-quantity type="number" min="1" value="1"><button class="ai-techty-carousel-{{ ai_gen_id }}__qty" data-plus type="button">+</button></div><div class="ai-techty-carousel-{{ ai_gen_id }}__actions"><button class="ai-techty-carousel-{{ ai_gen_id }}__button ai-techty-carousel-{{ ai_gen_id }}__cart" data-add type="button">Add to cart</button><button class="ai-techty-carousel-{{ ai_gen_id }}__button ai-techty-carousel-{{ ai_gen_id }}__buy" data-buy type="button">Buy it now</button></div></div><script type="application/json" data-v>{{ product.variants | json }}</script></article>{% endif %}{% endfor %}</div></div><div class="ai-techty-carousel-{{ ai_gen_id }}__product-nav"><button class="ai-techty-carousel-{{ ai_gen_id }}__nav" data-prev type="button">‹</button><button class="ai-techty-carousel-{{ ai_gen_id }}__nav" data-next type="button">›</button></div></techty-featured-products-{{ ai_gen_id }}>
<script>(function(){class T{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.t=this.querySelector('[data-slide]')?.parentElement;this.s=[...this.querySelectorAll('[data-slide]')];this.n=0;this.querySelector('[data-prev]')?.addEventListener('click',()=>this.go(this.n-1));this.querySelector('[data-next]')?.addEventListener('click',()=>this.go(this.n+1));this.s.forEach(x=>{let g=x.querySelector('[data-main]');x.querySelectorAll('[data-i]').forEach(b=>b.onclick=()=>{g.children[+b.dataset.i].scrollIntoView({behavior:'smooth',inline:'start'});x.querySelectorAll('[data-i]').forEach(q=>q.setAttribute('aria-current','false'));b.setAttribute('aria-current','true')});x.querySelector('[data-minus]').onclick=()=>x.querySelector('[data-quantity]').value=Math.max(1,+x.querySelector('[data-quantity]').value-1);x.querySelector('[data-plus]').onclick=()=>x.querySelector('[data-quantity]').value=+x.querySelector('[data-quantity]').value+1;let v=JSON.parse(x.querySelector('[data-v]').textContent),chosen=v[0];x.querySelectorAll('[data-option]').forEach(o=>o.onchange=()=>{let a=[...x.querySelectorAll('[data-option]')].map(q=>q.value);chosen=v.find(z=>z.options.every((q,i)=>q==a[i]))||chosen});let add=buy=>{let f=document.createElement('form');f.method='post';f.action='/cart/add';f.innerHTML='<input name="id" value="'+chosen.id+'"><input name="quantity" value="'+x.querySelector('[data-quantity]').value+'">'+(buy?'<input name="return_to" value="/checkout">':'');document.body.appendChild(f);f.submit()};x.querySelector('[data-add]').onclick=()=>add(false);x.querySelector('[data-buy]').onclick=()=>add(true)})}go(i){this.n=(i+this.s.length)%this.s.length;this.t.style.transform='translateX(-'+this.n*100+'%)'}}customElements.define('techty-featured-products-{{ ai_gen_id }}',T{{ ai_gen_id }})})();</script>
{% schema %}{"name":"Techty Featured Products","settings":[{"type":"header","content":"Products"},{"type":"product","id":"product_1","label":"Product 1"},{"type":"product","id":"product_2","label":"Product 2"},{"type":"product","id":"product_3","label":"Product 3"},{"type":"product","id":"product_4","label":"Product 4"},{"type":"product","id":"product_5","label":"Product 5"},{"type":"product","id":"product_6","label":"Product 6"},{"type":"header","content":"Typography"},{"type":"font_picker","id":"heading_font","label":"Headings","default":"assistant_n4"},{"type":"font_picker","id":"body_font","label":"Body text","default":"assistant_n4"},{"type":"color","id":"heading_color","label":"Heading","default":"#010133"},{"type":"color","id":"text_color","label":"Text","default":"#000041"},{"type":"header","content":"Colors and picture"},{"type":"color","id":"accent_color","label":"Accent","default":"#000041"},{"type":"color","id":"button_background","label":"Button background","default":"#f4f1ff"},{"type":"color","id":"button_text_color","label":"Button text","default":"#000041"},{"type":"color","id":"picture_background","label":"Picture background","default":"#f4f1ff"},{"type":"range","id":"picture_radius","label":"Picture radius","min":0,"max":40,"step":2,"unit":"px","default":4},{"type":"select","id":"container_width","label":"Container width","options":[{"value":"full","label":"Full width"},{"value":"wide","label":"Wide"},{"value":"medium","label":"Medium"}],"default":"wide"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"control_radius","label":"Control radius","min":0,"max":20,"step":2,"unit":"px","default":4}],"presets":[{"name":"Techty Featured Products"}],"tag":null,"class":"techty-featured-products"}{% endschema %}