{% doc %}
  @prompt
    Can you make a featured products block which allows me to scroll through multiple trending products with a quick add to cart options as well 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-trending-products-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    color: {{ block.settings.text_color }};
  }

  .ai-trending-products__header-{{ ai_gen_id }} {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 24px;
  }

  .ai-trending-products__heading-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.15;
  }

  .ai-trending-products__intro-{{ ai_gen_id }} {
    margin: 8px 0 0;
    color: {{ block.settings.text_color }};
    line-height: 1.5;
  }

  .ai-trending-products__controls-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
  }

  .ai-trending-products__control-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.button_radius }}px;
    background: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    cursor: pointer;
  }

  .ai-trending-products__control-{{ ai_gen_id }}:hover,
  .ai-trending-products__control-{{ ai_gen_id }}:focus-visible {
    background: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
  }

  .ai-trending-products__control-{{ ai_gen_id }}:focus-visible,
  .ai-trending-products__quick-add-{{ ai_gen_id }}:focus-visible,
  .ai-trending-products__card-link-{{ ai_gen_id }}:focus-visible {
    outline: 2px solid {{ block.settings.focus_color }};
    outline-offset: 3px;
  }

  .ai-trending-products__track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.card_gap }}px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    padding: 2px 2px 14px;
  }

  .ai-trending-products__card-{{ ai_gen_id }} {
    flex: 0 0 calc((100% - ({{ block.settings.cards_desktop | minus: 1 }} * {{ block.settings.card_gap }}px)) / {{ block.settings.cards_desktop }});
    min-width: 220px;
    scroll-snap-align: start;
  }

  .ai-trending-products__image-wrap-{{ ai_gen_id }} {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: {{ block.settings.card_radius }}px;
    background: {{ block.settings.image_background }};
  }

  .ai-trending-products__image-wrap-{{ ai_gen_id }} img,
  .ai-trending-products__placeholder-{{ ai_gen_id }} svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-trending-products__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    color: {{ block.settings.text_color }};
  }

  .ai-trending-products__badge-{{ ai_gen_id }} {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 5px 9px;
    border-radius: 999px;
    background: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    font-size: 12px;
    font-weight: 700;
  }

  .ai-trending-products__details-{{ ai_gen_id }} {
    padding-top: 14px;
  }

  .ai-trending-products__title-{{ ai_gen_id }} {
    display: block;
    margin: 0 0 7px;
    color: {{ block.settings.heading_color }};
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
  }

  .ai-trending-products__title-{{ ai_gen_id }}:hover {
    text-decoration: underline;
  }

  .ai-trending-products__price-{{ ai_gen_id }} {
    margin-bottom: 12px;
    color: {{ block.settings.text_color }};
    font-size: 15px;
  }

  .ai-trending-products__quick-add-{{ ai_gen_id }} {
    width: 100%;
    min-height: 42px;
    padding: 10px 14px;
    border: 1px solid {{ block.settings.button_background }};
    border-radius: {{ block.settings.button_radius }}px;
    background: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    cursor: pointer;
    font: inherit;
    font-weight: 600;
  }

  .ai-trending-products__quick-add-{{ ai_gen_id }}:hover:not(:disabled) {
    background: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
  }

  .ai-trending-products__quick-add-{{ ai_gen_id }}:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .ai-trending-products__status-{{ ai_gen_id }} {
    min-height: 20px;
    margin-top: 8px;
    color: {{ block.settings.text_color }};
    font-size: 13px;
  }

  @media screen and (max-width: 749px) {
    .ai-trending-products__header-{{ ai_gen_id }} {
      align-items: start;
      flex-direction: column;
    }

    .ai-trending-products__card-{{ ai_gen_id }} {
      flex-basis: calc(82% - {{ block.settings.card_gap }}px);
    }
  }
{% endstyle %}

<trending-products-{{ ai_gen_id }} class="ai-trending-products-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-trending-products__header-{{ ai_gen_id }}">
    <div>
      <h2 class="ai-trending-products__heading-{{ ai_gen_id }}">{{ block.settings.heading | escape }}</h2>
      {% if block.settings.description != blank %}
        <p class="ai-trending-products__intro-{{ ai_gen_id }}">{{ block.settings.description | escape }}</p>
      {% endif %}
    </div>
    <div class="ai-trending-products__controls-{{ ai_gen_id }}">
      <button type="button" class="ai-trending-products__control-{{ ai_gen_id }}" data-direction="previous" aria-label="Previous products">&#8592;</button>
      <button type="button" class="ai-trending-products__control-{{ ai_gen_id }}" data-direction="next" aria-label="Next products">&#8594;</button>
    </div>
  </div>

  <div class="ai-trending-products__track-{{ ai_gen_id }}" data-product-track>
    {% for product in block.settings.products %}
      {% assign product_variant = product.selected_or_first_available_variant %}
      <article class="ai-trending-products__card-{{ ai_gen_id }}">
        <a class="ai-trending-products__card-link-{{ ai_gen_id }}" href="{{ product.url }}" aria-label="View {{ product.title | escape }}">
          <div class="ai-trending-products__image-wrap-{{ ai_gen_id }}">
            {% if product.featured_image %}
              <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="800" height="800">
            {% else %}
              <div class="ai-trending-products__placeholder-{{ ai_gen_id }}">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>
            {% endif %}
            {% if block.settings.show_badge %}<span class="ai-trending-products__badge-{{ ai_gen_id }}">{{ block.settings.badge_text | escape }}</span>{% endif %}
          </div>
        </a>
        <div class="ai-trending-products__details-{{ ai_gen_id }}">
          <a class="ai-trending-products__title-{{ ai_gen_id }}" href="{{ product.url }}">{{ product.title | escape }}</a>
          <div class="ai-trending-products__price-{{ ai_gen_id }}">{{ product.price | money }}</div>
          {% if product_variant.available %}
            <button type="button" class="ai-trending-products__quick-add-{{ ai_gen_id }}" data-variant-id="{{ product_variant.id }}">{{ block.settings.button_label | escape }}</button>
          {% else %}
            <button type="button" class="ai-trending-products__quick-add-{{ ai_gen_id }}" disabled>{{ block.settings.sold_out_label | escape }}</button>
          {% endif %}
          <div class="ai-trending-products__status-{{ ai_gen_id }}" role="status" aria-live="polite"></div>
        </div>
      </article>
    {% else %}
      <p>{{ block.settings.empty_text | escape }}</p>
    {% endfor %}
  </div>
</trending-products-{{ ai_gen_id }}>

<script>
  (function() {
    class TrendingProducts{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        this.track = this.querySelector('[data-product-track]');
        this.setupControls();
        this.setupQuickAdd();
      }

      setupControls() {
        this.querySelectorAll('[data-direction]').forEach((button) => {
          button.addEventListener('click', () => {
            const distance = this.track.clientWidth * 0.85;
            this.track.scrollBy({ left: button.dataset.direction === 'next' ? distance : -distance, behavior: 'smooth' });
          });
        });
      }

      setupQuickAdd() {
        this.querySelectorAll('[data-variant-id]').forEach((button) => {
          button.addEventListener('click', async () => {
            const status = button.parentElement.querySelector('[role="status"]');
            button.disabled = true;
            status.textContent = 'Adding…';
            try {
              const response = await fetch('/cart/add.js', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify({ items: [{ id: Number(button.dataset.variantId), quantity: 1 }] })
              });
              if (!response.ok) throw new Error('Add failed');
              status.textContent = 'Added to cart';
              document.dispatchEvent(new CustomEvent('cart:refresh'));
            } catch (error) {
              status.textContent = 'Unable to add. Please try again.';
            } finally {
              button.disabled = false;
            }
          });
        });
      }
    }
    customElements.define('trending-products-{{ ai_gen_id }}', TrendingProducts{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Trending products",
  "settings": [
