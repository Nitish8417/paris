{% doc %}
  @prompt
    Create a NEW Paris theme section named 'Techty Featured Products' with repeatable product blocks: each block has ONE product picker, so I can add one product at a time (4 or 5 total) and drag/reorder the blocks in the theme editor to change carousel order. Do not use a single multi-product picker. Show one full product panel at a time, matching the existing Paris Featured product / Trending Item appearance: large scrollable main product image gallery on the left, with SMALL clickable image thumbnails horizontally BELOW it; selected product title, price, a centered and polished quantity selector, Add to cart and Buy it now on the right. Show variant selection only if that product has actual variant choices. Put prominent previous/next PRODUCT arrows at the outside left and right edges of the entire carousel, separate from controls for scrolling the current product's main images. Each slide's image gallery, variants, quantity, and purchase actions must operate on that slide's product. Responsive on mobile. Do not make compact cards or a featured collection banner. Do not modify or remove the existing Trending Featured product section or other blocks., This is just one product, I wanted at least 4 to 6 , Give me the ability to change the container. And Make the images scrollable , Make the thumbnails 20% smaller. And can you also give me the ability to change colors fonts and picture container , The arrows to switch between products is gone. Bring it Back and the Add to Cart button is the same color as the button make it F4F1FF color, Other products are not showing , wait No products are showing , Change the quantity picker look better , Can you make the quanity picker a bit longer and make add to cart and buy it now all the same length so that it looks cohesive , Two changes. The second and third products are not showing. And give me the ability to adjust the container size of the product , Fix the bugs that dont show the pictures and are not showing the next image product , The next product is showing. DOnt touch that code. Fix lack of images and thumbnails , the buy now and add to cart is gone 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}.techty-featured-products-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:{{ block.settings.container_max_width }}px;margin:0 auto;position:relative;font-family:{{ block.settings.body_font.family }};color:{{ block.settings.text_color }}}.techty-featured-products-{{ ai_gen_id }}__viewport{overflow:hidden}.techty-featured-products-{{ ai_gen_id }}__track{display:flex;transition:transform .35s ease}.techty-featured-products-{{ ai_gen_id }}__slide{flex:0 0 100%;display:grid;grid-template-columns:1fr 1fr;gap:40px;padding:20px;box-sizing:border-box}.techty-featured-products-{{ ai_gen_id }}__gallery{background:{{ block.settings.picture_background }};border-radius:{{ block.settings.picture_radius }}px;overflow:hidden}.techty-featured-products-{{ ai_gen_id }}__main{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;aspect-ratio:1}.techty-featured-products-{{ ai_gen_id }}__main img{flex:0 0 100%;width:100%;height:100%;object-fit:contain;scroll-snap-align:start}.techty-featured-products-{{ ai_gen_id }}__thumbs{display:flex;gap:8px;padding:10px;overflow-x:auto}.techty-featured-products-{{ ai_gen_id }}__thumb{flex:0 0 53px;width:53px;height:53px;padding:3px;background:#fff;border:1px solid #999}.techty-featured-products-{{ ai_gen_id }}__thumb img{width:100%;height:100%;object-fit:contain}.techty-featured-products-{{ ai_gen_id }}__qty{display:flex;align-items:center;justify-content:space-between;width:180px;height:48px;border:1px solid #000041;border-radius:24px;margin:24px auto}.techty-featured-products-{{ ai_gen_id }}__qty button{border:0;background:none;font-size:24px;width:48px;height:100%;cursor:pointer}.techty-featured-products-{{ ai_gen_id }}__qty input{width:60px;border:0;text-align:center;font-size:16px;background:transparent}.techty-featured-products-{{ ai_gen_id }}__actions{display:flex;gap:12px}.techty-featured-products-{{ ai_gen_id }}__actions button{flex:1;min-height:52px;padding:12px 18px;border-radius:{{ block.settings.button_radius }}px;border:1px solid #000041;font:inherit;cursor:pointer}.techty-featured-products-{{ ai_gen_id }}__add{background:#F4F1FF;color:#000041}.techty-featured-products-{{ ai_gen_id }}__buy{background:#000041;color:#F4F1FF}.techty-featured-products-{{ ai_gen_id }}__arrows{position:absolute;z-index:5;top:50%;left:-28px;right:-28px;display:flex;justify-content:space-between;transform:translateY(-50%)}.techty-featured-products-{{ ai_gen_id }}__arrows button{width:52px;height:52px;border-radius:50%;border:1px solid #000041;background:#F4F1FF;color:#000041;font-size:30px}@media(max-width:749px){.techty-featured-products-{{ ai_gen_id }}{width:100%}.techty-featured-products-{{ ai_gen_id }}__slide{grid-template-columns:1fr}.techty-featured-products-{{ ai_gen_id }}__arrows{left:4px;right:4px}.techty-featured-products-{{ ai_gen_id }}__actions{flex-direction:column}}{% endstyle %}
<techty-featured-products-{{ ai_gen_id }} class="techty-featured-products-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="techty-featured-products-{{ ai_gen_id }}__viewport"><div class="techty-featured-products-{{ ai_gen_id }}__track">{% for i in (1..6) %}{% case i %}{% when 1 %}{% assign product=block.settings.product_1 %}{% when 2 %}{% assign product=block.settings.product_2 %}{% when 3 %}{% assign product=block.settings.product_3 %}{% when 4 %}{% assign product=block.settings.product_4 %}{% when 5 %}{% assign product=block.settings.product_5 %}{% when 6 %}{% assign product=block.settings.product_6 %}{% endcase %}{% if product != blank %}{% assign variant=product.selected_or_first_available_variant %}<article class="techty-featured-products-{{ ai_gen_id }}__slide"><div class="techty-featured-products-{{ ai_gen_id }}__gallery"><div class="techty-featured-products-{{ ai_gen_id }}__main">{% for media in product.media %}{% if media.media_type == 'image' %}<img src="{{ media.preview_image | image_url: width: 1600 }}" alt="{{ media.alt | default: product.title | escape }}" loading="lazy">{% endif %}{% endfor %}{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 1600 }}" alt="{{ product.title | escape }}" loading="lazy">{% endif %}</div><div class="techty-featured-products-{{ ai_gen_id }}__thumbs">{% assign n=0 %}{% for media in product.media %}{% if media.media_type == 'image' %}{% assign n=n | plus:1 %}<button type="button" class="techty-featured-products-{{ ai_gen_id }}__thumb" data-index="{{ n | minus:1 }}"><img src="{{ media.preview_image | image_url: width:180 }}" alt="{{ media.alt | default: product.title | escape }}"></button>{% endif %}{% endfor %}</div></div><div><h2>{{ product.title }}</h2><p>{{ product.price | money }}</p>{% form 'product', product %}<input type="hidden" name="id" value="{{ variant.id }}"><div class="techty-featured-products-{{ ai_gen_id }}__qty"><button type="button" data-minus aria-label="Decrease quantity">−</button><input type="number" name="quantity" value="1" min="1" aria-label="Quantity"><button type="button" data-plus aria-label="Increase quantity">+</button></div><div class="techty-featured-products-{{ ai_gen_id }}__actions"><button class="techty-featured-products-{{ ai_gen_id }}__add" type="submit">Add to cart</button><button class="techty-featured-products-{{ ai_gen_id }}__buy" type="submit" name="add" value="{{ variant.id }}">Buy it now</button></div>{% endform %}</div></article>{% endif %}{% endfor %}</div></div><div class="techty-featured-products-{{ ai_gen_id }}__arrows"><button type="button" data-prev aria-label="Previous product">‹</button><button type="button" data-next aria-label="Next product">›</button></div></techty-featured-products-{{ ai_gen_id }}>
<script>(function(){class T{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.track=this.querySelector('[class*="__track"]');this.slides=[...this.querySelectorAll('[class*="__slide"]')];this.i=0;this.querySelector('[data-prev]').onclick=()=>this.go(this.i-1);this.querySelector('[data-next]').onclick=()=>this.go(this.i+1);this.slides.forEach(s=>{let m=s.querySelector('[class*="__main"]');s.querySelectorAll('[data-index]').forEach(b=>b.onclick=()=>m.scrollTo({left:m.clientWidth*+b.dataset.index,behavior:'smooth'}));let q=s.querySelector('input[name="quantity"]');s.querySelector('[data-minus]').onclick=()=>q.value=Math.max(1,+q.value-1);s.querySelector('[data-plus]').onclick=()=>q.value=+q.value+1})}go(i){if(!this.slides.length)return;this.i=(i+this.slides.length)%this.slides.length;this.track.style.transform='translate3d(-'+this.i*100+'%,0,0)'}}customElements.define('techty-featured-products-{{ ai_gen_id }}',T{{ ai_gen_id }})})();</script>
{% schema %}{"name":"Techty Featured Products","settings":[{"type":"product","id":"product_1","label":"Product 1"},{"type":"product","id":"product_2","label":"Product 2"},{"type":"product","id":"product_3","label":"Product 3"},{"type":"product","id":"product_4","label":"Product 4"},{"type":"product","id":"product_5","label":"Product 5"},{"type":"product","id":"product_6","label":"Product 6"},{"type":"font_picker","id":"body_font","label":"Font","default":"assistant_n4"},{"type":"color","id":"text_color","label":"Text color","default":"#000041"},{"type":"color","id":"picture_background","label":"Picture background","default":"#F4F1FF"},{"type":"range","id":"picture_radius","label":"Picture radius","min":0,"max":40,"step":2,"unit":"px","default":4},{"type":"range","id":"button_radius","label":"Button radius","min":0,"max":40,"step":2,"unit":"px","default":4},{"type":"range","id":"container_max_width","label":"Product container width","min":600,"max":1600,"step":50,"unit":"px","default":1200},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100}],"presets":[{"name":"Techty Featured Products"}],"tag":null,"class":"techty-featured-products"}{% endschema %}