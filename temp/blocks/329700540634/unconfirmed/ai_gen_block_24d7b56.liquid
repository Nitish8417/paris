{% doc %}
  @prompt
    Create a NEW Paris theme section named 'Techty Featured Products' with repeatable product blocks: each block has ONE product picker, so I can add one product at a time (4 or 5 total) and drag/reorder the blocks in the theme editor to change carousel order. Do not use a single multi-product picker. Show one full product panel at a time, matching the existing Paris Featured product / Trending Item appearance: large scrollable main product image gallery on the left, with SMALL clickable image thumbnails horizontally BELOW it; selected product title, price, a centered and polished quantity selector, Add to cart and Buy it now on the right. Show variant selection only if that product has actual variant choices. Put prominent previous/next PRODUCT arrows at the outside left and right edges of the entire carousel, separate from controls for scrolling the current product's main images. Each slide's image gallery, variants, quantity, and purchase actions must operate on that slide's product. Responsive on mobile. Do not make compact cards or a featured collection banner. Do not modify or remove the existing Trending Featured product section or other blocks., This is just one product, I wanted at least 4 to 6 , Give me the ability to change the container. And Make the images scrollable , Make the thumbnails 20% smaller. And can you also give me the ability to change colors fonts and picture container , The arrows to switch between products is gone. Bring it Back and the Add to Cart button is the same color as the button make it F4F1FF color
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}.ai-tfp-{{ ai_gen_id }}{display:block;position:relative;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:auto;color:{{ block.settings.text_color }}}.ai-tfp-{{ ai_gen_id }}__track{display:flex;overflow:hidden}.ai-tfp-{{ ai_gen_id }}__slide{min-width:100%;display:grid;grid-template-columns:1.1fr .9fr;gap:40px;align-items:center}.ai-tfp-{{ ai_gen_id }}__gallery{overflow:hidden;background:{{ block.settings.picture_background }};border-radius:{{ block.settings.picture_radius }}px}.ai-tfp-{{ ai_gen_id }}__main{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;aspect-ratio:1}.ai-tfp-{{ ai_gen_id }}__main img{min-width:100%;object-fit:contain;scroll-snap-align:start}.ai-tfp-{{ ai_gen_id }}__thumbs{display:flex;gap:8px;overflow:auto;padding:10px}.ai-tfp-{{ ai_gen_id }}__thumb{width:53px;height:53px;flex:0 0 53px;padding:3px;background:#fff;border:1px solid #999;cursor:pointer}.ai-tfp-{{ ai_gen_id }}__thumb img{width:100%;height:100%;object-fit:contain}.ai-tfp-{{ ai_gen_id }}__info{display:flex;flex-direction:column;gap:16px}.ai-tfp-{{ ai_gen_id }}__title{color:{{ block.settings.heading_color }};font-family:{{ block.settings.heading_font.family }};margin:0}.ai-tfp-{{ ai_gen_id }}__qty{display:flex;justify-content:center;gap:15px;align-items:center}.ai-tfp-{{ ai_gen_id }}__qty button{border:0;background:none;font-size:25px;cursor:pointer}.ai-tfp-{{ ai_gen_id }}__qty input{width:70px;padding:12px;text-align:center;border:1px solid {{ block.settings.accent_color }}}.ai-tfp-{{ ai_gen_id }}__button{width:100%;padding:15px;border:1px solid {{ block.settings.accent_color }};cursor:pointer;border-radius:{{ block.settings.control_radius }}px;font-weight:600}.ai-tfp-{{ ai_gen_id }}__cart{background:#F4F1FF;color:#000041}.ai-tfp-{{ ai_gen_id }}__buy{background:{{ block.settings.accent_color }};color:#F4F1FF}.ai-tfp-{{ ai_gen_id }}__product-arrows{position:absolute;z-index:5;top:50%;left:-30px;right:-30px;display:flex;justify-content:space-between;transform:translateY(-50%);pointer-events:none}.ai-tfp-{{ ai_gen_id }}__product-arrows button{pointer-events:auto;width:52px;height:52px;border-radius:50%;border:1px solid {{ block.settings.accent_color }};background:#F4F1FF;color:#000041;font-size:32px;line-height:1;cursor:pointer}@media(max-width:749px){.ai-tfp-{{ ai_gen_id }}__slide{grid-template-columns:1fr;gap:20px}.ai-tfp-{{ ai_gen_id }}__product-arrows{left:4px;right:4px}.ai-tfp-{{ ai_gen_id }}__product-arrows button{width:44px;height:44px}}
{% endstyle %}<techty-featured-products-{{ ai_gen_id }} class="ai-tfp-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-tfp-{{ ai_gen_id }}__track">{% for i in (1..6) %}{% assign key='product_' | append:i %}{% assign p=block.settings[key] %}{% if p != blank %}{% assign v=p.selected_or_first_available_variant %}<article class="ai-tfp-{{ ai_gen_id }}__slide"><div><div class="ai-tfp-{{ ai_gen_id }}__gallery"><div class="ai-tfp-{{ ai_gen_id }}__main" data-main>{% for image in p.images %}<img src="{{ image | image_url: width:1400 }}" alt="{{ image.alt | default:p.title | escape }}">{% endfor %}</div><div class="ai-tfp-{{ ai_gen_id }}__thumbs">{% for image in p.images %}<button class="ai-tfp-{{ ai_gen_id }}__thumb" type="button" data-index="{{ forloop.index0 }}"><img src="{{ image | image_url: width:120 }}" alt="{{ image.alt | default:p.title | escape }}"></button>{% endfor %}</div></div></div><div class="ai-tfp-{{ ai_gen_id }}__info"><h2 class="ai-tfp-{{ ai_gen_id }}__title">{{ p.title }}</h2><strong>{{ v.price | money }}</strong><div class="ai-tfp-{{ ai_gen_id }}__qty"><button type="button" data-minus>−</button><input type="number" min="1" value="1" data-quantity><button type="button" data-plus>+</button></div><button class="ai-tfp-{{ ai_gen_id }}__button ai-tfp-{{ ai_gen_id }}__cart" data-add type="button">Add to cart</button><button class="ai-tfp-{{ ai_gen_id }}__button ai-tfp-{{ ai_gen_id }}__buy" data-buy type="button">Buy it now</button></div><script type="application/json" data-variant>{{ v.id }}</script></article>{% endif %}{% endfor %}</div><div class="ai-tfp-{{ ai_gen_id }}__product-arrows"><button type="button" data-prev aria-label="Previous product">‹</button><button type="button" data-next aria-label="Next product">›</button></div></techty-featured-products-{{ ai_gen_id }}><script>(function(){class T{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.t=this.querySelector('.ai-tfp-{{ ai_gen_id }}__track');this.s=[...this.querySelectorAll('.ai-tfp-{{ ai_gen_id }}__slide')];this.i=0;this.querySelector('[data-prev]').onclick=()=>this.go(this.i-1);this.querySelector('[data-next]').onclick=()=>this.go(this.i+1);this.s.forEach(x=>{let m=x.querySelector('[data-main]');x.querySelectorAll('[data-index]').forEach(b=>b.onclick=()=>m.children[+b.dataset.index].scrollIntoView({behavior:'smooth',inline:'start'}));x.querySelector('[data-minus]').onclick=()=>x.querySelector('[data-quantity]').value=Math.max(1,+x.querySelector('[data-quantity]').value-1);x.querySelector('[data-plus]').onclick=()=>x.querySelector('[data-quantity]').value=+x.querySelector('[data-quantity]').value+1;let add=()=>{let f=document.createElement('form');f.method='post';f.action='/cart/add';f.innerHTML='<input name="id" value="'+x.querySelector('[data-variant]').textContent+'"><input name="quantity" value="'+x.querySelector('[data-quantity]').value+'">';document.body.appendChild(f);f.submit()};x.querySelector('[data-add]').onclick=add;x.querySelector('[data-buy]').onclick=add})}go(i){this.i=(i+this.s.length)%this.s.length;this.t.style.transform='translateX(-'+this.i*100+'%)'}}customElements.define('techty-featured-products-{{ ai_gen_id }}',T{{ ai_gen_id }})})();</script>{% schema %}{"name":"Techty Featured Products","settings":[{"type":"product","id":"product_1","label":"Product 1"},{"type":"product","id":"product_2","label":"Product 2"},{"type":"product","id":"product_3","label":"Product 3"},{"type":"product","id":"product_4","label":"Product 4"},{"type":"product","id":"product_5","label":"Product 5"},{"type":"product","id":"product_6","label":"Product 6"},{"type":"font_picker","id":"heading_font","label":"Headings","default":"assistant_n4"},{"type":"color","id":"heading_color","label":"Heading","default":"#010133"},{"type":"color","id":"text_color","label":"Text","default":"#000041"},{"type":"color","id":"accent_color","label":"Accent","default":"#000041"},{"type":"color","id":"picture_background","label":"Picture background","default":"#F4F1FF"},{"type":"range","id":"picture_radius","label":"Picture radius","min":0,"max":40,"step":2,"unit":"px","default":4},{"type":"range","id":"control_radius","label":"Control radius","min":0,"max":20,"step":2,"unit":"px","default":4},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100}],"presets":[{"name":"Techty Featured Products"}],"tag":null,"class":"techty-featured-products"}{% endschema %}