{% doc %}
  @prompt
    Create a NEW Paris theme section named 'Techty Featured Products' with repeatable product blocks: each block has ONE product picker, so I can add one product at a time (4 or 5 total) and drag/reorder the blocks in the theme editor to change carousel order. Do not use a single multi-product picker. Show one full product panel at a time, matching the existing Paris Featured product / Trending Item appearance: large scrollable main product image gallery on the left, with SMALL clickable image thumbnails horizontally BELOW it; selected product title, price, a centered and polished quantity selector, Add to cart and Buy it now on the right. Show variant selection only if that product has actual variant choices. Put prominent previous/next PRODUCT arrows at the outside left and right edges of the entire carousel, separate from controls for scrolling the current product's main images. Each slide's image gallery, variants, quantity, and purchase actions must operate on that slide's product. Responsive on mobile. Do not make compact cards or a featured collection banner. Do not modify or remove the existing Trending Featured product section or other blocks., This is just one product, I wanted at least 4 to 6 , Give me the ability to change the container. And Make the images scrollable 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-techty-carousel-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:0 auto;position:relative;color:#000041;font-family:{{ settings.type_body_font.family }};}
.ai-techty-carousel-{{ ai_gen_id }}__viewport{overflow:hidden}.ai-techty-carousel-{{ ai_gen_id }}__track{display:flex;transition:transform .25s ease}.ai-techty-carousel-{{ ai_gen_id }}__slide{min-width:100%;display:grid;grid-template-columns:minmax(0,1.15fr) minmax(280px,.85fr);gap:clamp(28px,5vw,72px);align-items:center}.ai-techty-carousel-{{ ai_gen_id }}__gallery{min-width:0}.ai-techty-carousel-{{ ai_gen_id }}__main{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:thin;background:{{ settings.image_background_color }};aspect-ratio:1;border-radius:{{ settings.all_product_grid_radius }}px}.ai-techty-carousel-{{ ai_gen_id }}__main-item{min-width:100%;height:100%;scroll-snap-align:start;display:flex}.ai-techty-carousel-{{ ai_gen_id }}__main-item img{width:100%;height:100%;object-fit:contain;display:block}.ai-techty-carousel-{{ ai_gen_id }}__thumbs{display:flex;gap:10px;overflow-x:auto;padding:14px 2px 4px}.ai-techty-carousel-{{ ai_gen_id }}__thumb{width:66px;height:66px;flex:0 0 66px;padding:3px;background:#fff;border:1px solid #d6d6d6;border-radius:{{ settings.all_product_grid_radius }}px;cursor:pointer}.ai-techty-carousel-{{ ai_gen_id }}__thumb[aria-current=true]{border:2px solid #000041}.ai-techty-carousel-{{ ai_gen_id }}__thumb img{width:100%;height:100%;object-fit:contain}.ai-techty-carousel-{{ ai_gen_id }}__info{display:flex;flex-direction:column;gap:16px}.ai-techty-carousel-{{ ai_gen_id }}__title{margin:0;font-family:{{ settings.type_heading_font.family }};font-size:clamp(24px,3vw,42px);line-height:1.1;color:#010133}.ai-techty-carousel-{{ ai_gen_id }}__price{font-size:20px;font-weight:600}.ai-techty-carousel-{{ ai_gen_id }}__select,.ai-techty-carousel-{{ ai_gen_id }}__quantity{width:100%;min-height:46px;border:1px solid #000041;border-radius:{{ settings.all_input_radius }}px;background:#fff;color:#000041;padding:0 14px}.ai-techty-carousel-{{ ai_gen_id }}__quantity-wrap{display:flex;align-items:center;justify-content:center;gap:18px}.ai-techty-carousel-{{ ai_gen_id }}__quantity{width:74px;text-align:center;padding:0}.ai-techty-carousel-{{ ai_gen_id }}__qty{border:0;background:transparent;color:#000041;font-size:26px;cursor:pointer;padding:8px}.ai-techty-carousel-{{ ai_gen_id }}__actions{display:grid;gap:10px}.ai-techty-carousel-{{ ai_gen_id }}__button{min-height:50px;border-radius:{{ settings.all_button_radius }}px;border:1px solid #000;cursor:pointer;font-weight:600}.ai-techty-carousel-{{ ai_gen_id }}__cart{background:#000;color:#f4f1ff}.ai-techty-carousel-{{ ai_gen_id }}__buy{background:#f4f1ff;color:#000041}.ai-techty-carousel-{{ ai_gen_id }}__product-nav{position:absolute;top:50%;left:-34px;right:-34px;display:flex;justify-content:space-between;pointer-events:none;transform:translateY(-50%)}.ai-techty-carousel-{{ ai_gen_id }}__nav{pointer-events:auto;width:52px;height:52px;border:1px solid #000041;border-radius:50%;background:#fff;color:#000041;font-size:30px;cursor:pointer}.ai-techty-carousel-{{ ai_gen_id }}__empty{padding:60px;text-align:center;background:{{ settings.image_background_color }}}@media(max-width:749px){.ai-techty-carousel-{{ ai_gen_id }}__slide{grid-template-columns:1fr;gap:24px}.ai-techty-carousel-{{ ai_gen_id }}__product-nav{left:4px;right:4px}.ai-techty-carousel-{{ ai_gen_id }}__nav{width:44px;height:44px;font-size:24px}}
{% endstyle %}
<techty-featured-products-{{ ai_gen_id }} class="ai-techty-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
{% assign product_count=0 %}{% for i in (1..6) %}{% assign key='product_' | append:i %}{% if block.settings[key] != blank %}{% assign product_count=product_count | plus:1 %}{% endif %}{% endfor %}
{% if product_count > 0 %}<div class="ai-techty-carousel-{{ ai_gen_id }}__viewport"><div class="ai-techty-carousel-{{ ai_gen_id }}__track">
{% for i in (1..6) %}{% assign key='product_' | append:i %}{% assign product=block.settings[key] %}{% if product != blank %}{% assign variant=product.selected_or_first_available_variant %}<article class="ai-techty-carousel-{{ ai_gen_id }}__slide" data-slide><div class="ai-techty-carousel-{{ ai_gen_id }}__gallery"><div class="ai-techty-carousel-{{ ai_gen_id }}__main" data-main-gallery>{% for image in product.images %}<div class="ai-techty-carousel-{{ ai_gen_id }}__main-item"><img src="{{ image | image_url: width:1400 }}" alt="{{ image.alt | default:product.title | escape }}"></div>{% endfor %}</div><div class="ai-techty-carousel-{{ ai_gen_id }}__thumbs">{% for image in product.images %}<button class="ai-techty-carousel-{{ ai_gen_id }}__thumb" type="button" data-image-index="{{ forloop.index0 }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="View image {{ forloop.index }}"><img src="{{ image | image_url: width:160 }}" alt="{{ image.alt | default:product.title | escape }}"></button>{% endfor %}</div></div><div class="ai-techty-carousel-{{ ai_gen_id }}__info"><h2 class="ai-techty-carousel-{{ ai_gen_id }}__title">{{ product.title }}</h2><div class="ai-techty-carousel-{{ ai_gen_id }}__price">{{ variant.price | money }}</div>{% if product.has_only_default_variant == false %}{% for option in product.options_with_values %}<label>{{ option.name }}<select class="ai-techty-carousel-{{ ai_gen_id }}__select" data-option="{{ forloop.index0 }}">{% for value in option.values %}<option>{{ value }}</option>{% endfor %}</select></label>{% endfor %}{% endif %}<div class="ai-techty-carousel-{{ ai_gen_id }}__quantity-wrap"><button class="ai-techty-carousel-{{ ai_gen_id }}__qty" data-minus type="button">−</button><input class="ai-techty-carousel-{{ ai_gen_id }}__quantity" data-quantity type="number" value="1" min="1" aria-label="Quantity"><button class="ai-techty-carousel-{{ ai_gen_id }}__qty" data-plus type="button">+</button></div><div class="ai-techty-carousel-{{ ai_gen_id }}__actions"><button class="ai-techty-carousel-{{ ai_gen_id }}__button ai-techty-carousel-{{ ai_gen_id }}__cart" data-add type="button">Add to cart</button><button class="ai-techty-carousel-{{ ai_gen_id }}__button ai-techty-carousel-{{ ai_gen_id }}__buy" data-buy type="button">Buy it now</button></div></div><script type="application/json" data-variants>{{ product.variants | json }}</script></article>{% endif %}{% endfor %}</div></div><div class="ai-techty-carousel-{{ ai_gen_id }}__product-nav"><button class="ai-techty-carousel-{{ ai_gen_id }}__nav" data-prev type="button" aria-label="Previous product">‹</button><button class="ai-techty-carousel-{{ ai_gen_id }}__nav" data-next type="button" aria-label="Next product">›</button></div>{% else %}<div class="ai-techty-carousel-{{ ai_gen_id }}__empty">Add products to the six product slots to create your carousel.</div>{% endif %}</techty-featured-products-{{ ai_gen_id }}>
<script>(function(){class TechtyCarousel{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.track=this.querySelector('[data-slide]')?.parentElement;this.slides=[...this.querySelectorAll('[data-slide]')];this.index=0;this.querySelector('[data-prev]')?.addEventListener('click',()=>this.go(this.index-1));this.querySelector('[data-next]')?.addEventListener('click',()=>this.go(this.index+1));this.slides.forEach(s=>{let gallery=s.querySelector('[data-main-gallery]');s.querySelectorAll('[data-image-index]').forEach(b=>b.addEventListener('click',()=>{gallery.children[+b.dataset.imageIndex].scrollIntoView({behavior:'smooth',block:'nearest',inline:'start'});s.querySelectorAll('[data-image-index]').forEach(x=>x.setAttribute('aria-current','false'));b.setAttribute('aria-current','true')}));s.querySelector('[data-minus]')?.addEventListener('click',()=>s.querySelector('[data-quantity]').value=Math.max(1,+s.querySelector('[data-quantity]').value-1));s.querySelector('[data-plus]')?.addEventListener('click',()=>s.querySelector('[data-quantity]').value=+s.querySelector('[data-quantity]').value+1);let variants=JSON.parse(s.querySelector('[data-variants]').textContent),chosen=variants[0];s.querySelectorAll('[data-option]').forEach(x=>x.addEventListener('change',()=>{let values=[...s.querySelectorAll('[data-option]')].map(o=>o.value);chosen=variants.find(v=>v.options.every((o,i)=>o==values[i]))||chosen}));let submit=buy=>{let f=document.createElement('form');f.method='post';f.action='/cart/add';f.innerHTML='<input name="id" value="'+chosen.id+'"><input name="quantity" value="'+s.querySelector('[data-quantity]').value+'">'+(buy?'<input name="return_to" value="/checkout">':'');document.body.appendChild(f);f.submit()};s.querySelector('[data-add]')?.addEventListener('click',()=>submit(false));s.querySelector('[data-buy]')?.addEventListener('click',()=>submit(true))})}go(i){if(!this.track)return;this.index=(i+this.slides.length)%this.slides.length;this.track.style.transform='translateX(-'+this.index*100+'%)'}}customElements.define('techty-featured-products-{{ ai_gen_id }}',TechtyCarousel{{ ai_gen_id }})})();</script>
{% schema %}{"name":"Techty Featured Products","settings":[{"type":"header","content":"Products"},{"type":"product","id":"product_1","label":"Product 1"},{"type":"product","id":"product_2","label":"Product 2"},{"type":"product","id":"product_3","label":"Product 3"},{"type":"product","id":"product_4","label":"Product 4"},{"type":"product","id":"product_5","label":"Product 5"},{"type":"product","id":"product_6","label":"Product 6"},{"type":"header","content":"Container"},{"type":"select","id":"container_width","label":"Container width","options":[{"value":"full","label":"Full width"},{"value":"wide","label":"Wide"},{"value":"medium","label":"Medium"}],"default":"wide"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100}],"presets":[{"name":"Techty Featured Products"}],"tag":null,"class":"techty-featured-products"}{% endschema %}