{% doc %}
  @prompt
    Create a new Paris-theme section that displays 2 or 3 individually selected products as a carousel of full Featured product panels, not a featured collection banner or a grid of product cards. Match the existing 'Trending Item' Featured product section appearance in the screenshot: each carousel slide contains one product with its image gallery and vertical thumbnails on the left, and its title, price, quantity selector, Add to cart and Buy it now controls on the right. Provide prominent outer previous/next controls to switch between the selected products, separate from the image gallery's own arrows. Each slide must show and purchase its own selected product correctly. Keep a responsive mobile layout. Do not modify or remove the existing Trending section., the picture is too big. I want it exactly like the featured prodcut image I sent. And the arrows need to be on the side , Make the main image bigger and thumbnail images under the main image and they should take less space , The thumbnail images do not correspond to the main picture 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}{% style %}.ai-fpc-{{ai_gen_id}}{display:block;position:relative;width:{{block.settings.desktop_width_percent}}%;max-width:100%;background:{{block.settings.background_color}};padding:24px}.ai-fpc-track-{{ai_gen_id}}{display:flex;transition:transform .3s ease}.ai-fpc-slide-{{ai_gen_id}}{min-width:100%;display:grid;grid-template-columns:1.15fr .85fr;gap:38px;padding:8px 88px 24px;align-items:center}.ai-fpc-gallery-{{ai_gen_id}}{display:flex;flex-direction:column;align-items:center;gap:10px}.ai-fpc-main{position:relative;width:min(100%,540px);aspect-ratio:1;background:{{block.settings.image_background_color}}}.ai-fpc-main img{width:100%;height:100%;object-fit:contain}.ai-fpc-thumbs{display:flex;gap:6px;overflow:hidden}.ai-fpc-thumb{width:48px;height:48px;padding:2px;background:#fff;border:1px solid {{block.settings.border_color}};cursor:pointer}.ai-fpc-thumb.active{border-color:{{block.settings.accent_color}}}.ai-fpc-thumb img{width:100%;height:100%;object-fit:cover}.ai-fpc-gallery-btn{position:absolute;top:50%;transform:translateY(-50%);background:#fff;border:0;width:34px;height:34px;cursor:pointer}.ai-fpc-gallery-prev{left:8px}.ai-fpc-gallery-next{right:8px}.ai-fpc-details h3{font-size:28px;color:{{block.settings.heading_color}}}.ai-fpc-price{font-size:20px;margin-bottom:20px}.ai-fpc-details form{display:flex;flex-direction:column;gap:12px}.ai-fpc-details select,.ai-fpc-details input{padding:13px;border:1px solid {{block.settings.border_color}}}.ai-fpc-btn{padding:15px;background:{{block.settings.button_color}};color:{{block.settings.button_text_color}};border:0;cursor:pointer}.ai-fpc-buy{background:transparent;color:{{block.settings.button_color}};border:1px solid {{block.settings.button_color}}}.ai-fpc-controls{position:absolute;left:18px;right:18px;top:55%;display:flex;justify-content:space-between}.ai-fpc-outer{width:52px;height:52px;border:0;border-radius:50%;background:{{block.settings.accent_color}};color:#fff;font-size:24px;cursor:pointer}@media(max-width:749px){.ai-fpc-slide-{{ai_gen_id}}{grid-template-columns:1fr;padding:8px 34px}.ai-fpc-main{width:min(100%,500px)}.ai-fpc-controls{left:2px;right:2px}.ai-fpc-outer{width:38px;height:38px}}{% endstyle %}<featured-product-carousel-{{ai_gen_id}} class="ai-fpc-{{ai_gen_id}}" {{block.shopify_attributes}}><div style="overflow:hidden"><div class="ai-fpc-track-{{ai_gen_id}}">{%for product in block.settings.products%}<article class="ai-fpc-slide-{{ai_gen_id}}" data-slide><div class="ai-fpc-gallery-{{ai_gen_id}}"><div class="ai-fpc-main">{%if product.images.first%}<img data-main src="{{product.images.first|image_url:width:1400}}" alt="{{product.images.first.alt|default:product.title|escape}}">{%else%}{{'product-apparel-1'|placeholder_svg_tag}}{%endif%}{%if product.images.size>1%}<button type="button" class="ai-fpc-gallery-btn ai-fpc-gallery-prev" data-prev aria-label="Previous image">&#8592;</button><button type="button" class="ai-fpc-gallery-btn ai-fpc-gallery-next" data-next aria-label="Next image">&#8594;</button>{%endif%}</div><div class="ai-fpc-thumbs">{%for image in product.images%}<button type="button" class="ai-fpc-thumb{%if forloop.first%} active{%endif%}" data-thumb data-url="{{image|image_url:width:1400}}" aria-label="View image {{forloop.index}}"><img src="{{image|image_url:width:100}}" alt="{{image.alt|default:product.title|escape}}"></button>{%endfor%}</div></div><div class="ai-fpc-details"><h3>{{product.title|escape}}</h3><div class="ai-fpc-price">{{product.selected_or_first_available_variant.price|money}}</div>{%form 'product',product%}<input type="hidden" name="id" value="{{product.selected_or_first_available_variant.id}}">{%unless product.has_only_default_variant%}<select name="id" aria-label="Product options">{%for variant in product.variants%}<option value="{{variant.id}}"{%unless variant.available%} disabled{%endunless%}>{{variant.title}}</option>{%endfor%}</select>{%endunless%}<label>Quantity</label><input type="number" name="quantity" value="1" min="1"><button class="ai-fpc-btn" type="submit">{{block.settings.add_to_cart_label}}</button>{%if block.settings.show_buy_button%}<button class="ai-fpc-btn ai-fpc-buy" type="submit" name="checkout">{{block.settings.buy_now_label}}</button>{%endif%}{%endform%}</div></article>{%endfor%}</div></div>{%if block.settings.products.size>1%}<div class="ai-fpc-controls"><button type="button" class="ai-fpc-outer" data-prev-product aria-label="Previous product">&#8592;</button><button type="button" class="ai-fpc-outer" data-next-product aria-label="Next product">&#8594;</button></div>{%endif%}</featured-product-carousel-{{ai_gen_id}}><script>(function(){class F{{ai_gen_id}} extends HTMLElement{connectedCallback(){this.t=this.querySelector('.ai-fpc-track-{{ai_gen_id}}');this.s=[...this.querySelectorAll('[data-slide]')];this.i=0;this.s.forEach(x=>{let b=[...x.querySelectorAll('[data-thumb]')],m=x.querySelector('[data-main]'),n=0,show=j=>{if(!b.length)return;n=(j+b.length)%b.length;m.src=b[n].dataset.url;b.forEach((z,k)=>z.classList.toggle('active',k===n))};b.forEach((z,k)=>z.onclick=()=>show(k));let p=x.querySelector('[data-prev]'),q=x.querySelector('[data-next]');if(p)p.onclick=()=>show(n-1);if(q)q.onclick=()=>show(n+1);show(0)});let p=this.querySelector('[data-prev-product]'),n=this.querySelector('[data-next-product]');if(p)p.onclick=()=>this.move(-1);if(n)n.onclick=()=>this.move(1)}move(d){this.i=(this.i+d+this.s.length)%this.s.length;this.t.style.transform='translateX(-'+this.i*100+'%)'}}customElements.define('featured-product-carousel-{{ai_gen_id}}',F{{ai_gen_id}})})();</script>{% schema %}{"name":"Featured product carousel","settings":[{"type":"product_list","id":"products","label":"Products","limit":3},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"text","id":"add_to_cart_label","label":"Add button text","default":"Add to cart"},{"type":"text","id":"buy_now_label","label":"Buy button text","default":"Buy it now"},{"type":"checkbox","id":"show_buy_button","label":"Show buy button","default":true},{"type":"color","id":"background_color","label":"Background","default":"#f4f1ff"},{"type":"color","id":"image_background_color","label":"Image background","default":"#f4f1ff"},{"type":"color","id":"heading_color","label":"Heading","default":"#010133"},{"type":"color","id":"accent_color","label":"Accent","default":"#000041"},{"type":"color","id":"button_color","label":"Button","default":"#000000"},{"type":"color","id":"button_text_color","label":"Button text","default":"#f4f1ff"},{"type":"color","id":"border_color","label":"Border","default":"#000041"}],"presets":[{"name":"Featured product carousel"}],"tag":null,"class":"featured-product-carousel-block"}{% endschema %}