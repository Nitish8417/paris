{% doc %}
  @prompt
    Create a new Paris-theme section that displays 2 or 3 individually selected products as a carousel of full Featured product panels, not a featured collection banner or a grid of product cards. Match the existing 'Trending Item' Featured product section appearance in the screenshot: each carousel slide contains one product with its image gallery and vertical thumbnails on the left, and its title, price, quantity selector, Add to cart and Buy it now controls on the right. Provide prominent outer previous/next controls to switch between the selected products, separate from the image gallery's own arrows. Each slide must show and purchase its own selected product correctly. Keep a responsive mobile layout. Do not modify or remove the existing Trending section.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-fpc-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:auto;background:{{ block.settings.background_color }};color:{{ block.settings.text_color }};padding:24px}.ai-fpc-{{ ai_gen_id }} h2{text-align:{{ block.settings.heading_alignment }};color:{{ block.settings.heading_color }};margin:0 0 24px}.ai-fpc-track-{{ ai_gen_id }}{display:flex;transition:transform .3s ease}.ai-fpc-slide-{{ ai_gen_id }}{min-width:100%;display:grid;grid-template-columns:1.1fr .9fr;gap:44px;align-items:center;padding:8px 56px 24px;box-sizing:border-box}.ai-fpc-gallery-{{ ai_gen_id }}{display:grid;grid-template-columns:70px 1fr;gap:14px}.ai-fpc-thumbs-{{ ai_gen_id }}{display:flex;flex-direction:column;gap:8px}.ai-fpc-thumb-{{ ai_gen_id }}{padding:3px;border:1px solid {{ block.settings.border_color }};background:#fff;cursor:pointer;aspect-ratio:1}.ai-fpc-thumb-{{ ai_gen_id }}.active{border-color:{{ block.settings.accent_color }}}.ai-fpc-thumb img,.ai-fpc-main img{width:100%;height:100%;object-fit:contain;display:block}.ai-fpc-main{position:relative;aspect-ratio:1;background:{{ block.settings.image_background_color }}}.ai-fpc-gallery-btn{position:absolute;top:50%;transform:translateY(-50%);z-index:2;border:0;background:#fff;color:#000;width:36px;height:36px;cursor:pointer}.ai-fpc-gallery-prev{left:10px}.ai-fpc-gallery-next{right:10px}.ai-fpc-details h3{color:{{ block.settings.heading_color }};font-size:28px;margin:0 0 14px}.ai-fpc-price{font-size:20px;margin-bottom:24px}.ai-fpc-details form{display:flex;flex-direction:column;gap:13px}.ai-fpc-details select,.ai-fpc-details input{padding:13px;border:1px solid {{ block.settings.border_color }};background:{{ block.settings.input_background }};color:{{ block.settings.text_color }};border-radius:{{ block.settings.input_radius }}px}.ai-fpc-details input{max-width:110px}.ai-fpc-btn{padding:15px;border:1px solid {{ block.settings.button_color }};background:{{ block.settings.button_color }};color:{{ block.settings.button_text_color }};border-radius:{{ block.settings.button_radius }}px;cursor:pointer;font-weight:600}.ai-fpc-buy{background:transparent;color:{{ block.settings.button_color }}}.ai-fpc-controls{text-align:center;margin-top:8px}.ai-fpc-outer{width:48px;height:48px;border:0;border-radius:50%;margin:0 5px;background:{{ block.settings.accent_color }};color:#fff;font-size:22px;cursor:pointer}@media(max-width:749px){.ai-fpc-slide-{{ ai_gen_id }}{grid-template-columns:1fr;gap:24px;padding:8px 4px 20px}.ai-fpc-gallery-{{ ai_gen_id }}{grid-template-columns:56px 1fr}.ai-fpc-details h3{font-size:24px}}
{% endstyle %}
<featured-product-carousel-{{ ai_gen_id }} class="ai-fpc-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
{% if block.settings.heading != blank %}<h2>{{ block.settings.heading | escape }}</h2>{% endif %}<div class="ai-fpc-viewport"><div class="ai-fpc-track-{{ ai_gen_id }}">
{% for product in block.settings.products %}<article class="ai-fpc-slide-{{ ai_gen_id }}" data-slide><div class="ai-fpc-gallery-{{ ai_gen_id }}" data-gallery><div class="ai-fpc-thumbs-{{ ai_gen_id }}">{% for image in product.images %}<button type="button" class="ai-fpc-thumb-{{ ai_gen_id }}{% if forloop.first %} active{% endif %}" data-thumb data-url="{{ image | image_url: width: 1200 }}" aria-label="View image {{ forloop.index }}"><img src="{{ image | image_url: width: 120 }}" alt="{{ image.alt | default: product.title | escape }}" loading="lazy"></button>{% endfor %}</div><div class="ai-fpc-main">{% if product.featured_image %}<img data-main src="{{ product.featured_image | image_url: width: 1200 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy">{% else %}{{ 'product-apparel-1' | placeholder_svg_tag }}{% endif %}{% if product.images.size > 1 %}<button type="button" class="ai-fpc-gallery-btn ai-fpc-gallery-prev" data-prev aria-label="Previous image">&#8592;</button><button type="button" class="ai-fpc-gallery-btn ai-fpc-gallery-next" data-next aria-label="Next image">&#8594;</button>{% endif %}</div></div><div class="ai-fpc-details"><h3>{{ product.title | escape }}</h3><div class="ai-fpc-price" data-price>{{ product.selected_or_first_available_variant.price | money }}</div>{% form 'product', product %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-id>{% unless product.has_only_default_variant %}<label for="v-{{ ai_gen_id }}-{{ product.id }}">Options</label><select id="v-{{ ai_gen_id }}-{{ product.id }}" data-variant>{% for variant in product.variants %}<option value="{{ variant.id }}" data-price="{{ variant.price | money | escape }}"{% unless variant.available %} disabled{% endunless %}>{{ variant.title }}{% unless variant.available %} - Sold out{% endunless %}</option>{% endfor %}</select>{% endunless %}<label for="q-{{ ai_gen_id }}-{{ product.id }}">Quantity</label><input id="q-{{ ai_gen_id }}-{{ product.id }}" type="number" name="quantity" value="1" min="1"> <button class="ai-fpc-btn" type="submit"{% unless product.available %} disabled{% endunless %}>{{ block.settings.add_to_cart_label }}</button>{% if block.settings.show_buy_button %}<button class="ai-fpc-btn ai-fpc-buy" type="submit" name="checkout"{% unless product.available %} disabled{% endunless %}>{{ block.settings.buy_now_label }}</button>{% endif %}{% endform %}</div></article>{% endfor %}</div></div>
{% if block.settings.products.size > 1 %}<div class="ai-fpc-controls"><button type="button" class="ai-fpc-outer" data-outer-prev aria-label="Previous product">&#8592;</button><button type="button" class="ai-fpc-outer" data-outer-next aria-label="Next product">&#8594;</button></div>{% endif %}</featured-product-carousel-{{ ai_gen_id }}>
<script>(function(){class C{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.t=this.querySelector('.ai-fpc-track-{{ ai_gen_id }}');this.s=[...this.querySelectorAll('[data-slide]')];this.i=0;this.s.forEach(x=>{let b=[...x.querySelectorAll('[data-thumb]')],m=x.querySelector('[data-main]'),n=0,show=j=>{if(!b.length||!m)return;n=(j+b.length)%b.length;m.src=b[n].dataset.url;b.forEach((z,k)=>z.classList.toggle('active',k==n))};b.forEach((z,k)=>z.onclick=()=>show(k));let p=x.querySelector('[data-prev]'),q=x.querySelector('[data-next]');if(p)p.onclick=()=>show(n-1);if(q)q.onclick=()=>show(n+1);let v=x.querySelector('[data-variant]'),id=x.querySelector('[data-id]'),pr=x.querySelector('[data-price]');if(v)v.onchange=()=>{id.value=v.value;pr.textContent=v.options[v.selectedIndex].dataset.price}});let p=this.querySelector('[data-outer-prev]'),n=this.querySelector('[data-outer-next]');if(p)p.onclick=()=>this.move(-1);if(n)n.onclick=()=>this.move(1)}move(d){this.i=(this.i+d+this.s.length)%this.s.length;this.t.style.transform='translateX(-'+this.i*100+'%)'}}if(!customElements.get('featured-product-carousel-{{ ai_gen_id }}'))customElements.define('featured-product-carousel-{{ ai_gen_id }}',C{{ ai_gen_id }})})();</script>
{% schema %}{"name":"Featured product carousel","settings":[{"type":"text","id":"heading","label":"Heading","default":"Featured products"},{"type":"product_list","id":"products","label":"Products","limit":3},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"select","id":"heading_alignment","label":"Heading alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"}],"default":"left"},{"type":"text","id":"add_to_cart_label","label":"Add button text","default":"Add to cart"},{"type":"text","id":"buy_now_label","label":"Buy button text","default":"Buy it now"},{"type":"checkbox","id":"show_buy_button","label":"Show buy button","default":true},{"type":"color","id":"background_color","label":"Background","default":"#f4f1ff"},{"type":"color","id":"image_background_color","label":"Image background","default":"#f4f1ff"},{"type":"color","id":"heading_color","label":"Heading","default":"#010133"},{"type":"color","id":"text_color","label":"Text","default":"#000041"},{"type":"color","id":"accent_color","label":"Accent","default":"#000041"},{"type":"color","id":"button_color","label":"Button","default":"#000000"},{"type":"color","id":"button_text_color","label":"Button text","default":"#f4f1ff"},{"type":"color","id":"border_color","label":"Border","default":"#000041"},{"type":"color","id":"input_background","label":"Input background","default":"#ffffff"},{"type":"range","id":"button_radius","label":"Button radius","min":0,"max":20,"step":2,"unit":"px","default":4},{"type":"range","id":"input_radius","label":"Input radius","min":0,"max":20,"step":2,"unit":"px","default":10}],"presets":[{"name":"Featured product carousel"}],"tag":null,"class":"featured-product-carousel-block"}{% endschema %}