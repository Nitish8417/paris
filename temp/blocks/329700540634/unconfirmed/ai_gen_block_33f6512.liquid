{% doc %}
  @prompt
    Create a NEW Paris theme section named 'Techty Featured Products' to replace the broken generated block, leaving the original Trending section untouched. Support 4 to 6 reorderable product blocks, each with its own single product picker; add products one at a time in the editor. Show one full Featured product panel at a time, with large independently scrollable main product images on the left and clickable thumbnails 20% smaller horizontally below, and title, price, real variant choices only if present, quantity, Add to cart and Buy it now on the right. FIX THE CURRENT FAILURE: products and their PICTURES do not appear on second and third carousel pages. For each slide, render images and thumbnails from THAT block's selected product, with a visible first image initially and working image navigation after switching products; avoid shared gallery state and duplicate element IDs. Include prominent outer left/right arrows to change products, separate from picture navigation. Ensure every slide shows the correct selected product, variant, image, thumbnail, price, and purchase form; the quantity and buttons work for that slide. Provide editor settings for overall container width, product/image container size, colors and fonts. Center and lengthen the polished quantity selector and align its width with Add to cart and Buy it now. Add to cart background #F4F1FF with readable contrasting text. Responsive on mobile. Do not create compact cards or a collection banner., Make the quantity picker, add to cart and buy it now better. Make the thumbnails smaller. Make the Images scrollable, Make the image fit to container not zoomed in. Make add to cart, buy it now and quanity picker look more asthetic, Make the images scrollable Can you change the add to cart and buy it now buttons more rounded, and make the quantity picker a Stepper (- / +)
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-featured-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:auto}.ai-featured-{{ ai_gen_id }}__main{height:{{ block.settings.image_height }}px;overflow:auto;display:flex;align-items:center;justify-content:center;background:{{ block.settings.image_background }};border-radius:{{ block.settings.radius }}px}.ai-featured-{{ ai_gen_id }}__main img{width:100%;height:100%;object-fit:contain}.ai-featured-{{ ai_gen_id }}__thumbs{display:flex;gap:8px;overflow-x:auto;padding:10px 8%;scrollbar-width:thin}.ai-featured-{{ ai_gen_id }}__thumb{flex:0 0 48px;width:48px;height:48px;padding:3px;border:1px solid {{ block.settings.border_color }};border-radius:{{ block.settings.radius }}px;background:#fff;cursor:pointer}.ai-featured-{{ ai_gen_id }}__thumb img{width:100%;height:100%;object-fit:cover}.ai-featured-{{ ai_gen_id }}__quantity-wrap{display:flex;align-items:center;justify-content:center;width:100%;max-width:100%;margin:8px auto;border:1px solid {{ block.settings.border_color }};border-radius:999px;background:{{ block.settings.input_background }};overflow:hidden}.ai-featured-{{ ai_gen_id }}__quantity-button{width:52px;height:52px;border:0;background:transparent;color:{{ block.settings.text_color }};font-size:25px;font-weight:700;cursor:pointer}.ai-featured-{{ ai_gen_id }}__quantity{width:70px;height:52px;border:0;background:transparent;text-align:center;font:700 18px inherit;color:{{ block.settings.text_color }};appearance:textfield}.ai-featured-{{ ai_gen_id }}__quantity::-webkit-inner-spin-button{appearance:none}.ai-featured-{{ ai_gen_id }}__actions{display:grid;gap:12px;width:100%}.ai-featured-{{ ai_gen_id }}__button{width:100%;min-height:56px;border-radius:999px;padding:15px 22px;font:inherit;font-weight:700;cursor:pointer}.ai-featured-{{ ai_gen_id }}__add{background:#F4F1FF;color:#03032B;border:1px solid #03032B}.ai-featured-{{ ai_gen_id }}__buy{background:{{ block.settings.buy_background }};color:{{ block.settings.buy_text }};border:1px solid {{ block.settings.buy_background }}}
{% endstyle %}
<featured-products-{{ ai_gen_id }} class="ai-featured-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-featured-{{ ai_gen_id }}__main"><span>Add products in the settings to display this featured product panel.</span></div><div class="ai-featured-{{ ai_gen_id }}__quantity-wrap"><button type="button" class="ai-featured-{{ ai_gen_id }}__quantity-button" data-minus aria-label="Decrease quantity">−</button><input class="ai-featured-{{ ai_gen_id }}__quantity" type="number" min="1" value="1" aria-label="Quantity"><button type="button" class="ai-featured-{{ ai_gen_id }}__quantity-button" data-plus aria-label="Increase quantity">+</button></div><div class="ai-featured-{{ ai_gen_id }}__actions"><button class="ai-featured-{{ ai_gen_id }}__button ai-featured-{{ ai_gen_id }}__add" type="button">Add to cart</button><button class="ai-featured-{{ ai_gen_id }}__button ai-featured-{{ ai_gen_id }}__buy" type="button">Buy it now</button></div></featured-products-{{ ai_gen_id }}><script>(function(){class FeaturedProducts{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.input=this.querySelector('.ai-featured-{{ ai_gen_id }}__quantity');this.querySelector('[data-minus]').addEventListener('click',()=>this.input.value=Math.max(1,Number(this.input.value)-1));this.querySelector('[data-plus]').addEventListener('click',()=>this.input.value=Number(this.input.value)+1)}}customElements.define('featured-products-{{ ai_gen_id }}',FeaturedProducts{{ ai_gen_id }})})();</script>
{% schema %}{"name":"Techty Featured Products","settings":[{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"image_height","label":"Image height","min":300,"max":900,"step":50,"unit":"px","default":600},{"type":"range","id":"radius","label":"Corner radius","min":0,"max":20,"step":2,"unit":"px","default":4},{"type":"color","id":"image_background","label":"Image background","default":"#F4F1FF"},{"type":"color","id":"input_background","label":"Input background","default":"#FFFFFF"},{"type":"color","id":"border_color","label":"Border color","default":"#585981"},{"type":"color","id":"text_color","label":"Text color","default":"#000041"},{"type":"color","id":"buy_background","label":"Buy background","default":"#03032B"},{"type":"color","id":"buy_text","label":"Buy text","default":"#F4F1FF"}],"presets":[{"name":"Techty Featured Products"}],"tag":null,"class":"techty-featured-products"}{% endschema %}