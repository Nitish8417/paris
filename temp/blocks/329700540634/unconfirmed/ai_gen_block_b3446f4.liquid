{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}.ai-tfp-{{ai_gen_id}}{display:block;width:{{block.settings.desktop_width}}%;max-width:100%;margin:auto;background:{{block.settings.background}};color:{{block.settings.text}};font-family:{{block.settings.body_font.family}}}.ai-tfp-{{ai_gen_id}}__stage{position:relative;padding:0 55px}.ai-tfp-{{ai_gen_id}}__slide{display:none;grid-template-columns:{{block.settings.image_width}}% 1fr;gap:{{block.settings.gap}}px;align-items:center}.ai-tfp-{{ai_gen_id}}__slide.active{display:grid}.ai-tfp-{{ai_gen_id}}__main{height:{{block.settings.image_height}}px;overflow-y:auto;scroll-snap-type:y mandatory;background:{{block.settings.image_background}};border-radius:{{block.settings.radius}}px}.ai-tfp-{{ai_gen_id}}__main img{width:100%;height:100%;object-fit:contain;display:block;scroll-snap-align:start}.ai-tfp-{{ai_gen_id}}__thumbs{display:flex;gap:8px;overflow-x:auto;padding-top:12px}.ai-tfp-{{ai_gen_id}}__thumb{flex:0 0 64px;height:52px;padding:0;border:2px solid transparent;background:none;overflow:hidden;cursor:pointer}.ai-tfp-{{ai_gen_id}}__thumb.selected{border-color:{{block.settings.accent}}}.ai-tfp-{{ai_gen_id}}__thumb img{width:100%;height:100%;object-fit:contain}.ai-tfp-{{ai_gen_id}}__name{font-family:{{block.settings.heading_font.family}};color:{{block.settings.heading}};font-size:{{block.settings.title_size}}px}.ai-tfp-{{ai_gen_id}}__select,.ai-tfp-{{ai_gen_id}}__qty{width:100%;padding:13px;border:1px solid {{block.settings.input_border}};border-radius:{{block.settings.control_radius}}px;background:{{block.settings.input_background}};color:{{block.settings.text}};margin-bottom:14px}.ai-tfp-{{ai_gen_id}}__qty{display:flex;padding:0;max-width:{{block.settings.control_width}}px;margin:14px auto}.ai-tfp-{{ai_gen_id}}__qty button{width:48px;border:0;background:none;font-size:22px;cursor:pointer;color:{{block.settings.text}}}.ai-tfp-{{ai_gen_id}}__qty input{flex:1;text-align:center;border:0;background:none}.ai-tfp-{{ai_gen_id}}__actions{display:grid;gap:14px}.ai-tfp-{{ai_gen_id}}__actions button{width:100%;min-height:52px;border-radius:{{block.settings.button_radius}}px;font-weight:bold;cursor:pointer}.ai-tfp-{{ai_gen_id}}__add{background:#F4F1FF;color:#000041;border:1px solid #000041}.ai-tfp-{{ai_gen_id}}__buy{background:{{block.settings.buy_background}};color:{{block.settings.buy_text}};border:0}.ai-tfp-{{ai_gen_id}}__arrow{position:absolute;top:50%;transform:translateY(-50%);z-index:2;width:48px;height:48px;border-radius:50%;border:1px solid {{block.settings.arrow_color}};background:{{block.settings.arrow_background}};color:{{block.settings.arrow_color}};font-size:28px;cursor:pointer}.ai-tfp-{{ai_gen_id}}__prev{left:0}.ai-tfp-{{ai_gen_id}}__next{right:0}@media(max-width:749px){.ai-tfp-{{ai_gen_id}}__slide{grid-template-columns:1fr}.ai-tfp-{{ai_gen_id}}__main{height:{{block.settings.mobile_height}}px}.ai-tfp-{{ai_gen_id}}__stage{padding:0 35px}}{% endstyle %}
<featured-products-{{ai_gen_id}} class="ai-tfp-{{ai_gen_id}}" {{block.shopify_attributes}}><div class="ai-tfp-{{ai_gen_id}}__stage"><button class="ai-tfp-{{ai_gen_id}}__arrow ai-tfp-{{ai_gen_id}}__prev" type="button" aria-label="Previous product">‹</button><button class="ai-tfp-{{ai_gen_id}}__arrow ai-tfp-{{ai_gen_id}}__next" type="button" aria-label="Next product">›</button>{% assign count=0 %}{% for n in (1..6) %}{% assign key='product_'|append:n %}{% assign p=block.settings[key] %}{% if p != blank %}{% assign count=count|plus:1 %}<article class="ai-tfp-{{ai_gen_id}}__slide{% if count==1 %} active{% endif %}"><div><div class="ai-tfp-{{ai_gen_id}}__main">{% for image in p.images %}<img src="{{image|image_url:width:1400}}" alt="{{image.alt|default:p.title|escape}}" loading="lazy">{% endfor %}</div><div class="ai-tfp-{{ai_gen_id}}__thumbs">{% for image in p.images %}<button type="button" class="ai-tfp-{{ai_gen_id}}__thumb{% if forloop.first %} selected{% endif %}"><img src="{{image|image_url:width:180}}" alt="{{image.alt|default:p.title|escape}}"></button>{% endfor %}</div></div><div><h2 class="ai-tfp-{{ai_gen_id}}__name">{{p.title}}</h2><p>{{p.selected_or_first_available_variant.price|money}}</p>{% form 'product',p %}<input type="hidden" name="id" value="{{p.selected_or_first_available_variant.id}}">{% unless p.has_only_default_variant %}{% for o in p.options_with_values %}<label>{{o.name}}<select class="ai-tfp-{{ai_gen_id}}__select" name="options[{{o.name|escape}}]">{% for v in o.values %}<option value="{{v|escape}}">{{v}}</option>{% endfor %}</select></label>{% endfor %}{% endunless %}<div class="ai-tfp-{{ai_gen_id}}__qty"><button type="button" data-minus>−</button><input type="number" name="quantity" value="1" min="1"><button type="button" data-plus>+</button></div><div class="ai-tfp-{{ai_gen_id}}__actions"><button class="ai-tfp-{{ai_gen_id}}__add" type="submit">Add to cart</button><button class="ai-tfp-{{ai_gen_id}}__buy" type="submit" name="checkout">Buy it now</button></div>{% endform %}</div></article>{% endif %}{% endfor %}</div></featured-products-{{ai_gen_id}}>
<script>(function(){class T{{ai_gen_id}} extends HTMLElement{connectedCallback(){this.s=[...this.querySelectorAll('.ai-tfp-{{ai_gen_id}}__slide')];this.i=0;this.querySelector('.ai-tfp-{{ai_gen_id}}__prev').onclick=()=>this.go(this.i-1);this.querySelector('.ai-tfp-{{ai_gen_id}}__next').onclick=()=>this.go(this.i+1);this.s.forEach(x=>{let m=x.querySelector('.ai-tfp-{{ai_gen_id}}__main');x.querySelectorAll('.ai-tfp-{{ai_gen_id}}__thumb').forEach((b,i)=>b.onclick=()=>{m.scrollTo({top:m.children[i].offsetTop,behavior:'smooth'});x.querySelectorAll('.ai-tfp-{{ai_gen_id}}__thumb').forEach(q=>q.classList.remove('selected'));b.classList.add('selected')});let q=x.querySelector('input[name=quantity]');x.querySelector('[data-minus]').onclick=()=>q.value=Math.max(1,+q.value-1);x.querySelector('[data-plus]').onclick=()=>q.value=+q.value+1})}go(n){if(!this.s.length)return;this.i=(n+this.s.length)%this.s.length;this.s.forEach((x,i)=>x.classList.toggle('active',i==this.i))}}customElements.define('featured-products-{{ai_gen_id}}',T{{ai_gen_id}})})();</script>
{% schema %}{"name":"Techty Featured Products","tag":null,"class":"techty-featured-products","settings":[{"type":"range","id":"desktop_width","label":"Container width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"image_width","label":"Image width","min":40,"max":70,"step":5,"unit":"%","default":55},{"type":"range","id":"image_height","label":"Image height","min":300,"max":800,"step":50,"unit":"px","default":550},{"type":"range","id":"mobile_height","label":"Mobile image height","min":220,"max":600,"step":20,"unit":"px","default":360},{"type":"range","id":"gap","label":"Column gap","min":20,"max":100,"step":10,"unit":"px","default":50},{"type":"range","id":"control_width","label":"Control width","min":180,"max":500,"step":20,"unit":"px","default":360},{"type":"range","id":"title_size","label":"Title size","min":18,"max":42,"step":2,"unit":"px","default":28},{"type":"range","id":"radius","label":"Image radius","min":0,"max":30,"step":2,"unit":"px","default":10},{"type":"range","id":"control_radius","label":"Control radius","min":4,"max":30,"step":2,"unit":"px","default":16},{"type":"range","id":"button_radius","label":"Button radius","min":4,"max":40,"step":2,"unit":"px","default":24},{"type":"font_picker","id":"heading_font","label":"Heading font","default":"inter_n7"},{"type":"font_picker","id":"body_font","label":"Body font","default":"inter_n4"},{"type":"color","id":"background","label":"Background","default":"#F4F1FF"},{"type":"color","id":"image_background","label":"Image background","default":"#FFFFFF"},{"type":"color","id":"heading","label":"Heading","default":"#03032B"},{"type":"color","id":"text","label":"Text","default":"#000041"},{"type":"color","id":"accent","label":"Accent","default":"#000041"},{"type":"color","id":"input_background","label":"Input background","default":"#FFFFFF"},{"type":"color","id":"input_border","label":"Input border","default":"#585981"},{"type":"color","id":"buy_background","label":"Buy button","default":"#000041"},{"type":"color","id":"buy_text","label":"Buy button text","default":"#F4F1FF"},{"type":"color","id":"arrow_background","label":"Arrow background","default":"#FFFFFF"},{"type":"color","id":"arrow_color","label":"Arrow color","default":"#000041"},{"type":"product","id":"product_1","label":"Product 1"},{"type":"product","id":"product_2","label":"Product 2"},{"type":"product","id":"product_3","label":"Product 3"},{"type":"product","id":"product_4","label":"Product 4"},{"type":"product","id":"product_5","label":"Product 5"},{"type":"product","id":"product_6","label":"Product 6"}],"presets":[{"name":"Techty Featured Products"}]}{% endschema %}