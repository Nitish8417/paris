{% doc %}
  @prompt
    Create a new Paris-theme section that displays 2 or 3 individually selected products as a carousel of full Featured product panels, not a featured collection banner or a grid of product cards. Match the existing 'Trending Item' Featured product section appearance in the screenshot: each carousel slide contains one product with its image gallery and vertical thumbnails on the left, and its title, price, quantity selector, Add to cart and Buy it now controls on the right. Provide prominent outer previous/next controls to switch between the selected products, separate from the image gallery's own arrows. Each slide must show and purchase its own selected product correctly. Keep a responsive mobile layout. Do not modify or remove the existing Trending section., Can you make the pictures scrollable - on the mobile I dont want arrows. And the thumbnails can be under the main image 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-featured-carousel-{{ ai_gen_id }} { display:block; width:{{ block.settings.desktop_width_percent }}%; max-width:100%; margin:0 auto; background:{{ block.settings.background_color }}; color:{{ block.settings.text_color }}; font-family:{{ settings.type_body_font.family }}; }
  .ai-featured-carousel-{{ ai_gen_id }}__heading { margin:0 0 28px; color:{{ block.settings.heading_color }}; font-family:{{ settings.type_heading_font.family }}; text-align:{{ block.settings.heading_alignment }}; font-size:clamp(24px,3vw,42px); }
  .ai-featured-carousel-{{ ai_gen_id }}__viewport { position:relative; overflow:hidden; }
  .ai-featured-carousel-{{ ai_gen_id }}__track { display:flex; transition:transform .35s ease; }
  .ai-featured-carousel-{{ ai_gen_id }}__slide { min-width:100%; display:grid; grid-template-columns:minmax(0,1.15fr) minmax(280px,.85fr); gap:clamp(28px,6vw,90px); align-items:center; padding:10px clamp(44px,8vw,100px) 18px; box-sizing:border-box; }
  .ai-featured-carousel-{{ ai_gen_id }}__gallery { display:grid; grid-template-columns:72px minmax(0,1fr); gap:16px; align-items:start; }
  .ai-featured-carousel-{{ ai_gen_id }}__thumbs { display:flex; flex-direction:column; gap:10px; }
  .ai-featured-carousel-{{ ai_gen_id }}__thumb { border:1px solid {{ block.settings.border_color }}; background:transparent; padding:3px; cursor:pointer; aspect-ratio:1; }
  .ai-featured-carousel-{{ ai_gen_id }}__thumb[aria-current="true"] { border-color:{{ block.settings.accent_color }}; border-width:2px; }
  .ai-featured-carousel-{{ ai_gen_id }}__thumb img,.ai-featured-carousel-{{ ai_gen_id }}__image { width:100%; height:100%; object-fit:contain; display:block; }
  .ai-featured-carousel-{{ ai_gen_id }}__main { aspect-ratio:1 / 1.08; background:{{ block.settings.image_background }}; min-width:0; overflow:hidden; }
  .ai-featured-carousel-{{ ai_gen_id }}__image-track { height:100%; display:flex; overflow-x:auto; scroll-snap-type:x mandatory; scrollbar-width:none; }
  .ai-featured-carousel-{{ ai_gen_id }}__image-track::-webkit-scrollbar { display:none; }
  .ai-featured-carousel-{{ ai_gen_id }}__image { min-width:100%; scroll-snap-align:start; }
  .ai-featured-carousel-{{ ai_gen_id }}__placeholder { height:100%; display:flex; align-items:center; justify-content:center; color:#666; }
  .ai-featured-carousel-{{ ai_gen_id }}__placeholder svg { width:100%; height:100%; }
  .ai-featured-carousel-{{ ai_gen_id }}__details { display:flex; flex-direction:column; gap:18px; }
  .ai-featured-carousel-{{ ai_gen_id }}__title { margin:0; color:{{ block.settings.heading_color }}; font-family:{{ settings.type_heading_font.family }}; font-size:clamp(24px,3vw,38px); line-height:1.15; }
  .ai-featured-carousel-{{ ai_gen_id }}__price { font-size:20px; font-weight:600; }
  .ai-featured-carousel-{{ ai_gen_id }}__form { display:flex; flex-direction:column; gap:12px; }
  .ai-featured-carousel-{{ ai_gen_id }}__quantity { display:flex; align-items:center; width:max-content; border:1px solid {{ block.settings.border_color }}; border-radius:{{ settings.all_input_radius }}px; overflow:hidden; }
  .ai-featured-carousel-{{ ai_gen_id }}__quantity button { width:38px; height:42px; background:transparent; border:0; cursor:pointer; font-size:20px; color:{{ block.settings.text_color }}; }
  .ai-featured-carousel-{{ ai_gen_id }}__quantity input { width:42px; height:42px; border:0; text-align:center; background:transparent; color:{{ block.settings.text_color }}; }
  .ai-featured-carousel-{{ ai_gen_id }}__button { min-height:48px; border:1px solid {{ block.settings.button_color }}; border-radius:{{ settings.all_button_radius }}px; background:{{ block.settings.button_color }}; color:{{ block.settings.button_text_color }}; cursor:pointer; font-weight:600; padding:12px 18px; }
  .ai-featured-carousel-{{ ai_gen_id }}__button--buy { background:transparent; color:{{ block.settings.button_color }}; }
  .ai-featured-carousel-{{ ai_gen_id }}__nav { position:absolute; top:50%; transform:translateY(-50%); width:42px; height:42px; border:1px solid {{ block.settings.border_color }}; border-radius:50%; background:{{ block.settings.background_color }}; color:{{ block.settings.text_color }}; cursor:pointer; z-index:2; font-size:24px; }
  .ai-featured-carousel-{{ ai_gen_id }}__nav--prev { left:0; }.ai-featured-carousel-{{ ai_gen_id }}__nav--next { right:0; }
  .ai-featured-carousel-{{ ai_gen_id }}__status { min-height:20px; font-size:14px; color:{{ block.settings.accent_color }}; }
  @media screen and (max-width:749px) {
    .ai-featured-carousel-{{ ai_gen_id }} { width:100%; }
    .ai-featured-carousel-{{ ai_gen_id }}__slide { grid-template-columns:1fr; gap:22px; padding:8px 42px 18px; }
    .ai-featured-carousel-{{ ai_gen_id }}__gallery { display:flex; flex-direction:column; gap:10px; }
    .ai-featured-carousel-{{ ai_gen_id }}__main { width:100%; aspect-ratio:1 / 1.08; }
    .ai-featured-carousel-{{ ai_gen_id }}__thumbs { order:2; width:100%; flex-direction:row; overflow-x:auto; padding:2px 0 5px; scrollbar-width:none; }
    .ai-featured-carousel-{{ ai_gen_id }}__thumbs::-webkit-scrollbar { display:none; }
    .ai-featured-carousel-{{ ai_gen_id }}__thumb { flex:0 0 58px; }
    .ai-featured-carousel-{{ ai_gen_id }}__details { gap:13px; }
    .ai-featured-carousel-{{ ai_gen_id }}__nav { width:34px; height:34px; }
  }
{% endstyle %}

<featured-product-carousel-{{ ai_gen_id }} class="ai-featured-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}<h2 class="ai-featured-carousel-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
  {% if block.settings.products.size > 0 %}
    <div class="ai-featured-carousel-{{ ai_gen_id }}__viewport">
      <button class="ai-featured-carousel-{{ ai_gen_id }}__nav ai-featured-carousel-{{ ai_gen_id }}__nav--prev" type="button" aria-label="Previous product">&#8249;</button>
      <div class="ai-featured-carousel-{{ ai_gen_id }}__track">
        {% for product in block.settings.products %}
          <article class="ai-featured-carousel-{{ ai_gen_id }}__slide">
            <div class="ai-featured-carousel-{{ ai_gen_id }}__gallery">
              <div class="ai-featured-carousel-{{ ai_gen_id }}__thumbs">
                {% for image in product.images limit: 5 %}<button class="ai-featured-carousel-{{ ai_gen_id }}__thumb" type="button" data-index="{{ forloop.index0 }}" aria-label="View image {{ forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}"><img src="{{ image | image_url: width: 140 }}" alt="{{ image.alt | default: product.title | escape }}" loading="lazy"></button>{% endfor %}
              </div>
              <div class="ai-featured-carousel-{{ ai_gen_id }}__main">
                {% if product.images.size > 0 %}<div class="ai-featured-carousel-{{ ai_gen_id }}__image-track">{% for image in product.images limit: 5 %}<img class="ai-featured-carousel-{{ ai_gen_id }}__image" src="{{ image | image_url: width: 1200 }}" alt="{{ image.alt | default: product.title | escape }}" loading="lazy">{% endfor %}</div>{% else %}<div class="ai-featured-carousel-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>{% endif %}
              </div>
            </div>
            <div class="ai-featured-carousel-{{ ai_gen_id }}__details">
              <h3 class="ai-featured-carousel-{{ ai_gen_id }}__title">{{ product.title | escape }}</h3><div class="ai-featured-carousel-{{ ai_gen_id }}__price">{{ product.price | money }}</div>
              <form class="ai-featured-carousel-{{ ai_gen_id }}__form" data-product-form><input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}"><div class="ai-featured-carousel-{{ ai_gen_id }}__quantity"><button type="button" data-minus aria-label="Decrease quantity">−</button><input type="number" name="quantity" value="1" min="1" aria-label="Quantity"><button type="button" data-plus aria-label="Increase quantity">+</button></div><button class="ai-featured-carousel-{{ ai_gen_id }}__button" type="submit">{{ block.settings.add_label }}</button><button class="ai-featured-carousel-{{ ai_gen_id }}__button ai-featured-carousel-{{ ai_gen_id }}__button--buy" type="button" data-buy>{{ block.settings.buy_label }}</button><div class="ai-featured-carousel-{{ ai_gen_id }}__status" aria-live="polite"></div></form>
            </div>
          </article>
        {% endfor %}
      </div>
      <button class="ai-featured-carousel-{{ ai_gen_id }}__nav ai-featured-carousel-{{ ai_gen_id }}__nav--next" type="button" aria-label="Next product">&#8250;</button>
    </div>
  {% else %}<p>Please select products in this block's settings.</p>{% endif %}
</featured-product-carousel-{{ ai_gen_id }}>

<script>
(function(){
  class FeaturedProductCarousel{{ ai_gen_id }} extends HTMLElement {
    connectedCallback(){
      this.track=this.querySelector('.ai-featured-carousel-{{ ai_gen_id }}__track'); this.slides=this.querySelectorAll('.ai-featured-carousel-{{ ai_gen_id }}__slide'); this.index=0;
      this.querySelector('.ai-featured-carousel-{{ ai_gen_id }}__nav--prev')?.addEventListener('click',()=>this.move(-1)); this.querySelector('.ai-featured-carousel-{{ ai_gen_id }}__nav--next')?.addEventListener('click',()=>this.move(1));
      this.slides.forEach(slide=>{ const imageTrack=slide.querySelector('.ai-featured-carousel-{{ ai_gen_id }}__image-track'); slide.querySelectorAll('[data-index]').forEach(btn=>btn.addEventListener('click',()=>{ const index=Number(btn.dataset.index); imageTrack?.children[index]?.scrollIntoView({behavior:'smooth',block:'nearest',inline:'start'}); slide.querySelectorAll('[data-index]').forEach(x=>x.setAttribute('aria-current','false')); btn.setAttribute('aria-current','true'); })); const form=slide.querySelector('[data-product-form]'); const input=form.querySelector('[name="quantity"]'); form.querySelector('[data-minus]').addEventListener('click',()=>input.value=Math.max(1,Number(input.value)-1)); form.querySelector('[data-plus]').addEventListener('click',()=>input.value=Number(input.value)+1); form.addEventListener('submit',e=>{e.preventDefault();this.add(form,false)}); form.querySelector('[data-buy]').addEventListener('click',()=>this.add(form,true)); });
    }
    move(step){this.index=(this.index+step+this.slides.length)%this.slides.length;this.track.style.transform='translateX(-'+this.index*100+'%)';}
    add(form,buy){const status=form.querySelector('.ai-featured-carousel-{{ ai_gen_id }}__status');fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({items:[{id:Number(form.querySelector('[name="id"]').value),quantity:Number(form.querySelector('[name="quantity"]').value)}]})}).then(r=>{if(!r.ok)throw new Error();return r.json()}).then(()=>{if(buy)location.href='/checkout';else{status.textContent='Added to cart';document.dispatchEvent(new CustomEvent('cart:refresh'));}}).catch(()=>status.textContent='Unable to add this product');}
  } customElements.define('featured-product-carousel-{{ ai_gen_id }}',FeaturedProductCarousel{{ ai_gen_id }});
})();
</script>

{% schema %}
{"name":"Featured product carousel","settings":[{"type":"text","id":"heading","label":"Heading","default":"Featured products"},{"type":"product_list","id":"products","label":"Products","limit":3},{"type":"text","id":"add_label","label":"Add button","default":"Add to cart"},{"type":"text","id":"buy_label","label":"Buy button","default":"Buy it now"},{"type":"select","id":"heading_alignment","label":"Heading alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"}],"default":"left"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"color","id":"background_color","label":"Background","default":"#f4f1ff"},{"type":"color","id":"image_background","label":"Image background","default":"#ffffff"},{"type":"color","id":"heading_color","label":"Headings","default":"#010133"},{"type":"color","id":"text_color","label":"Text","default":"#000041"},{"type":"color","id":"accent_color","label":"Accent","default":"#4b3613"},{"type":"color","id":"button_color","label":"Button","default":"#000000"},{"type":"color","id":"button_text_color","label":"Button text","default":"#f4f1ff"},{"type":"color","id":"border_color","label":"Borders","default":"#d6d2e5"}],"presets":[{"name":"Featured product carousel"}],"tag":null,"class":"featured-product-carousel-block"}
{% endschema %}