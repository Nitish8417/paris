{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}{% style %}.ai-fp-{{ai_gen_id}}{display:block;width:{{block.settings.desktop_width_percent}}%;max-width:100%;margin:auto}.ai-fp-{{ai_gen_id}}__slide{display:none;grid-template-columns:{{block.settings.image_width}}% 1fr;gap:{{block.settings.gap}}px;background:{{block.settings.panel_color}};padding:{{block.settings.padding}}px;border-radius:{{block.settings.radius}}px}.ai-fp-{{ai_gen_id}}__slide.active{display:grid}.ai-fp-{{ai_gen_id}}__main{height:{{block.settings.image_height}}px;overflow:auto;background:{{block.settings.image_bg}}}.ai-fp-{{ai_gen_id}}__main img{width:100%;height:auto;min-height:100%;object-fit:contain}.ai-fp-{{ai_gen_id}}__thumbs{display:flex;gap:8px;overflow:auto;padding-top:10px}.ai-fp-{{ai_gen_id}}__thumb{flex:0 0 {{block.settings.thumb_size}}px;height:{{block.settings.thumb_size}}px;padding:0;border:2px solid transparent}.ai-fp-{{ai_gen_id}}__thumb.active{border-color:{{block.settings.accent}}}.ai-fp-{{ai_gen_id}}__thumb img{width:100%;height:100%;object-fit:contain}.ai-fp-{{ai_gen_id}}__details{display:flex;flex-direction:column;gap:15px}.ai-fp-{{ai_gen_id}} select,.ai-fp-{{ai_gen_id}}__qty{width:100%;padding:13px;border:1px solid {{block.settings.border}};border-radius:{{block.settings.control_radius}}px}.ai-fp-{{ai_gen_id}}__qty{display:flex;padding:0;max-width:320px;margin:auto}.ai-fp-{{ai_gen_id}}__qty button{width:52px;background:{{block.settings.accent}};color:#fff;border:0;font-size:22px}.ai-fp-{{ai_gen_id}}__qty input{flex:1;text-align:center;border:0}.ai-fp-{{ai_gen_id}}__actions{max-width:320px;width:100%;margin:auto;display:grid;gap:10px}.ai-fp-{{ai_gen_id}}__actions button{min-height:50px;border-radius:{{block.settings.button_radius}}px;font-weight:bold}.ai-fp-{{ai_gen_id}}__add{background:#F4F1FF;color:#000041;border:1px solid {{block.settings.accent}}}.ai-fp-{{ai_gen_id}}__arrow{position:absolute;top:50%;transform:translateY(-50%);z-index:3;border:0;border-radius:50%;width:48px;height:48px;background:{{block.settings.accent}};color:#fff;font-size:22px}.ai-fp-{{ai_gen_id}}__prev{left:0}.ai-fp-{{ai_gen_id}}__next{right:0}.ai-fp-{{ai_gen_id}}__viewport{position:relative;padding:0 56px}@media(max-width:749px){.ai-fp-{{ai_gen_id}}__slide{grid-template-columns:1fr;padding:18px}.ai-fp-{{ai_gen_id}}__viewport{padding:0 8px}}{% endstyle %}<featured-products-{{ai_gen_id}} class="ai-fp-{{ai_gen_id}}" {{block.shopify_attributes}}><h2>{{block.settings.heading}}</h2><div class="ai-fp-{{ai_gen_id}}__viewport"><button type="button" class="ai-fp-{{ai_gen_id}}__arrow ai-fp-{{ai_gen_id}}__prev">←</button><button type="button" class="ai-fp-{{ai_gen_id}}__arrow ai-fp-{{ai_gen_id}}__next">→</button>{% for i in (1..6) %}{% assign key='product_'|append:i %}{% assign p=block.settings[key] %}{% if p != blank %}<article class="ai-fp-{{ai_gen_id}}__slide{% if forloop.first %} active{% endif %}"><div><div class="ai-fp-{{ai_gen_id}}__main">{% for im in p.images %}<img src="{{im|image_url:width:1400}}" alt="{{im.alt|default:p.title|escape}}" data-i="{{forloop.index0}}"{% unless forloop.first %} hidden{% endunless %}>{% endfor %}</div><div class="ai-fp-{{ai_gen_id}}__thumbs">{% for im in p.images %}<button type="button" class="ai-fp-{{ai_gen_id}}__thumb{% if forloop.first %} active{% endif %}" data-i="{{forloop.index0}}"><img src="{{im|image_url:width:200}}" alt="{{im.alt|default:p.title|escape}}"></button>{% endfor %}</div></div><div class="ai-fp-{{ai_gen_id}}__details"><h3>{{p.title}}</h3>{% form 'product',p %}<strong>{{p.selected_or_first_available_variant.price|money}}</strong>{% if p.has_only_default_variant == false %}<select name="id">{% for v in p.variants %}<option value="{{v.id}}"{% unless v.available %} disabled{% endunless %}>{{v.title}}</option>{% endfor %}</select>{% else %}<input type="hidden" name="id" value="{{p.selected_or_first_available_variant.id}}">{% endif %}<div class="ai-fp-{{ai_gen_id}}__qty"><button type="button" data-minus>−</button><input name="quantity" type="number" value="1" min="1"><button type="button" data-plus>+</button></div><div class="ai-fp-{{ai_gen_id}}__actions"><button class="ai-fp-{{ai_gen_id}}__add" type="submit">Add to cart</button>{{form|payment_button}}</div>{% endform %}</div></article>{% endif %}{% endfor %}</div></featured-products-{{ai_gen_id}}><script>(function(){class FP{{ai_gen_id}} extends HTMLElement{connectedCallback(){this.s=[...this.querySelectorAll('.ai-fp-{{ai_gen_id}}__slide')];this.i=0;this.querySelector('.ai-fp-{{ai_gen_id}}__prev').onclick=()=>this.go(this.i-1);this.querySelector('.ai-fp-{{ai_gen_id}}__next').onclick=()=>this.go(this.i+1);this.s.forEach(x=>{x.querySelectorAll('.ai-fp-{{ai_gen_id}}__thumb').forEach(b=>b.onclick=()=>{x.querySelectorAll('[data-i]').forEach(e=>e.hidden=e.dataset.i!=b.dataset.i);x.querySelectorAll('.ai-fp-{{ai_gen_id}}__thumb').forEach(e=>e.classList.toggle('active',e==b))});let q=x.querySelector('input[type=number]');x.querySelector('[data-minus]').onclick=()=>q.value=Math.max(1,+q.value-1);x.querySelector('[data-plus]').onclick=()=>q.value=+q.value+1})}go(i){this.i=(i+this.s.length)%this.s.length;this.s.forEach((x,j)=>x.classList.toggle('active',j==this.i))}}customElements.define('featured-products-{{ai_gen_id}}',FP{{ai_gen_id}})})();</script>{% schema %}{"name":"Techty Featured Products","tag":null,"class":"techty-featured-products","settings":[{"type":"text","id":"heading","label":"Heading","default":"Featured products"},{"type":"product","id":"product_1","label":"Product 1"},{"type":"product","id":"product_2","label":"Product 2"},{"type":"product","id":"product_3","label":"Product 3"},{"type":"product","id":"product_4","label":"Product 4"},{"type":"product","id":"product_5","label":"Product 5"},{"type":"product","id":"product_6","label":"Product 6"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"image_width","label":"Image column","min":40,"max":70,"step":5,"unit":"%","default":55},{"type":"range","id":"image_height","label":"Image height","min":300,"max":800,"step":50,"unit":"px","default":550},{"type":"range","id":"thumb_size","label":"Thumbnail size","min":40,"max":100,"step":10,"unit":"px","default":50},{"type":"range","id":"gap","label":"Column gap","min":16,"max":80,"step":8,"unit":"px","default":40},{"type":"range","id":"padding","label":"Panel padding","min":16,"max":64,"step":8,"unit":"px","default":32},{"type":"range","id":"radius","label":"Panel radius","min":0,"max":32,"step":4,"unit":"px","default":16},{"type":"range","id":"control_radius","label":"Control radius","min":4,"max":30,"step":2,"unit":"px","default":16},{"type":"range","id":"button_radius","label":"Button radius","min":8,"max":36,"step":2,"unit":"px","default":24},{"type":"color","id":"panel_color","label":"Panel background","default":"#F4F1FF"},{"type":"color","id":"image_bg","label":"Image background","default":"#FFFFFF"},{"type":"color","id":"accent","label":"Accent color","default":"#000041"},{"type":"color","id":"border","label":"Border color","default":"#B9B5D5"}],"presets":[{"name":"Techty Featured Products"}]}{% endschema %}