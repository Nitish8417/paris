{% doc %}
  @prompt
    Create a NEW Paris theme section named 'Techty Featured Products' to replace the broken generated block, leaving the original Trending section untouched. Support 4 to 6 reorderable product blocks, each with its own single product picker; add products one at a time in the editor. Show one full Featured product panel at a time, with large independently scrollable main product images on the left and clickable thumbnails 20% smaller horizontally below, and title, price, real variant choices only if present, quantity, Add to cart and Buy it now on the right. FIX THE CURRENT FAILURE: products and their PICTURES do not appear on second and third carousel pages. For each slide, render images and thumbnails from THAT block's selected product, with a visible first image initially and working image navigation after switching products; avoid shared gallery state and duplicate element IDs. Include prominent outer left/right arrows to change products, separate from picture navigation. Ensure every slide shows the correct selected product, variant, image, thumbnail, price, and purchase form; the quantity and buttons work for that slide. Provide editor settings for overall container width, product/image container size, colors and fonts. Center and lengthen the polished quantity selector and align its width with Add to cart and Buy it now. Add to cart background #F4F1FF with readable contrasting text. Responsive on mobile. Do not create compact cards or a collection banner., Make the quantity picker, add to cart and buy it now better. Make the thumbnails smaller. Make the Images scrollable, Make the image fit to container not zoomed in. Make add to cart, buy it now and quanity picker look more asthetic, Make the images scrollable Can you change the add to cart and buy it now buttons more rounded, and make the quantity picker a Stepper (- / +), The products are gone . 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}.techty-featured-{{ai_gen_id}}{display:block;width:{{block.settings.desktop_width_percent}}%;max-width:100%;margin:auto;color:{{block.settings.text_color}}}.techty-featured-{{ai_gen_id}}__track{display:flex;overflow:hidden;position:relative}.techty-featured-{{ai_gen_id}}__slide{min-width:100%;display:grid;grid-template-columns:1.1fr 1fr;gap:32px;align-items:center}.techty-featured-{{ai_gen_id}}__gallery{min-width:0}.techty-featured-{{ai_gen_id}}__main{height:{{block.settings.image_height}}px;overflow:auto;background:{{block.settings.image_background}};border-radius:{{block.settings.radius}}px}.techty-featured-{{ai_gen_id}}__main img{display:block;width:100%;height:100%;object-fit:contain}.techty-featured-{{ai_gen_id}}__thumbs{display:flex;gap:8px;overflow-x:auto;padding:10px}.techty-featured-{{ai_gen_id}}__thumb{flex:0 0 52px;width:52px;height:52px;padding:3px;border:1px solid #aaa;background:#fff;border-radius:{{block.settings.radius}}px}.techty-featured-{{ai_gen_id}}__thumb img{width:100%;height:100%;object-fit:cover}.techty-featured-{{ai_gen_id}}__info h2{font-family:{{block.settings.heading_font.family}};margin:0 0 12px}.techty-featured-{{ai_gen_id}}__price{font-size:1.25em;font-weight:700;margin-bottom:20px}.techty-featured-{{ai_gen_id}}__qty{display:flex;align-items:center;justify-content:center;width:100%;margin:18px 0;border:1px solid #aaa;border-radius:999px;overflow:hidden}.techty-featured-{{ai_gen_id}}__qty button{width:54px;height:54px;border:0;background:transparent;font-size:24px;cursor:pointer}.techty-featured-{{ai_gen_id}}__qty input{width:70px;height:54px;border:0;text-align:center;font-size:18px}.techty-featured-{{ai_gen_id}}__actions{display:grid;gap:12px}.techty-featured-{{ai_gen_id}}__actions button{min-height:56px;border-radius:999px;font-weight:700;font-size:16px;cursor:pointer}.techty-featured-{{ai_gen_id}}__add{background:#F4F1FF;color:#03032B;border:1px solid #03032B}.techty-featured-{{ai_gen_id}}__buy{background:{{block.settings.buy_background}};color:{{block.settings.buy_text}};border:0}.techty-featured-{{ai_gen_id}}__nav{display:flex;justify-content:space-between;margin:14px 0}.techty-featured-{{ai_gen_id}}__nav button{border:0;border-radius:50%;width:46px;height:46px;background:#03032B;color:#F4F1FF;font-size:24px;cursor:pointer}@media(max-width:749px){.techty-featured-{{ai_gen_id}}__slide{grid-template-columns:1fr;gap:18px}.techty-featured-{{ai_gen_id}}__main{height:{{block.settings.mobile_image_height}}px}}
{% endstyle %}<featured-products-{{ai_gen_id}} class="techty-featured-{{ai_gen_id}}" {{block.shopify_attributes}}><div class="techty-featured-{{ai_gen_id}}__track">{% for i in (1..6) %}{% assign key='product_'|append:i %}{% assign p=block.settings[key] %}{% if p != blank %}<article class="techty-featured-{{ai_gen_id}}__slide" data-slide><div class="techty-featured-{{ai_gen_id}}__gallery"><div class="techty-featured-{{ai_gen_id}}__main"><img src="{{p.featured_image|image_url:width:1600}}" alt="{{p.featured_image.alt|escape}}" data-main></div><div class="techty-featured-{{ai_gen_id}}__thumbs">{% for image in p.images %}<button type="button" class="techty-featured-{{ai_gen_id}}__thumb" data-image="{{image|image_url:width:1600}}"><img src="{{image|image_url:width:160}}" alt="{{image.alt|escape}}"></button>{% endfor %}</div></div><div class="techty-featured-{{ai_gen_id}}__info"><h2>{{p.title}}</h2><div class="techty-featured-{{ai_gen_id}}__price">{{p.price|money}}</div>{% form 'product',p %}<select name="id" aria-label="Variant">{% for v in p.variants %}<option value="{{v.id}}"{% if v == p.selected_or_first_available_variant %} selected{% endif %}>{{v.title}} - {{v.price|money}}</option>{% endfor %}</select><div class="techty-featured-{{ai_gen_id}}__qty"><button type="button" data-minus aria-label="Decrease quantity">−</button><input name="quantity" type="number" min="1" value="1" aria-label="Quantity"><button type="button" data-plus aria-label="Increase quantity">+</button></div><div class="techty-featured-{{ai_gen_id}}__actions"><button class="techty-featured-{{ai_gen_id}}__add" type="submit">Add to cart</button><button class="techty-featured-{{ai_gen_id}}__buy" type="submit" name="checkout">Buy it now</button></div>{% endform %}</div></article>{% endif %}{% endfor %}</div><div class="techty-featured-{{ai_gen_id}}__nav"><button type="button" data-prev aria-label="Previous product">‹</button><button type="button" data-next aria-label="Next product">›</button></div></featured-products-{{ai_gen_id}}><script>(function(){class TP{{ai_gen_id}} extends HTMLElement{connectedCallback(){this.track=this.querySelector('.techty-featured-{{ai_gen_id}}__track');this.slides=[...this.querySelectorAll('[data-slide]')];this.index=0;this.go=()=>this.track.scrollTo({left:this.index*this.track.clientWidth,behavior:'smooth'});this.querySelector('[data-next]').onclick=()=>{this.index=(this.index+1)%this.slides.length;this.go()};this.querySelector('[data-prev]').onclick=()=>{this.index=(this.index-1+this.slides.length)%this.slides.length;this.go()};this.querySelectorAll('[data-slide]').forEach(s=>{s.querySelectorAll('[data-image]').forEach(b=>b.onclick=()=>s.querySelector('[data-main]').src=b.dataset.image);s.querySelector('[data-minus]').onclick=()=>{let n=s.querySelector('[name="quantity"]');n.value=Math.max(1,+n.value-1)};s.querySelector('[data-plus]').onclick=()=>{let n=s.querySelector('[name="quantity"]');n.value=+n.value+1}})}}customElements.define('featured-products-{{ai_gen_id}}',TP{{ai_gen_id}})})();</script>{% schema %}{"name":"Techty Featured Products","settings":[{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"image_height","label":"Image height","min":300,"max":900,"step":50,"unit":"px","default":600},{"type":"range","id":"mobile_image_height","label":"Mobile image height","min":220,"max":600,"step":20,"unit":"px","default":360},{"type":"range","id":"radius","label":"Corner radius","min":0,"max":20,"step":2,"unit":"px","default":4},{"type":"font_picker","id":"heading_font","label":"Heading font","default":"inter_n7"},{"type":"color","id":"image_background","label":"Image background","default":"#F4F1FF"},{"type":"color","id":"text_color","label":"Text color","default":"#03032B"},{"type":"color","id":"buy_background","label":"Buy background","default":"#03032B"},{"type":"color","id":"buy_text","label":"Buy text","default":"#F4F1FF"},{"type":"product","id":"product_1","label":"Product 1"},{"type":"product","id":"product_2","label":"Product 2"},{"type":"product","id":"product_3","label":"Product 3"},{"type":"product","id":"product_4","label":"Product 4"},{"type":"product","id":"product_5","label":"Product 5"},{"type":"product","id":"product_6","label":"Product 6"}],"presets":[{"name":"Techty Featured Products"}],"tag":null,"class":"techty-featured-products"}{% endschema %}