{% doc %}
  @prompt
    Make the selected slideshow banner image fully clickable and link it to the Content Creator Kit collection at https://techty.com/collections/content-creator-kit. Preserve the existing banner image, text, layout, and styling. The link should cover the whole banner area and open the collection in the same tab.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-clickable-banner-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    overflow: hidden;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-clickable-banner-{{ ai_gen_id }}__link {
    position: relative;
    display: block;
    width: 100%;
    color: inherit;
    text-decoration: none;
  }

  .ai-clickable-banner-{{ ai_gen_id }}__media {
    display: block;
    width: 100%;
    height: auto;
  }

  .ai-clickable-banner-{{ ai_gen_id }}__placeholder {
    display: flex;
    position: relative;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 280px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-clickable-banner-{{ ai_gen_id }}__placeholder svg {
    display: block;
    width: 100%;
    max-width: 520px;
    height: 100%;
    min-height: 280px;
  }

  .ai-clickable-banner-{{ ai_gen_id }}__empty-state {
    position: absolute;
    bottom: 18px;
    left: 50%;
    width: calc(100% - 36px);
    transform: translateX(-50%);
    color: {{ block.settings.text_color }};
    font-size: 14px;
    text-align: center;
  }

  .ai-clickable-banner-{{ ai_gen_id }}__content {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    padding: 24px;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
    color: #ffffff;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-clickable-banner-{{ ai_gen_id }}__content:empty {
    display: none;
  }

  .ai-clickable-banner-{{ ai_gen_id }}__content p,
  .ai-clickable-banner-{{ ai_gen_id }}__content h1,
  .ai-clickable-banner-{{ ai_gen_id }}__content h2,
  .ai-clickable-banner-{{ ai_gen_id }}__content h3,
  .ai-clickable-banner-{{ ai_gen_id }}__content h4,
  .ai-clickable-banner-{{ ai_gen_id }}__content h5,
  .ai-clickable-banner-{{ ai_gen_id }}__content h6 {
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-clickable-banner-{{ ai_gen_id }}__content {
      padding: 16px;
    }
  }
{% endstyle %}

<div class="ai-clickable-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <a class="ai-clickable-banner-{{ ai_gen_id }}__link" href="https://techty.com/collections/content-creator-kit" aria-label="{{ block.settings.accessibility_label | escape }}">
    {% if block.settings.image != blank %}
      <img
        class="ai-clickable-banner-{{ ai_gen_id }}__media"
        src="{{ block.settings.image | image_url: width: 2400 }}"
        alt="{{ block.settings.image.alt | escape }}"
        width="{{ block.settings.image.width }}"
        height="{{ block.settings.image.height }}"
        loading="lazy"
      >
    {% else %}
      <div class="ai-clickable-banner-{{ ai_gen_id }}__placeholder">
        {{ 'image' | placeholder_svg_tag }}
        <span class="ai-clickable-banner-{{ ai_gen_id }}__empty-state">Add a banner image to get started</span>
      </div>
    {% endif %}

    {% if block.settings.text != blank %}
      <div class="ai-clickable-banner-{{ ai_gen_id }}__content">
        {{ block.settings.text }}
      </div>
    {% endif %}
  </a>
</div>

{% schema %}
{
  "name": "Clickable banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner image"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Banner text",
      "default": "<p>Content creator kit</p>"
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
      "default": "Shop the Content Creator Kit collection"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "radio",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Placeholder text",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Clickable banner"
    }
  ],
  "tag": null,
  "class": "clickable-banner-block"
}
{% endschema %}