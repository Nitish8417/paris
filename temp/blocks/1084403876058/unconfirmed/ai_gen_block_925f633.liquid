{% doc %}
  @prompt
    A heading with an animated glowing effect
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-glow-heading-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0;
    color: {{ block.settings.text_color }};
    font-family: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_weight }};
    line-height: 1.15;
    text-align: {{ block.settings.alignment }};
    text-shadow: 0 0 {{ block.settings.glow_blur }}px {{ block.settings.glow_color }}, 0 0 {{ block.settings.glow_blur | times: 2 }}px {{ block.settings.glow_color }};
    animation: ai-glow-pulse-{{ ai_gen_id }} {{ block.settings.animation_speed }}s ease-in-out infinite alternate;
  }

  @keyframes ai-glow-pulse-{{ ai_gen_id }} {
    from {
      text-shadow: 0 0 {{ block.settings.glow_blur | divided_by: 2 }}px {{ block.settings.glow_color }}, 0 0 {{ block.settings.glow_blur }}px {{ block.settings.glow_color }};
    }
    to {
      text-shadow: 0 0 {{ block.settings.glow_blur }}px {{ block.settings.glow_color }}, 0 0 {{ block.settings.glow_blur | times: 2 }}px {{ block.settings.glow_color }};
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-glow-heading-{{ ai_gen_id }} {
      animation: none;
    }
  }
{% endstyle %}

<h2 class="ai-glow-heading-{{ ai_gen_id }}" {{ block.shopify_attributes }}>{{ block.settings.heading | escape }}</h2>

{% schema %}
{
  "name": "Glowing heading",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A brighter way forward"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 16,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" }
      ],
      "default": "700"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#F4F1FF"
    },
    {
      "type": "color",
      "id": "glow_color",
      "label": "Glow color",
      "default": "#7A25FF"
    },
    {
      "type": "range",
      "id": "glow_blur",
      "label": "Glow intensity",
      "min": 4,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "animation_speed",
      "label": "Animation speed",
      "min": 1,
      "max": 6,
      "step": 1,
      "unit": "s",
      "default": 3
    }
  ],
  "presets": [
    {
      "name": "Glowing heading"
    }
  ],
  "tag": null,
  "class": "glowing-heading-block"
}
{% endschema %}