{% doc %}
  @prompt
    I want a banner with scrolling video banner with shows 10s videos of 3-4 prodcuts of a brand 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-product-banner-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.vertical_padding }}px 0;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-video-product-banner-{{ ai_gen_id }}__inner {
    width: 100%;
    padding: 0 20px;
  }

  .ai-video-product-banner-{{ ai_gen_id }}__heading {
    max-width: 680px;
    margin: 0 auto 22px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-video-product-banner-{{ ai_gen_id }}__title {
    margin: 0 0 8px;
    color: {{ block.settings.heading_color }};
    font-family: {{ settings.type_heading_font.family }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.2;
  }

  .ai-video-product-banner-{{ ai_gen_id }}__text {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: 16px;
    line-height: 1.5;
  }

  .ai-video-product-banner-{{ ai_gen_id }}__rail {
    display: flex;
    gap: 16px;
    width: 100%;
    overflow-x: auto;
    padding: 4px 2px 12px;
    scroll-snap-type: x mandatory;
    scrollbar-color: {{ block.settings.accent_color }} transparent;
  }

  .ai-video-product-banner-{{ ai_gen_id }}__card {
    position: relative;
    flex: 0 0 calc((100% - 48px) / 4);
    min-width: 220px;
    overflow: hidden;
    border-radius: {{ settings.all_box_radius }}px;
    background: {{ block.settings.card_color }};
    scroll-snap-align: start;
    text-decoration: none;
    color: inherit;
  }

  .ai-video-product-banner-{{ ai_gen_id }}__media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: {{ settings.image_background_color }};
  }

  .ai-video-product-banner-{{ ai_gen_id }}__media video,
  .ai-video-product-banner-{{ ai_gen_id }}__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-video-product-banner-{{ ai_gen_id }}__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: {{ block.settings.text_color }};
  }

  .ai-video-product-banner-{{ ai_gen_id }}__placeholder svg {
    width: 70%;
    height: 70%;
  }

  .ai-video-product-banner-{{ ai_gen_id }}__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 5px 9px;
    border-radius: 3px;
    background: {{ block.settings.accent_color }};
    color: {{ block.settings.badge_text_color }};
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .ai-video-product-banner-{{ ai_gen_id }}__info {
    padding: 14px 16px 16px;
  }

  .ai-video-product-banner-{{ ai_gen_id }}__vendor {
    margin: 0 0 4px;
    color: {{ block.settings.accent_color }};
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .ai-video-product-banner-{{ ai_gen_id }}__product-title {
    margin: 0;
    color: {{ block.settings.card_text_color }};
    font-size: 16px;
    line-height: 1.35;
  }

  @media screen and (max-width: 749px) {
    .ai-video-product-banner-{{ ai_gen_id }}__inner { padding: 0 14px; }
    .ai-video-product-banner-{{ ai_gen_id }}__card { flex-basis: 74%; min-width: 0; }
    .ai-video-product-banner-{{ ai_gen_id }}__title { font-size: {{ block.settings.mobile_heading_size }}px; }
  }
{% endstyle %}

<video-product-banner-{{ ai_gen_id }} class="ai-video-product-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-video-product-banner-{{ ai_gen_id }}__inner">
    <div class="ai-video-product-banner-{{ ai_gen_id }}__heading">
      {% if block.settings.title != blank %}<h2 class="ai-video-product-banner-{{ ai_gen_id }}__title">{{ block.settings.title | escape }}</h2>{% endif %}
      {% if block.settings.description != blank %}<p class="ai-video-product-banner-{{ ai_gen_id }}__text">{{ block.settings.description | escape }}</p>{% endif %}
    </div>

    <div class="ai-video-product-banner-{{ ai_gen_id }}__rail" aria-label="{{ block.settings.title | escape }}">
      {% for product in block.settings.products limit: 4 %}
        {% assign product_video = blank %}
        {% for media in product.media %}
          {% if media.media_type == 'video' or media.media_type == 'external_video' %}
            {% assign product_video = media %}
            {% break %}
          {% endif %}
        {% endfor %}
        <a class="ai-video-product-banner-{{ ai_gen_id }}__card" href="{{ product.url }}" aria-label="View {{ product.title | escape }}">
          <div class="ai-video-product-banner-{{ ai_gen_id }}__media">
            {% if product_video != blank %}
              {{ product_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, image_size: '800x' }}
            {% elsif product.featured_image %}
              <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="800" height="1000">
            {% else %}
              <div class="ai-video-product-banner-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>
            {% endif %}
            <span class="ai-video-product-banner-{{ ai_gen_id }}__badge">{{ block.settings.badge_text | escape }}</span>
          </div>
          <div class="ai-video-product-banner-{{ ai_gen_id }}__info">
            {% if product.vendor != blank %}<p class="ai-video-product-banner-{{ ai_gen_id }}__vendor">{{ product.vendor | escape }}</p>{% endif %}
            <h3 class="ai-video-product-banner-{{ ai_gen_id }}__product-title">{{ product.title | escape }}</h3>
          </div>
        </a>
      {% else %}
        <div class="ai-video-product-banner-{{ ai_gen_id }}__card"><div class="ai-video-product-banner-{{ ai_gen_id }}__media"><div class="ai-video-product-banner-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div></div><div class="ai-video-product-banner-{{ ai_gen_id }}__info"><p class="ai-video-product-banner-{{ ai_gen_id }}__product-title">Add up to four products to show their videos.</p></div></div>
      {% endfor %}
    </div>
  </div>
</video-product-banner-{{ ai_gen_id }}>

<script>
  (function() {
    class VideoProductBanner{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        this.videos = this.querySelectorAll('video');
        this.videos.forEach((video) => {
          video.addEventListener('timeupdate', () => {
            if (video.currentTime >= 10) video.currentTime = 0;
          });
        });
      }
    }
    if (!customElements.get('video-product-banner-{{ ai_gen_id }}')) customElements.define('video-product-banner-{{ ai_gen_id }}', VideoProductBanner{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Scrolling video banner",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "title", "label": "Title", "default": "Explore the collection" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Discover the latest products in motion." },
    { "type": "text", "id": "badge_text", "label": "Badge text", "default": "Watch" },
    { "type": "product_list", "id": "products", "label": "Products", "limit": 4 },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "select", "id": "text_alignment", "label": "Text alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }], "default": "center" },
    { "type": "range", "id": "vertical_padding", "label": "Vertical spacing", "min": 10, "max": 80, "step": 5, "unit": "px", "default": 35 },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 18, "max": 56, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "mobile_heading_size", "label": "Mobile heading size", "min": 16, "max": 40, "step": 2, "unit": "px", "default": 24 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#000000" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#F4F1FF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#F1F1FC" },
    { "type": "color", "id": "card_color", "label": "Card background", "default": "#171719" },
    { "type": "color", "id": "card_text_color", "label": "Card text", "default": "#FFFFFF" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#B1ED66" },
    { "type": "color", "id": "badge_text_color", "label": "Badge text", "default": "#000000" }
  ],
  "presets": [{ "name": "Scrolling video banner" }],
  "tag": null,
  "class": "scrolling-video-banner-block"
}
{% endschema %}