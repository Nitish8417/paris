{% doc %}
  @prompt
    An interactive vertical timeline that highlights as the user scrolls
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}.ai-timeline-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:auto;padding:{{ block.settings.padding }}px 16px;color:{{ block.settings.text_color }};font-family:{{ block.settings.body_font.family }};}.ai-timeline-{{ ai_gen_id }}__head{text-align:center;max-width:760px;margin:0 auto 40px}.ai-timeline-{{ ai_gen_id }}__head h2{margin:0 0 10px;color:{{ block.settings.heading_color }};font-family:{{ block.settings.heading_font.family }};font-size:{{ block.settings.heading_size }}px}.ai-timeline-{{ ai_gen_id }}__head div,.ai-timeline-{{ ai_gen_id }}__content{line-height:1.6}.ai-timeline-{{ ai_gen_id }}__list{position:relative;max-width:900px;margin:auto;padding:0;list-style:none}.ai-timeline-{{ ai_gen_id }}__list:before{content:'';position:absolute;left:21px;top:0;bottom:0;width:2px;background:{{ block.settings.line_color }}}.ai-timeline-{{ ai_gen_id }}__item{display:grid;grid-template-columns:44px 1fr;gap:22px;position:relative;margin-bottom:40px}.ai-timeline-{{ ai_gen_id }}__marker{z-index:1;width:44px;height:44px;display:flex;align-items:center;justify-content:center;border:2px solid {{ block.settings.line_color }};border-radius:50%;background:{{ block.settings.background_color }};color:{{ block.settings.muted_color }};font-weight:700;transition:.2s}.ai-timeline-{{ ai_gen_id }}__item.is-active .ai-timeline-{{ ai_gen_id }}__marker{background:{{ block.settings.accent_color }};border-color:{{ block.settings.accent_color }};color:{{ block.settings.accent_text_color }};transform:scale(1.08)}.ai-timeline-{{ ai_gen_id }}__card{padding:24px;border:1px solid {{ block.settings.card_border_color }};border-radius:{{ block.settings.radius }}px;background:{{ block.settings.card_color }};transition:.2s}.ai-timeline-{{ ai_gen_id }}__item.is-active .ai-timeline-{{ ai_gen_id }}__card{border-color:{{ block.settings.accent_color }};transform:translateY(-2px)}.ai-timeline-{{ ai_gen_id }}__eyebrow{color:{{ block.settings.accent_color }};font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.08em}.ai-timeline-{{ ai_gen_id }}__title{margin:8px 0;color:{{ block.settings.heading_color }};font-family:{{ block.settings.heading_font.family }};font-size:23px}.ai-timeline-{{ ai_gen_id }}__content p{margin:0}@media(max-width:749px){.ai-timeline-{{ ai_gen_id }}{padding:30px 16px}.ai-timeline-{{ ai_gen_id }}__head h2{font-size:{{ block.settings.mobile_heading_size }}px}.ai-timeline-{{ ai_gen_id }}__list:before{left:17px}.ai-timeline-{{ ai_gen_id }}__item{grid-template-columns:36px 1fr;gap:14px}.ai-timeline-{{ ai_gen_id }}__marker{width:36px;height:36px}.ai-timeline-{{ ai_gen_id }}__card{padding:18px}}{% endstyle %}
<scroll-timeline-{{ ai_gen_id }} class="ai-timeline-{{ ai_gen_id }}" {{ block.shopify_attributes }}>{% if block.settings.heading != blank or block.settings.intro != blank %}<div class="ai-timeline-{{ ai_gen_id }}__head">{% if block.settings.heading != blank %}<h2>{{ block.settings.heading | escape }}</h2>{% endif %}{% if block.settings.intro != blank %}<div>{{ block.settings.intro }}</div>{% endif %}</div>{% endif %}<ol class="ai-timeline-{{ ai_gen_id }}__list">{% for i in (1..3) %}{% assign enabled_key = 'item_' | append: i | append: '_enabled' %}{% assign eyebrow_key = 'item_' | append: i | append: '_eyebrow' %}{% assign title_key = 'item_' | append: i | append: '_title' %}{% assign content_key = 'item_' | append: i | append: '_content' %}{% if block.settings[enabled_key] %}<li class="ai-timeline-{{ ai_gen_id }}__item" data-item><span class="ai-timeline-{{ ai_gen_id }}__marker">{{ i }}</span><article class="ai-timeline-{{ ai_gen_id }}__card">{% if block.settings[eyebrow_key] != blank %}<span class="ai-timeline-{{ ai_gen_id }}__eyebrow">{{ block.settings[eyebrow_key] | escape }}</span>{% endif %}<h3 class="ai-timeline-{{ ai_gen_id }}__title">{{ block.settings[title_key] | escape }}</h3><div class="ai-timeline-{{ ai_gen_id }}__content">{{ block.settings[content_key] }}</div></article></li>{% endif %}{% endfor %}</ol></scroll-timeline-{{ ai_gen_id }}>
<script>(function(){class T{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.i=[...this.querySelectorAll('[data-item]')];this.f=()=>{let p=innerHeight*.42,c=this.i[0],d=1e9;this.i.forEach(x=>{let r=x.getBoundingClientRect(),n=Math.abs(r.top+r.height/2-p);if(n<d){d=n;c=x}});this.i.forEach(x=>x.classList.toggle('is-active',x===c))};this.f();addEventListener('scroll',this.f,{passive:true})}disconnectedCallback(){removeEventListener('scroll',this.f)}}customElements.define('scroll-timeline-{{ ai_gen_id }}',T{{ ai_gen_id }})})();</script>
{% schema %}{"name":"Scroll timeline","tag":null,"class":"scroll-timeline-block","settings":[{"type":"text","id":"heading","label":"Heading","default":"Our journey"},{"type":"richtext","id":"intro","label":"Intro","default":"<p>Follow each step as you scroll.</p>"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"padding","label":"Spacing","min":20,"max":100,"step":10,"unit":"px","default":60},{"type":"range","id":"heading_size","label":"Heading size","min":24,"max":64,"step":4,"unit":"px","default":40},{"type":"range","id":"mobile_heading_size","label":"Mobile heading size","min":20,"max":40,"step":4,"unit":"px","default":28},{"type":"range","id":"radius","label":"Card radius","min":0,"max":20,"step":2,"unit":"px","default":4},{"type":"color","id":"background_color","label":"Background","default":"#f4f1ff"},{"type":"color","id":"card_color","label":"Card","default":"#ffffff"},{"type":"color","id":"heading_color","label":"Headings","default":"#010133"},{"type":"color","id":"text_color","label":"Text","default":"#000041"},{"type":"color","id":"muted_color","label":"Muted text","default":"#5c5d5d"},{"type":"color","id":"line_color","label":"Line","default":"#b3b4e9"},{"type":"color","id":"accent_color","label":"Accent","default":"#000041"},{"type":"color","id":"accent_text_color","label":"Accent text","default":"#ffffff"},{"type":"color","id":"card_border_color","label":"Card border","default":"#e1e1f1"},{"type":"font_picker","id":"heading_font","label":"Heading font","default":"inter_n7"},{"type":"font_picker","id":"body_font","label":"Body font","default":"inter_n4"},{"type":"header","content":"Timeline items"},{"type":"checkbox","id":"item_1_enabled","label":"Show item 1","default":true},{"type":"text","id":"item_1_eyebrow","label":"Item 1 label","default":"Step one"},{"type":"text","id":"item_1_title","label":"Item 1 title","default":"Start with a clear idea"},{"type":"richtext","id":"item_1_content","label":"Item 1 content","default":"<p>Introduce the first milestone.</p>"},{"type":"checkbox","id":"item_2_enabled","label":"Show item 2","default":true},{"type":"text","id":"item_2_eyebrow","label":"Item 2 label","default":"Step two"},{"type":"text","id":"item_2_title","label":"Item 2 title","default":"Build the experience"},{"type":"richtext","id":"item_2_content","label":"Item 2 content","default":"<p>Show how the next stage takes shape.</p>"},{"type":"checkbox","id":"item_3_enabled","label":"Show item 3","default":true},{"type":"text","id":"item_3_eyebrow","label":"Item 3 label","default":"Step three"},{"type":"text","id":"item_3_title","label":"Item 3 title","default":"Keep moving forward"},{"type":"richtext","id":"item_3_content","label":"Item 3 content","default":"<p>Close with the next chapter.</p>"}],"presets":[{"name":"Scroll timeline"}]}{% endschema %}