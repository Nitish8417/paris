{% doc %}
  @prompt
    A magazine-style editorial layout
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}.ai-editorial-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:0 auto;background:{{ block.settings.background_color }};color:{{ block.settings.text_color }};padding:{{ block.settings.vertical_padding }}px {{ block.settings.horizontal_padding }}px}.ai-editorial-{{ ai_gen_id }}__inner{max-width:1280px;margin:0 auto}.ai-editorial-{{ ai_gen_id }}__masthead{display:flex;justify-content:space-between;align-items:center;gap:20px;border-top:1px solid {{ block.settings.rule_color }};border-bottom:1px solid {{ block.settings.rule_color }};padding:12px 0;margin-bottom:28px;font-size:11px;letter-spacing:.14em;text-transform:uppercase}.ai-editorial-{{ ai_gen_id }}__eyebrow,.ai-editorial-{{ ai_gen_id }}__story-label,.ai-editorial-{{ ai_gen_id }}__kicker{color:{{ block.settings.accent_color }};font-weight:700}.ai-editorial-{{ ai_gen_id }}__issue{opacity:.7}.ai-editorial-{{ ai_gen_id }}__lead{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(260px,.85fr);gap:42px;align-items:center;padding-bottom:34px;border-bottom:1px solid {{ block.settings.rule_color }}}.ai-editorial-{{ ai_gen_id }}__media,.ai-editorial-{{ ai_gen_id }}__placeholder{width:100%;aspect-ratio:4/3;overflow:hidden;background:{{ block.settings.placeholder_color }}}.ai-editorial-{{ ai_gen_id }}__media img{width:100%;height:100%;display:block;object-fit:cover}.ai-editorial-{{ ai_gen_id }}__placeholder{display:flex;align-items:center;justify-content:center;position:relative}.ai-editorial-{{ ai_gen_id }}__placeholder svg{width:100%;height:100%}.ai-editorial-{{ ai_gen_id }}__empty{position:absolute;bottom:16px;left:50%;transform:translateX(-50%);width:calc(100% - 32px);color:{{ block.settings.muted_color }};font-size:12px;text-align:center}.ai-editorial-{{ ai_gen_id }}__content{padding:8px 0}.ai-editorial-{{ ai_gen_id }}__kicker{margin:0 0 14px;font-size:12px;letter-spacing:.16em;text-transform:uppercase}.ai-editorial-{{ ai_gen_id }}__title{margin:0 0 18px;color:{{ block.settings.heading_color }};font-size:clamp(34px,5vw,{{ block.settings.heading_size }}px);line-height:.98;letter-spacing:-.04em}.ai-editorial-{{ ai_gen_id }}__intro{margin:0 0 22px;font-size:17px;line-height:1.55}.ai-editorial-{{ ai_gen_id }}__link{display:inline-flex;color:{{ block.settings.link_color }};font-size:12px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;text-decoration:none;border-bottom:1px solid currentColor;padding-bottom:5px}.ai-editorial-{{ ai_gen_id }}__link:focus-visible{outline:2px solid {{ block.settings.accent_color }};outline-offset:4px}.ai-editorial-{{ ai_gen_id }}__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;padding-top:30px}.ai-editorial-{{ ai_gen_id }}__story{min-width:0}.ai-editorial-{{ ai_gen_id }}__story:not(:last-child){border-right:1px solid {{ block.settings.rule_color }};padding-right:24px}.ai-editorial-{{ ai_gen_id }}__story-label{margin:0 0 9px;font-size:10px;letter-spacing:.12em;text-transform:uppercase}.ai-editorial-{{ ai_gen_id }}__story-title{margin:0 0 10px;color:{{ block.settings.heading_color }};font-size:21px;line-height:1.1}.ai-editorial-{{ ai_gen_id }}__story-text{margin:0 0 14px;font-size:14px;line-height:1.55}@media screen and (max-width:749px){.ai-editorial-{{ ai_gen_id }}{padding:28px 18px}.ai-editorial-{{ ai_gen_id }}__lead{grid-template-columns:1fr;gap:24px}.ai-editorial-{{ ai_gen_id }}__grid{grid-template-columns:1fr;gap:24px}.ai-editorial-{{ ai_gen_id }}__story:not(:last-child){border-right:0;border-bottom:1px solid {{ block.settings.rule_color }};padding:0 0 24px}}{% endstyle %}
<div class="ai-editorial-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-editorial-{{ ai_gen_id }}__inner"><div class="ai-editorial-{{ ai_gen_id }}__masthead"><span class="ai-editorial-{{ ai_gen_id }}__eyebrow">{{ block.settings.section_label }}</span><span class="ai-editorial-{{ ai_gen_id }}__issue">{{ block.settings.issue_label }}</span></div><div class="ai-editorial-{{ ai_gen_id }}__lead">{% if block.settings.feature_image %}<div class="ai-editorial-{{ ai_gen_id }}__media"><img src="{{ block.settings.feature_image | image_url: width: 1600 }}" alt="{{ block.settings.feature_image.alt | escape }}" loading="lazy" width="{{ block.settings.feature_image.width }}" height="{{ block.settings.feature_image.height }}"></div>{% else %}<div class="ai-editorial-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}<span class="ai-editorial-{{ ai_gen_id }}__empty">Add a feature image to complete this editorial layout.</span></div>{% endif %}<div class="ai-editorial-{{ ai_gen_id }}__content">{% if block.settings.feature_kicker != blank %}<p class="ai-editorial-{{ ai_gen_id }}__kicker">{{ block.settings.feature_kicker }}</p>{% endif %}<h2 class="ai-editorial-{{ ai_gen_id }}__title">{{ block.settings.feature_title }}</h2>{% if block.settings.feature_intro != blank %}<div class="ai-editorial-{{ ai_gen_id }}__intro">{{ block.settings.feature_intro }}</div>{% endif %}{% if block.settings.feature_link != blank %}<a class="ai-editorial-{{ ai_gen_id }}__link" href="{{ block.settings.feature_link }}">{{ block.settings.feature_link_label }}</a>{% endif %}</div></div><div class="ai-editorial-{{ ai_gen_id }}__grid">{% for i in (1..3) %}{% liquid
assign label_key = 'story_' | append: i | append: '_label'
assign title_key = 'story_' | append: i | append: '_title'
assign text_key = 'story_' | append: i | append: '_text'
assign link_key = 'story_' | append: i | append: '_link'
assign label = block.settings[label_key]
assign title = block.settings[title_key]
assign text = block.settings[text_key]
assign link = block.settings[link_key]
%}<article class="ai-editorial-{{ ai_gen_id }}__story">{% if label != blank %}<p class="ai-editorial-{{ ai_gen_id }}__story-label">{{ label }}</p>{% endif %}<h3 class="ai-editorial-{{ ai_gen_id }}__story-title">{{ title }}</h3>{% if text != blank %}<p class="ai-editorial-{{ ai_gen_id }}__story-text">{{ text }}</p>{% endif %}{% if link != blank %}<a class="ai-editorial-{{ ai_gen_id }}__link" href="{{ link }}">{{ block.settings.story_link_label }}</a>{% endif %}</article>{% endfor %}</div></div></div>
{% schema %}{"name":"Editorial layout","settings":[{"type":"header","content":"Feature story"},{"type":"image_picker","id":"feature_image","label":"Feature image"},{"type":"text","id":"section_label","label":"Section label","default":"The edit"},{"type":"text","id":"issue_label","label":"Issue label","default":"Issue 01 / 2026"},{"type":"text","id":"feature_kicker","label":"Kicker","default":"A considered collection"},{"type":"text","id":"feature_title","label":"Feature title","default":"Objects with a point of view"},{"type":"richtext","id":"feature_intro","label":"Feature introduction","default":"<p>Explore thoughtful pieces, practical ideas, and the details that make everyday living feel more intentional.</p>"},{"type":"url","id":"feature_link","label":"Feature link"},{"type":"text","id":"feature_link_label","label":"Feature link label","default":"Read the story"},{"type":"header","content":"Secondary stories"},{"type":"text","id":"story_1_label","label":"Story 1 label","default":"01 / Perspective"},{"type":"text","id":"story_1_title","label":"Story 1 title","default":"Small details, lasting impact"},{"type":"textarea","id":"story_1_text","label":"Story 1 text","default":"A closer look at the choices behind a more considered routine."},{"type":"url","id":"story_1_link","label":"Story 1 link"},{"type":"text","id":"story_2_label","label":"Story 2 label","default":"02 / Guide"},{"type":"text","id":"story_2_title","label":"Story 2 title","default":"How to choose with confidence"},{"type":"textarea","id":"story_2_text","label":"Story 2 text","default":"Useful advice for finding the right fit without the guesswork."},{"type":"url","id":"story_2_link","label":"Story 2 link"},{"type":"text","id":"story_3_label","label":"Story 3 label","default":"03 / New arrivals"},{"type":"text","id":"story_3_title","label":"Story 3 title","default":"The latest edit"},{"type":"textarea","id":"story_3_text","label":"Story 3 text","default":"Discover the newest additions selected for the season ahead."},{"type":"url","id":"story_3_link","label":"Story 3 link"},{"type":"text","id":"story_link_label","label":"Story link label","default":"Explore"},{"type":"header","content":"Layout"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"heading_size","label":"Heading size","min":40,"max":90,"step":5,"unit":"px","default":65},{"type":"range","id":"vertical_padding","label":"Vertical padding","min":20,"max":100,"step":5,"unit":"px","default":55},{"type":"range","id":"horizontal_padding","label":"Horizontal padding","min":10,"max":80,"step":5,"unit":"px","default":30},{"type":"color","id":"background_color","label":"Background","default":"#f4f1ff"},{"type":"color","id":"heading_color","label":"Headings","default":"#010133"},{"type":"color","id":"text_color","label":"Text","default":"#000041"},{"type":"color","id":"accent_color","label":"Accent","default":"#4b3613"},{"type":"color","id":"link_color","label":"Links","default":"#000041"},{"type":"color","id":"rule_color","label":"Rules","default":"#000041"},{"type":"color","id":"placeholder_color","label":"Placeholder","default":"#e3dff8"},{"type":"color","id":"muted_color","label":"Muted text","default":"#3f3f43"}],"presets":[{"name":"Editorial layout"}],"tag":null,"class":"editorial-layout-block"}{% endschema %}