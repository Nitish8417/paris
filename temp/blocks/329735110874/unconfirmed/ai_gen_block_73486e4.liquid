{% doc %}
  @prompt
    Create a polished, responsive slideshow section for the storefront with rounded corners, a subtle adjustable soft shadow, centered presentation, image captions, three slide slots, and navigation dots. Each slide must include an image and a normal URL/link setting. Clicking the slide image should open the entered link. Do not use product or collection picker settings. The image must always remain visible whether the link field is empty or filled, so never conditionally hide or replace the image when a link is added. Place the previous and next arrow buttons vertically centered on the left and right sides of the slideshow image, not at the bottom. Keep the design clean and modern, preserve accessible labels and keyboard-friendly controls, and include easy-to-adjust settings for corner radius, shadow softness, image ratio, slideshow width, caption styling, arrow controls, dots, and colors., It is still erasing the picture. It has nothing 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-slideshow-{{ ai_gen_id }} { display:block; width:{{ block.settings.desktop_width_percent }}%; max-width:100%; margin:0 auto; color:{{ block.settings.caption_color }}; }
  .ai-slideshow-{{ ai_gen_id }}__frame { position:relative; overflow:hidden; border-radius:{{ block.settings.corner_radius }}px; box-shadow:0 4px {{ block.settings.shadow_softness }}px rgba(0,0,0,{{ block.settings.shadow_opacity | divided_by:100.0 }}); background:{{ block.settings.surface_color }}; }
  .ai-slideshow-{{ ai_gen_id }}__slide { display:none; }
  .ai-slideshow-{{ ai_gen_id }}__slide.is-active { display:block; }
  .ai-slideshow-{{ ai_gen_id }}__media { display:block; width:100%; aspect-ratio:{{ block.settings.image_ratio }}; overflow:hidden; }
  .ai-slideshow-{{ ai_gen_id }}__media img { display:block; width:100%; height:100%; object-fit:cover; }
  .ai-slideshow-{{ ai_gen_id }}__placeholder { display:grid; place-items:center; width:100%; aspect-ratio:{{ block.settings.image_ratio }}; background:{{ block.settings.surface_color }}; }
  .ai-slideshow-{{ ai_gen_id }}__placeholder svg { display:block; width:100%; height:100%; }
  .ai-slideshow-{{ ai_gen_id }}__empty { padding:14px; color:#333; text-align:center; font-size:14px; }
  .ai-slideshow-{{ ai_gen_id }}__caption { margin:0; padding:{{ block.settings.caption_padding }}px 18px; background:{{ block.settings.caption_background }}; color:{{ block.settings.caption_color }}; text-align:{{ block.settings.caption_alignment }}; font-size:{{ block.settings.caption_size }}px; line-height:1.45; }
  .ai-slideshow-{{ ai_gen_id }}__arrow { position:absolute; z-index:2; top:50%; display:grid; place-items:center; width:44px; height:44px; padding:0; transform:translateY(-50%); border:1px solid {{ block.settings.control_border }}; border-radius:50%; background:{{ block.settings.control_background }}; color:{{ block.settings.control_color }}; cursor:pointer; }
  .ai-slideshow-{{ ai_gen_id }}__arrow:hover { background:{{ block.settings.control_hover_background }}; color:{{ block.settings.control_hover_color }}; }
  .ai-slideshow-{{ ai_gen_id }}__arrow:focus-visible,.ai-slideshow-{{ ai_gen_id }}__dot:focus-visible,.ai-slideshow-{{ ai_gen_id }}__media:focus-visible { outline:3px solid {{ block.settings.focus_color }}; outline-offset:3px; }
  .ai-slideshow-{{ ai_gen_id }}__arrow--prev { left:14px; }
  .ai-slideshow-{{ ai_gen_id }}__arrow--next { right:14px; }
  .ai-slideshow-{{ ai_gen_id }}__arrow svg { width:20px; height:20px; }
  .ai-slideshow-{{ ai_gen_id }}__dots { display:flex; justify-content:center; gap:10px; padding-top:14px; }
  .ai-slideshow-{{ ai_gen_id }}__dot { width:12px; height:12px; padding:0; border:2px solid {{ block.settings.dot_color }}; border-radius:50%; background:transparent; cursor:pointer; }
  .ai-slideshow-{{ ai_gen_id }}__dot[aria-current="true"] { background:{{ block.settings.dot_color }}; }
  @media screen and (max-width:749px) { .ai-slideshow-{{ ai_gen_id }}__arrow { width:38px; height:38px; } .ai-slideshow-{{ ai_gen_id }}__arrow--prev { left:9px; } .ai-slideshow-{{ ai_gen_id }}__arrow--next { right:9px; } .ai-slideshow-{{ ai_gen_id }}__caption { padding:{{ block.settings.caption_padding | times:0.75 }}px 14px; } }
{% endstyle %}

<ai-slideshow-{{ ai_gen_id }} class="ai-slideshow-{{ ai_gen_id }}" {{ block.shopify_attributes }} aria-label="Slideshow">
  {% assign slide_count = 0 %}
  {% for i in (1..3) %}
    {% assign image_key = 'slide_' | append:i | append:'_image' %}
    {% if block.settings[image_key] != blank %}{% assign slide_count = slide_count | plus:1 %}{% endif %}
  {% endfor %}
  {% if slide_count > 0 %}
    <div class="ai-slideshow-{{ ai_gen_id }}__frame">
      {% assign rendered_slide = 0 %}
      {% for i in (1..3) %}
        {% liquid
          assign image_key = 'slide_' | append:i | append:'_image'
          assign link_key = 'slide_' | append:i | append:'_link'
          assign caption_key = 'slide_' | append:i | append:'_caption'
          assign slide_image = block.settings[image_key]
          assign slide_link = block.settings[link_key]
          assign slide_caption = block.settings[caption_key]
        %}
        {% if slide_image != blank %}
          {% assign rendered_slide = rendered_slide | plus:1 %}
          <div class="ai-slideshow-{{ ai_gen_id }}__slide{% if rendered_slide == 1 %} is-active{% endif %}" data-slide="{{ rendered_slide }}"{% if rendered_slide != 1 %} aria-hidden="true"{% endif %}>
            {% if slide_link != blank %}<a class="ai-slideshow-{{ ai_gen_id }}__media" href="{{ slide_link }}" aria-label="{% if slide_caption != blank %}{{ slide_caption | escape }}{% else %}Open slide {{ rendered_slide }} link{% endif %}">{% endif %}
              {{ slide_image | image_url: width:2400 | image_tag: loading:'lazy', alt:slide_image.alt, widths:'600, 900, 1200, 1600, 2000, 2400' }}
            {% if slide_link != blank %}</a>{% endif %}
            {% if slide_caption != blank %}<p class="ai-slideshow-{{ ai_gen_id }}__caption">{{ slide_caption | escape }}</p>{% endif %}
          </div>
        {% endif %}
      {% endfor %}
      {% if slide_count > 1 %}
        <button class="ai-slideshow-{{ ai_gen_id }}__arrow ai-slideshow-{{ ai_gen_id }}__arrow--prev" type="button" aria-label="Previous slide"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m15 18-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
        <button class="ai-slideshow-{{ ai_gen_id }}__arrow ai-slideshow-{{ ai_gen_id }}__arrow--next" type="button" aria-label="Next slide"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m9 18 6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      {% endif %}
    </div>
    {% if slide_count > 1 %}<div class="ai-slideshow-{{ ai_gen_id }}__dots" role="group" aria-label="Choose a slide">{% for i in (1..slide_count) %}<button class="ai-slideshow-{{ ai_gen_id }}__dot" type="button" data-dot="{{ i }}" aria-label="Go to slide {{ i }}" aria-current="{% if i == 1 %}true{% else %}false{% endif %}"></button>{% endfor %}</div>{% endif %}
  {% else %}
    <div class="ai-slideshow-{{ ai_gen_id }}__frame"><div class="ai-slideshow-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}<div class="ai-slideshow-{{ ai_gen_id }}__empty">Choose an image in one of the slide settings to display it here.</div></div></div>
  {% endif %}
</ai-slideshow-{{ ai_gen_id }}>

<script>
  (function() {
    const tagName = 'ai-slideshow-{{ ai_gen_id }}';
    if (customElements.get(tagName)) return;
    class AiSlideshow extends HTMLElement {
      connectedCallback() {
        this.slides = Array.from(this.querySelectorAll('[data-slide]'));
        this.dots = Array.from(this.querySelectorAll('[data-dot]'));
        this.current = 0;
        if (this.slides.length < 2) return;
        this.addEventListener('click', (event) => {
          if (event.target.closest('.ai-slideshow-{{ ai_gen_id }}__arrow--prev')) this.show(this.current - 1);
          if (event.target.closest('.ai-slideshow-{{ ai_gen_id }}__arrow--next')) this.show(this.current + 1);
          const dot = event.target.closest('[data-dot]');
          if (dot) this.show(Number(dot.dataset.dot) - 1);
        });
        this.addEventListener('keydown', (event) => {
          if (event.key === 'ArrowLeft') { event.preventDefault(); this.show(this.current - 1); }
          if (event.key === 'ArrowRight') { event.preventDefault(); this.show(this.current + 1); }
        });
      }
      show(index) {
        this.current = (index + this.slides.length) % this.slides.length;
        this.slides.forEach((slide, i) => {
          const active = i === this.current;
          slide.classList.toggle('is-active', active);
          slide.setAttribute('aria-hidden', active ? 'false' : 'true');
        });
        this.dots.forEach((dot, i) => dot.setAttribute('aria-current', i === this.current ? 'true' : 'false'));
      }
    }
    customElements.define(tagName, AiSlideshow);
  })();
</script>

{% schema %}
{
  "name":"Image slideshow",
  "settings":[
    {"type":"range","id":"desktop_width_percent","label":"Slideshow width","min":50,"max":100,"step":5,"unit":"%","default":100},
    {"type":"select","id":"image_ratio","label":"Image ratio","options":[{"value":"16 / 9","label":"Wide (16:9)"},{"value":"4 / 3","label":"Landscape (4:3)"},{"value":"1 / 1","label":"Square (1:1)"},{"value":"3 / 4","label":"Portrait (3:4)"}],"default":"16 / 9"},
    {"type":"range","id":"corner_radius","label":"Corner radius","min":0,"max":40,"step":2,"unit":"px","default":16},
    {"type":"range","id":"shadow_softness","label":"Shadow softness","min":0,"max":40,"step":2,"unit":"px","default":12},
    {"type":"range","id":"shadow_opacity","label":"Shadow opacity","min":0,"max":50,"step":5,"unit":"%","default":10},
    {"type":"header","content":"Slide 1"},{"type":"image_picker","id":"slide_1_image","label":"Image"},{"type":"url","id":"slide_1_link","label":"Image link"},{"type":"text","id":"slide_1_caption","label":"Caption"},
    {"type":"header","content":"Slide 2"},{"type":"image_picker","id":"slide_2_image","label":"Image"},{"type":"url","id":"slide_2_link","label":"Image link"},{"type":"text","id":"slide_2_caption","label":"Caption"},
    {"type":"header","content":"Slide 3"},{"type":"image_picker","id":"slide_3_image","label":"Image"},{"type":"url","id":"slide_3_link","label":"Image link"},{"type":"text","id":"slide_3_caption","label":"Caption"},
    {"type":"header","content":"Caption style"},{"type":"range","id":"caption_size","label":"Text size","min":12,"max":28,"step":2,"unit":"px","default":16},{"type":"range","id":"caption_padding","label":"Caption spacing","min":8,"max":32,"step":4,"unit":"px","default":16},{"type":"select","id":"caption_alignment","label":"Text alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}],"default":"center"},
    {"type":"header","content":"Controls and colors"},{"type":"color","id":"caption_background","label":"Caption background","default":"#FFFFFF"},{"type":"color","id":"caption_color","label":"Caption text","default":"#111111"},{"type":"color","id":"surface_color","label":"Image surface","default":"#F4F1FF"},{"type":"color","id":"control_background","label":"Arrow background","default":"#FFFFFF"},{"type":"color","id":"control_color","label":"Arrow icon","default":"#111111"},{"type":"color","id":"control_border","label":"Arrow border","default":"#D6D6D6"},{"type":"color","id":"control_hover_background","label":"Arrow hover background","default":"#111111"},{"type":"color","id":"control_hover_color","label":"Arrow hover icon","default":"#FFFFFF"},{"type":"color","id":"dot_color","label":"Navigation dots","default":"#111111"},{"type":"color","id":"focus_color","label":"Keyboard focus","default":"#005FCC"}
  ],
  "presets":[{"name":"Image slideshow"}],
  "tag":null,
  "class":"image-slideshow-block"
}
{% endschema %}