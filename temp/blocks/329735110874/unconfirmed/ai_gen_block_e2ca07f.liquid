{% doc %}
  @prompt
    Create a replacement slideshow section named Image slideshow. It must have three image and caption slots, with an optional normal URL link setting for each slide. Render each image independently first, and only wrap the rendered image in an anchor when its link is not blank. Never use the link as a replacement for the image, and never hide or erase the image when a link is entered. Clicking an image with a link should open that URL. Include rounded corners, an adjustable soft shadow, centered responsive layout, previous and next arrow buttons vertically centered on the left and right sides of the image, navigation dots below, accessible labels, and settings for image ratio, width, captions, controls, dots, colors, radius, and shadow., It is not showing the picture and the link is also not taking me to the destination 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-slideshow-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin-inline: auto;
    color: {{ block.settings.caption_color }};
  }
  .ai-image-slideshow-{{ ai_gen_id }} .ai-image-slideshow__viewport {
    position: relative;
    overflow: hidden;
    width: 100%;
    aspect-ratio: {{ block.settings.image_ratio }};
    border-radius: {{ block.settings.corner_radius }}px;
    box-shadow: 0 {{ block.settings.shadow_strength | divided_by: 2 }}px {{ block.settings.shadow_strength }}px rgba(0, 0, 0, 0.18);
    background: #f4f4f4;
  }
  .ai-image-slideshow-{{ ai_gen_id }} .ai-image-slideshow__slide {
    position: absolute;
    inset: 0;
    display: none;
  }
  .ai-image-slideshow-{{ ai_gen_id }} .ai-image-slideshow__slide.is-active { display: block; }
  .ai-image-slideshow-{{ ai_gen_id }} .ai-image-slideshow__media,
  .ai-image-slideshow-{{ ai_gen_id }} .ai-image-slideshow__media img,
  .ai-image-slideshow-{{ ai_gen_id }} .ai-image-slideshow__placeholder {
    display: block;
    width: 100%;
    height: 100%;
  }
  .ai-image-slideshow-{{ ai_gen_id }} .ai-image-slideshow__media img { object-fit: cover; }
  .ai-image-slideshow-{{ ai_gen_id }} .ai-image-slideshow__placeholder { position: relative; background: #f1f1f1; }
  .ai-image-slideshow-{{ ai_gen_id }} .ai-image-slideshow__placeholder svg { width: 100%; height: 100%; object-fit: cover; }
  .ai-image-slideshow-{{ ai_gen_id }} .ai-image-slideshow__empty { position: absolute; inset: auto 12px 12px; padding: 8px 12px; text-align: center; color: #333; background: rgba(255,255,255,.92); font-size: 14px; border-radius: 4px; }
  .ai-image-slideshow-{{ ai_gen_id }} .ai-image-slideshow__arrow { position: absolute; z-index: 2; top: 50%; transform: translateY(-50%); display: grid; place-items: center; width: 44px; height: 44px; padding: 0; border: 0; border-radius: 50%; color: {{ block.settings.control_color }}; background: {{ block.settings.control_background }}; cursor: pointer; }
  .ai-image-slideshow-{{ ai_gen_id }} .ai-image-slideshow__arrow--prev { left: 12px; }
  .ai-image-slideshow-{{ ai_gen_id }} .ai-image-slideshow__arrow--next { right: 12px; }
  .ai-image-slideshow-{{ ai_gen_id }} .ai-image-slideshow__arrow svg { width: 20px; height: 20px; }
  .ai-image-slideshow-{{ ai_gen_id }} button:focus-visible,
  .ai-image-slideshow-{{ ai_gen_id }} a:focus-visible { outline: 3px solid {{ block.settings.caption_color }}; outline-offset: 3px; }
  .ai-image-slideshow-{{ ai_gen_id }} .ai-image-slideshow__caption { display: none; margin: 12px 0 0; text-align: center; font-size: 16px; line-height: 1.5; }
  .ai-image-slideshow-{{ ai_gen_id }} .ai-image-slideshow__caption.is-active { display: block; }
  .ai-image-slideshow-{{ ai_gen_id }} .ai-image-slideshow__dots { display: flex; justify-content: center; align-items: center; gap: 10px; margin-top: 14px; }
  .ai-image-slideshow-{{ ai_gen_id }} .ai-image-slideshow__dot { width: 12px; height: 12px; padding: 0; border: 2px solid {{ block.settings.dot_color }}; border-radius: 50%; background: transparent; cursor: pointer; }
  .ai-image-slideshow-{{ ai_gen_id }} .ai-image-slideshow__dot[aria-current="true"] { background: {{ block.settings.dot_color }}; }
  @media (max-width: 749px) { .ai-image-slideshow-{{ ai_gen_id }} { width: 100%; } }
{% endstyle %}

<image-slideshow-{{ ai_gen_id }} class="ai-image-slideshow-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-image-slideshow__viewport" aria-live="polite">
    {% for i in (1..3) %}
      {% liquid
        assign image_key = 'slide_' | append: i | append: '_image'
        assign caption_key = 'slide_' | append: i | append: '_caption'
        assign link_key = 'slide_' | append: i | append: '_link'
        assign slide_image = block.settings[image_key]
        assign slide_caption = block.settings[caption_key]
        assign slide_link = block.settings[link_key]
      %}
      <div class="ai-image-slideshow__slide{% if forloop.first %} is-active{% endif %}" data-slide="{{ forloop.index0 }}" {% unless forloop.first %}hidden{% endunless %}>
        {% if slide_image != blank %}
          {% capture slide_media %}<img src="{{ slide_image | image_url: width: 2000 }}" alt="{{ slide_image.alt | default: slide_caption | escape }}" loading="lazy" width="{{ slide_image.width }}" height="{{ slide_image.height }}">{% endcapture %}
          {% if slide_link != blank %}<a class="ai-image-slideshow__media" href="{{ slide_link }}">{{ slide_media }}</a>{% else %}<div class="ai-image-slideshow__media">{{ slide_media }}</div>{% endif %}
        {% else %}
          <div class="ai-image-slideshow__placeholder">{{ 'image' | placeholder_svg_tag }}<span class="ai-image-slideshow__empty">Add an image for slide {{ i }}</span></div>
        {% endif %}
      </div>
    {% endfor %}
    {% if block.settings.show_arrows %}
      <button class="ai-image-slideshow__arrow ai-image-slideshow__arrow--prev" type="button" aria-label="Previous slide"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg></button>
      <button class="ai-image-slideshow__arrow ai-image-slideshow__arrow--next" type="button" aria-label="Next slide"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg></button>
    {% endif %}
  </div>
  {% for i in (1..3) %}
    {% assign caption_key = 'slide_' | append: i | append: '_caption' %}
    {% assign slide_caption = block.settings[caption_key] %}
    {% if slide_caption != blank %}<p class="ai-image-slideshow__caption{% if forloop.first %} is-active{% endif %}" data-caption="{{ forloop.index0 }}" {% unless forloop.first %}hidden{% endunless %}>{{ slide_caption | escape }}</p>{% endif %}
  {% endfor %}
  {% if block.settings.show_dots %}<div class="ai-image-slideshow__dots" role="group" aria-label="Choose a slide">{% for i in (1..3) %}<button class="ai-image-slideshow__dot" type="button" data-dot="{{ forloop.index0 }}" aria-label="Go to slide {{ forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}"></button>{% endfor %}</div>{% endif %}
</image-slideshow-{{ ai_gen_id }}>

<script>
  (function() {
    const tagName = 'image-slideshow-{{ ai_gen_id }}';
    if (customElements.get(tagName)) return;
    class ImageSlideshow extends HTMLElement {
      connectedCallback() {
        this.slides = Array.from(this.querySelectorAll('[data-slide]'));
        this.dots = Array.from(this.querySelectorAll('[data-dot]'));
        this.captions = Array.from(this.querySelectorAll('[data-caption]'));
        this.index = 0;
        const previous = this.querySelector('.ai-image-slideshow__arrow--prev');
        const next = this.querySelector('.ai-image-slideshow__arrow--next');
        if (previous) previous.addEventListener('click', () => this.goTo(this.index - 1));
        if (next) next.addEventListener('click', () => this.goTo(this.index + 1));
        this.dots.forEach((dot) => dot.addEventListener('click', () => this.goTo(Number(dot.dataset.dot))));
      }
      goTo(index) {
        this.index = (index + this.slides.length) % this.slides.length;
        this.slides.forEach((slide, i) => { const active = i === this.index; slide.hidden = !active; slide.classList.toggle('is-active', active); });
        this.dots.forEach((dot, i) => dot.setAttribute('aria-current', i === this.index ? 'true' : 'false'));
        this.captions.forEach((caption) => { const active = Number(caption.dataset.caption) === this.index; caption.hidden = !active; caption.classList.toggle('is-active', active); });
      }
    }
    customElements.define(tagName, ImageSlideshow);
  })();
</script>

{% schema %}
{
  "name": "Image slideshow",
  "settings": [
    { "type": "header", "content": "Slides" },
    { "type": "image_picker", "id": "slide_1_image", "label": "Slide 1 image" },
    { "type": "text", "id": "slide_1_caption", "label": "Slide 1 caption" },
    { "type": "url", "id": "slide_1_link", "label": "Slide 1 link" },
    { "type": "image_picker", "id": "slide_2_image", "label": "Slide 2 image" },
    { "type": "text", "id": "slide_2_caption", "label": "Slide 2 caption" },
    { "type": "url", "id": "slide_2_link", "label": "Slide 2 link" },
    { "type": "image_picker", "id": "slide_3_image", "label": "Slide 3 image" },
    { "type": "text", "id": "slide_3_caption", "label": "Slide 3 caption" },
    { "type": "url", "id": "slide_3_link", "label": "Slide 3 link" },
    { "type": "header", "content": "Layout and controls" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "select", "id": "image_ratio", "label": "Image ratio", "options": [{ "value": "16 / 9", "label": "Wide (16:9)" }, { "value": "4 / 3", "label": "Landscape (4:3)" }, { "value": "1 / 1", "label": "Square (1:1)" }, { "value": "3 / 4", "label": "Portrait (3:4)" }], "default": "16 / 9" },
    { "type": "checkbox", "id": "show_arrows", "label": "Show arrow controls", "default": true },
    { "type": "checkbox", "id": "show_dots", "label": "Show navigation dots", "default": true },
    { "type": "header", "content": "Appearance" },
    { "type": "color", "id": "caption_color", "label": "Caption color", "default": "#000000" },
    { "type": "color", "id": "control_color", "label": "Arrow color", "default": "#000000" },
    { "type": "color", "id": "control_background", "label": "Arrow background", "default": "#FFFFFF" },
    { "type": "color", "id": "dot_color", "label": "Dot color", "default": "#000000" },
    { "type": "range", "id": "corner_radius", "label": "Corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 10 },
    { "type": "range", "id": "shadow_strength", "label": "Shadow strength", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 12 }
  ],
  "presets": [{ "name": "Image slideshow" }],
  "tag": null,
  "class": "image-slideshow-block"
}
{% endschema %}