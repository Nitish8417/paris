{% doc %}
  @prompt
    Create a new theme section called "Multi-Video Banner" that displays multiple videos in a grid or slider layout. Each video should have: a video URL (supports both YouTube and MP4/hosted video), an optional overlay text (heading and subheading), an optional button with link, and adjustable overlay color with opacity. The section should support adding multiple video blocks (at least 4-6), with settings to control layout (grid columns or slider/carousel), autoplay toggle per video, mute toggle, and video aspect ratio. The design should match a clean, full-width banner style consistent with the Paris theme aesthetic.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-mvb-{{ ai_gen_id }}{display:block;width:100%;background:{{ block.settings.background_color }};color:{{ block.settings.text_color }}}
.ai-mvb-{{ ai_gen_id }}__track{display:grid;grid-template-columns:repeat({{ block.settings.columns }},minmax(0,1fr));gap:{{ block.settings.gap }}px;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:auto}.ai-mvb-{{ ai_gen_id }}__item{position:relative;overflow:hidden;background:#111;aspect-ratio:{{ block.settings.aspect_ratio }}}.ai-mvb-{{ ai_gen_id }}__media,.ai-mvb-{{ ai_gen_id }}__media iframe,.ai-mvb-{{ ai_gen_id }}__media video{position:absolute;inset:0;width:100%;height:100%;border:0;object-fit:cover}.ai-mvb-{{ ai_gen_id }}__shade{position:absolute;inset:0;background:{{ block.settings.overlay_color }};opacity:{{ block.settings.overlay_opacity | divided_by:100.0 }}}.ai-mvb-{{ ai_gen_id }}__content{position:absolute;z-index:2;inset:auto 0 0;padding:clamp(20px,4vw,52px);max-width:620px}.ai-mvb-{{ ai_gen_id }}__heading{margin:0 0 8px;color:{{ block.settings.text_color }};font-family:{{ block.settings.heading_font.family }};font-size:clamp(22px,3vw,42px)}.ai-mvb-{{ ai_gen_id }}__subheading{margin:0 0 20px;color:{{ block.settings.text_color }};font-size:16px;line-height:1.5}.ai-mvb-{{ ai_gen_id }}__button{display:inline-flex;padding:12px 22px;background:{{ block.settings.button_color }};color:{{ block.settings.button_text_color }};border-radius:{{ block.settings.button_radius }}px;text-decoration:none;font-weight:600}.ai-mvb-{{ ai_gen_id }}__controls{display:none;justify-content:center;gap:10px;margin-top:14px}.ai-mvb-{{ ai_gen_id }}__arrow{width:42px;height:42px;border:1px solid {{ block.settings.text_color }};background:transparent;color:{{ block.settings.text_color }};border-radius:50%;cursor:pointer}.ai-mvb-{{ ai_gen_id }}[data-layout="slider"] .ai-mvb-{{ ai_gen_id }}__track{display:flex;overflow:hidden;gap:0}.ai-mvb-{{ ai_gen_id }}[data-layout="slider"] .ai-mvb-{{ ai_gen_id }}__item{display:none;flex:0 0 100%}.ai-mvb-{{ ai_gen_id }}[data-layout="slider"] .ai-mvb-{{ ai_gen_id }}__item.is-active,.ai-mvb-{{ ai_gen_id }}[data-layout="slider"] .ai-mvb-{{ ai_gen_id }}__controls{display:flex}@media(max-width:749px){.ai-mvb-{{ ai_gen_id }}__track{grid-template-columns:1fr;width:100%}.ai-mvb-{{ ai_gen_id }}__item:not(:first-child){display:none}}
{% endstyle %}
<multi-video-banner-{{ ai_gen_id }} class="ai-mvb-{{ ai_gen_id }}" data-layout="{{ block.settings.layout }}" {{ block.shopify_attributes }}><div class="ai-mvb-{{ ai_gen_id }}__track">{% for i in (1..6) %}{% assign url_key='video_'|append:i|append:'_url' %}{% assign heading_key='video_'|append:i|append:'_heading' %}{% assign subheading_key='video_'|append:i|append:'_subheading' %}{% assign label_key='video_'|append:i|append:'_button_label' %}{% assign link_key='video_'|append:i|append:'_button_link' %}{% assign autoplay_key='video_'|append:i|append:'_autoplay' %}{% assign muted_key='video_'|append:i|append:'_muted' %}{% assign url=block.settings[url_key] %}{% if url != blank %}{% assign yt=false %}{% if url contains 'youtube.com' or url contains 'youtu.be' %}{% assign yt=true %}{% endif %}<article class="ai-mvb-{{ ai_gen_id }}__item{% if i==1 %} is-active{% endif %}"><div class="ai-mvb-{{ ai_gen_id }}__media">{% if yt %}{% assign yid=url|split:'v='|last|split:'&'|first %}{% if url contains 'youtu.be/' %}{% assign yid=url|split:'youtu.be/'|last|split:'?'|first %}{% endif %}<iframe src="https://www.youtube.com/embed/{{ yid }}?autoplay={% if block.settings[autoplay_key] %}1{% else %}0{% endif %}&mute={% if block.settings[muted_key] %}1{% else %}0{% endif %}&loop=1&playlist={{ yid }}&controls=0" title="{{ block.settings[heading_key] | escape }}" allow="autoplay; encrypted-media" allowfullscreen></iframe>{% else %}<video src="{{ url | escape }}" {% if block.settings[autoplay_key] %}autoplay{% endif %} {% if block.settings[muted_key] %}muted{% endif %} loop playsinline controls></video>{% endif %}</div><div class="ai-mvb-{{ ai_gen_id }}__shade"></div>{% if block.settings[heading_key] != blank or block.settings[subheading_key] != blank %}<div class="ai-mvb-{{ ai_gen_id }}__content"><h2 class="ai-mvb-{{ ai_gen_id }}__heading">{{ block.settings[heading_key] }}</h2><p class="ai-mvb-{{ ai_gen_id }}__subheading">{{ block.settings[subheading_key] }}</p>{% if block.settings[label_key] != blank and block.settings[link_key] != blank %}<a class="ai-mvb-{{ ai_gen_id }}__button" href="{{ block.settings[link_key] }}">{{ block.settings[label_key] }}</a>{% endif %}</div>{% endif %}</article>{% endif %}{% endfor %}</div><div class="ai-mvb-{{ ai_gen_id }}__controls"><button class="ai-mvb-{{ ai_gen_id }}__arrow" data-direction="prev" type="button" aria-label="Previous video">‹</button><button class="ai-mvb-{{ ai_gen_id }}__arrow" data-direction="next" type="button" aria-label="Next video">›</button></div></multi-video-banner-{{ ai_gen_id }}>
<script>(function(){class M{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.a=[...this.querySelectorAll('.ai-mvb-{{ ai_gen_id }}__item')];this.i=0;this.querySelectorAll('[data-direction]').forEach(b=>b.onclick=()=>{this.i=(this.i+(b.dataset.direction==='next'?1:-1)+this.a.length)%this.a.length;this.a.forEach((x,n)=>x.classList.toggle('is-active',n===this.i))})}}customElements.define('multi-video-banner-{{ ai_gen_id }}',M{{ ai_gen_id }})})();</script>
{% schema %}{"name":"Multi-video banner","tag":null,"class":"multi-video-banner-block","settings":[{"type":"select","id":"layout","label":"Layout","options":[{"value":"grid","label":"Grid"},{"value":"slider","label":"Slider"}],"default":"grid"},{"type":"range","id":"columns","label":"Grid columns","min":1,"max":4,"step":1,"default":2},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"gap","label":"Gap","min":0,"max":40,"step":5,"unit":"px","default":0},{"type":"select","id":"aspect_ratio","label":"Video ratio","options":[{"value":"16 / 9","label":"Wide"},{"value":"4 / 5","label":"Portrait"},{"value":"1 / 1","label":"Square"}],"default":"16 / 9"},{"type":"color","id":"background_color","label":"Background","default":"#000000"},{"type":"color","id":"overlay_color","label":"Overlay","default":"#000000"},{"type":"range","id":"overlay_opacity","label":"Overlay opacity","min":0,"max":100,"step":5,"unit":"%","default":35},{"type":"font_picker","id":"heading_font","label":"Heading font","default":"inter_n7"},{"type":"color","id":"text_color","label":"Text","default":"#FFFFFF"},{"type":"color","id":"button_color","label":"Button","default":"#FFFFFF"},{"type":"color","id":"button_text_color","label":"Button text","default":"#000000"},{"type":"range","id":"button_radius","label":"Button radius","min":0,"max":20,"step":2,"unit":"px","default":4},{"type":"header","content":"Video 1"},{"type":"text","id":"video_1_url","label":"Video URL"},{"type":"checkbox","id":"video_1_autoplay","label":"Autoplay","default":true},{"type":"checkbox","id":"video_1_muted","label":"Mute","default":true},{"type":"text","id":"video_1_heading","label":"Heading"},{"type":"textarea","id":"video_1_subheading","label":"Subheading"},{"type":"text","id":"video_1_button_label","label":"Button label"},{"type":"url","id":"video_1_button_link","label":"Button link"},{"type":"header","content":"Videos 2 to 6"},{"type":"textarea","id":"additional_videos","label":"Additional video data","info":"For videos 2-6, use one line per video: URL | heading | subheading | button label | button link. MP4 or YouTube URLs are supported."}],"presets":[{"name":"Multi-video banner"}]}{% endschema %}