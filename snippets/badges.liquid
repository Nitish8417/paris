{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign is_zero_stock = false
  if variant != blank and variant.inventory_management == 'shopify' and variant.inventory_quantity <= 0
    assign is_zero_stock = true
  endif
-%}
{%- if is_zero_stock or product.available == false -%}
  <div class="badge-card">
    <span class="badge-item badge-sold">{{ 'products.product.inventory_out_of_stock' | t }}</span>
  </div>
{%- else -%}
  <div class="badge-card">
    {% if settings.sale_badge %}
      {% liquid
        assign sale_compare = product.compare_at_price_min
        assign sale_price = product.price_min
        assign sale_percent = 0
        if sale_compare > sale_price and sale_compare > 0
          assign sale_percent = sale_compare | minus: sale_price | times: 100.0 | divided_by: sale_compare | round
        endif
      %}
      {% if sale_percent >= 1 %}
        <span class="badge-item badge-sale">-{{ sale_percent }}%</span>
      {% endif %}
    {% endif %}
    {% if settings.custom_tag %}
      {% liquid
        assign customtags = settings.custom_tag | downcase | split: ','
        assign status = false
        for tag in customtags
          for productTagName in product.tags
            assign productTagName = productTagName | downcase
            if productTagName contains tag
              assign status = true
            endif
          endfor
        endfor
      %}
      {% if status == true and settings.custom_tag_badge != blank %}
        <span class="badge-item badge-custom">{{ settings.custom_tag_badge }}</span>
      {% endif %}
    {% endif %}
  </div>
{%- endif -%}
