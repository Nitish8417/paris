{%- comment -%}
  Products come from the product metafield:
  namespace custom, key frequently_bought_together, type List of products.
{%- endcomment -%}
{%- assign fbt_products = product.metafields.custom.frequently_bought_together.value -%}
{%- if fbt_products != blank -%}
  <product-rail class="product-rail fbt">
    <div class="product-rail__header">
      <h2 class="product-rail__title h5">Frequently bought together</h2>
      <div class="product-rail__actions">
        {% render 'product-rail-nav' %}
      </div>
    </div>
    <ul class="product-rail__track" data-rail-track role="list">
      {%- assign card_index = 0 -%}
      {%- for pass in (1..2) -%}
        {%- for fbt_product in fbt_products -%}
          {%- if fbt_product == blank or fbt_product.id == product.id -%}{%- continue -%}{%- endif -%}
          {%- capture is_sold_out -%}{%- render 'card-sold-out', product: fbt_product -%}{%- endcapture -%}
          {%- assign is_sold_out = is_sold_out | strip -%}
          {%- if pass == 1 and is_sold_out == 'true' -%}{%- continue -%}{%- endif -%}
          {%- if pass == 2 and is_sold_out != 'true' -%}{%- continue -%}{%- endif -%}
          {%- assign card_index = card_index | plus: 1 -%}
          {%- assign productFormId = 'product-form-fbt-' | append: card_index -%}
          <li class="product-rail__item">
            {% render 'product-grid',
              cardProduct: fbt_product,
              section: section,
              productFormId: productFormId,
              imageRatio: 'square',
              show_add_to_cart: true,
              enable_image_border: true,
              search: true
            %}
          </li>
        {%- endfor -%}
      {%- endfor -%}
    </ul>
  </product-rail>
  <style>
    .fbt {
      --railColumns: 4;
      --railGap: 12px;
      margin-top: 28px;
    }
    .fbt .product-rail__header {
      margin-bottom: 14px;
    }
    .fbt .product-rail__title {
      font-size: 16px;
    }
    .fbt .product-rail__arrow {
      width: 34px;
      height: 34px;
    }
    .fbt .product-card .media-image img,
    .fbt .product-card .media-image .placeholder-svg {
      padding: 12px;
    }
    .fbt .product-name {
      font-size: 13px;
      line-height: 1.35;
      min-height: calc(1.35em * 2);
      max-height: calc(1.35em * 2);
    }
    .fbt .price-wrapper,
    .fbt .item-price,
    .fbt .item-price-old {
      font-size: 12px;
    }
    .fbt .product-card-atc {
      padding-top: 10px;
    }
    .fbt .product-card-atc__btn {
      min-width: 0;
      min-height: 36px;
      padding: 6px 4px;
      font-size: 11px;
    }
    .fbt .view-product-box {
      display: none;
    }
    @media only screen and (max-width: 989px) {
      .fbt {
        --railColumns: 4;
      }
    }
    @media only screen and (max-width: 767px) {
      .fbt .product-rail__track {
        grid-auto-columns: calc(45% - var(--railGap));
      }
    }
  </style>
{%- endif -%}
